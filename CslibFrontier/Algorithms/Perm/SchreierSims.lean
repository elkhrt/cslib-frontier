/-!
# Deterministic Schreier–Sims Permutation Group Order Algorithm

This module implements a purely functional deterministic Schreier–Sims / Furst–Hopcroft–Luks
algorithm computing the order of a finite permutation group generated by a list of permutations on
`Fin n` via strong generating sift tables, and proves its algebraic correctness unconditionally
under standard Lean axioms.

## Main definitions

* `CslibFrontier.Algorithms.Perm.SchreierSims.isPermList`, `permId`, `permMul`, `permInv`:
  list-level permutation arithmetic on `Fin n`.
* `CslibFrontier.Algorithms.Perm.SchreierSims.siftOne`, `closeOnce`, `closeTable`:
  the `n × n` sift table construction and pairwise-product closure.
* `CslibFrontier.Algorithms.Perm.SchreierSims.schreierSimsOrder`:
  computes `|⟨S⟩|` from a list of generating permutations on `Fin n`.

## Main results

* `CslibFrontier.Algorithms.Perm.SchreierSims.schreierSimsOrder_eq_card`:
  for any list `gens` of permutations on `Fin n`, `schreierSimsOrder n gens` equals the cardinality
  of the subgroup of `Equiv.Perm (Fin n)` generated by the valid permutations in `gens`.
-/

public section

namespace CslibFrontier.Algorithms.Perm.SchreierSims


/-! ### 1. List Representation of Permutations on `Fin n` -/

/-- Test whether `p : List ℕ` represents a bijection on `Fin n`. -/
@[expose] def isPermList (n : ℕ) (p : List ℕ) : Bool :=
  (p.length == n) &&
    (List.range n).all (fun i => decide (p.getD i n < n)) &&
    (List.range n).all (fun j => (List.range n).any (fun i => p.getD i n == j))

/-- The identity permutation on `Fin n` as a list `[0, 1, …, n - 1]`. -/
@[expose] def permId (n : ℕ) : List ℕ := List.range n

/-- Composition `(p * q)(i) = p(q(i))` of list-encoded permutations on `Fin n`. -/
@[expose] def permMul (n : ℕ) (p q : List ℕ) : List ℕ :=
  (List.range n).map (fun i => p.getD (q.getD i n) n)

/-- Inverse of a list-encoded permutation on `Fin n`. -/
@[expose] def permInv (n : ℕ) (p : List ℕ) : List ℕ :=
  (List.range n).map (fun j => p.idxOf j)

/-- Convert an `Equiv.Perm (Fin n)` to its list encoding. -/
@[expose] def permToList {n : ℕ} (σ : Equiv.Perm (Fin n)) : List ℕ :=
  (List.range n).map (fun i => if h : i < n then (σ ⟨i, h⟩).val else n)

/-- Reading position `i` of `permToList σ` recovers `(σ ⟨i, hi⟩).val`. -/
theorem getD_permToList {n : ℕ} (σ : Equiv.Perm (Fin n)) {i : ℕ} (hi : i < n) :
    (permToList σ).getD i n = (σ ⟨i, hi⟩).val := by
  rw [List.getD_eq_getElem _ _ (by simp [permToList, hi])]
  simp [permToList, hi]

@[simp] theorem length_permToList {n : ℕ} (σ : Equiv.Perm (Fin n)) :
    (permToList σ).length = n := by simp [permToList]

theorem mem_permToList {n : ℕ} (σ : Equiv.Perm (Fin n)) {x : ℕ} :
    x ∈ permToList σ ↔ ∃ (k : ℕ) (hk : k < n), (σ ⟨k, hk⟩).val = x := by
  simp only [permToList, List.mem_map, List.mem_range]
  exact ⟨fun ⟨k, hk, h⟩ => ⟨k, hk, by simpa [hk] using h⟩,
    fun ⟨k, hk, h⟩ => ⟨k, hk, by simpa [hk] using h⟩⟩

@[simp] theorem length_permMul (n : ℕ) (p q : List ℕ) : (permMul n p q).length = n := by
  simp [permMul]

theorem mem_permMul (n : ℕ) (p q : List ℕ) {z : ℕ} :
    z ∈ permMul n p q ↔ ∃ m < n, p.getD (q.getD m n) n = z := by
  simp [permMul]

theorem getElem_permInv (n : ℕ) (p : List ℕ) {q : ℕ} (hq : q < (permInv n p).length) :
    (permInv n p)[q] = p.idxOf q := by
  simp [permInv]

/-- Predicate characterizing valid permutation lists of length `n`. -/
theorem isPermList_eq_true_iff (n : ℕ) (p : List ℕ) :
    isPermList n p = true ↔ ∃ σ : Equiv.Perm (Fin n), permToList σ = p := by
  constructor
  · intro h
    simp only [isPermList, Bool.and_eq_true, beq_iff_eq, List.all_eq_true,
      List.mem_range, decide_eq_true_eq, List.any_eq_true] at h
    obtain ⟨⟨hlen, hlt⟩, hsurj⟩ := h
    let f : Fin n → Fin n := fun i => ⟨p.getD i.val n, hlt i.val i.isLt⟩
    have hf_surj : Function.Surjective f := fun j => by
      obtain ⟨i, hi, hij⟩ := hsurj j.val j.isLt
      exact ⟨⟨i, hi⟩, Fin.ext hij⟩
    have hf_bij : Function.Bijective f :=
      ⟨Finite.injective_iff_surjective.mpr hf_surj, hf_surj⟩
    refine ⟨Equiv.ofBijective f hf_bij, ?_⟩
    refine List.ext_getElem (by simp [permToList, hlen]) fun i hi1 hi2 => ?_
    have hi : i < n := by simpa [permToList] using hi1
    simp only [permToList, List.getElem_map, List.getElem_range, hi, ↓reduceDIte,
      Equiv.ofBijective_apply, f]
    rw [List.getD_eq_getElem _ _ hi2]
  · rintro ⟨σ, rfl⟩
    simp only [isPermList, Bool.and_eq_true, beq_iff_eq, List.all_eq_true,
      List.mem_range, decide_eq_true_eq, List.any_eq_true]
    refine ⟨⟨by simp [permToList], fun i hi => ?_⟩, fun j hj => ?_⟩
    · rw [getD_permToList σ hi]; exact (σ ⟨i, hi⟩).isLt
    · refine ⟨(σ.symm ⟨j, hj⟩).val, (σ.symm ⟨j, hj⟩).isLt, ?_⟩
      rw [getD_permToList σ (σ.symm ⟨j, hj⟩).isLt]
      simp

/-- `permToList` is injective on `Equiv.Perm (Fin n)`. -/
theorem permToList_injective {n : ℕ} : Function.Injective (permToList (n := n)) := by
  intro σ τ h
  ext ⟨i, hi⟩
  have hget := congrArg (fun l => l.getD i n) h
  simpa only [getD_permToList σ hi, getD_permToList τ hi] using hget

/-- `permToList 1 = permId n`. -/
@[simp] theorem permToList_one (n : ℕ) : permToList (1 : Equiv.Perm (Fin n)) = permId n := by
  refine List.ext_getElem (by simp [permToList, permId]) fun i hi _ => ?_
  have hin : i < n := by simpa [permToList] using hi
  simp [permToList, permId, hin]

/-- `permToList (σ * τ) = permMul n (permToList σ) (permToList τ)`. -/
@[simp] theorem permToList_mul {n : ℕ} (σ τ : Equiv.Perm (Fin n)) :
    permToList (σ * τ) = permMul n (permToList σ) (permToList τ) := by
  refine List.ext_getElem (by simp [permToList, permMul]) fun i hi _ => ?_
  have hin : i < n := by simpa [permToList] using hi
  simp only [permMul, List.getElem_map, List.getElem_range]
  rw [getD_permToList τ hin, getD_permToList σ (τ ⟨i, hin⟩).isLt]
  simp [permToList, hin]

private theorem list_idxOf_eq_of_getElem {α : Type*} [BEq α] [LawfulBEq α]
    (l : List α) (a : α) (k : ℕ) (hk : k < l.length) (hget : l[k] = a)
    (hfirst : ∀ j (hj : j < k), l[j]'(lt_trans hj hk) ≠ a) : l.idxOf a = k := by
  induction l generalizing k with
  | nil => simp at hk
  | cons hd tl ih =>
    cases k with
    | zero =>
      simp only [List.getElem_cons_zero] at hget
      simp [hget]
    | succ k =>
      simp only [List.getElem_cons_succ] at hget
      have hne : hd ≠ a := by simpa using hfirst 0 (Nat.zero_lt_succ k)
      have hbeq : (hd == a) = false := beq_false_of_ne hne
      simp only [List.idxOf_cons, hbeq]
      exact congrArg (· + 1) (ih k (by simpa using hk) hget
        (fun j hj => by simpa using hfirst (j + 1) (Nat.succ_lt_succ hj)))

/-- `permToList σ⁻¹ = permInv n (permToList σ)`. -/
@[simp] theorem permToList_inv {n : ℕ} (σ : Equiv.Perm (Fin n)) :
    permToList σ⁻¹ = permInv n (permToList σ) := by
  refine List.ext_getElem (by simp [permToList, permInv]) fun j hj _ => ?_
  have hjn : j < n := by simpa [permToList] using hj
  rw [show (permToList σ⁻¹)[j] = (σ⁻¹ ⟨j, hjn⟩).val by simp [permToList, hjn]]
  simp only [permInv, List.getElem_map, List.getElem_range]
  symm
  refine list_idxOf_eq_of_getElem (permToList σ) j (σ⁻¹ ⟨j, hjn⟩).val
    (by simp [permToList]) ?_ (fun k hk => ?_)
  · simp [permToList]
  · simp only [permToList, List.getElem_map, List.getElem_range,
      show k < n from lt_trans hk (σ⁻¹ ⟨j, hjn⟩).isLt, ↓reduceDIte]
    intro heq
    have hfin : (⟨k, lt_trans hk (σ⁻¹ ⟨j, hjn⟩).isLt⟩ : Fin n) = σ⁻¹ ⟨j, hjn⟩ := by
      apply σ.injective
      ext
      simpa using heq
    exact Nat.ne_of_lt hk (congrArg Fin.val hfin)

/-! ### 2. Sift Tables and Algebraic Correctness -/

/-- A mathematical strong generating sift table on `Fin n`. -/
abbrev MathTable (n : ℕ) := Fin n → Fin n → Option (Equiv.Perm (Fin n))

/-- Well-formedness invariant of a sift table with respect to a subgroup `G ≤ Perm (Fin n)`:
every stored entry `T i j = some σ` belongs to `G`, fixes all `k < i`, and maps `i` to `j`;
and every diagonal entry `T i i` is `some 1`. -/
structure TableInv {n : ℕ} (G : Subgroup (Equiv.Perm (Fin n))) (T : MathTable n) : Prop where
  diag : ∀ i : Fin n, T i i = some 1
  mem_group : ∀ i j σ, T i j = some σ → σ ∈ G
  fixes_lt : ∀ i j σ, T i j = some σ → ∀ k : Fin n, k < i → σ k = k
  maps_to : ∀ i j σ, T i j = some σ → σ i = j

/-- Count of stored entries in row `i` of a `MathTable`. -/
noncomputable def rowCard {n : ℕ} (T : MathTable n) (i : Fin n) : ℕ := by
  classical
  exact (Finset.univ.filter (fun j : Fin n => (T i j).isSome)).card

/-- Total number of stored entries in a `MathTable`. -/
noncomputable def tableCard {n : ℕ} (T : MathTable n) : ℕ :=
  ∑ i : Fin n, rowCard T i

/-- `tableCard T ≤ n * n`. -/
theorem tableCard_le {n : ℕ} (T : MathTable n) : tableCard T ≤ n * n := by
  calc tableCard T = ∑ i : Fin n, rowCard T i := rfl
    _ ≤ ∑ _i : Fin n, n := Finset.sum_le_sum fun i _ => by
      simpa [rowCard] using
        Finset.card_le_univ (Finset.univ.filter (fun j : Fin n => (T i j).isSome))
    _ = n * n := by simp

/-- Mathematical sifting of `g : Perm (Fin n)` through `T` starting at level `k`. -/
def mathSiftAux {n : ℕ} : ℕ → MathTable n → Equiv.Perm (Fin n) → MathTable n
  | 0, T, _ => T
  | k + 1, T, g =>
    if h : n - (k + 1) < n then
      let i : Fin n := ⟨n - (k + 1), h⟩
      let j := g i
      match T i j with
      | none => fun a b => if a = i ∧ b = j then some g else T a b
      | some σ => mathSiftAux k T (σ⁻¹ * g)
    else T

/-- Sift `g` through `T` from level `0` to `n - 1`. -/
def mathSift {n : ℕ} (T : MathTable n) (g : Equiv.Perm (Fin n)) : MathTable n :=
  mathSiftAux n T g

/-- Result of sifting `g` through `T` without modifying `T`: `true` iff `g` sifts to `1`. -/
def mathSiftsToOneAux {n : ℕ} : ℕ → MathTable n → Equiv.Perm (Fin n) → Prop
  | 0, _, g => g = 1
  | k + 1, T, g =>
    if h : n - (k + 1) < n then
      let i : Fin n := ⟨n - (k + 1), h⟩
      match T i (g i) with
      | none => False
      | some σ => mathSiftsToOneAux k T (σ⁻¹ * g)
    else g = 1

/-- `g` sifts to `1` in `T` (so `g` factors as a product of entries of `T`). -/
def mathSiftsToOne {n : ℕ} (T : MathTable n) (g : Equiv.Perm (Fin n)) : Prop :=
  mathSiftsToOneAux n T g

/-- `P_k T`: products `g_k * g_{k+1} * … * g_{n-1}` with each `g_i` in row `i` of `T`. -/
def rowProdSet {n : ℕ} (T : MathTable n) : ℕ → Set (Equiv.Perm (Fin n))
  | 0 => {1}
  | k + 1 =>
    if h : n - (k + 1) < n then
      let i : Fin n := ⟨n - (k + 1), h⟩
      {x | ∃ (j : Fin n) (σ : Equiv.Perm (Fin n)) (y : Equiv.Perm (Fin n)),
        T i j = some σ ∧ y ∈ rowProdSet T k ∧ x = σ * y}
    else {1}

/-- Sifting preserves `TableInv` and only adds entries (never overwrites existing entries). -/
theorem mathSiftAux_inv {n : ℕ} {G : Subgroup (Equiv.Perm (Fin n))} :
    ∀ (k : ℕ) (_hk : k ≤ n) (T : MathTable n) (g : Equiv.Perm (Fin n)),
      TableInv G T → g ∈ G → (∀ m : Fin n, m.val < n - k → g m = m) →
      TableInv G (mathSiftAux k T g) ∧
        (∀ i j σ, T i j = some σ → mathSiftAux k T g i j = some σ) ∧
        (mathSiftAux k T g = T ↔ mathSiftsToOneAux k T g) := by
  intro k
  induction k with
  | zero =>
    intro _ T g hT _ hfix
    have hg1 : g = 1 := by
      ext m
      exact congrArg Fin.val (hfix m (by omega))
    exact ⟨hT, fun _ _ _ h => h, ⟨fun _ => hg1, fun _ => rfl⟩⟩
  | succ k ih =>
    intro hk T g hT hg hfix
    have hlt : n - (k + 1) < n := by omega
    let i : Fin n := ⟨n - (k + 1), hlt⟩
    simp only [mathSiftAux, mathSiftsToOneAux, hlt, ↓reduceDIte]
    cases hTi : T i (g i) with
    | none =>
      refine ⟨?_, ?_, ?_⟩
      · refine ⟨fun a => ?_, fun a b σ h => ?_, fun a b σ h m hm => ?_, fun a b σ h => ?_⟩
        · by_cases ha : a = i ∧ a = g i
          · exfalso
            have hig : i = g i := ha.1.symm.trans ha.2
            rw [← hig, hT.diag i] at hTi
            cases hTi
          · change (if a = i ∧ a = g i then some g else T a a) = some 1
            simp only [ha, ↓reduceIte, hT.diag a]
        · change (if a = i ∧ b = g i then some g else T a b) = some σ at h
          by_cases ha : a = i ∧ b = g i
          · simp only [ha, and_self, ↓reduceIte, Option.some.injEq] at h; exact h ▸ hg
          · simp only [ha, ↓reduceIte] at h; exact hT.mem_group a b σ h
        · change (if a = i ∧ b = g i then some g else T a b) = some σ at h
          by_cases ha : a = i ∧ b = g i
          · simp only [ha, and_self, ↓reduceIte, Option.some.injEq] at h
            rw [← h]; exact hfix m (by rw [ha.1] at hm; exact hm)
          · simp only [ha, ↓reduceIte] at h; exact hT.fixes_lt a b σ h m hm
        · change (if a = i ∧ b = g i then some g else T a b) = some σ at h
          by_cases ha : a = i ∧ b = g i
          · simp only [ha, and_self, ↓reduceIte, Option.some.injEq] at h; rw [← h, ha.1, ha.2]
          · simp only [ha, ↓reduceIte] at h; exact hT.maps_to a b σ h
      · intro a b σ h
        change (if a = i ∧ b = g i then some g else T a b) = some σ
        by_cases ha : a = i ∧ b = g i
        · rw [ha.1, ha.2, hTi] at h; cases h
        · simp only [ha, ↓reduceIte, h]
      · constructor
        · intro heq
          have hsome : (fun a b => if a = i ∧ b = g i then some g else T a b) i (g i) =
              T i (g i) := congrFun (congrFun heq i) (g i)
          simp [hTi] at hsome
        · exact False.elim
    | some σ =>
      have hσG : σ ∈ G := hT.mem_group i (g i) σ hTi
      have hfix' : ∀ m : Fin n, m.val < n - k → (σ⁻¹ * g) m = m := by
        intro m hm
        by_cases hmi : m.val < n - (k + 1)
        · have hgm : g m = m := hfix m hmi
          have hσm : σ m = m := hT.fixes_lt i (g i) σ hTi m hmi
          apply σ.injective
          simp [Equiv.Perm.mul_apply, hgm, hσm]
        · have hmeq : m = i := Fin.ext (by dsimp [i]; omega)
          rw [hmeq]
          apply σ.injective
          simp [Equiv.Perm.mul_apply, hT.maps_to i (g i) σ hTi]
      exact ih (by omega) T (σ⁻¹ * g) hT (G.mul_mem (G.inv_mem hσG) hg) hfix'

/-- Every element in `rowProdSet T k` fixes all indices `< n - k`. -/
theorem rowProdSet_fixes_lt {n : ℕ} {G : Subgroup (Equiv.Perm (Fin n))} {T : MathTable n}
    (hT : TableInv G T) : ∀ (k : ℕ) (x : Equiv.Perm (Fin n)),
      x ∈ rowProdSet T k → ∀ m : Fin n, m.val < n - k → x m = m := by
  intro k
  induction k with
  | zero =>
    intro x hx m _
    simp only [rowProdSet, Set.mem_singleton_iff] at hx
    simp [hx]
  | succ k ih =>
    intro x hx m hm
    by_cases hlt : n - (k + 1) < n
    · simp only [rowProdSet, hlt, ↓reduceDIte, Set.mem_ofPred_eq] at hx
      obtain ⟨j, σ, y, hσ, hy, rfl⟩ := hx
      have hym : y m = m := ih y hy m (by omega)
      have hσm : σ m = m := hT.fixes_lt ⟨n - (k + 1), hlt⟩ j σ hσ m hm
      simp [Equiv.Perm.mul_apply, hym, hσm]
    · simp only [rowProdSet, hlt, ↓reduceDIte, Set.mem_singleton_iff] at hx
      simp [hx]

/-- `mathSiftsToOneAux k T g ↔ g ∈ rowProdSet T k` (for `g` fixing `< n - k`). -/
theorem mathSiftsToOneAux_iff_mem_rowProdSet {n : ℕ} {G : Subgroup (Equiv.Perm (Fin n))}
    {T : MathTable n} (hT : TableInv G T) :
    ∀ (k : ℕ) (_hk : k ≤ n) (g : Equiv.Perm (Fin n)),
      (∀ m : Fin n, m.val < n - k → g m = m) →
      (mathSiftsToOneAux k T g ↔ g ∈ rowProdSet T k) := by
  intro k
  induction k with
  | zero =>
    intro _ g _
    simp [mathSiftsToOneAux, rowProdSet]
  | succ k ih =>
    intro hk g hfix
    have hlt : n - (k + 1) < n := by omega
    let i : Fin n := ⟨n - (k + 1), hlt⟩
    simp only [mathSiftsToOneAux, rowProdSet, hlt, ↓reduceDIte, Set.mem_ofPred_eq]
    cases hTi : T i (g i) with
    | none =>
      simp only [false_iff, not_exists, not_and]
      intro j σ y hσ hy heq
      have hyi : y i = i := rowProdSet_fixes_lt hT k y hy i (by dsimp [i]; omega)
      have hgi : g i = j := by
        rw [heq, Equiv.Perm.mul_apply, hyi, hT.maps_to i j σ hσ]
      rw [hgi, hσ] at hTi
      cases hTi
    | some σ =>
      have hfix' : ∀ m : Fin n, m.val < n - k → (σ⁻¹ * g) m = m := by
        intro m hm
        by_cases hmi : m.val < n - (k + 1)
        · have hgm := hfix m hmi
          have hσm := hT.fixes_lt i (g i) σ hTi m hmi
          apply σ.injective
          simp [Equiv.Perm.mul_apply, hgm, hσm]
        · have hmeq : m = i := Fin.ext (by dsimp [i]; omega)
          rw [hmeq]
          apply σ.injective
          simp [Equiv.Perm.mul_apply, hT.maps_to i (g i) σ hTi]
      dsimp only
      rw [ih (by omega) (σ⁻¹ * g) hfix']
      constructor
      · intro hy
        exact ⟨g i, σ, σ⁻¹ * g, hTi, hy, by simp⟩
      · rintro ⟨j, σ', y, hσ', hy, heq⟩
        have hyi : y i = i := rowProdSet_fixes_lt hT k y hy i (by dsimp [i]; omega)
        have hgi : g i = j := by
          rw [heq, Equiv.Perm.mul_apply, hyi, hT.maps_to i j σ' hσ']
        rw [hgi, hσ'] at hTi
        have hσeq : σ' = σ := Option.some.inj hTi
        subst hσeq
        simpa [heq] using hy

/-- Uniqueness of factorization: `|rowProdSet T k| = ∏_{i ≥ n - k} rowCard T i`. -/
theorem card_rowProdSet {n : ℕ} {G : Subgroup (Equiv.Perm (Fin n))} {T : MathTable n}
    (hT : TableInv G T) : ∀ (k : ℕ) (_hk : k ≤ n),
      Nat.card (rowProdSet T k) =
        ∏ i ∈ Finset.univ.filter (fun i : Fin n => n - k ≤ i.val), rowCard T i := by
  classical
  intro k
  induction k with
  | zero =>
    intro _
    have hemp : (Finset.univ.filter (fun i : Fin n => n ≤ i.val)) = ∅ := by
      ext i; simp
    simp [rowProdSet, hemp]
  | succ k ih =>
    intro hk
    have hlt : n - (k + 1) < n := by omega
    let i₀ : Fin n := ⟨n - (k + 1), hlt⟩
    let S_i : Finset (Fin n) := Finset.univ.filter (fun j : Fin n => (T i₀ j).isSome)
    -- Bijection between `S_i × rowProdSet T k` and `rowProdSet T (k + 1)`
    have hbij : ∃ e : (S_i × (rowProdSet T k)) ≃ rowProdSet T (k + 1), True := by
      refine ⟨Equiv.ofBijective (fun p =>
        let σ := (T i₀ p.1.val).get (Finset.mem_filter.mp p.1.property).2
        ⟨σ * p.2.val, by
          simp only [rowProdSet, hlt, ↓reduceDIte, Set.mem_ofPred_eq]
          exact ⟨p.1.val, σ, p.2.val, (Option.some_get _).symm, p.2.property, rfl⟩⟩) ?_, trivial⟩
      constructor
      · intro p q heq
        have hval := congrArg Subtype.val heq
        dsimp only at hval
        set σ₁ := (T i₀ p.1.val).get (Finset.mem_filter.mp p.1.property).2
        set σ₂ := (T i₀ q.1.val).get (Finset.mem_filter.mp q.1.property).2
        have hp_y : p.2.val i₀ = i₀ :=
          rowProdSet_fixes_lt hT k p.2.val p.2.property i₀ (by dsimp [i₀]; omega)
        have hq_y : q.2.val i₀ = i₀ :=
          rowProdSet_fixes_lt hT k q.2.val q.2.property i₀ (by dsimp [i₀]; omega)
        have h1 : (σ₁ * p.2.val) i₀ = p.1.val := by
          simp [Equiv.Perm.mul_apply, hp_y, hT.maps_to i₀ p.1.val σ₁ (Option.some_get _).symm]
        have h2 : (σ₂ * q.2.val) i₀ = q.1.val := by
          simp [Equiv.Perm.mul_apply, hq_y, hT.maps_to i₀ q.1.val σ₂ (Option.some_get _).symm]
        have hj : p.1 = q.1 := Subtype.ext (h1.symm.trans (hval ▸ h2))
        have hσeq : σ₁ = σ₂ := by
          have hget1 : some σ₁ = T i₀ p.1.val :=
            Option.some_get (Finset.mem_filter.mp p.1.property).2
          have hget2 : some σ₂ = T i₀ q.1.val :=
            Option.some_get (Finset.mem_filter.mp q.1.property).2
          rw [hj] at hget1
          exact Option.some.inj (hget1.trans hget2.symm)
        have hy : p.2 = q.2 := Subtype.ext (mul_left_cancel (hσeq ▸ hval))
        exact Prod.ext hj hy
      · rintro ⟨x, hx⟩
        simp only [rowProdSet, hlt, ↓reduceDIte, Set.mem_ofPred_eq] at hx
        obtain ⟨j, σ, y, hσ, hy, rfl⟩ := hx
        have hj : j ∈ S_i := Finset.mem_filter.mpr ⟨Finset.mem_univ j, by rw [hσ]; rfl⟩
        refine ⟨(⟨j, hj⟩, ⟨y, hy⟩), Subtype.ext ?_⟩
        dsimp only
        have hget : (T i₀ j).get (Finset.mem_filter.mp hj).2 = σ :=
          Option.some.inj ((Option.some_get _).trans hσ)
        rw [hget]
    obtain ⟨e, _⟩ := hbij
    have hcard := Nat.card_congr e.symm
    rw [hcard, Nat.card_prod, ih (by omega)]
    have hfinset : Finset.univ.filter (fun i : Fin n => n - (k + 1) ≤ i.val) =
        insert i₀ (Finset.univ.filter (fun i : Fin n => n - k ≤ i.val)) := by
      ext i
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert, Fin.ext_iff, i₀]
      omega
    have hnotmem : i₀ ∉ Finset.univ.filter (fun i : Fin n => n - k ≤ i.val) := by
      simp [i₀]; omega
    rw [hfinset, Finset.prod_insert hnotmem, Nat.card_eq_fintype_card, Fintype.card_coe]
    rfl

/-- Main algebraic theorem of Schreier–Sims / Furst–Hopcroft–Luks: if `T` satisfies `TableInv G T`,
every generator in `S` sifts to `1` in `T`, and every product `σ * τ` of entries of `T` sifts to `1`
in `T`, then `rowProdSet T n = Subgroup.closure S` and
`Nat.card (Subgroup.closure S) = ∏ i, rowCard T i`. -/
theorem closed_table_eq_closure {n : ℕ} (S : Set (Equiv.Perm (Fin n))) (T : MathTable n)
    (hT : TableInv (Subgroup.closure S) T)
    (hS : ∀ s ∈ S, mathSiftsToOne T s)
    (hclosed : ∀ i₁ j₁ σ₁ i₂ j₂ σ₂,
      T i₁ j₁ = some σ₁ → T i₂ j₂ = some σ₂ → mathSiftsToOne T (σ₁ * σ₂)) :
    rowProdSet T n = (Subgroup.closure S : Set (Equiv.Perm (Fin n))) ∧
      Nat.card (Subgroup.closure S) = ∏ i : Fin n, rowCard T i := by
  -- Step 1: Every element of `rowProdSet T k` is closed under left multiplication by any
  -- entry `σ` of `T` at level `m ≥ n - k`, proved by induction on `k`.
  have hmul_row : ∀ (k : ℕ) (hk : k ≤ n) (m : Fin n) (_hm : n - k ≤ m.val)
      (j : Fin n) (σ : Equiv.Perm (Fin n)),
      T m j = some σ → ∀ p ∈ rowProdSet T k, σ * p ∈ rowProdSet T k := by
    intro k
    induction k with
    | zero =>
      intro _ m hm _ _ _ _ _
      omega
    | succ k ih =>
      intro hk m hm j σ hσ p hp
      have hlt : n - (k + 1) < n := by omega
      let i₀ : Fin n := ⟨n - (k + 1), hlt⟩
      simp only [rowProdSet, hlt, ↓reduceDIte, Set.mem_ofPred_eq] at hp
      obtain ⟨j', τ, y, hτ, hy, rfl⟩ := hp
      -- `σ * τ` fixes all indices `< n - (k + 1)` because both `σ` and `τ` do.
      have hστ_fix : ∀ r : Fin n, r.val < n - (k + 1) → (σ * τ) r = r := by
        intro r hr
        have hτr := hT.fixes_lt i₀ j' τ hτ r hr
        have hσr := hT.fixes_lt m j σ hσ r (by omega)
        simp [Equiv.Perm.mul_apply, hτr, hσr]
      have hsift_στ : mathSiftsToOneAux (k + 1) T (σ * τ) := by
        have hall := hclosed m j σ i₀ j' τ hσ hτ
        have hskip : ∀ (d : ℕ) (hd : k + 1 + d ≤ n) (x : Equiv.Perm (Fin n)),
            (∀ r : Fin n, r.val < n - (k + 1) → x r = r) →
            mathSiftsToOneAux (k + 1 + d) T x → mathSiftsToOneAux (k + 1) T x := by
          intro d
          induction d with
          | zero => intro _ x _ hx; simpa using hx
          | succ d ihd =>
            intro hd x hx hxd
            have hlt' : n - ((k + 1 + d) + 1) < n := by omega
            have hadd : k + 1 + (d + 1) = (k + 1 + d) + 1 := by omega
            rw [hadd] at hxd
            simp only [mathSiftsToOneAux, hlt', ↓reduceDIte] at hxd
            have hxfix : x ⟨n - ((k + 1 + d) + 1), hlt'⟩ = ⟨n - ((k + 1 + d) + 1), hlt'⟩ :=
              hx _ (by dsimp only; omega)
            rw [hxfix, hT.diag] at hxd
            simp only [inv_one, one_mul] at hxd
            exact ihd (by omega) x hx hxd
        exact hskip (n - (k + 1)) (by omega) (σ * τ) hστ_fix
          (by simpa [Nat.add_sub_of_le hk] using (show mathSiftsToOneAux n T (σ * τ) from hall))
      have hστ_mem : σ * τ ∈ rowProdSet T (k + 1) :=
        (mathSiftsToOneAux_iff_mem_rowProdSet hT (k + 1) hk (σ * τ) hστ_fix).mp hsift_στ
      simp only [rowProdSet, hlt, ↓reduceDIte, Set.mem_ofPred_eq] at hστ_mem
      obtain ⟨j'', ρ, q, hρ, hq, hστ_eq⟩ := hστ_mem
      have hq_mul : ∀ (k' : ℕ) (hk' : k' ≤ k) (q' : Equiv.Perm (Fin n)),
          q' ∈ rowProdSet T k' → ∀ y' ∈ rowProdSet T k, q' * y' ∈ rowProdSet T k := by
        intro k'
        induction k' with
        | zero =>
          intro _ q' hq' y' hy'
          simp only [rowProdSet, Set.mem_singleton_iff] at hq'
          simpa [hq'] using hy'
        | succ k' ihk' =>
          intro hk' q' hq' y' hy'
          have hlt' : n - (k' + 1) < n := by omega
          simp only [rowProdSet, hlt', ↓reduceDIte, Set.mem_ofPred_eq] at hq'
          obtain ⟨j₁, σ₁, q₁, hσ₁, hq₁, rfl⟩ := hq'
          rw [mul_assoc]
          exact ih (by omega) ⟨n - (k' + 1), hlt'⟩ (by dsimp only; omega) j₁ σ₁ hσ₁ _
            (ihk' (by omega) q₁ hq₁ y' hy')
      simp only [rowProdSet, hlt, ↓reduceDIte, Set.mem_ofPred_eq]
      refine ⟨j'', ρ, q * y, hρ, hq_mul k le_rfl q hq y hy, ?_⟩
      rw [← mul_assoc, hστ_eq, mul_assoc]
  -- Step 2: `rowProdSet T n` is closed under multiplication by every element of `rowProdSet T n`.
  have hmul : ∀ a ∈ rowProdSet T n, ∀ b ∈ rowProdSet T n, a * b ∈ rowProdSet T n := by
    have haux : ∀ (k : ℕ) (hk : k ≤ n) (a : Equiv.Perm (Fin n)),
        a ∈ rowProdSet T k → ∀ b ∈ rowProdSet T n, a * b ∈ rowProdSet T n := by
      intro k
      induction k with
      | zero =>
        intro _ a ha b hb
        simp only [rowProdSet, Set.mem_singleton_iff] at ha
        simpa [ha] using hb
      | succ k ih =>
        intro hk a ha b hb
        have hlt : n - (k + 1) < n := by omega
        simp only [rowProdSet, hlt, ↓reduceDIte, Set.mem_ofPred_eq] at ha
        obtain ⟨j, σ, y, hσ, hy, rfl⟩ := ha
        rw [mul_assoc]
        exact hmul_row n le_rfl ⟨n - (k + 1), hlt⟩ (by omega) j σ hσ _
          (ih (by omega) y hy b hb)
    exact haux n le_rfl
  -- Step 3: `rowProdSet T n ⊆ Subgroup.closure S` and contains `1` and `S`.
  have hsub : rowProdSet T n ⊆ (Subgroup.closure S : Set (Equiv.Perm (Fin n))) := by
    have haux : ∀ (k : ℕ) (hk : k ≤ n) (a : Equiv.Perm (Fin n)),
        a ∈ rowProdSet T k → a ∈ Subgroup.closure S := by
      intro k
      induction k with
      | zero =>
        intro _ a ha
        simp only [rowProdSet, Set.mem_singleton_iff] at ha
        exact ha ▸ (Subgroup.closure S).one_mem
      | succ k ih =>
        intro hk a ha
        have hlt : n - (k + 1) < n := by omega
        simp only [rowProdSet, hlt, ↓reduceDIte, Set.mem_ofPred_eq] at ha
        obtain ⟨j, σ, y, hσ, hy, rfl⟩ := ha
        exact (Subgroup.closure S).mul_mem (hT.mem_group _ j σ hσ) (ih (by omega) y hy)
    exact haux n le_rfl
  have hone : (1 : Equiv.Perm (Fin n)) ∈ rowProdSet T n :=
    (mathSiftsToOneAux_iff_mem_rowProdSet hT n le_rfl 1 (fun _ _ => rfl)).mp
      (by
        have haux : ∀ (k : ℕ) (hk : k ≤ n), mathSiftsToOneAux k T 1 := by
          intro k
          induction k with
          | zero => intro _; rfl
          | succ k ih =>
            intro hk
            have hlt : n - (k + 1) < n := by omega
            simp only [mathSiftsToOneAux, hlt, ↓reduceDIte, Equiv.Perm.one_apply, hT.diag,
              inv_one, one_mul]
            exact ih (by omega)
        exact haux n le_rfl)
  -- Step 4: Every nonempty finite subset of a finite group closed under `*` is a subgroup
  -- (for any `a ∈ P`, `a⁻¹ = a ^ (orderOf a - 1) ∈ P`).
  have hinv : ∀ a ∈ rowProdSet T n, a⁻¹ ∈ rowProdSet T n := by
    intro a ha
    have hpow : ∀ m : ℕ, 1 ≤ m → a ^ m ∈ rowProdSet T n := by
      intro m hm
      induction m with
      | zero => omega
      | succ m ihm =>
        cases m with
        | zero => simpa using ha
        | succ m =>
          rw [pow_succ]
          exact hmul _ (ihm (by omega)) a ha
    have hord : 0 < orderOf a := orderOf_pos a
    by_cases h1 : orderOf a = 1
    · have ha1 : a = 1 := orderOf_eq_one_iff.mp h1
      simpa [ha1] using hone
    · have hge2 : 1 ≤ orderOf a - 1 := by omega
      have heq : a⁻¹ = a ^ (orderOf a - 1) := by
        have h := pow_orderOf_eq_one a
        rw [← Nat.sub_add_cancel hord, pow_succ] at h
        exact (eq_inv_of_mul_eq_one_left h).symm
      rw [heq]
      exact hpow _ hge2
  let H : Subgroup (Equiv.Perm (Fin n)) :=
    { carrier := rowProdSet T n
      one_mem' := hone
      mul_mem' := fun {a b} ha hb => hmul a ha b hb
      inv_mem' := fun {a} ha => hinv a ha }
  have hS_sub : S ⊆ H := fun s hs =>
    (mathSiftsToOneAux_iff_mem_rowProdSet hT n le_rfl s (fun _ h => by omega)).mp (hS s hs)
  have hclosure_le : Subgroup.closure S ≤ H := fun x hx =>
    Subgroup.closure_induction (fun s hs => hS_sub hs) H.one_mem
      (fun _ _ _ _ ha hb => H.mul_mem ha hb) (fun _ _ ha => H.inv_mem ha) hx
  have hset_eq : rowProdSet T n = (Subgroup.closure S : Set (Equiv.Perm (Fin n))) :=
    Set.Subset.antisymm hsub (fun x hx => hclosure_le hx)
  refine ⟨hset_eq, ?_⟩
  have hcard := card_rowProdSet hT n le_rfl
  rw [hset_eq] at hcard
  simpa using hcard

/-! ### 3. Concrete List-Level Sift Table and Polynomial-Time Certificate -/

/-- Replace the entry at index `idx` of a list `l` with `val` (via `zipIdx` + `map`). -/
@[expose] def listSet {α : Type} (l : List α) (idx : ℕ) (val : α) : List α :=
  l.zipIdx.map (fun p => if p.2 == idx then val else p.1)

/-- Set entry `(i, j)` of an `n × n` table `T` to `val`. -/
@[expose] def tableSet (T : List (List (List ℕ))) (i j : ℕ) (val : List ℕ) :
    List (List (List ℕ)) :=
  listSet T i (listSet (T.getD i []) j val)

/-- Initial `n × n` sift table: diagonal entries are `permId n`, off-diagonal entries are `[]`. -/
@[expose] def initTable (n : ℕ) : List (List (List ℕ)) :=
  (List.range n).map (fun i => (List.range n).map (fun j => if i == j then permId n else []))

/-- Sift a single permutation `g` into list-level table `T`. -/
@[expose] def siftOne (n : ℕ) (T : List (List (List ℕ))) (g : List ℕ) : List (List (List ℕ)) :=
  ((List.range n).foldl (fun (st : List (List (List ℕ)) × List ℕ × Bool) (i : ℕ) =>
    if st.2.2 then st
    else
      let j := st.2.1.getD i n
      let h := (st.1.getD i []).getD j []
      if h.isEmpty then (tableSet st.1 i j st.2.1, st.2.1, true)
      else (st.1, permMul n (permInv n h) st.2.1, false))
    (T, g, false)).1

/-- Sift all permutations in `gs` sequentially into `T`. -/
@[expose] def siftAll (n : ℕ) (T : List (List (List ℕ))) (gs : List (List ℕ)) :
    List (List (List ℕ)) :=
  gs.foldl (siftOne n) T

/-- One closure pass: collect all non-empty entries of `T`, form all pairwise products, and sift
them into `T`. -/
@[expose] def closeOnce (n : ℕ) (T : List (List (List ℕ))) : List (List (List ℕ)) :=
  let entries := (T.flatten).filter (fun e => !e.isEmpty)
  let prods := entries.flatMap (fun g => entries.map (fun h => permMul n g h))
  siftAll n T prods

/-- Check whether a list-level table satisfies `ValidListTable n T`. -/
@[expose] def isValidTable (n : ℕ) (T : List (List (List ℕ))) : Bool :=
  (T.length == n) &&
    T.all (fun row => (row.length == n) && row.all (fun e => e.isEmpty || isPermList n e))

/-- One closure pass guarded by `isValidTable` (identical to `closeOnce` on valid tables). -/
@[expose] def closeOnceSafe (n : ℕ) (T : List (List (List ℕ))) : List (List (List ℕ)) :=
  if isValidTable n T then closeOnce n T else T

/-- Full Schreier–Sims / Furst–Hopcroft–Luks table closure from a list of generators `gens`. -/
@[expose] def closeTable (n : ℕ) (gens : List (List ℕ)) : List (List (List ℕ)) :=
  let valid := gens.filter (isPermList n)
  let T₀ := siftAll n (initTable n) valid
  (closeOnceSafe n)^[n * n] T₀

/-- Compute the order `|⟨S⟩|` of the permutation group generated by the valid permutations in
`gens` on `Fin n`. -/
@[expose] def schreierSimsOrder (n : ℕ) (gens : List (List ℕ)) : ℕ :=
  ((closeTable n gens).map (fun row => row.countP (fun entry => !entry.isEmpty))).prod

/-! ### 4. Refinement: List-Level Table Equals `MathTable` -/

/-- Predicate asserting that `T` is a well-formed `n × n` list table whose entries are either `[]`
or valid `permToList` encodings of permutations on `Fin n`. -/
@[expose] def ValidListTable (n : ℕ) (T : List (List (List ℕ))) : Prop :=
  T.length = n ∧
    (∀ row ∈ T, row.length = n ∧
      ∀ e ∈ row, e = [] ∨ ∃ σ : Equiv.Perm (Fin n), permToList σ = e)

theorem listSet_eq_map {α : Type} (l : List α) (idx : ℕ) (val : α) :
    listSet l idx val = l.zipIdx.map (fun p => if p.2 == idx then val else p.1) := rfl

theorem tableSet_eq_listSet (T : List (List (List ℕ))) (i j : ℕ) (val : List ℕ) :
    tableSet T i j val = listSet T i (listSet (T.getD i []) j val) := rfl

@[simp] theorem siftAll_nil (n : ℕ) (T : List (List (List ℕ))) : siftAll n T [] = T := rfl

theorem isValidTable_eq_true_iff (n : ℕ) (T : List (List (List ℕ))) :
    isValidTable n T = true ↔ ValidListTable n T := by
  simp only [isValidTable, ValidListTable, Bool.and_eq_true, beq_iff_eq, List.all_eq_true,
    Bool.or_eq_true, List.isEmpty_iff, isPermList_eq_true_iff]

theorem closeOnceSafe_eq_of_valid {n : ℕ} {T : List (List (List ℕ))} (h : isValidTable n T = true) :
    closeOnceSafe n T = closeOnce n T := by simp [closeOnceSafe, h]

theorem closeOnce_eq_siftAll (n : ℕ) (T : List (List (List ℕ))) :
    closeOnce n T =
      let entries := (T.flatten).filter (fun e => !e.isEmpty)
      siftAll n T (entries.flatMap (fun g => entries.map (fun h => permMul n g h))) := rfl

/-- Interpret a valid list-level table as a `MathTable n`. -/
noncomputable def decodeTable (n : ℕ) (T : List (List (List ℕ))) : MathTable n :=
  fun i j =>
    let e := (T.getD i.val []).getD j.val []
    if h : ∃ σ : Equiv.Perm (Fin n), permToList σ = e then some h.choose else none

private theorem listSet_length {α : Type} (l : List α) (idx : ℕ) (val : α) :
    (listSet l idx val).length = l.length := by
  simp [listSet]

private theorem listSet_getD {α : Type} (l : List α) (idx j : ℕ) (val d : α)
    (hj : j < l.length) :
    (listSet l idx val).getD j d = if j == idx then val else l.getD j d := by
  have hj' : j < (listSet l idx val).length := by rwa [listSet_length]
  rw [List.getD_eq_getElem _ _ hj', List.getD_eq_getElem _ _ hj]
  simp [listSet]

private theorem mem_listSet {α : Type} {l : List α} {idx : ℕ} {val x : α}
    (hx : x ∈ listSet l idx val) : x = val ∨ x ∈ l := by
  obtain ⟨k, hk, rfl⟩ := List.getElem_of_mem hx
  have hkl : k < l.length := by simpa [listSet] using hk
  simp only [listSet, List.getElem_map, List.getElem_zipIdx]
  split
  · exact Or.inl rfl
  · exact Or.inr (List.getElem_mem hkl)

/-- The initial diagonal sift table `initTable n` is a valid `n × n` list table. -/
theorem initTable_valid (n : ℕ) : ValidListTable n (initTable n) := by
  refine ⟨by simp [initTable], fun row hrow => ?_⟩
  simp only [initTable, List.mem_map, List.mem_range] at hrow
  obtain ⟨i, hi, rfl⟩ := hrow
  refine ⟨by simp, fun e he => ?_⟩
  simp only [List.mem_map, List.mem_range] at he
  obtain ⟨j, hj, rfl⟩ := he
  split
  · exact Or.inr ⟨1, permToList_one n⟩
  · exact Or.inl rfl

private theorem decodeTable_initTable (n : ℕ) :
    decodeTable n (initTable n) = fun i j => if i = j then some 1 else none := by
  funext i j
  have hrow : (initTable n).getD i.val [] =
      (List.range n).map (fun j' => if i.val == j' then permId n else []) := by
    rw [List.getD_eq_getElem (initTable n) [] (by simp [initTable, i.isLt])]
    simp [initTable]
  have hcell : ((initTable n).getD i.val []).getD j.val [] =
      if i = j then permId n else [] := by
    rw [hrow, List.getD_eq_getElem _ [] (by simp [j.isLt])]
    simp only [List.getElem_map, List.getElem_range]
    by_cases hij : i = j
    · subst hij; simp
    · simp [hij, Fin.val_ne_of_ne hij]
  simp only [decodeTable, hcell]
  by_cases hij : i = j
  · subst hij
    have hex : ∃ σ : Equiv.Perm (Fin n), permToList σ = permId n := ⟨1, permToList_one n⟩
    simp only [↓reduceIte, hex, ↓reduceDIte, Option.some.injEq]
    exact permToList_injective (hex.choose_spec.trans (permToList_one n).symm)
  · have hno : ¬ ∃ σ : Equiv.Perm (Fin n), permToList σ = [] := by
      rintro ⟨σ, hσ⟩
      have hlen := congrArg List.length hσ
      simp only [permToList, List.length_map, List.length_range, List.length_nil] at hlen
      have := i.isLt; omega
    simp only [hij, ↓reduceIte, hno, ↓reduceDIte]

private theorem tableSet_valid' {n : ℕ} {T : List (List (List ℕ))} {i j : ℕ}
    {σ : Equiv.Perm (Fin n)} (hT : ValidListTable n T) (hi : i < n) :
    ValidListTable n (tableSet T i j (permToList σ)) := by
  have hTlen := hT.1
  refine ⟨by simp [tableSet, listSet_length, hTlen], fun row hrow => ?_⟩
  rcases mem_listSet hrow with rfl | hrow'
  · have hrow_mem : T.getD i [] ∈ T := by
      rw [List.getD_eq_getElem _ _ (by omega)]
      exact List.getElem_mem _
    have hrow_v := hT.2 _ hrow_mem
    refine ⟨(listSet_length _ _ _).trans hrow_v.1, fun e he => ?_⟩
    rcases mem_listSet he with rfl | he'
    · exact Or.inr ⟨σ, rfl⟩
    · exact hrow_v.2 e he'
  · exact hT.2 row hrow'

private theorem decodeTable_tableSet {n : ℕ} {T : List (List (List ℕ))}
    (hT : ValidListTable n T) (i j : Fin n) (σ : Equiv.Perm (Fin n)) :
    decodeTable n (tableSet T i.val j.val (permToList σ)) =
      fun a b => if a = i ∧ b = j then some σ else decodeTable n T a b := by
  funext a b
  have hTlen := hT.1
  have hcell : ((tableSet T i.val j.val (permToList σ)).getD a.val []).getD b.val [] =
      if a = i ∧ b = j then permToList σ else (T.getD a.val []).getD b.val [] := by
    simp only [tableSet]
    rw [listSet_getD T i.val a.val _ [] (by omega)]
    by_cases hai : a = i
    · subst hai
      have hba : (a.val == a.val) = true := beq_self_eq_true _
      simp only [hba, ↓reduceIte]
      have hrow_mem : T.getD a.val [] ∈ T := by
        rw [List.getD_eq_getElem _ _ (by omega)]
        exact List.getElem_mem _
      have hrow_len : (T.getD a.val []).length = n := (hT.2 _ hrow_mem).1
      rw [listSet_getD (T.getD a.val []) j.val b.val _ [] (by omega)]
      by_cases hbj : b = j
      · subst hbj; simp
      · have hbb : (b.val == j.val) = false := beq_false_of_ne (Fin.val_ne_of_ne hbj)
        simp [hbb, hbj]
    · have hba : (a.val == i.val) = false := beq_false_of_ne (Fin.val_ne_of_ne hai)
      simp [hba, hai]
  simp only [decodeTable, hcell]
  by_cases hab : a = i ∧ b = j
  · have hex : ∃ τ : Equiv.Perm (Fin n), permToList τ = permToList σ := ⟨σ, rfl⟩
    simp only [hab, and_self, ↓reduceIte, hex, ↓reduceDIte, Option.some.injEq]
    exact permToList_injective hex.choose_spec
  · simp only [hab, ↓reduceIte]

/-- Sifting a valid permutation through a valid list table preserves validity and refines
`mathSift`. -/
theorem decodeTable_siftOne {n : ℕ} (T : List (List (List ℕ)))
    (hT : ValidListTable n T) (σ : Equiv.Perm (Fin n)) :
    ValidListTable n (siftOne n T (permToList σ)) ∧
      decodeTable n (siftOne n T (permToList σ)) = mathSift (decodeTable n T) σ := by
  let step := fun (st : List (List (List ℕ)) × List ℕ × Bool) (i : ℕ) =>
    if st.2.2 then st
    else
      let j := st.2.1.getD i n
      let h := (st.1.getD i []).getD j []
      if h.isEmpty then (tableSet st.1 i j st.2.1, st.2.1, true)
      else (st.1, permMul n (permInv n h) st.2.1, false)
  have hfold : ∀ (d : ℕ) (hd : d ≤ n) (T' : List (List (List ℕ))) (τ : Equiv.Perm (Fin n)),
      ValidListTable n T' →
      let res := ((List.range d).map (fun r => n - d + r)).foldl step (T', permToList τ, false)
      ValidListTable n res.1 ∧
        decodeTable n res.1 = mathSiftAux d (decodeTable n T') τ := by
    intro d
    induction d with
    | zero =>
      intro _ T' τ hT'
      exact ⟨hT', rfl⟩
    | succ d ih =>
      intro hd T' τ hT'
      have hT'len := hT'.1
      have hlt : n - (d + 1) < n := by omega
      let i₀ : Fin n := ⟨n - (d + 1), hlt⟩
      have hsplit : (List.range (d + 1)).map (fun r => n - (d + 1) + r) =
          i₀.val :: (List.range d).map (fun r => n - d + r) := by
        rw [List.range_succ_eq_map, List.map_cons, List.map_map]
        congr 1
        refine List.map_congr_left fun r _ => ?_
        dsimp only [Function.comp_def]; omega
      dsimp only
      rw [hsplit, List.foldl_cons]
      have hj_eq : (permToList τ).getD i₀.val n = (τ i₀).val := getD_permToList τ hlt
      have hrow_mem : T'.getD i₀.val [] ∈ T' := by
        rw [List.getD_eq_getElem T' [] (by omega)]
        exact List.getElem_mem _
      have hrow_v := hT'.2 _ hrow_mem
      have hentry_mem : (T'.getD i₀.val []).getD (τ i₀).val [] ∈ T'.getD i₀.val [] := by
        rw [List.getD_eq_getElem (T'.getD i₀.val []) [] (by rw [hrow_v.1]; exact (τ i₀).isLt)]
        exact List.getElem_mem _
      have hentry_v := hrow_v.2 _ hentry_mem
      simp only [step, Bool.false_eq_true, ↓reduceIte, hj_eq]
      rcases hentry_v with he | ⟨ρ, hρ⟩
      · have hnone : decodeTable n T' i₀ (τ i₀) = none := by
          have hno : ¬ ∃ ρ' : Equiv.Perm (Fin n), permToList ρ' = [] := by
            rintro ⟨ρ', hρ'⟩
            have hlen := congrArg List.length hρ'
            simp only [permToList, List.length_map, List.length_range, List.length_nil] at hlen
            omega
          simp only [decodeTable, he, hno, ↓reduceDIte]
        have hdone : ∀ (l : List ℕ) (A : List (List (List ℕ))) (B : List ℕ),
            (l.foldl step (A, B, true)).1 = A := by
          intro l
          induction l with
          | nil => intros; rfl
          | cons _ _ ihl =>
            intro A B
            simp only [List.foldl_cons, step, ↓reduceIte]
            exact ihl A B
        simp only [he, List.isEmpty_nil, ↓reduceIte]
        change ValidListTable n
            ((((List.range d).map (fun r => n - d + r)).foldl step
              (tableSet T' i₀.val (τ i₀).val (permToList τ), permToList τ, true)).1) ∧ _
        rw [hdone]
        simp only [mathSiftAux, hlt, ↓reduceDIte]
        have hnone' : decodeTable n T' ⟨n - (d + 1), hlt⟩ (τ ⟨n - (d + 1), hlt⟩) = none := hnone
        rw [hnone']
        exact ⟨tableSet_valid' hT' hlt, decodeTable_tableSet hT' i₀ (τ i₀) τ⟩
      · have hne : ((T'.getD i₀.val []).getD (τ i₀).val []).isEmpty = false := by
          rw [← hρ]
          have hlen : (permToList ρ).length = n := by simp [permToList]
          cases hlist : permToList ρ with
          | nil => rw [hlist] at hlen; simp at hlen; omega
          | cons _ _ => rfl
        have hsome : decodeTable n T' i₀ (τ i₀) = some ρ := by
          have hex : ∃ ρ' : Equiv.Perm (Fin n), permToList ρ' = permToList ρ := ⟨ρ, rfl⟩
          simp only [decodeTable, ← hρ, hex, ↓reduceDIte, Option.some.injEq]
          exact permToList_injective hex.choose_spec
        simp only [hne, Bool.false_eq_true, ↓reduceIte]
        simp only [← hρ, ← permToList_inv, ← permToList_mul]
        change ValidListTable n
            ((((List.range d).map (fun r => n - d + r)).foldl step
              (T', permToList (ρ⁻¹ * τ), false)).1) ∧ _
        simp only [mathSiftAux, hlt, ↓reduceDIte]
        have hsome' : decodeTable n T' ⟨n - (d + 1), hlt⟩ (τ ⟨n - (d + 1), hlt⟩) = some ρ := hsome
        rw [hsome']
        exact ih (by omega) T' (ρ⁻¹ * τ) hT'
  have h0 := hfold n le_rfl T σ hT
  have hrange : (List.range n).map (fun r => n - n + r) = List.range n := by
    simp
  rw [hrange] at h0
  exact h0

/-- Count of non-empty entries in row `i` of a valid list table equals `rowCard`. -/
private theorem rowCount_eq_rowCard {n : ℕ} {T : List (List (List ℕ))}
    (hT : ValidListTable n T) (i : Fin n) :
    ((T.getD i.val []).countP (fun entry => !entry.isEmpty)) =
      rowCard (decodeTable n T) i := by
  classical
  have hTlen := hT.1
  have hrow_mem : T.getD i.val [] ∈ T := by
    rw [List.getD_eq_getElem T [] (by omega)]
    exact List.getElem_mem _
  have hrow_v := hT.2 _ hrow_mem
  have h1 : (T.getD i.val []).countP (fun entry => !entry.isEmpty) =
      ((List.finRange n).filter (fun j : Fin n =>
        !((T.getD i.val []).getD j.val []).isEmpty)).length := by
    have hmap : T.getD i.val [] = (List.finRange n).map (fun j : Fin n =>
        (T.getD i.val []).getD j.val []) := by
      refine List.ext_getElem (by rw [List.length_map, List.length_finRange, hrow_v.1])
        fun j hj1 hj2 => ?_
      have hjn : j < n := by omega
      simp only [List.getElem_map, List.getElem_finRange]
      rw [List.getD_eq_getElem (T.getD i.val []) [] (by omega)]
      rfl
    conv_lhs => rw [hmap]
    rw [List.countP_map, List.countP_eq_length_filter]
    rfl
  rw [h1, rowCard, ← List.toFinset_card_of_nodup ((List.nodup_finRange n).filter _),
    List.toFinset_filter]
  congr 1
  ext j
  simp only [Finset.mem_filter, List.mem_toFinset, List.mem_finRange, Finset.mem_univ, true_and]
  simp only [Bool.not_eq_true', List.isEmpty_eq_false_iff, decodeTable]
  have hentry_mem : (T.getD i.val []).getD j.val [] ∈ T.getD i.val [] := by
    rw [List.getD_eq_getElem (T.getD i.val []) [] (by rw [hrow_v.1]; exact j.isLt)]
    exact List.getElem_mem _
  rcases hrow_v.2 _ hentry_mem with he | ⟨σ, hσ⟩
  · have hno : ¬ ∃ τ : Equiv.Perm (Fin n), permToList τ = [] := by
      rintro ⟨τ, hτ⟩
      have := congrArg List.length hτ
      simp [permToList] at this; have := j.isLt; omega
    simp only [he, hno, ↓reduceDIte, Option.isSome_none, Bool.false_eq_true, ne_eq,
      not_true_eq_false]
  · have hex : ∃ τ : Equiv.Perm (Fin n), permToList τ = permToList σ := ⟨σ, rfl⟩
    have hne : permToList σ ≠ [] := by
      intro h0
      have := congrArg List.length h0
      simp [permToList] at this; have := j.isLt; omega
    simp only [← hσ, hex, ↓reduceDIte, Option.isSome_some, iff_true]
    exact hne

/-- Exact algebraic correctness of `schreierSimsOrder`: for any list `gens` of lists,
`schreierSimsOrder n gens` equals the cardinality of the subgroup generated by all valid
permutations represented in `gens`. -/
theorem schreierSimsOrder_eq_card (n : ℕ) (gens : List (List ℕ)) :
    schreierSimsOrder n gens =
      Nat.card (Subgroup.closure
        {σ : Equiv.Perm (Fin n) | permToList σ ∈ gens}) := by
  let S : Set (Equiv.Perm (Fin n)) := {σ | permToList σ ∈ gens}
  let G := Subgroup.closure S
  let valid := gens.filter (isPermList n)
  have hvalid : ∀ g ∈ valid, ∃ σ : Equiv.Perm (Fin n), permToList σ = g := by
    intro g hg
    exact (isPermList_eq_true_iff n g).mp (List.mem_filter.mp hg).2
  have hvalid_G : ∀ g ∈ valid, ∀ σ : Equiv.Perm (Fin n), permToList σ = g → σ ∈ G := by
    intro g hg σ hσ
    apply Subgroup.subset_closure
    have := (List.mem_filter.mp hg).1
    rwa [← hσ] at this
  have hinit_inv : TableInv G (decodeTable n (initTable n)) := by
    rw [decodeTable_initTable]
    refine ⟨fun i => by simp, fun i j σ h => ?_, fun i j σ h k _ => ?_, fun i j σ h => ?_⟩
    · split at h <;> cases h; exact G.one_mem
    · split at h <;> cases h; rfl
    · split at h
      · rename_i hij; cases h; simp [hij]
      · cases h
  -- Helper: `siftAll` preserves `TableInv G` and monotonicity of entries.
  have hsiftAll_mono : ∀ (T : List (List (List ℕ))) (gs : List (List ℕ)),
      ValidListTable n T → TableInv G (decodeTable n T) →
      (∀ g ∈ gs, ∃ σ : Equiv.Perm (Fin n), permToList σ = g) →
      (∀ g ∈ gs, ∀ σ, permToList σ = g → σ ∈ G) →
      ValidListTable n (siftAll n T gs) ∧
        TableInv G (decodeTable n (siftAll n T gs)) ∧
        (∀ i j σ, decodeTable n T i j = some σ →
          decodeTable n (siftAll n T gs) i j = some σ) ∧
        (∀ g ∈ gs, ∀ σ, permToList σ = g →
          decodeTable n (siftAll n T gs) = decodeTable n T →
          mathSiftsToOne (decodeTable n T) σ) := by
    intro T gs
    induction gs generalizing T with
    | nil =>
      intro hT hTG _ _
      exact ⟨hT, hTG, fun _ _ _ h => h, fun _ h => nomatch h⟩
    | cons g gs ih =>
      intro hT hTG hgs hgsG
      obtain ⟨σ, rfl⟩ := hgs g List.mem_cons_self
      have hσG : σ ∈ G := hgsG _ List.mem_cons_self σ rfl
      have h1 := decodeTable_siftOne T hT σ
      have hstep := mathSiftAux_inv n le_rfl (decodeTable n T) σ hTG hσG (fun _ h => by omega)
      have hT1 : TableInv G (decodeTable n (siftOne n T (permToList σ))) := h1.2 ▸ hstep.1
      have hrest := ih (siftOne n T (permToList σ)) h1.1 hT1
        (fun g' hg' => hgs g' (List.mem_cons_of_mem _ hg'))
        (fun g' hg' σ' hσ' => hgsG g' (List.mem_cons_of_mem _ hg') σ' hσ')
      refine ⟨hrest.1, hrest.2.1, fun i j τ hτ =>
        hrest.2.2.1 i j τ (h1.2.symm ▸ hstep.2.1 i j τ hτ), fun g' hg' τ hτ hsame => ?_⟩
      -- If `siftAll` didn't change `decodeTable n T`, then `siftOne` didn't change it either!
      have hstep_eq : decodeTable n (siftOne n T (permToList σ)) = decodeTable n T := by
        funext i j
        cases h0 : decodeTable n T i j with
        | some ρ => exact h1.2.symm ▸ hstep.2.1 i j ρ h0
        | none =>
          cases h1' : decodeTable n (siftOne n T (permToList σ)) i j with
          | none => rfl
          | some ρ =>
            have hρ' : decodeTable n (siftAll n T (permToList σ :: gs)) i j = some ρ :=
              hrest.2.2.1 i j ρ h1'
            rw [hsame, h0] at hρ'
            cases hρ'
      rcases List.mem_cons.mp hg' with rfl | hg'
      · have hστ : τ = σ := permToList_injective hτ
        subst hστ
        exact hstep.2.2.mp (h1.2.symm.trans hstep_eq)
      · rw [← hstep_eq]
        exact hrest.2.2.2 g' hg' τ hτ (hsame.trans hstep_eq.symm)
  -- Properties of `T₀`
  have hT₀ := hsiftAll_mono (initTable n) valid (initTable_valid n) hinit_inv hvalid hvalid_G
  -- Properties of `closeOnce`
  have hcloseOnce : ∀ (T : List (List (List ℕ))),
      ValidListTable n T → TableInv G (decodeTable n T) →
      ValidListTable n (closeOnce n T) ∧
        TableInv G (decodeTable n (closeOnce n T)) ∧
        (∀ i j σ, decodeTable n T i j = some σ →
          decodeTable n (closeOnce n T) i j = some σ) ∧
        (decodeTable n (closeOnce n T) = decodeTable n T →
          ∀ i₁ j₁ σ₁ i₂ j₂ σ₂,
            decodeTable n T i₁ j₁ = some σ₁ → decodeTable n T i₂ j₂ = some σ₂ →
            mathSiftsToOne (decodeTable n T) (σ₁ * σ₂)) := by
    intro T hT hTG
    let entries := (T.flatten).filter (fun e => !e.isEmpty)
    let prods := entries.flatMap (fun g => entries.map (fun h => permMul n g h))
    have hentries : ∀ e ∈ entries, ∃ σ : Equiv.Perm (Fin n), permToList σ = e := by
      intro e he
      obtain ⟨hflat, hne⟩ := List.mem_filter.mp he
      obtain ⟨row, hrow, herow⟩ := List.mem_flatten.mp hflat
      rcases (hT.2 row hrow).2 e herow with rfl | h
      · simp at hne
      · exact h
    have hentries_G : ∀ e ∈ entries, ∀ σ, permToList σ = e → σ ∈ G := by
      intro e he σ hσ
      obtain ⟨hflat, _⟩ := List.mem_filter.mp he
      obtain ⟨row, hrow, herow⟩ := List.mem_flatten.mp hflat
      obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hrow
      obtain ⟨j, hj, rfl⟩ := List.getElem_of_mem herow
      have hTlen := hT.1
      have hjn : j < n := by rw [← (hT.2 _ (List.getElem_mem _)).1]; exact hj
      have hin : i < n := by omega
      have hdec : decodeTable n T ⟨i, hin⟩ ⟨j, hjn⟩ = some σ := by
        simp only [decodeTable]
        rw [List.getD_eq_getElem _ _ hi, List.getD_eq_getElem _ _ hj]
        have hex : ∃ τ : Equiv.Perm (Fin n), permToList τ = T[i][j] := ⟨σ, hσ⟩
        simp only [hex, ↓reduceDIte, Option.some.injEq]
        exact permToList_injective (hex.choose_spec.trans hσ.symm)
      exact hTG.mem_group ⟨i, hin⟩ ⟨j, hjn⟩ σ hdec
    have hprods : ∀ p ∈ prods, ∃ σ : Equiv.Perm (Fin n), permToList σ = p := by
      intro p hp
      obtain ⟨g, hg, hp'⟩ := List.mem_flatMap.mp hp
      obtain ⟨h, hh, rfl⟩ := List.mem_map.mp hp'
      obtain ⟨σ₁, rfl⟩ := hentries g hg
      obtain ⟨σ₂, rfl⟩ := hentries h hh
      exact ⟨σ₁ * σ₂, permToList_mul σ₁ σ₂⟩
    have hprods_G : ∀ p ∈ prods, ∀ σ, permToList σ = p → σ ∈ G := by
      intro p hp σ hσ
      obtain ⟨g, hg, hp'⟩ := List.mem_flatMap.mp hp
      obtain ⟨h, hh, hmul⟩ := List.mem_map.mp hp'
      obtain ⟨σ₁, rfl⟩ := hentries g hg
      obtain ⟨σ₂, rfl⟩ := hentries h hh
      have h1 : σ₁ ∈ G := hentries_G _ hg σ₁ rfl
      have h2 : σ₂ ∈ G := hentries_G _ hh σ₂ rfl
      have heq : σ = σ₁ * σ₂ :=
        permToList_injective (hσ.trans (hmul.symm.trans (permToList_mul σ₁ σ₂).symm))
      exact heq ▸ G.mul_mem h1 h2
    have hres := hsiftAll_mono T prods hT hTG hprods hprods_G
    refine ⟨hres.1, hres.2.1, hres.2.2.1, fun hsame i₁ j₁ σ₁ i₂ j₂ σ₂ h1 h2 => ?_⟩
    have hmem_e : ∀ i j σ, decodeTable n T i j = some σ → permToList σ ∈ entries := by
      intro i j σ hdec
      have hTlen := hT.1
      have hrow_mem : T.getD i.val [] ∈ T := by
        rw [List.getD_eq_getElem T [] (by omega)]
        exact List.getElem_mem _
      have hrow_v := hT.2 _ hrow_mem
      have hentry_mem : (T.getD i.val []).getD j.val [] ∈ T.getD i.val [] := by
        rw [List.getD_eq_getElem (T.getD i.val []) [] (by rw [hrow_v.1]; exact j.isLt)]
        exact List.getElem_mem _
      rcases hrow_v.2 _ hentry_mem with he | ⟨τ, hτ⟩
      · exfalso
        have hno : ¬ ∃ τ : Equiv.Perm (Fin n), permToList τ = [] := by
          rintro ⟨τ, hτ⟩; have := congrArg List.length hτ
          simp [permToList] at this; have := i.isLt; omega
        simp only [decodeTable, he, hno, ↓reduceDIte] at hdec
        cases hdec
      · have hστ : σ = τ := by
          have hex : ∃ τ' : Equiv.Perm (Fin n), permToList τ' = permToList τ := ⟨τ, rfl⟩
          simp only [decodeTable, ← hτ, hex, ↓reduceDIte, Option.some.injEq] at hdec
          exact hdec.symm.trans (permToList_injective hex.choose_spec)
        subst hστ
        refine List.mem_filter.mpr ⟨List.mem_flatten.mpr ⟨_, hrow_mem, hτ ▸ hentry_mem⟩, ?_⟩
        have hne : (permToList σ).length = n := by simp [permToList]
        cases hlist : permToList σ with
        | nil => rw [hlist] at hne; simp at hne; have := i.isLt; omega
        | cons _ _ => rfl
    have hp_mem : permToList (σ₁ * σ₂) ∈ prods := by
      rw [permToList_mul]
      exact List.mem_flatMap.mpr ⟨permToList σ₁, hmem_e i₁ j₁ σ₁ h1,
        List.mem_map.mpr ⟨permToList σ₂, hmem_e i₂ j₂ σ₂ h2, rfl⟩⟩
    exact hres.2.2.2 _ hp_mem (σ₁ * σ₂) rfl hsame
  -- Iterating `closeOnce` preserves `ValidListTable`, `TableInv G`, and monotonicity.
  have hiter : ∀ k : ℕ,
      let Tk := (closeOnce n)^[k] (siftAll n (initTable n) valid)
      ValidListTable n Tk ∧ TableInv G (decodeTable n Tk) ∧
        (∀ i j σ, decodeTable n (siftAll n (initTable n) valid) i j = some σ →
          decodeTable n Tk i j = some σ) ∧
        (∀ a b, a ≤ b → b ≤ k → ∀ i j σ,
          decodeTable n ((closeOnce n)^[a] (siftAll n (initTable n) valid)) i j = some σ →
          decodeTable n ((closeOnce n)^[b] (siftAll n (initTable n) valid)) i j = some σ) := by
    intro k
    induction k with
    | zero =>
      refine ⟨hT₀.1, hT₀.2.1, fun _ _ _ h => h, fun a b hab hbk i j σ h => ?_⟩
      have ha0 : a = 0 := by omega
      have hb0 : b = 0 := by omega
      subst ha0 hb0; exact h
    | succ k ih =>
      have hc := hcloseOnce _ ih.1 ih.2.1
      refine ⟨?_, ?_, ?_, ?_⟩
      · simpa only [Function.iterate_succ_apply'] using hc.1
      · simpa only [Function.iterate_succ_apply'] using hc.2.1
      · intro i j σ h
        simpa only [Function.iterate_succ_apply'] using hc.2.2.1 i j σ (ih.2.2.1 i j σ h)
      · intro a b hab hbk i j σ h
        by_cases hbk' : b ≤ k
        · exact ih.2.2.2 a b hab hbk' i j σ h
        · have hbe : b = k + 1 := by omega
          subst hbe
          rw [Function.iterate_succ_apply']
          by_cases hak : a ≤ k
          · exact hc.2.2.1 i j σ (ih.2.2.2 a k hak le_rfl i j σ h)
          · have hae : a = k + 1 := by omega
            subst hae; simpa only [Function.iterate_succ_apply'] using h
  -- Pigeonhole on `tableCard`: in `n * n` steps, some step leaves `decodeTable` unchanged.
  let Tseq (k : ℕ) := (closeOnce n)^[k] (siftAll n (initTable n) valid)
  have hstabilizes : decodeTable n (Tseq (n * n + 1)) = decodeTable n (Tseq (n * n)) := by
    suffices ∃ k ≤ n * n, decodeTable n (Tseq (k + 1)) = decodeTable n (Tseq k) by
      obtain ⟨k, hk, hfix⟩ := this
      -- Once `closeOnce` fixes `decodeTable`, `Tseq (k + 1)` is closed, so all future `closeOnce`
      -- fix `decodeTable`!
      have hstay : ∀ m, decodeTable n (Tseq (k + m)) = decodeTable n (Tseq k) := by
        intro m
        induction m with
        | zero => rfl
        | succ m ihm =>
          -- Need: `decodeTable n (closeOnce n T) = decodeTable n T` when `T` is already closed!
          -- We prove: if `decodeTable n (closeOnce n T') = decodeTable n T'` and `decodeTable n T =
          -- decodeTable n T'`,
          -- wait: `closeOnce n T` only depends on `decodeTable n T`? Yes, every product sifts to 1!
          have hTkm_v := (hiter (k + m)).1
          have hTkm_inv := (hiter (k + m)).2.1
          have hclosed_k : ∀ i₁ j₁ σ₁ i₂ j₂ σ₂,
              decodeTable n (Tseq k) i₁ j₁ = some σ₁ →
              decodeTable n (Tseq k) i₂ j₂ = some σ₂ →
              mathSiftsToOne (decodeTable n (Tseq k)) (σ₁ * σ₂) :=
            (hcloseOnce _ (hiter k).1 (hiter k).2.1).2.2.2 (by
              simpa [Tseq, Function.iterate_succ_apply'] using hfix)
          -- Every `siftOne` on a permutation that sifts to 1 leaves `decodeTable` unchanged!
          have hstep_m := hcloseOnce _ hTkm_v hTkm_inv
          have hsame_m : decodeTable n (closeOnce n (Tseq (k + m))) =
            decodeTable n (Tseq (k + m)) := by
            -- `Tseq (k + m)` has the same `decodeTable` as `Tseq k`, so every product of entries of
            -- `Tseq (k + m)` sifts to 1 in `Tseq (k + m)`!
            -- Wait: let's prove `siftAll` leaves `decodeTable` unchanged when every element sifts
            -- to 1!
            have hsift_noop : ∀ (A : List (List (List ℕ))) (gs : List (List ℕ)),
                ValidListTable n A → TableInv G (decodeTable n A) →
                (∀ g ∈ gs, ∃ σ, permToList σ = g ∧ mathSiftsToOne (decodeTable n A) σ) →
                decodeTable n (siftAll n A gs) = decodeTable n A := by
              intro A gs
              induction gs generalizing A with
              | nil => intros; rfl
              | cons g gs ihg =>
                intro hA hAG hgs
                obtain ⟨σ, rfl, hσ1⟩ := hgs g List.mem_cons_self
                have h1 := decodeTable_siftOne A hA σ
                have hσG : σ ∈ G := by
                  have hmem := (mathSiftsToOneAux_iff_mem_rowProdSet hAG n le_rfl σ
                    (fun _ h => by omega)).mp hσ1
                  -- `rowProdSet ⊆ G`
                  have haux : ∀ (r : ℕ) (hr : r ≤ n) (x : Equiv.Perm (Fin n)),
                      x ∈ rowProdSet (decodeTable n A) r → x ∈ G := by
                    intro r
                    induction r with
                    | zero =>
                      intro _ x hx
                      simp only [rowProdSet, Set.mem_singleton_iff] at hx
                      exact hx ▸ G.one_mem
                    | succ r ihr =>
                      intro hr x hx
                      have hltr : n - (r + 1) < n := by omega
                      simp only [rowProdSet, hltr, ↓reduceDIte, Set.mem_ofPred_eq] at hx
                      obtain ⟨j, τ, y, hτ, hy, rfl⟩ := hx
                      exact G.mul_mem (hAG.mem_group _ j τ hτ) (ihr (by omega) y hy)
                  exact haux n le_rfl σ hmem
                have hno := (mathSiftAux_inv n le_rfl (decodeTable n A) σ hAG hσG
                  (fun _ h => by omega)).2.2.mpr hσ1
                have heq1 : decodeTable n (siftOne n A (permToList σ)) = decodeTable n A :=
                  h1.2.trans hno
                have hrest := ihg (siftOne n A (permToList σ)) h1.1 (heq1 ▸ hAG)
                  (fun g' hg' => by
                    obtain ⟨τ, rfl, hτ1⟩ := hgs g' (List.mem_cons_of_mem _ hg')
                    exact ⟨τ, rfl, heq1.symm ▸ hτ1⟩)
                exact hrest.trans heq1
            apply hsift_noop _ _ hTkm_v hTkm_inv
            intro p hp
            obtain ⟨g, hg, hp'⟩ := List.mem_flatMap.mp hp
            obtain ⟨h, hh, rfl⟩ := List.mem_map.mp hp'
            have get_entry : ∀ e ∈ (Tseq (k + m)).flatten.filter (fun e => !e.isEmpty),
                ∃ i j σ, permToList σ = e ∧ decodeTable n (Tseq (k + m)) i j = some σ := by
              intro e he
              obtain ⟨hflat, hne⟩ := List.mem_filter.mp he
              obtain ⟨row, hrow, herow⟩ := List.mem_flatten.mp hflat
              obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hrow
              obtain ⟨j, hj, rfl⟩ := List.getElem_of_mem herow
              have hin : i < n := by rw [← hTkm_v.1]; exact hi
              have hjn : j < n := by rw [← (hTkm_v.2 _ (List.getElem_mem _)).1]; exact hj
              rcases (hTkm_v.2 _ (List.getElem_mem _)).2 _ (List.getElem_mem _) with h0 | ⟨σ, hσ⟩
              · exfalso
                have h0' : (Tseq (k + m))[i][j] = [] := h0
                simp [h0'] at hne
              · refine ⟨⟨i, hin⟩, ⟨j, hjn⟩, σ, hσ, ?_⟩
                simp only [decodeTable]
                rw [List.getD_eq_getElem _ _ hi, List.getD_eq_getElem _ _ hj]
                have hex : ∃ τ : Equiv.Perm (Fin n), permToList τ = (Tseq (k + m))[i][j] := ⟨σ, hσ⟩
                simp only [hex, ↓reduceDIte, Option.some.injEq]
                exact permToList_injective (hex.choose_spec.trans hσ.symm)
            obtain ⟨i₁, j₁, σ₁, rfl, h1⟩ := get_entry g hg
            obtain ⟨i₂, j₂, σ₂, rfl, h2⟩ := get_entry h hh
            refine ⟨σ₁ * σ₂, permToList_mul σ₁ σ₂, ?_⟩
            rw [ihm] at h1 h2 ⊢
            exact hclosed_k i₁ j₁ σ₁ i₂ j₂ σ₂ h1 h2
          rw [show k + (m + 1) = (k + m) + 1 by omega, show Tseq (k + m + 1) =
            closeOnce n (Tseq (k + m)) from Function.iterate_succ_apply' _ _ _]
          exact hsame_m.trans ihm
      have h1 := hstay (n * n - k)
      have h2 := hstay (n * n - k + 1)
      rw [show k + (n * n - k) = n * n by omega] at h1
      rw [show k + (n * n - k + 1) = n * n + 1 by omega] at h2
      exact h2.trans h1.symm
    -- Now prove `∃ k ≤ n * n, decodeTable n (Tseq (k + 1)) = decodeTable n (Tseq k)` by
    -- contradiction.
    by_contra hno
    push Not at hno
    have hstrict : ∀ k ≤ n * n, tableCard (decodeTable n (Tseq k)) <
        tableCard (decodeTable n (Tseq (k + 1))) := by
      intro k hk
      have hmono := (hiter (k + 1)).2.2.2 k (k + 1) (Nat.le_succ k) le_rfl
      have hne := hno k hk
      -- Find a cell `(i₀, j₀)` where `Tseq k` is `none` and `Tseq (k + 1)` is `some`.
      have hex : ∃ i j, decodeTable n (Tseq k) i j = none ∧
          (decodeTable n (Tseq (k + 1)) i j).isSome := by
        by_contra hall
        push Not at hall
        apply hne
        funext i j
        cases h0 : decodeTable n (Tseq k) i j with
        | some σ => exact hmono i j σ h0
        | none =>
          have := hall i j h0
          simpa using this
      obtain ⟨i₀, j₀, h0, h1⟩ := hex
      have hrow_le : ∀ i : Fin n, rowCard (decodeTable n (Tseq k)) i ≤
          rowCard (decodeTable n (Tseq (k + 1))) i := fun i => by
        classical
        refine Finset.card_le_card fun j hj => ?_
        obtain ⟨σ, hσ⟩ := Option.isSome_iff_exists.mp (Finset.mem_filter.mp hj).2
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ j, by rw [hmono i j σ hσ]; rfl⟩
      have hrow_lt : rowCard (decodeTable n (Tseq k)) i₀ <
          rowCard (decodeTable n (Tseq (k + 1))) i₀ := by
        classical
        refine Finset.card_lt_card
          (Finset.ssubset_iff_subset_ne.mpr ⟨fun j hj => ?_, fun heq => ?_⟩)
        · obtain ⟨σ, hσ⟩ := Option.isSome_iff_exists.mp (Finset.mem_filter.mp hj).2
          exact Finset.mem_filter.mpr ⟨Finset.mem_univ j, by rw [hmono i₀ j σ hσ]; rfl⟩
        · have hmem : j₀ ∈ Finset.univ.filter
              (fun j => (decodeTable n (Tseq (k + 1)) i₀ j).isSome) :=
            Finset.mem_filter.mpr ⟨Finset.mem_univ j₀, h1⟩
          rw [← heq] at hmem; simp [h0] at hmem
      exact Finset.sum_lt_sum (fun i _ => hrow_le i) ⟨i₀, Finset.mem_univ i₀, hrow_lt⟩
    have hgrow : ∀ k ≤ n * n + 1, k ≤ tableCard (decodeTable n (Tseq k)) := by
      intro k hk; induction k with
      | zero => exact Nat.zero_le _
      | succ k ihk => have := hstrict k (by omega); have := ihk (by omega); omega
    have h1 := hgrow (n * n + 1) le_rfl
    have h2 := tableCard_le (decodeTable n (Tseq (n * n + 1)))
    omega
  have hcloseSafe_eq : ∀ (k : ℕ),
      (closeOnceSafe n)^[k] (siftAll n (initTable n) valid) =
        (closeOnce n)^[k] (siftAll n (initTable n) valid) := by
    intro k; induction k with
    | zero => rfl
    | succ k ihk =>
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ihk]
      exact closeOnceSafe_eq_of_valid ((isValidTable_eq_true_iff n _).mpr (hiter k).1)
  -- Now apply `closed_table_eq_closure` to `T_final := Tseq (n * n)`!
  let T_final := closeTable n gens
  have hT_final_eq : T_final = Tseq (n * n) := hcloseSafe_eq (n * n)
  have hTf_v : ValidListTable n T_final := hT_final_eq ▸ (hiter (n * n)).1
  have hTf_inv : TableInv G (decodeTable n T_final) := hT_final_eq ▸ (hiter (n * n)).2.1
  have hTf_closed : ∀ i₁ j₁ σ₁ i₂ j₂ σ₂,
      decodeTable n T_final i₁ j₁ = some σ₁ →
      decodeTable n T_final i₂ j₂ = some σ₂ →
      mathSiftsToOne (decodeTable n T_final) (σ₁ * σ₂) :=
    (hcloseOnce _ hTf_v hTf_inv).2.2.2 (by
      rw [hT_final_eq]
      simpa [Tseq, Function.iterate_succ_apply'] using hstabilizes)
  have hTf_S : ∀ s ∈ S, mathSiftsToOne (decodeTable n T_final) s := by
    intro s hs
    have hsmem : permToList s ∈ valid :=
      List.mem_filter.mpr ⟨hs, (isPermList_eq_true_iff n _).mpr ⟨s, rfl⟩⟩
    have hsub_row : ∀ (A B : MathTable n), TableInv G A → TableInv G B →
        (∀ i j σ, A i j = some σ → B i j = some σ) → ∀ k, rowProdSet A k ⊆ rowProdSet B k := by
      intro A B _ _ hAB k; induction k with
      | zero => exact Set.Subset.rfl
      | succ k ihk =>
        intro x hx; by_cases hlt : n - (k + 1) < n
        · simp only [rowProdSet, hlt, ↓reduceDIte, Set.mem_ofPred_eq] at hx ⊢
          obtain ⟨j, σ, y, hσ, hy, rfl⟩ := hx; exact ⟨j, σ, y, hAB _ j σ hσ, ihk hy, rfl⟩
        · simpa [rowProdSet, hlt] using hx
    have hs_after_sift : ∀ (A : MathTable n) (τ : Equiv.Perm (Fin n)),
        TableInv G A → τ ∈ G → mathSiftsToOne (mathSift A τ) τ := by
      intro A τ hA hτG
      have haux : ∀ (k : ℕ) (_hk : k ≤ n) (x : Equiv.Perm (Fin n)),
          x ∈ G → (∀ m : Fin n, m.val < n - k → x m = m) →
          mathSiftsToOneAux k (mathSiftAux k A x) x := by
        intro k; induction k with
        | zero => intro _ x _ hx; ext m; exact congrArg Fin.val (hx m (by omega))
        | succ k ihk =>
          intro hk x hxG hxfix
          have hlt : n - (k + 1) < n := by omega
          let i : Fin n := ⟨n - (k + 1), hlt⟩
          simp only [mathSiftAux, mathSiftsToOneAux, hlt, ↓reduceDIte]
          cases hAi : A i (x i) with
          | none =>
            simp only [and_self, ↓reduceIte, inv_mul_cancel]
            have h1aux : ∀ (r : ℕ) (_hr : r ≤ n),
                mathSiftsToOneAux r (fun a b => if a = i ∧ b = x i then some x else A a b) 1 := by
              intro r; induction r with
              | zero => intro _; rfl
              | succ r ihr =>
                intro hr; have hltr : n - (r + 1) < n := by omega
                have hdiag : (if (⟨n - (r + 1), hltr⟩ : Fin n) = i ∧
                      (1 : Equiv.Perm (Fin n)) ⟨n - (r + 1), hltr⟩ = x i then some x
                    else A ⟨n - (r + 1), hltr⟩ ((1 : Equiv.Perm (Fin n)) ⟨n - (r + 1), hltr⟩)) =
                    some 1 := by
                  simp only [Equiv.Perm.one_apply]
                  by_cases heq : (⟨n - (r + 1), hltr⟩ : Fin n) = i ∧
                      (⟨n - (r + 1), hltr⟩ : Fin n) = x i
                  · exfalso; rw [← heq.1.symm.trans heq.2, hA.diag] at hAi; cases hAi
                  · simp only [heq, ↓reduceIte, hA.diag]
                simp only [mathSiftsToOneAux, hltr, ↓reduceDIte]
                rw [hdiag]; simp only [inv_one, one_mul]; exact ihr (by omega)
            exact h1aux k (by omega)
          | some ρ =>
            have hfix' : ∀ m : Fin n, m.val < n - k → (ρ⁻¹ * x) m = m := by
              intro m hm; by_cases hmi : m.val < n - (k + 1)
              · apply ρ.injective
                simp [Equiv.Perm.mul_apply, hxfix m hmi, hA.fixes_lt i (x i) ρ hAi m hmi]
              · have hmeq : m = i := Fin.ext (by dsimp [i]; omega)
                rw [hmeq]; apply ρ.injective
                simp [Equiv.Perm.mul_apply, hA.maps_to i (x i) ρ hAi]
            have hkeep : mathSiftAux k A (ρ⁻¹ * x) i (x i) = some ρ :=
              (mathSiftAux_inv k (by omega) A (ρ⁻¹ * x) hA
                (G.mul_mem (G.inv_mem (hA.mem_group i (x i) ρ hAi)) hxG) hfix').2.1 i (x i) ρ hAi
            dsimp only; rw [hkeep]
            exact ihk (by omega) (ρ⁻¹ * x)
              (G.mul_mem (G.inv_mem (hA.mem_group i (x i) ρ hAi)) hxG) hfix'
      exact haux n le_rfl τ hτG (fun _ h => by omega)
    have hs_T₀ : mathSiftsToOne (decodeTable n (siftAll n (initTable n) valid)) s := by
      have hwalk : ∀ (T : List (List (List ℕ))) (gs : List (List ℕ)),
          ValidListTable n T → TableInv G (decodeTable n T) →
          (∀ g ∈ gs, ∃ σ : Equiv.Perm (Fin n), permToList σ = g) →
          (∀ g ∈ gs, ∀ σ, permToList σ = g → σ ∈ G) → permToList s ∈ gs →
          mathSiftsToOne (decodeTable n (siftAll n T gs)) s := by
        intro T gs; induction gs generalizing T with
        | nil => intro _ _ _ _ h; cases h
        | cons g gs ihg =>
          intro hT hTG hgs hgsG hs_in
          obtain ⟨σ, rfl⟩ := hgs g List.mem_cons_self
          have hσG : σ ∈ G := hgsG _ List.mem_cons_self σ rfl
          have h1 := decodeTable_siftOne T hT σ
          have hstep := mathSiftAux_inv n le_rfl (decodeTable n T) σ hTG hσG (fun _ h => by omega)
          have hT1 : TableInv G (decodeTable n (siftOne n T (permToList σ))) := h1.2 ▸ hstep.1
          have hrest := hsiftAll_mono (siftOne n T (permToList σ)) gs h1.1 hT1
            (fun g' hg' => hgs g' (List.mem_cons_of_mem _ hg'))
            (fun g' hg' σ' hσ' => hgsG g' (List.mem_cons_of_mem _ hg') σ' hσ')
          rcases List.mem_cons.mp hs_in with heq | hs_tail
          · have hσs : s = σ := permToList_injective heq; subst hσs
            have hs1 : mathSiftsToOne (decodeTable n (siftOne n T (permToList s))) s :=
              h1.2.symm ▸ hs_after_sift (decodeTable n T) s hTG hσG
            have hs_mem := (mathSiftsToOneAux_iff_mem_rowProdSet hT1 n le_rfl s
              (fun _ h => by omega)).mp hs1
            exact (mathSiftsToOneAux_iff_mem_rowProdSet hrest.2.1 n le_rfl s
              (fun _ h => by omega)).mpr (hsub_row _ _ hT1 hrest.2.1 hrest.2.2.1 n hs_mem)
          · exact ihg _ h1.1 hT1 (fun g' hg' => hgs g' (List.mem_cons_of_mem _ hg'))
              (fun g' hg' σ' hσ' => hgsG g' (List.mem_cons_of_mem _ hg') σ' hσ') hs_tail
      exact hwalk (initTable n) valid (initTable_valid n) hinit_inv hvalid hvalid_G hsmem
    have hs_mem₀ := (mathSiftsToOneAux_iff_mem_rowProdSet hT₀.2.1 n le_rfl s
      (fun _ h => by omega)).mp hs_T₀
    exact (mathSiftsToOneAux_iff_mem_rowProdSet hTf_inv n le_rfl s (fun _ h => by omega)).mpr
      (hsub_row _ _ hT₀.2.1 hTf_inv (hT_final_eq ▸ (hiter (n * n)).2.2.1) n hs_mem₀)
  rw [(closed_table_eq_closure S (decodeTable n T_final) hTf_inv hTf_S hTf_closed).2]
  have hmap : T_final.map (fun row => row.countP (fun entry => !entry.isEmpty)) =
      (List.finRange n).map (fun i : Fin n => rowCard (decodeTable n T_final) i) := by
    refine List.ext_getElem (by simp [hTf_v.1]) fun i hi1 hi2 => ?_
    have hin : i < n := by rw [List.length_map, hTf_v.1] at hi1; exact hi1
    have hi' : i < T_final.length := by rw [hTf_v.1]; exact hin
    simp only [List.getElem_map, List.getElem_finRange]
    change T_final[i].countP (fun entry => !entry.isEmpty) =
      rowCard (decodeTable n T_final) ⟨i, hin⟩
    rw [← rowCount_eq_rowCard hTf_v ⟨i, hin⟩, List.getD_eq_getElem T_final [] hi']
  have hprod_finRange : ∀ {m : ℕ} (f : Fin m → ℕ),
      ((List.finRange m).map f).prod = ∏ i : Fin m, f i := by
    intro m; induction m with
    | zero => intro _; simp
    | succ m ihm =>
      intro f
      rw [List.finRange_succ, List.map_cons, List.prod_cons, List.map_map, Fin.prod_univ_succ]
      exact congrArg (f 0 * ·) (ihm (fun i => f i.succ))
  rw [schreierSimsOrder, hmap, hprod_finRange]

end CslibFrontier.Algorithms.Perm.SchreierSims
