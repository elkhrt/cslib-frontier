/-!
# Generalized Permanents and Non-Membership in Matrix Trace Subalgebras

Formalizes left-right symmetries of the matrix permanent, generalized permanents in `k` generic
`n × n` variable matrices `X_1, ..., X_k`, the `K`-subalgebra generated by traces of matrix powers
`trace ((B_i * X_i * C_i) ^ j)`, and the unconditional algebraic separation showing that over any
field `K` with `2 ≠ 0`, `k ≥ 1`, and `n ≥ 2`, no generalized permanent lies in any matrix trace
subalgebra (for arbitrary, possibly singular, matrices `B_i, C_i`), together with the conditional
`VP`/`VNP` implication for `VNP`-complete families.

## Main definitions

* `CslibFrontier.Computability.Circuit.Arithmetic.blockVarMatrix`: the `i`-th generic `n × n`
  variable matrix `X_i`.
* `CslibFrontier.Computability.Circuit.Arithmetic.matrixLRSubst`, `tupleMatrixLRSubst`: left-right
  matrix substitution algebra endomorphisms.
* `CslibFrontier.Computability.Circuit.Arithmetic.IsPermSymmetry`, `IsGeneralizedPermanent`:
  left-right permanent symmetries and generalized permanents.
* `CslibFrontier.Computability.Circuit.Arithmetic.tracePowerPoly`, `traceSubalgebra`: trace
  generators `trace ((B_i * X_i * C_i) ^ j)` and the `K`-subalgebra they generate.

## Main results

* `sum_permanent_isGeneralizedPermanent`: `∑ i, perm(X_i)` is a generalized permanent for all
  `n ≥ 1`, `k ≥ 1`.
* `not_mem_traceSubalgebra_of_isGeneralizedPermanent`: over any field `K` with `2 ≠ 0`, `k ≥ 1`,
  and `n ≥ 2`, no generalized permanent lies in `traceSubalgebra B C`.
* `not_eq_aeval_tracePowerPoly_of_isGeneralizedPermanent`: explicit multivariate polynomial form.
* `not_vp_trace_expr_of_isVNPComplete`: assuming `¬ VNP K ⊆ VP K`, no `VNP`-complete family is
  `VP`-computable from matrix traces.
-/

public section

namespace CslibFrontier.Computability.Circuit.Arithmetic

open MvPolynomial Matrix
open Cslib.Circuits Cslib.Circuits.Arithmetic

section Defs

/-- The `i`-th `n × n` generic variable matrix `X_i` in the polynomial ring over
`Fin k × Fin n × Fin n`. -/
noncomputable def blockVarMatrix (K : Type*) [CommSemiring K] (k n : ℕ) (i : Fin k) :
    Matrix (Fin n) (Fin n) (MvPolynomial (Fin k × Fin n × Fin n) K) :=
  Matrix.of fun r c => MvPolynomial.X (i, r, c)

variable {K : Type*} [CommRing K]

/-- Left-right matrix substitution `p(X) ↦ p(U * X * V)` on polynomials in one `n × n` matrix. -/
noncomputable def matrixLRSubst {n : ℕ} (U V : Matrix (Fin n) (Fin n) K) :
    MvPolynomial (Fin n × Fin n) K →ₐ[K] MvPolynomial (Fin n × Fin n) K :=
  MvPolynomial.aeval fun rc =>
    ((U.map MvPolynomial.C * Matrix.mvPolynomialX (Fin n) (Fin n) K * V.map MvPolynomial.C :
      Matrix (Fin n) (Fin n) (MvPolynomial (Fin n × Fin n) K)) rc.1 rc.2)

/-- Action of `matrixLRSubst U V` on a coordinate variable `X (i, j)`. -/
theorem matrixLRSubst_X {n : ℕ} (U V : Matrix (Fin n) (Fin n) K) (rc : Fin n × Fin n) :
    matrixLRSubst U V (MvPolynomial.X rc) =
      ((U.map MvPolynomial.C * Matrix.mvPolynomialX (Fin n) (Fin n) K * V.map MvPolynomial.C :
        Matrix (Fin n) (Fin n) (MvPolynomial (Fin n × Fin n) K)) rc.1 rc.2) := by
  simp [matrixLRSubst]

/-- Left-right matrix substitution `(X_1, ..., X_k) ↦ (U_1 * X_1 * V_1, ..., U_k * X_k * V_k)`
on polynomials in `k` variable `n × n` matrices. -/
noncomputable def tupleMatrixLRSubst {k n : ℕ}
    (U V : Fin k → Matrix (Fin n) (Fin n) K) :
    MvPolynomial (Fin k × Fin n × Fin n) K →ₐ[K] MvPolynomial (Fin k × Fin n × Fin n) K :=
  MvPolynomial.aeval fun irc =>
    (((U irc.1).map MvPolynomial.C * blockVarMatrix K k n irc.1 * (V irc.1).map MvPolynomial.C :
      Matrix (Fin n) (Fin n) (MvPolynomial (Fin k × Fin n × Fin n) K)) irc.2.1 irc.2.2)

/-- A pair `(U, V)` of invertible `n × n` matrices is a left-right symmetry of `perm(X)` if
`perm(U * X * V) = perm(X)` as polynomials in `X`. -/
def IsPermSymmetry {n : ℕ} (U V : GL (Fin n) K) : Prop :=
  matrixLRSubst (U : Matrix (Fin n) (Fin n) K) (V : Matrix (Fin n) (Fin n) K)
    (Matrix.mvPolynomialX (Fin n) (Fin n) K).permanent =
      (Matrix.mvPolynomialX (Fin n) (Fin n) K).permanent

/-- A polynomial `p(X_1, ..., X_k)` is a
*generalized permanent* if it has exactly the same left-right invertible-matrix symmetries as
the permanent on each matrix block. -/
def IsGeneralizedPermanent {k n : ℕ} (p : MvPolynomial (Fin k × Fin n × Fin n) K) : Prop :=
  ∀ U V : Fin k → GL (Fin n) K,
    tupleMatrixLRSubst (fun i => (U i : Matrix (Fin n) (Fin n) K))
      (fun i => (V i : Matrix (Fin n) (Fin n) K)) p = p ↔
        ∀ i, IsPermSymmetry (U i) (V i)

/-- The trace polynomial `trace ((B_i * X_i * C_i) ^ j)`. -/
noncomputable def tracePowerPoly {k n : ℕ}
    (B C : Fin k → Matrix (Fin n) (Fin n) K) (i : Fin k) (j : ℕ) :
    MvPolynomial (Fin k × Fin n × Fin n) K :=
  (((B i).map MvPolynomial.C * blockVarMatrix K k n i * (C i).map MvPolynomial.C) ^ j).trace

/-- The `K`-subalgebra of `MvPolynomial (Fin k × Fin n × Fin n) K` generated by all traces
`trace ((B_i * X_i * C_i) ^ j)` for `1 ≤ i ≤ k` and `j ≥ 0`. -/
noncomputable def traceSubalgebra {k n : ℕ}
    (B C : Fin k → Matrix (Fin n) (Fin n) K) :
    Subalgebra K (MvPolynomial (Fin k × Fin n × Fin n) K) :=
  Algebra.adjoin K { q | ∃ (i : Fin k) (j : ℕ), q = tracePowerPoly B C i j }

end Defs

section BasicAPI

variable {K : Type*} [CommRing K]

private lemma eval_matrixLRSubst {n : ℕ} (U V X : Matrix (Fin n) (Fin n) K)
    (p : MvPolynomial (Fin n × Fin n) K) :
    MvPolynomial.eval (fun rc => X rc.1 rc.2) (matrixLRSubst U V p) =
      MvPolynomial.eval (fun rc => (U * X * V) rc.1 rc.2) p := by
  unfold matrixLRSubst
  have heval : ∀ (f : Fin n × Fin n → K) (q : MvPolynomial (Fin n × Fin n) K),
      MvPolynomial.eval f q = MvPolynomial.aeval (R := K) f q := fun _ _ => rfl
  rw [heval, heval, ← AlgHom.comp_apply]
  refine AlgHom.congr_fun ?_ p
  apply MvPolynomial.algHom_ext
  intro rc
  simp only [AlgHom.comp_apply, MvPolynomial.aeval_X, ← heval]
  simp only [Matrix.mul_apply, Matrix.map_apply, Matrix.mvPolynomialX_apply,
    map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]

private lemma eval_mvPolynomialX_permanent {n : ℕ} (X : Matrix (Fin n) (Fin n) K) :
    MvPolynomial.eval (fun rc => X rc.1 rc.2)
      (Matrix.mvPolynomialX (Fin n) (Fin n) K).permanent = X.permanent := by
  simp only [Matrix.permanent, map_sum, map_prod, Matrix.mvPolynomialX_apply, MvPolynomial.eval_X]

/-- Evaluating `matrixLRSubst U V (perm X)` at a concrete matrix `X` yields `perm (U * X * V)`. -/
theorem eval_matrixLRSubst_permanent {n : ℕ} (U V X : Matrix (Fin n) (Fin n) K) :
    MvPolynomial.eval (fun rc => X rc.1 rc.2)
      (matrixLRSubst U V (Matrix.mvPolynomialX (Fin n) (Fin n) K).permanent) =
        (U * X * V).permanent := by
  rw [eval_matrixLRSubst, eval_mvPolynomialX_permanent]

/-- Semantic unfolding of `IsPermSymmetry`. -/
theorem isPermSymmetry_iff {n : ℕ} (U V : GL (Fin n) K) :
    IsPermSymmetry U V ↔
      matrixLRSubst (U : Matrix (Fin n) (Fin n) K) (V : Matrix (Fin n) (Fin n) K)
        (Matrix.mvPolynomialX (Fin n) (Fin n) K).permanent =
          (Matrix.mvPolynomialX (Fin n) (Fin n) K).permanent :=
  Iff.rfl

/-- If `(U, V)` is a symmetry of the permanent polynomial, then `perm (U * X * V) = perm X` for
every matrix `X`. -/
theorem IsPermSymmetry.permanent_mul_eq {n : ℕ} {U V : GL (Fin n) K}
    (h : IsPermSymmetry U V) (X : Matrix (Fin n) (Fin n) K) :
    ((U : Matrix (Fin n) (Fin n) K) * X * (V : Matrix (Fin n) (Fin n) K)).permanent =
      X.permanent := by
  have hev := congrArg (MvPolynomial.eval fun rc => X rc.1 rc.2) h
  rwa [eval_matrixLRSubst_permanent, eval_mvPolynomialX_permanent] at hev

private lemma tupleMatrixLRSubst_blockVarMatrix_permanent {k n : ℕ}
    (U V : Fin k → Matrix (Fin n) (Fin n) K) (i : Fin k) :
    tupleMatrixLRSubst U V (blockVarMatrix K k n i).permanent =
      MvPolynomial.rename (fun rc : Fin n × Fin n => (i, rc))
        (matrixLRSubst (U i) (V i) (Matrix.mvPolynomialX (Fin n) (Fin n) K).permanent) := by
  have hblk : (blockVarMatrix K k n i).permanent =
      MvPolynomial.rename (fun rc : Fin n × Fin n => (i, rc))
        (Matrix.mvPolynomialX (Fin n) (Fin n) K).permanent := by
    simp only [Matrix.permanent, map_sum, map_prod, blockVarMatrix, Matrix.of_apply,
      Matrix.mvPolynomialX_apply, MvPolynomial.rename_X]
  rw [hblk]
  have hcomp :
      (tupleMatrixLRSubst U V).comp (MvPolynomial.rename (fun rc : Fin n × Fin n => (i, rc))) =
        (MvPolynomial.rename (fun rc : Fin n × Fin n => (i, rc))).comp
          (matrixLRSubst (U i) (V i)) := by
    apply MvPolynomial.algHom_ext
    intro rc
    simp only [AlgHom.comp_apply, MvPolynomial.rename_X, tupleMatrixLRSubst, matrixLRSubst,
      MvPolynomial.aeval_X, Matrix.mul_apply, Matrix.map_apply, blockVarMatrix, Matrix.of_apply,
      Matrix.mvPolynomialX_apply, map_sum, map_mul, MvPolynomial.rename_C]
  exact AlgHom.congr_fun hcomp _

/-- Non-vacuity witness: the sum of permanents `∑ i, perm(X_i)` is a
generalized permanent for every `n ≥ 1` and `k ≥ 1` over any commutative ring `K`. -/
theorem sum_permanent_isGeneralizedPermanent {k n : ℕ} (hn : 1 ≤ n) :
    IsGeneralizedPermanent (∑ i : Fin k, (blockVarMatrix K k n i).permanent) := by
  intro U V
  constructor
  · intro hsum i
    have hzero : ∀ j : Fin k, j ≠ i →
        MvPolynomial.aeval
          (fun irc : Fin k × Fin n × Fin n =>
            if irc.1 = i then MvPolynomial.X irc.2 else (0 : MvPolynomial (Fin n × Fin n) K))
          (blockVarMatrix K k n j).permanent = 0 := by
      intro j hji
      have : Nonempty (Fin n) := ⟨⟨0, by omega⟩⟩
      simp only [Matrix.permanent, map_sum, map_prod, blockVarMatrix, Matrix.of_apply,
        MvPolynomial.aeval_X, ite_eq_right hji]
      exact Finset.sum_eq_zero fun _ _ => Finset.prod_eq_zero (Finset.mem_univ ⟨0, by omega⟩) rfl
    have hproj := congrArg
      (MvPolynomial.aeval
        (fun irc : Fin k × Fin n × Fin n =>
          if irc.1 = i then MvPolynomial.X irc.2 else (0 : MvPolynomial (Fin n × Fin n) K))) hsum
    have hcomp_eq : ∀ j : Fin k,
        (MvPolynomial.aeval
          (fun irc : Fin k × Fin n × Fin n =>
            if irc.1 = i then MvPolynomial.X irc.2 else (0 : MvPolynomial (Fin n × Fin n) K))).comp
          (MvPolynomial.rename (fun rc : Fin n × Fin n => (j, rc))) =
          if j = i then AlgHom.id K _ else
            MvPolynomial.aeval (fun _ : Fin n × Fin n => (0 : MvPolynomial (Fin n × Fin n) K)) := by
      intro j
      apply MvPolynomial.algHom_ext
      intro rc
      by_cases hji : j = i <;> simp [hji]
    rw [map_sum, map_sum, map_sum] at hproj
    have hlhs : ∀ j : Fin k,
        MvPolynomial.aeval
          (fun irc : Fin k × Fin n × Fin n =>
            if irc.1 = i then MvPolynomial.X irc.2 else (0 : MvPolynomial (Fin n × Fin n) K))
          (tupleMatrixLRSubst (fun l => (U l : Matrix _ _ K)) (fun l => (V l : Matrix _ _ K))
            (blockVarMatrix K k n j).permanent) =
        if j = i then
          matrixLRSubst (U i : Matrix _ _ K) (V i : Matrix _ _ K)
            (Matrix.mvPolynomialX (Fin n) (Fin n) K).permanent
        else 0 := by
      intro j
      rw [tupleMatrixLRSubst_blockVarMatrix_permanent, ← AlgHom.comp_apply, hcomp_eq j]
      by_cases hji : j = i
      · subst hji
        simp
      · rw [ite_eq_right hji, ite_eq_right hji]
        have : Nonempty (Fin n) := ⟨⟨0, by omega⟩⟩
        rw [← AlgHom.comp_apply]
        have hz :
            (MvPolynomial.aeval
              (fun _ : Fin n × Fin n => (0 : MvPolynomial (Fin n × Fin n) K))).comp
              (matrixLRSubst (U j : Matrix _ _ K) (V j : Matrix _ _ K)) =
            MvPolynomial.aeval (fun _ : Fin n × Fin n => (0 : MvPolynomial (Fin n × Fin n) K)) := by
          apply MvPolynomial.algHom_ext
          intro rc
          simp [matrixLRSubst, Matrix.mul_apply]
        rw [AlgHom.congr_fun hz]
        simp only [Matrix.permanent, map_sum, map_prod, Matrix.mvPolynomialX_apply,
          MvPolynomial.aeval_X]
        exact Finset.sum_eq_zero fun _ _ => Finset.prod_eq_zero (Finset.mem_univ ⟨0, by omega⟩) rfl
    have hrhs : ∀ j : Fin k,
        MvPolynomial.aeval
          (fun irc : Fin k × Fin n × Fin n =>
            if irc.1 = i then MvPolynomial.X irc.2 else (0 : MvPolynomial (Fin n × Fin n) K))
          (blockVarMatrix K k n j).permanent =
        if j = i then (Matrix.mvPolynomialX (Fin n) (Fin n) K).permanent else 0 := by
      intro j
      by_cases hji : j = i
      · subst hji
        simp only [ite_true]
        rw [Matrix.permanent, Matrix.permanent, map_sum]
        refine Finset.sum_congr rfl fun σ _ => ?_
        rw [map_prod]
        refine Finset.prod_congr rfl fun r _ => ?_
        simp only [blockVarMatrix, Matrix.of_apply, Matrix.mvPolynomialX_apply,
          MvPolynomial.aeval_X, ite_true]
      · rw [ite_eq_right hji]
        exact hzero j hji
    simp_rw [hlhs, hrhs, Finset.sum_ite_eq', Finset.mem_univ, ite_true] at hproj
    exact hproj
  · intro hsym
    rw [map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [tupleMatrixLRSubst_blockVarMatrix_permanent, hsym i]
    simp only [Matrix.permanent, map_sum, map_prod, blockVarMatrix, Matrix.of_apply,
      Matrix.mvPolynomialX_apply, MvPolynomial.rename_X]

end BasicAPI

section TraceInvariance

variable {K : Type*} [CommRing K]

/-- Cyclicity of matrix power traces: `trace ((B * A * C) ^ j) = trace ((C * B * A) ^ j)` for
all `j ≥ 1`. -/
private lemma trace_pow_mul_assoc {R : Type*} [CommRing R] {n : ℕ}
    (B A C : Matrix (Fin n) (Fin n) R) :
    ∀ m : ℕ, ((B * A * C) ^ (m + 1)).trace = ((C * B * A) ^ (m + 1)).trace := by
  intro m
  have hstep : ∀ t : ℕ, (B * A * C) ^ (t + 1) = (B * A) * (C * B * A) ^ t * C := by
    intro t
    induction t with
    | zero => simp
    | succ s ih =>
      rw [pow_succ, ih, pow_succ]
      simp only [Matrix.mul_assoc]
  rw [hstep m, Matrix.trace_mul_comm ((B * A) * (C * B * A) ^ m) C, pow_succ']
  simp only [Matrix.mul_assoc]

/-- Left-right matrix substitution preserves `tracePowerPoly B C i j` whenever
`V_i * (C_i * B_i) * U_i = C_i * B_i`. -/
theorem tupleMatrixLRSubst_tracePowerPoly_eq {k n : ℕ}
    (B C U V : Fin k → Matrix (Fin n) (Fin n) K)
    (hstab : ∀ i, V i * (C i * B i) * U i = C i * B i) (i : Fin k) (j : ℕ) :
    tupleMatrixLRSubst U V (tracePowerPoly B C i j) = tracePowerPoly B C i j := by
  unfold tracePowerPoly
  have hmap : ∀ M : Matrix (Fin n) (Fin n) (MvPolynomial (Fin k × Fin n × Fin n) K),
      tupleMatrixLRSubst U V M.trace = (M.map (tupleMatrixLRSubst U V)).trace := by
    intro M
    simp [Matrix.trace, Matrix.diag, map_sum]
  rw [hmap]
  have hpow :
      (((B i).map MvPolynomial.C * blockVarMatrix K k n i * (C i).map MvPolynomial.C) ^ j).map
        (tupleMatrixLRSubst U V) =
      ((B i).map MvPolynomial.C *
        ((U i).map MvPolynomial.C * blockVarMatrix K k n i * (V i).map MvPolynomial.C) *
        (C i).map MvPolynomial.C) ^ j := by
    let φ : MvPolynomial (Fin k × Fin n × Fin n) K →+* MvPolynomial (Fin k × Fin n × Fin n) K :=
      (tupleMatrixLRSubst U V).toRingHom
    change φ.mapMatrix
      (((B i).map MvPolynomial.C * blockVarMatrix K k n i * (C i).map MvPolynomial.C) ^ j) = _
    rw [map_pow, map_mul, map_mul]
    have hB : φ.mapMatrix ((B i).map MvPolynomial.C) = (B i).map MvPolynomial.C := by
      ext r c; simp [φ, RingHom.mapMatrix_apply]
    have hC : φ.mapMatrix ((C i).map MvPolynomial.C) = (C i).map MvPolynomial.C := by
      ext r c; simp [φ, RingHom.mapMatrix_apply]
    have hX : φ.mapMatrix (blockVarMatrix K k n i) =
        (U i).map MvPolynomial.C * blockVarMatrix K k n i * (V i).map MvPolynomial.C := by
      ext r c; simp [φ, RingHom.mapMatrix_apply, blockVarMatrix, tupleMatrixLRSubst]
    rw [hB, hC, hX]
  rw [hpow]
  cases j with
  | zero => simp
  | succ m =>
    have h1 := trace_pow_mul_assoc
      ((B i).map MvPolynomial.C * (U i).map MvPolynomial.C)
      (blockVarMatrix K k n i)
      ((V i).map MvPolynomial.C * (C i).map MvPolynomial.C) m
    have h2 := trace_pow_mul_assoc
      ((B i).map MvPolynomial.C)
      (blockVarMatrix K k n i)
      ((C i).map MvPolynomial.C) m
    have hassoc :
        (B i).map MvPolynomial.C *
          ((U i).map MvPolynomial.C * blockVarMatrix K k n i * (V i).map MvPolynomial.C) *
          (C i).map MvPolynomial.C =
        ((B i).map MvPolynomial.C * (U i).map MvPolynomial.C) * blockVarMatrix K k n i *
          ((V i).map MvPolynomial.C * (C i).map MvPolynomial.C) := by
      simp only [Matrix.mul_assoc]
    rw [hassoc, h1, h2]
    let cHom : K →+* MvPolynomial (Fin k × Fin n × Fin n) K := MvPolynomial.C
    have hmid :
        (V i).map cHom * (C i).map cHom * ((B i).map cHom * (U i).map cHom) =
        (C i).map cHom * (B i).map cHom := by
      have hm := congrArg cHom.mapMatrix (hstab i)
      simpa only [RingHom.mapMatrix_apply, map_mul, Matrix.mul_assoc] using hm
    exact congrArg (fun M => ((M * blockVarMatrix K k n i) ^ (m + 1)).trace) hmid

/-- Every polynomial in `traceSubalgebra B C` is invariant under every stabilizer `(U, V)`
satisfying `V_i * (C_i * B_i) * U_i = C_i * B_i` for all `i`. -/
theorem tupleMatrixLRSubst_eq_of_mem_traceSubalgebra {k n : ℕ}
    (B C U V : Fin k → Matrix (Fin n) (Fin n) K)
    (hstab : ∀ i, V i * (C i * B i) * U i = C i * B i)
    {p : MvPolynomial (Fin k × Fin n × Fin n) K} (hp : p ∈ traceSubalgebra B C) :
    tupleMatrixLRSubst U V p = p := by
  induction hp using Algebra.adjoin_induction with
  | mem q hq =>
    rcases hq with ⟨i, j, rfl⟩
    exact tupleMatrixLRSubst_tracePowerPoly_eq B C U V hstab i j
  | algebraMap r => simp
  | add x y _ _ hx hy => rw [map_add, hx, hy]
  | mul x y _ _ hx hy => rw [map_mul, hx, hy]

end TraceInvariance

section NonSymmetry

variable {K : Type*} [Field K]

/-- If every column `j ∉ {a, b}` of `A` equals the standard basis vector `e_j`, then
`A.permanent = A a a * A b b + A a b * A b a`. -/
private lemma permanent_eq_two_block {n : ℕ} {a b : Fin n} (hab : a ≠ b)
    (A : Matrix (Fin n) (Fin n) K)
    (hcol : ∀ i j : Fin n, j ≠ a → j ≠ b → A i j = if i = j then 1 else 0) :
    A.permanent = A a a * A b b + A a b * A b a := by
  classical
  unfold Matrix.permanent
  have hsupp : ∀ σ : Equiv.Perm (Fin n),
      σ ≠ 1 → σ ≠ Equiv.swap a b → ∏ i : Fin n, A (σ i) i = 0 := by
    intro σ h1 hswap
    by_cases hfix : ∀ j : Fin n, j ≠ a → j ≠ b → σ j = j
    · exfalso
      have hmap_a : σ a = a ∨ σ a = b := by
        by_contra hna
        push Not at hna
        have := hfix (σ a) hna.1 hna.2
        have hinj := σ.injective this.symm
        exact hna.1 hinj.symm
      have hmap_b : σ b = a ∨ σ b = b := by
        by_contra hnb
        push Not at hnb
        have := hfix (σ b) hnb.1 hnb.2
        have hinj := σ.injective this.symm
        exact hnb.2 hinj.symm
      rcases hmap_a with ha | ha <;> rcases hmap_b with hb | hb
      · exact hab (σ.injective (ha.trans hb.symm))
      · exact h1 (Equiv.ext fun x => by
          by_cases hxa : x = a
          · simp [hxa, ha]
          · by_cases hxb : x = b
            · simp [hxb, hb]
            · simp [hfix x hxa hxb])
      · exact hswap (Equiv.ext fun x => by
          by_cases hxa : x = a
          · simp [hxa, ha]
          · by_cases hxb : x = b
            · simp [hxb, hb]
            · rw [hfix x hxa hxb, Equiv.swap_apply_of_ne_of_ne hxa hxb])
      · exact hab (σ.injective (ha.trans hb.symm))
    · push Not at hfix
      rcases hfix with ⟨j, hja, hjb, hne⟩
      refine Finset.prod_eq_zero (Finset.mem_univ j) ?_
      rw [hcol (σ j) j hja hjb, ite_eq_right hne]
  have hpair : ({1, Equiv.swap a b} : Finset (Equiv.Perm (Fin n))) ⊆ Finset.univ :=
    Finset.subset_univ _
  rw [← Finset.sum_subset hpair]
  · have hne : (1 : Equiv.Perm (Fin n)) ≠ Equiv.swap a b := by
      intro heq
      have := Equiv.congr_fun heq a
      simp [hab] at this
    rw [Finset.sum_pair hne]
    have hprod1 : ∏ i : Fin n, A ((1 : Equiv.Perm (Fin n)) i) i = A a a * A b b := by
      have hsub : ({a, b} : Finset (Fin n)) ⊆ Finset.univ := Finset.subset_univ _
      rw [← Finset.prod_subset hsub]
      · rw [Finset.prod_pair hab]
        simp
      · intro j _ hj
        simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hj
        simp [hcol j j hj.1 hj.2]
    have hprod2 : ∏ i : Fin n, A (Equiv.swap a b i) i = A b a * A a b := by
      have hsub : ({a, b} : Finset (Fin n)) ⊆ Finset.univ := Finset.subset_univ _
      rw [← Finset.prod_subset hsub]
      · rw [Finset.prod_pair hab]
        simp
      · intro j _ hj
        simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hj
        rw [Equiv.swap_apply_of_ne_of_ne hj.1 hj.2, hcol j j hj.1 hj.2, ite_eq_left rfl]
    rw [hprod1, hprod2, mul_comm (A b a) (A a b)]
  · intro σ _ hσ
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hσ
    exact hsupp σ hσ.1 hσ.2

/-- A matrix with a zero row has permanent `0`. -/
private lemma permanent_eq_zero_of_row_zero {n : ℕ} (X : Matrix (Fin n) (Fin n) K)
    {r : Fin n} (hr : ∀ j, X r j = 0) : X.permanent = 0 := by
  unfold Matrix.permanent
  refine Finset.sum_eq_zero fun σ _ => ?_
  exact Finset.prod_eq_zero (Finset.mem_univ (σ.symm r)) (by simp [hr])

/-- Core linear-algebraic lemma: for any `n × n` matrix `M` (`n ≥ 2`) over a field `K` with
`(2 : K) ≠ 0`, there exists `(U, V) ∈ GL_n(K) × GL_n(K)` stabilizing `M` (`V * M * U = M`)
that is not a left-right symmetry of the permanent. -/
theorem exists_stabilizer_not_isPermSymmetry (h2 : (2 : K) ≠ 0) {n : ℕ} (hn : 2 ≤ n)
    (M : Matrix (Fin n) (Fin n) K) :
    ∃ U V : GL (Fin n) K,
      (V : Matrix (Fin n) (Fin n) K) * M * (U : Matrix (Fin n) (Fin n) K) = M ∧
        ¬ IsPermSymmetry U V := by
  classical
  by_cases hdet : M.det = 0
  · -- Singular case: choose a nonzero kernel vector `v` of `M`.
    obtain ⟨v, hv_ne, hMv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hex : ∃ a : Fin n, v a ≠ 0 := by
      by_contra hall
      push Not at hall
      exact hv_ne (funext hall)
    obtain ⟨a, hva⟩ := hex
    let b : Fin n := if a = ⟨0, by omega⟩ then ⟨1, by omega⟩ else ⟨0, by omega⟩
    have hab : a ≠ b := by
      dsimp only [b]
      split_ifs with h0
      · rw [h0]
        intro h
        have hv := congrArg Fin.val h
        simp at hv
      · exact h0
    by_cases hvb : v b = 0
    · -- Subcase 1: `v b = 0`; use the unipotent perturbation `U = 1 + v * e_bᵀ`, `V = 1`.
      let P : Matrix (Fin n) (Fin n) K := Matrix.of fun i j => if j = b then v i else 0
      have hP2 : P * P = 0 := by
        ext i j
        simp only [Matrix.mul_apply, P, Matrix.of_apply, Matrix.zero_apply]
        refine Finset.sum_eq_zero fun k _ => ?_
        by_cases hkb : k = b
        · subst hkb; simp [hvb]
        · simp [hkb]
      have hMP : M * P = 0 := by
        ext i j
        simp only [Matrix.mul_apply, P, Matrix.of_apply, Matrix.zero_apply]
        by_cases hjb : j = b
        · subst hjb
          have hi := congrFun hMv i
          simpa [Matrix.mulVec, dotProduct] using hi
        · simp [hjb]
      let U : GL (Fin n) K :=
        { val := 1 + P
          inv := 1 - P
          val_inv := by simp [mul_sub, add_mul, hP2]
          inv_val := by simp [mul_add, sub_mul, hP2] }
      refine ⟨U, 1, ?_, ?_⟩
      · change (1 : Matrix (Fin n) (Fin n) K) * M * (1 + P) = M
        rw [one_mul, mul_add, mul_one, hMP, add_zero]
      · intro hsym
        let X : Matrix (Fin n) (Fin n) K :=
          Matrix.of fun i j =>
            if i = a then 0
            else if i = b then (if j = a ∨ j = b then 1 else 0)
            else if i = j then 1 else 0
        have hX0 : X.permanent = 0 :=
          permanent_eq_zero_of_row_zero X (r := a) (fun j => by simp [X])
        have hUX_eq : (U : Matrix (Fin n) (Fin n) K) * X * (1 : Matrix (Fin n) (Fin n) K) =
            (1 + P) * X := mul_one _
        have hperm := hsym.permanent_mul_eq X
        rw [show (1 : GL (Fin n) K).val = (1 : Matrix (Fin n) (Fin n) K) from rfl,
          hUX_eq, hX0] at hperm
        have hentry : ∀ i j : Fin n,
            ((1 + P) * X) i j = X i j + v i * X b j := by
          intro i j
          rw [add_mul, one_mul, Matrix.add_apply, Matrix.mul_apply]
          congr 1
          rw [Finset.sum_eq_single b]
          · simp [P]
          · intro k _ hkb; simp [P, hkb]
          · intro hb'; exact absurd (Finset.mem_univ b) hb'
        have hcol : ∀ i j : Fin n, j ≠ a → j ≠ b → ((1 + P) * X) i j = if i = j then 1 else 0 := by
          intro i j hja hjb
          rw [hentry i j]
          have hXbj : X b j = 0 := by simp [X, hab.symm, hja, hjb]
          rw [hXbj, mul_zero, add_zero]
          by_cases hia : i = a
          · subst hia; simp [X, hja.symm]
          · by_cases hib : i = b
            · subst hib; simp [X, hab.symm, hja, hjb, hjb.symm]
            · simp [X, hia, hib]
        have hval := permanent_eq_two_block hab ((1 + P) * X) hcol
        have haa : ((1 + P) * X) a a = v a := by
          rw [hentry a a]; simp [X, hab.symm]
        have hab' : ((1 + P) * X) a b = v a := by
          rw [hentry a b]; simp [X, hab.symm]
        have hba : ((1 + P) * X) b a = 1 := by
          rw [hentry b a]; simp [X, hab.symm, hvb]
        have hbb : ((1 + P) * X) b b = 1 := by
          rw [hentry b b]; simp [X, hab.symm, hvb]
        rw [haa, hab', hba, hbb, mul_one, ← two_mul] at hval
        rw [hval] at hperm
        exact mul_ne_zero h2 hva hperm
    · -- Subcase 2: `v b ≠ 0`; use the reflection `U = 1 - 2 • v * (e_a / v a)ᵀ`, `V = 1`.
      let P : Matrix (Fin n) (Fin n) K :=
        Matrix.of fun i j => if j = a then v i * (v a)⁻¹ else 0
      have hP2 : P * P = P := by
        ext i j
        simp only [Matrix.mul_apply, P, Matrix.of_apply]
        rw [Finset.sum_eq_single a]
        · by_cases hja : j = a
          · subst hja
            simp only [ite_true]
            rw [mul_assoc, inv_mul_cancel_left₀ hva]
          · simp [hja]
        · intro k _ hka; simp [hka]
        · intro ha'; exact absurd (Finset.mem_univ a) ha'
      have hMP : M * P = 0 := by
        ext i j
        simp only [Matrix.mul_apply, P, Matrix.of_apply, Matrix.zero_apply]
        by_cases hja : j = a
        · rw [hja]
          simp only [ite_true]
          have hi := congrFun hMv i
          have hsum : ∑ k : Fin n, M i k * (v k * (v a)⁻¹) =
              (∑ k : Fin n, M i k * v k) * (v a)⁻¹ := by
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl fun k _ => ?_
            ring
          rw [hsum]
          have h0 : ∑ k : Fin n, M i k * v k = 0 := by simpa [Matrix.mulVec, dotProduct] using hi
          rw [h0, zero_mul]
        · simp [hja]
      let Umat : Matrix (Fin n) (Fin n) K := 1 - (2 : K) • P
      have hU2 : Umat * Umat = 1 := by
        dsimp only [Umat]
        simp only [sub_mul, mul_sub, one_mul, mul_one, Matrix.smul_mul, Matrix.mul_smul,
          smul_smul, hP2]
        have h4 : (2 : K) • P + (2 : K) • P = (2 * 2 : K) • P := by
          rw [← add_smul]
          congr 1
          ring
        calc
          1 - (2 : K) • P - ((2 : K) • P - (2 * 2 : K) • P)
              = 1 - ((2 : K) • P + (2 : K) • P) + (2 * 2 : K) • P := by abel
          _ = 1 - (2 * 2 : K) • P + (2 * 2 : K) • P := by rw [h4]
          _ = 1 := by abel
      let U : GL (Fin n) K := ⟨Umat, Umat, hU2, hU2⟩
      refine ⟨U, 1, ?_, ?_⟩
      · change (1 : Matrix (Fin n) (Fin n) K) * M * (1 - (2 : K) • P) = M
        rw [one_mul, mul_sub, mul_one, Matrix.mul_smul, hMP, smul_zero, sub_zero]
      · intro hsym
        let X : Matrix (Fin n) (Fin n) K :=
          Matrix.of fun i j =>
            if i = b then 0
            else if i = a then (if j = a ∨ j = b then 1 else 0)
            else if i = j then 1 else 0
        have hX0 : X.permanent = 0 :=
          permanent_eq_zero_of_row_zero X (r := b) (fun j => by simp [X])
        have hperm := hsym.permanent_mul_eq X
        rw [show (1 : GL (Fin n) K).val = (1 : Matrix (Fin n) (Fin n) K) from rfl,
          mul_one, hX0] at hperm
        have hentry : ∀ i j : Fin n,
            (Umat * X) i j = X i j - 2 * (v i * (v a)⁻¹) * X a j := by
          intro i j
          dsimp only [Umat]
          rw [sub_mul, one_mul, Matrix.sub_apply, Matrix.smul_mul, Matrix.smul_apply,
            Matrix.mul_apply, smul_eq_mul]
          congr 1
          rw [Finset.sum_eq_single a]
          · simp [P, mul_assoc]
          · intro k _ hka; simp [P, hka]
          · intro ha'; exact absurd (Finset.mem_univ a) ha'
        have hcol : ∀ i j : Fin n, j ≠ a → j ≠ b → (Umat * X) i j = if i = j then 1 else 0 := by
          intro i j hja hjb
          rw [hentry i j]
          have hXaj : X a j = 0 := by simp [X, hab, hja, hjb]
          rw [hXaj, mul_zero, sub_zero]
          by_cases hib : i = b
          · subst hib; simp [X, hjb.symm]
          · by_cases hia : i = a
            · subst hia; simp [X, hab, hja, hjb, hja.symm]
            · simp [X, hib, hia]
        have hval := permanent_eq_two_block hab (Umat * X) hcol
        have haa : (Umat * X) a a = -1 := by
          rw [hentry a a]
          simp only [X, Matrix.of_apply, ite_eq_right hab, ite_true, true_or]
          rw [mul_inv_cancel₀ hva]
          ring
        have hab' : (Umat * X) a b = -1 := by
          rw [hentry a b]
          simp only [X, Matrix.of_apply, ite_eq_right hab, ite_true, or_true]
          rw [mul_inv_cancel₀ hva]
          ring
        have hba : (Umat * X) b a = -(2 * (v b * (v a)⁻¹)) := by
          rw [hentry b a]
          simp only [X, Matrix.of_apply, ite_true, ite_eq_right hab, true_or]
          ring
        have hbb : (Umat * X) b b = -(2 * (v b * (v a)⁻¹)) := by
          rw [hentry b b]
          simp only [X, Matrix.of_apply, ite_true, ite_eq_right hab, or_true]
          ring
        rw [haa, hab', hba, hbb] at hval
        have hprod : (-1 : K) * -(2 * (v b * (v a)⁻¹)) + (-1 : K) * -(2 * (v b * (v a)⁻¹)) =
            2 * 2 * v b * (v a)⁻¹ := by ring
        rw [hprod] at hval
        change (Umat * X).permanent = 0 at hperm
        rw [hval] at hperm
        exact mul_ne_zero (mul_ne_zero (mul_ne_zero h2 h2) hvb) (inv_ne_zero hva) hperm
  · -- Invertible case: `M` lifts to `GL_n(K)`; use shear `U = 1 + E_{0,1}` and `V = M U⁻¹ M⁻¹`.
    let Mu : GL (Fin n) K := Matrix.GeneralLinearGroup.mkOfDetNeZero M hdet
    let i0 : Fin n := ⟨0, by omega⟩
    let i1 : Fin n := ⟨1, by omega⟩
    have hi01 : i0 ≠ i1 := fun h => by
      have hv := congrArg Fin.val h
      simp [i0, i1] at hv
    let E : Matrix (Fin n) (Fin n) K := Matrix.single i0 i1 (1 : K)
    have hE2 : E * E = 0 := by
      ext r c
      simp only [E, Matrix.mul_apply, Matrix.single, Matrix.of_apply, Matrix.zero_apply]
      refine Finset.sum_eq_zero fun j _ => ?_
      by_cases h1 : i0 = r ∧ i1 = j
      · have hj : j = i1 := h1.2.symm
        subst hj
        simp [hi01]
      · simp [h1]
    let U : GL (Fin n) K :=
      { val := 1 + E
        inv := 1 - E
        val_inv := by simp [mul_sub, add_mul, hE2]
        inv_val := by simp [mul_add, sub_mul, hE2] }
    let V : GL (Fin n) K := Mu * U⁻¹ * Mu⁻¹
    refine ⟨U, V, ?_, ?_⟩
    · have hMu : (Mu : Matrix (Fin n) (Fin n) K) = M := rfl
      have hgrp : V * Mu * U = Mu := by
        dsimp only [V]
        group
      have hval := congrArg Units.val hgrp
      simpa only [Units.val_mul, hMu] using hval
    · intro hsym
      let Y : Matrix (Fin n) (Fin n) K :=
        Matrix.of fun i j =>
          if i = i0 then 0
          else if i = i1 then (if j = i0 ∨ j = i1 then 1 else 0)
          else if i = j then 1 else 0
      let X : Matrix (Fin n) (Fin n) K := Y * (V⁻¹ : GL (Fin n) K).val
      have hX0 : X.permanent = 0 := by
        refine permanent_eq_zero_of_row_zero X (r := i0) fun j => ?_
        simp only [X, Matrix.mul_apply, Y, Matrix.of_apply, ite_true, zero_mul,
          Finset.sum_const_zero]
      have hperm := hsym.permanent_mul_eq X
      have hmul : (U : Matrix (Fin n) (Fin n) K) * X * (V : Matrix (Fin n) (Fin n) K) =
          (1 + E) * Y := by
        dsimp only [X]
        rw [Matrix.mul_assoc, Matrix.mul_assoc,
          show (V⁻¹ : GL (Fin n) K).val * (V : Matrix (Fin n) (Fin n) K) = 1 from V.inv_val,
          mul_one]
      rw [hmul, hX0] at hperm
      have hentry : ∀ i j : Fin n,
          ((1 + E) * Y) i j = Y i j + if i = i0 then Y i1 j else 0 := by
        intro i j
        rw [add_mul, one_mul, Matrix.add_apply, Matrix.mul_apply]
        congr 1
        rw [Finset.sum_eq_single i1]
        · by_cases hi : i = i0
          · subst hi; simp [E, Matrix.single]
          · simp [E, Matrix.single, hi, Ne.symm hi]
        · intro k _ hk; simp [E, Matrix.single, Ne.symm hk]
        · intro hi1'; exact absurd (Finset.mem_univ i1) hi1'
      have hcol : ∀ i j : Fin n, j ≠ i0 → j ≠ i1 →
          ((1 + E) * Y) i j = if i = j then 1 else 0 := by
        intro i j hj0 hj1
        rw [hentry i j]
        have hYi1 : Y i1 j = 0 := by simp [Y, hi01.symm, hj0, hj1]
        rw [hYi1, ite_self, add_zero]
        by_cases hi : i = i0
        · subst hi; simp [Y, hj0.symm]
        · by_cases hi' : i = i1
          · subst hi'; simp [Y, hi01.symm, hj0, hj1, hj1.symm]
          · simp [Y, hi, hi']
      have hval := permanent_eq_two_block hi01 ((1 + E) * Y) hcol
      have h00 : ((1 + E) * Y) i0 i0 = 1 := by rw [hentry i0 i0]; simp [Y, hi01.symm]
      have h01 : ((1 + E) * Y) i0 i1 = 1 := by rw [hentry i0 i1]; simp [Y, hi01.symm]
      have h10 : ((1 + E) * Y) i1 i0 = 1 := by rw [hentry i1 i0]; simp [Y, hi01.symm]
      have h11 : ((1 + E) * Y) i1 i1 = 1 := by rw [hentry i1 i1]; simp [Y, hi01.symm]
      rw [h00, h01, h10, h11, mul_one, one_add_one_eq_two] at hval
      rw [hval] at hperm
      exact h2 hperm

end NonSymmetry

section MainTheorems

variable {K : Type*} [Field K]

/-- Over any field `K` of characteristic different from `2` (in particular `ℂ` and any
algebraically closed field of characteristic `≠ 2`), for `n ≥ 2` and `k ≥ 1`, no generalized
permanent `p(X_1, ..., X_k)` lies in the polynomial subalgebra generated by the traces
`trace ((B_i * X_i * C_i) ^ j)` (`1 ≤ i ≤ k`, `j ≥ 0`), for any (possibly singular) `n × n`
matrices `B_i, C_i`. -/
theorem not_mem_traceSubalgebra_of_isGeneralizedPermanent (h2 : (2 : K) ≠ 0) {k n : ℕ}
    (hk : 1 ≤ k) (hn : 2 ≤ n)
    {p : MvPolynomial (Fin k × Fin n × Fin n) K} (hp : IsGeneralizedPermanent p)
    (B C : Fin k → Matrix (Fin n) (Fin n) K) :
    p ∉ traceSubalgebra B C := by
  classical
  intro hmem
  let i0 : Fin k := ⟨0, by omega⟩
  obtain ⟨U0, V0, hstab0, hnot0⟩ :=
    exists_stabilizer_not_isPermSymmetry h2 hn (C i0 * B i0)
  let U : Fin k → GL (Fin n) K := fun i => if i = i0 then U0 else 1
  let V : Fin k → GL (Fin n) K := fun i => if i = i0 then V0 else 1
  have hstab : ∀ i : Fin k,
      (V i : Matrix (Fin n) (Fin n) K) * (C i * B i) * (U i : Matrix (Fin n) (Fin n) K) =
        C i * B i := by
    intro i
    by_cases hi : i = i0
    · subst hi
      simp [U, V, hstab0]
    · simp [U, V, hi]
  have hinv := tupleMatrixLRSubst_eq_of_mem_traceSubalgebra B C
    (fun i => (U i : Matrix _ _ K)) (fun i => (V i : Matrix _ _ K)) hstab hmem
  have hall := (hp U V).mp hinv
  have hi0 := hall i0
  simp only [U, V, ite_true] at hi0
  exact hnot0 hi0

/-- Explicit multivariate polynomial formulation: no generalized permanent
`p(X_1, ..., X_k)` equals `Q(trace ((B_i * X_i * C_i) ^ j))` for any polynomial `Q` over
`Fin k × Fin d`. -/
theorem not_eq_aeval_tracePowerPoly_of_isGeneralizedPermanent (h2 : (2 : K) ≠ 0) {k n d : ℕ}
    (hk : 1 ≤ k) (hn : 2 ≤ n)
    {p : MvPolynomial (Fin k × Fin n × Fin n) K} (hp : IsGeneralizedPermanent p)
    (B C : Fin k → Matrix (Fin n) (Fin n) K)
    (Q : MvPolynomial (Fin k × Fin d) K) :
    p ≠ MvPolynomial.aeval (fun ij : Fin k × Fin d => tracePowerPoly B C ij.1 ij.2.val) Q := by
  intro heq
  apply not_mem_traceSubalgebra_of_isGeneralizedPermanent h2 hk hn hp B C
  rw [heq]
  clear heq
  induction Q using MvPolynomial.induction_on with
  | C r => rw [MvPolynomial.aeval_C]; exact Subalgebra.algebraMap_mem (traceSubalgebra B C) r
  | add f g hf hg => rw [map_add]; exact Subalgebra.add_mem _ hf hg
  | mul_X f ij hf =>
    rw [map_mul, MvPolynomial.aeval_X]
    exact Subalgebra.mul_mem _ hf (Algebra.subset_adjoin ⟨ij.1, ij.2.val, rfl⟩)

/-- Assuming `VNP ⊈ VP`, no `VNP`-complete
polynomial family `f` can belong to `VP` (in particular, cannot be expressed as a `VP`-computable
polynomial function of `VP`-computable trace powers `trace ((B_i * X_i * C_i) ^ j)`). -/
theorem not_vp_trace_expr_of_isVNPComplete {K : Type*} [CommSemiring K]
    (hsep : ¬ (VNP K ⊆ VP K)) {f : PolynomialFamily K} (hf : IsVNPComplete f) :
    f ∉ VP K :=
  fun hmem => hsep (hf.VNP_subset_VP hmem)

end MainTheorems

end CslibFrontier.Computability.Circuit.Arithmetic
