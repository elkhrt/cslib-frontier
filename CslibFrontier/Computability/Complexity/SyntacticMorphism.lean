module

public import Mathlib.Data.Fintype.Defs
public import Mathlib.Data.List.Basic
public import Mathlib.Data.Set.Image

/-!
# Syntactic Morphisms, Complexity Classes, and Hierarchy Separation

This module formalizes free-monoid homomorphisms (syntactic morphisms), inverse-homomorphism
reducibility, complexity classes closed under inverse syntactic morphisms, principal classes,
invariant hierarchies, highness, and separation arguments for invariant hierarchies. All results
are proved under standard Lean axioms (`propext`, `Classical.choice`, `Quot.sound`).

## Main definitions

* `CslibFrontier.Computability.Complexity.syntacticMorphism`: The free-monoid homomorphism
  `List α → List β` generated by `f : α → List β`.
* `CslibFrontier.Computability.Complexity.SyntacticReducible`: Inverse-homomorphism reducibility
  `L = syntacticMorphism f ⁻¹' T`.
* `CslibFrontier.Computability.Complexity.LanguageClass`: Universe-polymorphic family of formal
  languages over finite alphabets.
* `CslibFrontier.Computability.Complexity.IsSyntacticComplexityClass`: Closure of a language class
  under inverse images of syntactic morphisms.
* `CslibFrontier.Computability.Complexity.IsSyntacticComplete`: Completeness of a language for a
  language class under syntactic morphisms.
* `CslibFrontier.Computability.Complexity.IsPrincipal`: Existence of a complete language in a
  syntactic complexity class.
* `CslibFrontier.Computability.Complexity.IsInvariantHierarchy`: A hierarchy of language classes
  whose positive levels are closed under inverse syntactic morphisms.
* `CslibFrontier.Computability.Complexity.IsHighInHierarchy`: A language class containing languages
  outside every level of a hierarchy.

## Main results

* `CslibFrontier.Computability.Complexity.not_subset_of_isPrincipal_of_isHighInHierarchy`:
  A principal class that is high in an invariant hierarchy cannot be contained in the union
  of that hierarchy.
* `CslibFrontier.Computability.Complexity.not_isPrincipal_of_strict_invariantHierarchy`:
  Non-principality of strict invariant hierarchies: the union of a strict invariant hierarchy
  is not principal.
* `CslibFrontier.Computability.Complexity.not_subset_of_isPrincipal_of_not_isPrincipal`:
  A principal class cannot be contained in a non-principal complexity class that it contains.
-/

public section

namespace CslibFrontier.Computability.Complexity

universe u

/-- The syntactic morphism (free-monoid homomorphism) `List α → List β` induced by a map
`f : α → List β`. -/
def syntacticMorphism {α β : Type*} (f : α → List β) : List α → List β :=
  List.flatMap f

@[simp]
theorem syntacticMorphism_nil {α β : Type*} (f : α → List β) :
    syntacticMorphism f [] = [] :=
  List.flatMap_nil

theorem syntacticMorphism_singleton {α β : Type*} (f : α → List β) (a : α) :
    syntacticMorphism f [a] = f a := by
  simp [syntacticMorphism]

@[simp]
theorem syntacticMorphism_cons {α β : Type*} (f : α → List β) (a : α) (w : List α) :
    syntacticMorphism f (a :: w) = f a ++ syntacticMorphism f w :=
  List.flatMap_cons

@[simp]
theorem syntacticMorphism_append {α β : Type*} (f : α → List β) (u v : List α) :
    syntacticMorphism f (u ++ v) = syntacticMorphism f u ++ syntacticMorphism f v :=
  List.flatMap_append

theorem syntacticMorphism_id {α : Type*} (w : List α) :
    syntacticMorphism (fun a : α ↦ [a]) w = w := by
  induction w with
  | nil => rfl
  | cons a w ih => simp [ih]

theorem syntacticMorphism_comp {α β γ : Type*} (g : β → List γ) (f : α → List β) (w : List α) :
    syntacticMorphism g (syntacticMorphism f w) =
      syntacticMorphism (fun a ↦ syntacticMorphism g (f a)) w := by
  induction w with
  | nil => rfl
  | cons a w ih => simp [ih]

/-- A language `L ⊆ List α` is reducible to `T ⊆ List β` under syntactic morphisms if `L` is
the preimage of `T` under some syntactic morphism `List α → List β`. -/
@[expose]
def SyntacticReducible {α β : Type*} (L : Set (List α)) (T : Set (List β)) : Prop :=
  ∃ f : α → List β, L = syntacticMorphism f ⁻¹' T

theorem syntacticReducible_refl {α : Type*} (L : Set (List α)) :
    SyntacticReducible L L := by
  refine ⟨fun a ↦ [a], ?_⟩
  ext w
  simp [syntacticMorphism_id]

theorem syntacticReducible_trans {α β γ : Type*} {L : Set (List α)} {T : Set (List β)}
    {U : Set (List γ)} (hLT : SyntacticReducible L T) (hTU : SyntacticReducible T U) :
    SyntacticReducible L U := by
  rcases hLT with ⟨f, rfl⟩
  rcases hTU with ⟨g, rfl⟩
  refine ⟨fun a ↦ syntacticMorphism g (f a), ?_⟩
  ext w
  simp [syntacticMorphism_comp]

theorem syntacticReducible_compl {α β : Type*} {L : Set (List α)} {T : Set (List β)}
    (h : SyntacticReducible L T) : SyntacticReducible Lᶜ Tᶜ := by
  rcases h with ⟨f, rfl⟩
  exact ⟨f, rfl⟩

/-- A universe-polymorphic family of formal languages over finite alphabets. -/
abbrev LanguageClass : Type (u + 1) :=
  ∀ {α : Type u} [Fintype α], Set (Set (List α))

/-- A language class `C` is a syntactic complexity class if it is closed under inverse images
of syntactic morphisms. -/
@[expose]
def IsSyntacticComplexityClass (C : LanguageClass.{u}) : Prop :=
  ∀ {α β : Type u} [Fintype α] [Fintype β] {L : Set (List α)} {T : Set (List β)},
    T ∈ C → SyntacticReducible L T → L ∈ C

/-- A language `T` in `C` is complete for `C` under syntactic morphisms if every language in `C`
is syntactically reducible to `T`. -/
@[expose]
def IsSyntacticComplete (C : LanguageClass.{u}) {β : Type u} [Fintype β]
    (T : Set (List β)) : Prop :=
  T ∈ C ∧ ∀ {α : Type u} [Fintype α] (L : Set (List α)), L ∈ C → SyntacticReducible L T

/-- A syntactic complexity class is principal if it contains a complete language. -/
@[expose]
def IsPrincipal (C : LanguageClass.{u}) : Prop :=
  IsSyntacticComplexityClass C ∧
    ∃ (β : Type u) (_ : Fintype β) (T : Set (List β)), IsSyntacticComplete C T

/-- A sequence of language classes `H : ℕ → LanguageClass` forms an invariant hierarchy if
every positive level `H i` (`i ≥ 1`) is closed under inverse syntactic morphisms. -/
@[expose]
def IsInvariantHierarchy (H : ℕ → LanguageClass.{u}) : Prop :=
  ∀ i : ℕ, 1 ≤ i → IsSyntacticComplexityClass (H i)

/-- The union `⋃_{i ≥ 1} H i` of a hierarchy of language classes. -/
@[expose]
def unionHierarchy (H : ℕ → LanguageClass.{u}) : LanguageClass.{u} :=
  fun {α} _ ↦ {L : Set (List α) | ∃ i : ℕ, 1 ≤ i ∧ L ∈ H i}

theorem mem_unionHierarchy {H : ℕ → LanguageClass.{u}} {α : Type u} [Fintype α]
    {L : Set (List α)} : L ∈ unionHierarchy H ↔ ∃ i : ℕ, 1 ≤ i ∧ L ∈ H i :=
  Iff.rfl

/-- Inclusion of language classes `D ⊆ C` across all finite alphabets. -/
@[expose]
def LanguageClassSubset (D C : LanguageClass.{u}) : Prop :=
  ∀ {α : Type u} [Fintype α] (L : Set (List α)), L ∈ D → L ∈ C

/-- A language class `D` is high in a hierarchy `H` if for every positive level `n ≥ 1`, there
exists a language in `D` outside `H n`. -/
@[expose]
def IsHighInHierarchy (D : LanguageClass.{u}) (H : ℕ → LanguageClass.{u}) : Prop :=
  ∀ n : ℕ, 1 ≤ n → ∃ (α : Type u) (_ : Fintype α) (L : Set (List α)), L ∈ D ∧ L ∉ H n

/-- The union of an invariant hierarchy is a syntactic complexity class. -/
theorem isSyntacticComplexityClass_unionHierarchy {H : ℕ → LanguageClass.{u}}
    (hH : IsInvariantHierarchy H) : IsSyntacticComplexityClass (unionHierarchy H) := by
  intro α β _ _ L T hT hred
  rcases mem_unionHierarchy.mp hT with ⟨i, hi, hTi⟩
  exact mem_unionHierarchy.mpr ⟨i, hi, hH i hi hTi hred⟩

/-- **the Argument**: If `H` is an invariant hierarchy and `D` is a principal complexity
class that is high in `H`, then `D` is not contained in `⋃_{i ≥ 1} H i`. -/
theorem not_subset_of_isPrincipal_of_isHighInHierarchy {D : LanguageClass.{u}}
    {H : ℕ → LanguageClass.{u}} (hH : IsInvariantHierarchy H)
    (hD : IsPrincipal D) (hhigh : IsHighInHierarchy D H) :
    ¬ LanguageClassSubset D (unionHierarchy H) := by
  intro hsub
  rcases hD with ⟨_, β, _, T, hTmem, hTcomp⟩
  rcases mem_unionHierarchy.mp (hsub T hTmem) with ⟨k, hk, hTk⟩
  rcases hhigh k hk with ⟨α, _, L, hLD, hLnot⟩
  exact hLnot (hH k hk hTk (hTcomp L hLD))

/-- Non-principality of strict invariant hierarchies: if an invariant hierarchy `H` is strict (its
union is high in `H`), then `⋃_{i ≥ 1} H i` is not principal. -/
theorem not_isPrincipal_of_strict_invariantHierarchy {H : ℕ → LanguageClass.{u}}
    (hH : IsInvariantHierarchy H)
    (hstrict : IsHighInHierarchy (unionHierarchy H) H) :
    ¬ IsPrincipal (unionHierarchy H) := by
  intro hP
  exact not_subset_of_isPrincipal_of_isHighInHierarchy hH hP hstrict (fun _ h ↦ h)

/-- A principal class cannot be contained in a non-principal complexity class that it contains. -/
theorem not_subset_of_isPrincipal_of_not_isPrincipal {C D : LanguageClass.{u}}
    (hC_sub : LanguageClassSubset C D) (hD : IsPrincipal D) (hC : ¬ IsPrincipal C)
    (hC_cls : IsSyntacticComplexityClass C) : ¬ LanguageClassSubset D C := by
  intro hD_sub
  apply hC
  refine ⟨hC_cls, ?_⟩
  rcases hD with ⟨_, β, _, T, hTmem, hTcomp⟩
  exact ⟨β, inferInstance, T, hD_sub T hTmem, fun L hLC ↦ hTcomp L (hC_sub L hLC)⟩

/-! ### Non-vacuity examples -/

example :
    let D : LanguageClass.{0} := fun {α} _ ↦ {L | ∃ S : Set α, L = {w : List α | ∃ a ∈ w, a ∈ S}}
    let H : ℕ → LanguageClass.{0} := fun _ {_} _ ↦ {L | L = ∅ ∨ L = Set.univ}
    IsInvariantHierarchy H ∧ IsPrincipal D ∧ IsHighInHierarchy D H := by
  classical
  refine ⟨?_, ⟨?_, Bool, inferInstance, {w | true ∈ w}, ?_, ?_⟩, ?_⟩
  · rintro i _ α β _ _ L T hT ⟨f, rfl⟩
    rcases hT with rfl | rfl
    · exact Or.inl rfl
    · exact Or.inr rfl
  · rintro α β _ _ L T ⟨S, rfl⟩ ⟨f, rfl⟩
    refine ⟨{a : α | ∃ b ∈ f a, b ∈ S}, ?_⟩
    ext w
    simp only [syntacticMorphism, Set.mem_preimage, Set.mem_ofPred_eq, List.mem_flatMap]
    exact ⟨fun ⟨b, ⟨a, haw, hbf⟩, hbS⟩ ↦ ⟨a, haw, b, hbf, hbS⟩,
      fun ⟨a, haw, b, hbf, hbS⟩ ↦ ⟨b, ⟨a, haw, hbf⟩, hbS⟩⟩
  · refine ⟨{true}, ?_⟩
    ext w
    simp
  · rintro α _ L ⟨S, rfl⟩
    refine ⟨fun a ↦ if a ∈ S then [true] else [], ?_⟩
    ext w
    simp only [syntacticMorphism, Set.mem_preimage, Set.mem_ofPred_eq, List.mem_flatMap]
    constructor
    · rintro ⟨a, haw, haS⟩
      exact ⟨a, haw, by simp [haS]⟩
    · rintro ⟨a, haw, hmem⟩
      by_cases haS : a ∈ S
      · exact ⟨a, haw, haS⟩
      · simp [haS] at hmem
  · intro n _
    refine ⟨Bool, inferInstance, {w | true ∈ w}, ⟨{true}, by ext w; simp⟩, ?_⟩
    rintro (h | h)
    · have : ([true] : List Bool) ∈ (∅ : Set (List Bool)) := h ▸ by simp
      exact this
    · have : ([] : List Bool) ∈ {w : List Bool | true ∈ w} := h.symm ▸ Set.mem_univ []
      simp at this

end CslibFrontier.Computability.Complexity
