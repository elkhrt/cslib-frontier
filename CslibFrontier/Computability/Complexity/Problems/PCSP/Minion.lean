/-!
# Algebraic Theory of Fixed-Template Promise CSPs: Minions and Free Structures

This module develops the foundational algebraic objects of fixed-template promise constraint
satisfaction problems (PCSPs) specialized to single-relation `r`-ary templates
: relational templates, homomorphisms, finite powers, polymorphisms,
minions, minion homomorphisms, polymorphism minions, free structures, and the free-structure /
polymorphism-minion adjunction (`freeStructureWithHomEquiv`).

All definitions and theorems are universe-polymorphic and proved under standard Lean axioms.

## Main definitions

* `Cslib.Complexity.PCSP.Template`: an `r`-ary relational structure `(Domain, rel)`.
* `Cslib.Complexity.PCSP.Template.Hom`: homomorphisms between `r`-ary templates.
* `Cslib.Complexity.PCSP.Template.HasHom`: existence of a template homomorphism.
* `Cslib.Complexity.PCSP.Template.power`: the `p`-th categorical power `A^p` of a template.
* `Cslib.Complexity.PCSP.Template.IsPolymorphism`: a `p`-ary polymorphism from `A` to `B`.
* `Cslib.Complexity.PCSP.Minion`: a functor from the skeleton of finite sets to `Type u`.
* `Cslib.Complexity.PCSP.Minion.Hom`: a minion homomorphism (natural transformation).
* `Cslib.Complexity.PCSP.Minion.HasHom`: existence of a minion homomorphism.
* `Cslib.Complexity.PCSP.polMinion`: the polymorphism minion `Pol(A, B)`.
* `Cslib.Complexity.PCSP.freeStructureWith` and `Cslib.Complexity.PCSP.freeStructure`: the free
  structure `F_M(A)` of a minion `M` generated by a finite template `A`.

## Main results

* `Cslib.Complexity.PCSP.isPolymorphism_self_iff_cslib`: agreement between `Template.IsPolymorphism`
  on `(A, A)` and `Cslib.Logic.IsPolymorphism`.
* `Cslib.Complexity.PCSP.freeStructureWithHomEquiv`: the natural bijection between
  template homomorphisms `F_M(A) → B` and minion homomorphisms `M → Pol(A, B)`
.
* `Cslib.Complexity.PCSP.freeStructure_hasHom_iff`: `F_M(A) → B ↔ M → Pol(A, B)`.
-/

public section

namespace Cslib.Complexity.PCSP

universe u v w

/-- An `r`-ary relational structure (template) consisting of a domain type and an `r`-ary
relation. -/
@[ext]
structure Template (r : ℕ) where
  /-- The underlying domain of the structure. -/
  Domain : Type u
  /-- The `r`-ary relation on `Domain`. -/
  rel : Set (Fin r → Domain)

namespace Template

variable {r : ℕ}

/-- A function `h : A.Domain → B.Domain` is a homomorphism when it maps every tuple of `A.rel`
into `B.rel`. -/
@[expose]
def IsHom (A : Template.{u} r) (B : Template.{v} r) (h : A.Domain → B.Domain) : Prop :=
  ∀ ⦃t : Fin r → A.Domain⦄, t ∈ A.rel → (h ∘ t) ∈ B.rel

/-- A bundled homomorphism between `r`-ary templates. -/
@[ext]
structure Hom (A : Template.{u} r) (B : Template.{v} r) where
  /-- The underlying function on domains. -/
  toFun : A.Domain → B.Domain
  /-- Preservation of the `r`-ary relation. -/
  map_rel' : ∀ ⦃t : Fin r → A.Domain⦄, t ∈ A.rel → (toFun ∘ t) ∈ B.rel

instance (A : Template.{u} r) (B : Template.{v} r) : FunLike (A.Hom B) A.Domain B.Domain where
  coe := Hom.toFun
  coe_injective := fun _ _ h => Hom.ext h

@[simp]
theorem Hom.coe_mk {A : Template.{u} r} {B : Template.{v} r} (f : A.Domain → B.Domain)
    (hf : ∀ ⦃t : Fin r → A.Domain⦄, t ∈ A.rel → (f ∘ t) ∈ B.rel) :
    ⇑(Hom.mk f hf) = f :=
  rfl

/-- A homomorphism preserves membership in the template relation. -/
theorem Hom.map_rel {A : Template.{u} r} {B : Template.{v} r} (h : A.Hom B)
    {t : Fin r → A.Domain} (ht : t ∈ A.rel) : (fun i => h (t i)) ∈ B.rel :=
  h.map_rel' ht

/-- The identity homomorphism on a template. -/
@[expose, simps]
def Hom.id (A : Template.{u} r) : A.Hom A where
  toFun := _root_.id
  map_rel' := fun _ ht => ht

/-- Composition of template homomorphisms. -/
@[expose, simps]
def Hom.comp {A : Template.{u} r} {B : Template.{v} r} {C : Template.{w} r}
    (g : B.Hom C) (f : A.Hom B) : A.Hom C where
  toFun := g ∘ f
  map_rel' := fun _ ht => g.map_rel' (f.map_rel' ht)

/-- Existence of a homomorphism from `A` to `B`. -/
@[expose]
def HasHom (A : Template.{u} r) (B : Template.{v} r) : Prop :=
  Nonempty (A.Hom B)

/-- Reflexivity of `HasHom`. -/
@[refl]
theorem HasHom.refl (A : Template.{u} r) : A.HasHom A :=
  ⟨Hom.id A⟩

/-- Transitivity of `HasHom`. -/
@[trans]
theorem HasHom.trans {A : Template.{u} r} {B : Template.{v} r} {C : Template.{w} r}
    (hAB : A.HasHom B) (hBC : B.HasHom C) : A.HasHom C :=
  ⟨hBC.some.comp hAB.some⟩

/-- The `p`-th power `A^p` of an `r`-ary template `A`: its domain is `Fin p → A.Domain`, and a
tuple of `r` vectors belongs to `rel` iff every column belongs to `A.rel`. -/
@[expose]
def power (A : Template.{u} r) (p : ℕ) : Template.{u} r where
  Domain := Fin p → A.Domain
  rel := {M : Fin r → Fin p → A.Domain | ∀ j : Fin p, (fun i => M i j) ∈ A.rel}

/-- Characterization of membership in `(A.power p).rel`. -/
theorem mem_power_rel_iff {A : Template.{u} r} {p : ℕ} {M : Fin r → Fin p → A.Domain} :
    M ∈ (A.power p).rel ↔ ∀ j : Fin p, (fun i => M i j) ∈ A.rel :=
  Iff.rfl

/-- A `p`-ary polymorphism from `A` to `B` is a homomorphism `A^p → B`. -/
@[expose]
def IsPolymorphism (A : Template.{u} r) (B : Template.{v} r) (p : ℕ)
    (f : (Fin p → A.Domain) → B.Domain) : Prop :=
  (A.power p).IsHom B f

/-- On a single template `(A, A)`, `Template.IsPolymorphism` agrees with
`Cslib.Logic.IsPolymorphism`. -/
theorem isPolymorphism_self_iff_cslib {A : Template.{u} r} {p : ℕ}
    {f : (Fin p → A.Domain) → A.Domain} :
    A.IsPolymorphism A p f ↔ Cslib.Logic.IsPolymorphism f A.rel := by
  constructor
  · intro hf a ha
    exact hf (t := fun i j => a j i) ha
  · intro hf M hM
    exact hf (fun j i => M i j) hM

/-- Coordinate projection `x ↦ x j` composed with a homomorphism `h : A → B` is a
polymorphism. -/
@[expose, simps]
def Hom.projPoly {A : Template.{u} r} {B : Template.{v} r} (h : A.Hom B)
    {p : ℕ} (j : Fin p) : (A.power p).Hom B where
  toFun x := h (x j)
  map_rel' _ hM := h.map_rel' (hM j)

end Template

/-- A minion: a sequence of carrier types `carrier p` (`p : ℕ`) equipped with functorial minor
operations along functions `Fin p → Fin q`. -/
structure Minion where
  /-- The `p`-ary elements of the minion. -/
  carrier : ℕ → Type u
  /-- The minor operation along `π : Fin p → Fin q`. -/
  minor : {p q : ℕ} → (Fin p → Fin q) → carrier p → carrier q
  /-- Minoring by the identity is the identity. -/
  minor_id : ∀ {p : ℕ} (f : carrier p), minor id f = f
  /-- Minoring respects function composition. -/
  minor_comp : ∀ {p q t : ℕ} (π : Fin p → Fin q) (σ : Fin q → Fin t) (f : carrier p),
    minor (σ ∘ π) f = minor σ (minor π f)

namespace Minion

/-- A minion homomorphism from `M` to `N`: an arity-preserving map commuting with all minors. -/
@[ext]
structure Hom (M : Minion.{u}) (N : Minion.{v}) where
  /-- The map on `p`-ary elements. -/
  toFun : ∀ p : ℕ, M.carrier p → N.carrier p
  /-- Compatibility with all minor operations. -/
  map_minor : ∀ {p q : ℕ} (π : Fin p → Fin q) (f : M.carrier p),
    toFun q (M.minor π f) = N.minor π (toFun p f)

/-- The identity minion homomorphism. -/
@[expose, simps]
def Hom.id (M : Minion.{u}) : M.Hom M where
  toFun _ f := f
  map_minor _ _ := rfl

/-- Composition of minion homomorphisms. -/
@[expose, simps]
def Hom.comp {M : Minion.{u}} {N : Minion.{v}} {P : Minion.{w}}
    (g : N.Hom P) (f : M.Hom N) : M.Hom P where
  toFun p x := g.toFun p (f.toFun p x)
  map_minor π x := by rw [f.map_minor, g.map_minor]

/-- Existence of a minion homomorphism from `M` to `N`. -/
@[expose]
def HasHom (M : Minion.{u}) (N : Minion.{v}) : Prop :=
  Nonempty (M.Hom N)

/-- Reflexivity of `Minion.HasHom`. -/
@[refl]
theorem HasHom.refl (M : Minion.{u}) : M.HasHom M :=
  ⟨Hom.id M⟩

/-- Transitivity of `Minion.HasHom`. -/
@[trans]
theorem HasHom.trans {M : Minion.{u}} {N : Minion.{v}} {P : Minion.{w}}
    (hMN : M.HasHom N) (hNP : N.HasHom P) : M.HasHom P :=
  ⟨hNP.some.comp hMN.some⟩

end Minion

/-- The polymorphism minion `Pol(A, B)` of a pair of `r`-ary templates `(A, B)`: its `p`-ary
elements are homomorphisms `A^p → B`, and `minor π f` precomposes with `x ↦ x ∘ π`. -/
@[expose]
def polMinion {r : ℕ} (A : Template.{u} r) (B : Template.{v} r) : Minion.{max u v} where
  carrier p := (A.power p).Hom B
  minor π f :=
    { toFun := fun x => f (x ∘ π)
      map_rel' := fun _ hM => f.map_rel' (fun j => hM (π j)) }
  minor_id _ := rfl
  minor_comp _ _ _ := rfl

@[simp]
theorem polMinion_minor_apply {r p q : ℕ} {A : Template.{u} r} {B : Template.{v} r}
    (π : Fin p → Fin q) (f : (polMinion A B).carrier p) (x : Fin q → A.Domain) :
    Template.Hom.toFun ((polMinion A B).minor π f) x = Template.Hom.toFun f (x ∘ π) :=
  rfl

/-- The free structure `F_M(A)` of a minion `M` generated by an `r`-ary template `A`, presented
via explicit enumerations `eA : A.Domain ≃ Fin n` and `eR : A.rel ≃ Fin k`. -/
@[expose]
def freeStructureWith {r n k : ℕ} (M : Minion.{u}) (A : Template.{v} r)
    (eA : A.Domain ≃ Fin n) (eR : A.rel ≃ Fin k) : Template.{u} r where
  Domain := M.carrier n
  rel := {t : Fin r → M.carrier n |
    ∃ f : M.carrier k, ∀ i : Fin r, t i = M.minor (fun j => eA ((eR.symm j).1 i)) f}

/-- The canonical free structure `F_M(A)` for a finite template `A` with finite relation `A.rel`,
using `Fintype.equivFin`. -/
@[expose]
noncomputable def freeStructure {r : ℕ} (M : Minion.{u}) (A : Template.{v} r)
    [Fintype A.Domain] [Fintype A.rel] : Template.{u} r :=
  freeStructureWith M A (Fintype.equivFin A.Domain) (Fintype.equivFin A.rel)

/-- **Free-structure / polymorphism-minion adjunction**
: template homomorphisms `F_M(A) → B` are in 1-to-1 correspondence with minion
homomorphisms `M → Pol(A, B)`.
-/
def freeStructureWithHomEquiv {r n k : ℕ} (M : Minion.{u})
    (A : Template.{v} r) (B : Template.{w} r)
    (eA : A.Domain ≃ Fin n) (eR : A.rel ≃ Fin k) :
    ((freeStructureWith M A eA eR).Hom B) ≃ (M.Hom (polMinion A B)) where
  toFun h :=
    { toFun := fun p f =>
        { toFun := fun x => h (M.minor (eA ∘ x) f)
          map_rel' := fun X hX => by
            let σ : Fin p → Fin k := fun j => eR ⟨fun i => X i j, hX j⟩
            have hmem : (fun i => M.minor (eA ∘ X i) f) ∈ (freeStructureWith M A eA eR).rel := by
              refine ⟨M.minor σ f, fun i => ?_⟩
              dsimp only
              rw [← M.minor_comp]
              congr 1
              funext j
              simp [σ]
              rfl
            exact h.map_rel' hmem }
      map_minor := fun {p q} π f => by
        apply Template.Hom.ext
        funext x
        change h (M.minor (eA ∘ x) (M.minor π f)) = h (M.minor (eA ∘ (x ∘ π)) f)
        rw [← M.minor_comp]
        rfl }
  invFun ξ :=
    { toFun := fun f => Template.Hom.toFun (ξ.toFun n f) ⇑eA.symm
      map_rel' := fun t ht => by
        obtain ⟨f, hf⟩ := ht
        have hcomp : ∀ i : Fin r, Template.Hom.toFun (ξ.toFun n (t i)) ⇑eA.symm =
            Template.Hom.toFun (ξ.toFun k f) (fun j => (eR.symm j).1 i) := by
          intro i
          rw [hf i, ξ.map_minor]
          simp only [polMinion_minor_apply]
          congr 1
          funext j
          simp
        change (fun i => Template.Hom.toFun (ξ.toFun n (t i)) ⇑eA.symm) ∈ B.rel
        simp_rw [hcomp]
        exact (ξ.toFun k f).map_rel' (fun j => (eR.symm j).2) }
  left_inv h := by
    ext f
    change h (M.minor (eA ∘ eA.symm) f) = h f
    have hcomp : (⇑eA ∘ ⇑eA.symm) = id := funext fun x => eA.apply_symm_apply x
    rw [hcomp]
    exact congrArg h (M.minor_id f)
  right_inv ξ := by
    ext p f
    apply Template.Hom.ext
    funext x
    change Template.Hom.toFun (ξ.toFun n (M.minor (eA ∘ x) f)) ⇑eA.symm =
      Template.Hom.toFun (ξ.toFun p f) x
    rw [ξ.map_minor]
    simp only [polMinion_minor_apply]
    congr 1
    funext j
    exact eA.symm_apply_apply (x j)

/-- Existence form of the adjunction for `freeStructureWith`: `F_M(A) → B` iff `M → Pol(A, B)`. -/
theorem freeStructureWith_hasHom_iff {r n k : ℕ} (M : Minion.{u})
    (A : Template.{v} r) (B : Template.{w} r)
    (eA : A.Domain ≃ Fin n) (eR : A.rel ≃ Fin k) :
    (freeStructureWith M A eA eR).HasHom B ↔ M.HasHom (polMinion A B) :=
  ⟨fun ⟨h⟩ => ⟨freeStructureWithHomEquiv M A B eA eR h⟩,
   fun ⟨ξ⟩ => ⟨(freeStructureWithHomEquiv M A B eA eR).symm ξ⟩⟩

/-- Canonical adjunction bijection for `freeStructure`. -/
noncomputable def freeStructureHomEquiv {r : ℕ} (M : Minion.{u})
    (A : Template.{v} r) (B : Template.{w} r) [Fintype A.Domain] [Fintype A.rel] :
    ((freeStructure M A).Hom B) ≃ (M.Hom (polMinion A B)) :=
  freeStructureWithHomEquiv M A B (Fintype.equivFin A.Domain) (Fintype.equivFin A.rel)

/-- Canonical existence adjunction: `F_M(A) → B` iff `M → Pol(A, B)`. -/
theorem freeStructure_hasHom_iff {r : ℕ} (M : Minion.{u})
    (A : Template.{v} r) (B : Template.{w} r) [Fintype A.Domain] [Fintype A.rel] :
    (freeStructure M A).HasHom B ↔ M.HasHom (polMinion A B) :=
  freeStructureWith_hasHom_iff M A B (Fintype.equivFin A.Domain) (Fintype.equivFin A.rel)

end Cslib.Complexity.PCSP
