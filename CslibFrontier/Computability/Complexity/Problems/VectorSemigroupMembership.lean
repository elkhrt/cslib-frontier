/-!
# Integer vector semigroup membership

`VectorSemigroupMembership` is the decision problem of Semigroup Membership in `ℤ^d` (with the
dimension `d` part of the input in unary, and generator/target coordinates encoded in signed
binary `Turing.MultiTapeTM.encIntBin`): given an ambient dimension `dim`, a finite list of
generator vectors `generators : List (List ℤ)`, and a target vector `target : List ℤ`, decide
whether `target` belongs to the subsemigroup of `ℤ^{dim}` generated by `generators` — equivalently,
whether there exists a nonzero nonnegative integer combination `n : Fin generators.length → ℕ`
with `∃ i, 0 < n i` and `∑ i, n i * generators[i][j] = target[j]` for every `j < dim`.

Membership in `NP` is proved by a polynomial-time many-one reduction to general integer inequality
feasibility (`Cslib.Complexity.IntegerProgram.Feasible`), encoding `x_i ≥ 0`, `∑_i x_i ≥ 1`, and
both directions of each coordinate equation. `NP`-hardness is proved by a polynomial-time reduction
from `Cslib.Complexity.SubsetSum` using zero-one slack coordinates in `ℤ^{m + 1}`.

## Main definitions

* `Cslib.Complexity.VectorSemigroupInstance`, `Cslib.Complexity.encVectorSemigroup`,
  `Cslib.Complexity.VectorSemigroupMembership`.
* `Cslib.Complexity.VectorSemigroupMembership.toIntegerProgram`: reduction to
  `IntegerProgram.Feasible`.
* `Cslib.Complexity.SubsetSum.toVectorSemigroup`: reduction from `SubsetSum`.

## Main results

* `Cslib.Complexity.mem_VectorSemigroupMembership_iff_closure`: equivalence with
  `Subsemigroup.closure` inside `Multiplicative (Fin x.dim → ℤ)`.
* `Cslib.Complexity.VectorSemigroupMembership.mem_NP`:
  `VectorSemigroupMembership ∈ NP encVectorSemigroup`.
* `Cslib.Complexity.polyTimeReducible_SubsetSum_VectorSemigroupMembership`,
  `Cslib.Complexity.VectorSemigroupMembership_npHard`,
  `Cslib.Complexity.VectorSemigroupMembership_npComplete`: `VectorSemigroupMembership` is
  `NP`-complete.
-/

public section

namespace Cslib.Complexity

open Finset Turing.MultiTapeTM ComputableInPolyTime
open scoped IntegerProgram

/-- An instance of integer vector semigroup membership in `ℤ^d`: an ambient dimension `dim`
(encoded in unary), a finite list of generator rows `generators` (entries in signed binary, padded
or truncated to `dim`), and a target vector `target`. -/
@[ext]
structure VectorSemigroupInstance where
  /-- Ambient dimension `d` of `ℤ^d`. -/
  dim : ℕ
  /-- Candidate generator vectors in `ℤ^d`. -/
  generators : List (List ℤ)
  /-- Target vector in `ℤ^d`. -/
  target : List ℤ
  deriving DecidableEq, Repr

/-- Framing of `VectorSemigroupInstance`: unary dimension, framed list of signed-binary generator
rows, and framed signed-binary target vector. -/
enc_structure encVectorSemigroup : VectorSemigroupInstance where
  dim : encUnary, generators : (encList (encList encIntBin)), target : (encList encIntBin)

attribute [fun_prop] encVectorSemigroup_dim_polyTime encVectorSemigroup_generators_polyTime
  encVectorSemigroup_target_polyTime encVectorSemigroup_mk_polyTime

/-- Integer vector semigroup membership: some nonzero nonnegative integer combination of
`x.generators` equals `x.target` in every coordinate below `x.dim`. -/
@[expose] def VectorSemigroupMembership : Set VectorSemigroupInstance :=
  {x | ∃ n : Fin x.generators.length → ℕ, (∃ i, 0 < n i) ∧
    ∀ j : Fin x.dim,
      ∑ i : Fin x.generators.length, (n i : ℤ) * (x.generators[i.val]).getD j.val 0 =
        x.target.getD j.val 0}

theorem mem_VectorSemigroupMembership {x : VectorSemigroupInstance} :
    x ∈ VectorSemigroupMembership ↔
      ∃ n : Fin x.generators.length → ℕ, (∃ i, 0 < n i) ∧
        ∀ j : Fin x.dim,
          ∑ i : Fin x.generators.length, (n i : ℤ) * (x.generators[i.val]).getD j.val 0 =
            x.target.getD j.val 0 := by
  rfl

/-- Equivalence between `VectorSemigroupMembership` and canonical `Subsemigroup.closure` membership
in `Multiplicative (Fin x.dim → ℤ)`. -/
theorem mem_VectorSemigroupMembership_iff_closure {x : VectorSemigroupInstance} :
    x ∈ VectorSemigroupMembership ↔
      Multiplicative.ofAdd (fun j : Fin x.dim => x.target.getD j.val 0) ∈
        Subsemigroup.closure
          ({g | g ∈ x.generators.map fun row =>
            Multiplicative.ofAdd (fun j : Fin x.dim => row.getD j.val 0)} :
            Set (Multiplicative (Fin x.dim → ℤ))) := by
  let vec (row : List ℤ) : Fin x.dim → ℤ := fun j => row.getD j.val 0
  let S : Set (Multiplicative (Fin x.dim → ℤ)) :=
    Multiplicative.ofAdd '' ({v | v ∈ x.generators.map vec} : Set (Fin x.dim → ℤ))
  have hset : ({g | g ∈ x.generators.map fun row => Multiplicative.ofAdd (vec row)} :
      Set (Multiplicative (Fin x.dim → ℤ))) = S := by
    ext g
    dsimp only [S]
    simp only [Set.mem_image, List.mem_map]
    constructor
    · rintro ⟨row, hrow, rfl⟩
      exact ⟨vec row, ⟨row, hrow, rfl⟩, rfl⟩
    · rintro ⟨_, ⟨row, hrow, rfl⟩, rfl⟩
      exact ⟨row, hrow, rfl⟩
  rw [hset, mem_VectorSemigroupMembership]
  constructor
  · rintro ⟨n, ⟨i₀, hi₀⟩, hsum⟩
    have hfin : ∀ (k : ℕ) (f : Fin k → ℕ) (gs : Fin k → Fin x.dim → ℤ),
        (∀ a, Multiplicative.ofAdd (gs a) ∈ S) → (∃ a, 0 < f a) →
        Multiplicative.ofAdd (∑ a : Fin k, (f a : ℤ) • gs a) ∈ Subsemigroup.closure S := by
      intro k
      induction k with
      | zero => rintro _ _ _ ⟨a, _⟩; exact Fin.elim0 a
      | succ k ih =>
        intro f gs hmem ⟨a₀, ha₀⟩
        rw [Fin.sum_univ_succ]
        have hhead : f 0 = 0 ∨
            Multiplicative.ofAdd ((f 0 : ℤ) • gs 0) ∈ Subsemigroup.closure S := by
          cases h0 : f 0 with
          | zero => exact Or.inl rfl
          | succ q =>
            right
            have hg0 := hmem 0
            have hp : ∀ r : ℕ,
                Multiplicative.ofAdd (((r + 1 : ℕ) : ℤ) • gs 0) ∈ Subsemigroup.closure S := by
              intro r
              induction r with
              | zero => simpa using Subsemigroup.subset_closure hg0
              | succ r ihr =>
                have hstep : ((r + 1 + 1 : ℕ) : ℤ) • gs 0 =
                    ((r + 1 : ℕ) : ℤ) • gs 0 + gs 0 := by
                  ext j; simp [Pi.add_apply, Pi.smul_apply]; ring
                rw [hstep, ofAdd_add]
                exact Subsemigroup.mul_mem _ ihr (Subsemigroup.subset_closure hg0)
            simpa [h0] using hp q
        by_cases htail : ∃ a : Fin k, 0 < f a.succ
        · rcases hhead with hf0 | hh
          · simpa [hf0] using ih (fun a => f a.succ) (fun a => gs a.succ)
              (fun a => hmem a.succ) htail
          · rw [ofAdd_add]
            exact Subsemigroup.mul_mem _ hh
              (ih (fun a => f a.succ) (fun a => gs a.succ) (fun a => hmem a.succ) htail)
        · push Not at htail
          have htail0 : ∑ a : Fin k, (f a.succ : ℤ) • gs a.succ = 0 :=
            Finset.sum_eq_zero fun a _ => by simp [Nat.le_zero.mp (htail a)]
          rcases hhead with hf0 | hh
          · cases a₀ using Fin.cases with
            | zero => omega
            | succ a₁ => exact absurd ha₀ (not_lt.mpr (htail a₁))
          · rwa [htail0, add_zero]
    have ht : (fun j : Fin x.dim => x.target.getD j.val 0) =
        ∑ i : Fin x.generators.length, (n i : ℤ) • vec x.generators[i.val] := by
      ext j
      rw [Finset.sum_apply, ← hsum j]
      refine Finset.sum_congr rfl fun i _ => ?_
      dsimp only [vec, Pi.smul_apply]
      rw [zsmul_eq_mul, Int.cast_id]
    rw [ht]
    exact hfin x.generators.length n (fun i => vec x.generators[i.val])
      (fun i => ⟨vec x.generators[i.val], List.mem_map.mpr ⟨x.generators[i.val],
        List.getElem_mem i.isLt, rfl⟩, rfl⟩) ⟨i₀, hi₀⟩
  · intro hcl
    have hall : ∀ z ∈ Subsemigroup.closure S,
        ∃ n : Fin x.generators.length → ℕ, (∃ i, 0 < n i) ∧
          ∀ j : Fin x.dim,
            ∑ i : Fin x.generators.length, (n i : ℤ) * (x.generators[i.val]).getD j.val 0 =
              Multiplicative.toAdd z j := by
      intro z hz
      induction hz using Subsemigroup.closure_induction with
      | mem g hg =>
        rcases hg with ⟨v, hv, rfl⟩
        rcases List.mem_map.mp hv with ⟨row, hrow, rfl⟩
        obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hrow
        let idx : Fin x.generators.length := ⟨i, hi⟩
        refine ⟨fun a => if a = idx then 1 else 0, ⟨idx, by simp⟩, fun j => ?_⟩
        calc ∑ a : Fin x.generators.length,
                ((if a = idx then 1 else 0 : ℕ) : ℤ) * (x.generators[a.val]).getD j.val 0
            = ∑ a : Fin x.generators.length,
                if a = idx then (x.generators[a.val]).getD j.val 0 else 0 := by
              refine Finset.sum_congr rfl fun a _ => by split_ifs <;> simp
          _ = (x.generators[idx.val]).getD j.val 0 := by simp [Finset.sum_ite_eq']
      | mul u v _ _ ihu ihv =>
        obtain ⟨nu, ⟨iu, hiu⟩, hu⟩ := ihu
        obtain ⟨nv, _, hv⟩ := ihv
        refine ⟨fun a => nu a + nv a,
          ⟨iu, Nat.lt_of_lt_of_le hiu (Nat.le_add_right _ _)⟩, fun j => ?_⟩
        simp only [Nat.cast_add, add_mul, Finset.sum_add_distrib, hu j, hv j, toAdd_mul,
          Pi.add_apply]
    exact hall _ hcl

namespace VectorSemigroupMembership

/-- Polynomial-time reduction from `VectorSemigroupMembership` to `IntegerProgram.Feasible`. -/
@[expose] def toIntegerProgram (x : VectorSemigroupInstance) : IntegerProgram where
  numVars := x.generators.length
  constraints :=
    ((List.range x.generators.length).map fun i =>
        IntegerProgram.Inequality.mk (List.replicate i (0 : ℤ) ++ [-1]) 0) ++
      [IntegerProgram.Inequality.mk (List.replicate x.generators.length (-1 : ℤ)) (-1)] ++
      ((List.range x.dim).map fun j =>
        IntegerProgram.Inequality.mk (x.generators.map fun row => row.getD j 0)
          (x.target.getD j 0)) ++
      ((List.range x.dim).map fun j =>
        IntegerProgram.Inequality.mk (x.generators.map fun row => -(row.getD j 0))
          (-(x.target.getD j 0)))

private lemma getD_replicate_zero_snoc (i k : ℕ) (c : ℤ) :
    (List.replicate i (0 : ℤ) ++ [c]).getD k 0 = if k = i then c else 0 := by
  rcases lt_trichotomy k i with hlt | rfl | hgt
  · rw [List.getD_append _ _ _ _ (by simp [hlt]), List.getD_eq_getElem _ _ (by simp [hlt]),
      List.getElem_replicate]
    simp [hlt.ne]
  · rw [List.getD_append_right _ _ _ _ (by simp)]
    simp
  · rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by simp; omega)]
    simp [hgt.ne']

/-- Correctness of `toIntegerProgram`. -/
theorem toIntegerProgram_mem_iff {x : VectorSemigroupInstance} :
    x ∈ VectorSemigroupMembership ↔ toIntegerProgram x ∈ IntegerProgram.Feasible := by
  constructor
  · rintro ⟨n, ⟨i₀, hi₀⟩, hsum⟩
    refine ⟨fun i => (n i : ℤ), fun c hc => ?_⟩
    simp only [toIntegerProgram, List.mem_append, List.mem_map, List.mem_range,
      List.mem_singleton] at hc
    rcases hc with ((⟨i, hi, rfl⟩ | rfl) | ⟨j, hj, rfl⟩) | ⟨j, hj, rfl⟩
    · have hsingle : (∑ a : Fin x.generators.length,
          (List.replicate i (0 : ℤ) ++ [-1]).getD a.val 0 * (n a : ℤ)) = -(n ⟨i, hi⟩ : ℤ) := by
        simp_rw [getD_replicate_zero_snoc]
        calc ∑ a : Fin x.generators.length, (if a.val = i then (-1 : ℤ) else 0) * (n a : ℤ)
            = ∑ a : Fin x.generators.length, if a = ⟨i, hi⟩ then -(n a : ℤ) else 0 := by
              refine Finset.sum_congr rfl fun a _ => ?_
              by_cases ha : a = ⟨i, hi⟩
              · subst ha; simp
              · have hne : a.val ≠ i := fun h => ha (Fin.ext h)
                simp [ha, hne]
          _ = -(n ⟨i, hi⟩ : ℤ) := by simp [Finset.sum_ite_eq']
      change (∑ a : Fin x.generators.length,
        (List.replicate i (0 : ℤ) ++ [-1]).getD a.val 0 * (n a : ℤ)) ≤ 0
      rw [hsingle]; omega
    · change (∑ a : Fin x.generators.length,
          (List.replicate x.generators.length (-1 : ℤ)).getD a.val 0 * (n a : ℤ)) ≤ -1
      have hrep : ∀ a : Fin x.generators.length,
          (List.replicate x.generators.length (-1 : ℤ)).getD a.val 0 = -1 := fun a => by
        rw [List.getD_eq_getElem _ _ (by simp), List.getElem_replicate]
      simp_rw [hrep, neg_one_mul, Finset.sum_neg_distrib]
      have hle : (n i₀ : ℤ) ≤ ∑ a : Fin x.generators.length, (n a : ℤ) :=
        Finset.single_le_sum (fun a _ => Nat.cast_nonneg (n a)) (Finset.mem_univ i₀)
      omega
    · change (∑ a : Fin x.generators.length,
          (x.generators.map fun row => row.getD j 0).getD a.val 0 * (n a : ℤ)) ≤
        x.target.getD j 0
      have hrow : ∀ a : Fin x.generators.length,
          (x.generators.map fun row => row.getD j 0).getD a.val 0 =
            (x.generators[a.val]).getD j 0 := fun a => by
        rw [List.getD_map_of_lt _ _ [] 0 a.isLt, List.getD_eq_getElem _ _ a.isLt]
      simp_rw [hrow, mul_comm _ (n _ : ℤ)]
      exact (hsum ⟨j, hj⟩).le
    · change (∑ a : Fin x.generators.length,
          (x.generators.map fun row => -(row.getD j 0)).getD a.val 0 * (n a : ℤ)) ≤
        -(x.target.getD j 0)
      have hrow : ∀ a : Fin x.generators.length,
          (x.generators.map fun row => -(row.getD j 0)).getD a.val 0 =
            -((x.generators[a.val]).getD j 0) := fun a => by
        rw [List.getD_map_of_lt _ _ [] 0 a.isLt, List.getD_eq_getElem _ _ a.isLt]
      simp_rw [hrow, neg_mul, Finset.sum_neg_distrib, mul_comm _ (n _ : ℤ), hsum ⟨j, hj⟩]
      exact le_rfl
  · rintro ⟨z, hz⟩
    dsimp only [toIntegerProgram] at z hz
    have hnonneg : ∀ a : Fin x.generators.length, 0 ≤ z a := fun a => by
      have hc := hz (IntegerProgram.Inequality.mk (List.replicate a.val (0 : ℤ) ++ [-1]) 0) <| by
        simp only [List.mem_append, List.mem_map, List.mem_range]
        exact Or.inl (Or.inl (Or.inl ⟨a.val, a.isLt, rfl⟩))
      change (∑ b : Fin x.generators.length,
          (List.replicate a.val (0 : ℤ) ++ [-1]).getD b.val 0 * z b) ≤ 0 at hc
      simp_rw [getD_replicate_zero_snoc] at hc
      have hsingle : (∑ b : Fin x.generators.length,
          (if b.val = a.val then (-1 : ℤ) else 0) * z b) = -z a := by
        calc ∑ b : Fin x.generators.length, (if b.val = a.val then (-1 : ℤ) else 0) * z b
            = ∑ b : Fin x.generators.length, if b = a then -z b else 0 := by
              refine Finset.sum_congr rfl fun b _ => ?_
              by_cases hb : b = a
              · subst hb; simp
              · have hne : b.val ≠ a.val := fun h => hb (Fin.ext h)
                simp [hb, hne]
          _ = -z a := by simp [Finset.sum_ite_eq']
      linarith
    have hpos_sum : 1 ≤ ∑ a : Fin x.generators.length, z a := by
      have hc := hz (IntegerProgram.Inequality.mk
          (List.replicate x.generators.length (-1 : ℤ)) (-1)) <| by
        simp
      change (∑ a : Fin x.generators.length,
          (List.replicate x.generators.length (-1 : ℤ)).getD a.val 0 * z a) ≤ -1 at hc
      have hrep : ∀ a : Fin x.generators.length,
          (List.replicate x.generators.length (-1 : ℤ)).getD a.val 0 = -1 := fun a => by
        rw [List.getD_eq_getElem _ _ (by simp), List.getElem_replicate]
      simp_rw [hrep, neg_one_mul, Finset.sum_neg_distrib] at hc
      linarith
    have hex_pos : ∃ a : Fin x.generators.length, 0 < (z a).toNat := by
      by_contra hnone
      push Not at hnone
      have hall0 : ∀ a : Fin x.generators.length, z a = 0 := fun a => by
        have h0 : (z a).toNat = 0 := Nat.le_zero.mp (hnone a)
        have hz_eq := Int.toNat_of_nonneg (hnonneg a)
        omega
      simp [hall0] at hpos_sum
    refine ⟨fun a => (z a).toNat, hex_pos, fun j => ?_⟩
    have hcast : ∀ a : Fin x.generators.length, ((z a).toNat : ℤ) = z a :=
      fun a => Int.toNat_of_nonneg (hnonneg a)
    simp_rw [hcast]
    have hup := hz (IntegerProgram.Inequality.mk
        (x.generators.map fun row => row.getD j.val 0) (x.target.getD j.val 0)) <| by
      simp only [List.mem_append, List.mem_map, List.mem_range]
      exact Or.inl (Or.inr ⟨j.val, j.isLt, rfl⟩)
    have hlo := hz (IntegerProgram.Inequality.mk
        (x.generators.map fun row => -(row.getD j.val 0)) (-(x.target.getD j.val 0))) <| by
      simp only [List.mem_append, List.mem_map, List.mem_range]
      exact Or.inr ⟨j.val, j.isLt, rfl⟩
    change (∑ a : Fin x.generators.length,
        (x.generators.map fun row => row.getD j.val 0).getD a.val 0 * z a) ≤
      x.target.getD j.val 0 at hup
    change (∑ a : Fin x.generators.length,
        (x.generators.map fun row => -(row.getD j.val 0)).getD a.val 0 * z a) ≤
      -(x.target.getD j.val 0) at hlo
    have hrow1 : ∀ a : Fin x.generators.length,
        (x.generators.map fun row => row.getD j.val 0).getD a.val 0 =
          (x.generators[a.val]).getD j.val 0 := fun a => by
      rw [List.getD_map_of_lt _ _ [] 0 a.isLt, List.getD_eq_getElem _ _ a.isLt]
    have hrow2 : ∀ a : Fin x.generators.length,
        (x.generators.map fun row => -(row.getD j.val 0)).getD a.val 0 =
          -((x.generators[a.val]).getD j.val 0) := fun a => by
      rw [List.getD_map_of_lt _ _ [] 0 a.isLt, List.getD_eq_getElem _ _ a.isLt]
    simp_rw [hrow1, mul_comm _ (z _)] at hup
    simp_rw [hrow2, neg_mul, Finset.sum_neg_distrib, mul_comm _ (z _)] at hlo
    linarith

/-- `toIntegerProgram` runs in polynomial time. -/
@[fun_prop]
theorem computableInPolyTime_toIntegerProgram :
    ComputableInPolyTime toIntegerProgram encVectorSemigroup IntegerProgram.enc := by
  unfold toIntegerProgram
  fun_prop

/-- `VectorSemigroupMembership` reduces in polynomial time to `IntegerProgram.Feasible`. -/
theorem polyTimeReducible_IntegerProgram :
    PolyTimeReducible encVectorSemigroup IntegerProgram.enc
      VectorSemigroupMembership IntegerProgram.Feasible :=
  ⟨toIntegerProgram, computableInPolyTime_toIntegerProgram, fun _ => toIntegerProgram_mem_iff⟩

/-- `VectorSemigroupMembership` belongs to `NP`. -/
theorem mem_NP : VectorSemigroupMembership ∈ NP encVectorSemigroup :=
  polyTimeReducible_IntegerProgram.mem_NP IntegerProgram.mem_NP

end VectorSemigroupMembership

namespace SubsetSum

/-- Polynomial-time reduction from `SubsetSum` to `VectorSemigroupMembership` using zero-one slack
coordinates in `ℤ^{m + 1}`. -/
@[expose] def toVectorSemigroup (s : SubsetSumInstance) : VectorSemigroupInstance :=
  if decide ((s.target : ℤ) = 0) then
    ⟨1, [[0]], [0]⟩
  else if s.numbers.isEmpty then
    ⟨1, [], [1]⟩
  else
    ⟨s.numbers.length + 1,
      (List.range s.numbers.length).flatMap (fun i =>
        [((s.numbers.getD i 0 : ℕ) : ℤ) :: (List.replicate i (0 : ℤ) ++ [1]),
          (0 : ℤ) :: (List.replicate i (0 : ℤ) ++ [1])]),
      (s.target : ℤ) :: List.replicate s.numbers.length (1 : ℤ)⟩

private lemma sublist_iff_exists_mask_sum :
    ∀ (l : List ℕ) (t : ℕ),
      (∃ sub, List.Sublist sub l ∧ sub.sum = t) ↔
        ∃ b : Fin l.length → Bool, (∑ k : Fin l.length, if b k then l[k.val] else 0) = t
  | [], t => by
    simp only [List.sublist_nil, exists_eq_left, List.sum_nil]
    exact ⟨fun h => ⟨Fin.elim0, by simpa using h⟩, fun ⟨_, h⟩ => by simpa using h⟩
  | a :: l, t => by
    dsimp only [List.length_cons]
    constructor
    · rintro ⟨sub, hsub, rfl⟩
      cases hsub with
      | cons _ htl =>
        obtain ⟨b, hb⟩ := (sublist_iff_exists_mask_sum l sub.sum).mp ⟨sub, htl, rfl⟩
        refine ⟨Fin.cons false b, ?_⟩
        rw [Fin.sum_univ_succ]
        simpa using hb
      | cons_cons _ htl =>
        rename_i sub'
        obtain ⟨b, hb⟩ := (sublist_iff_exists_mask_sum l sub'.sum).mp ⟨sub', htl, rfl⟩
        refine ⟨Fin.cons true b, ?_⟩
        rw [Fin.sum_univ_succ]
        simpa [List.sum_cons] using congrArg (a + ·) hb
    · rintro ⟨b, hb⟩
      rw [Fin.sum_univ_succ] at hb
      cases h0 : b 0 with
      | false =>
        simp only [h0, Bool.false_eq_true, ↓reduceIte, zero_add] at hb
        obtain ⟨sub, hsub, hsum⟩ := (sublist_iff_exists_mask_sum l t).mpr ⟨fun k => b k.succ, hb⟩
        exact ⟨sub, List.Sublist.cons a hsub, hsum⟩
      | true =>
        simp only [h0, ↓reduceIte, Fin.val_zero, List.getElem_cons_zero] at hb
        obtain ⟨sub, hsub, hsum⟩ := (sublist_iff_exists_mask_sum l
          (∑ k : Fin l.length, if b k.succ then (a :: l)[k.succ.val] else 0)).mpr
          ⟨fun k => b k.succ, rfl⟩
        exact ⟨a :: sub, List.Sublist.cons_cons a hsub, by rw [List.sum_cons, hsum, hb]⟩

private lemma pair_flatMap_length {α β : Type*} (l : List α) (f g : α → β) :
    (l.flatMap fun x => [f x, g x]).length = 2 * l.length := by
  induction l with
  | nil => simp
  | cons a tl ih => simp [List.flatMap_cons, ih]; omega

private lemma pair_flatMap_getElem {α β : Type*} (l : List α) (f g : α → β)
    (idx : ℕ) (hidx : idx < 2 * l.length) :
    (l.flatMap fun x => [f x, g x])[idx]'(by rw [pair_flatMap_length]; exact hidx) =
      if idx % 2 = 0 then f (l[idx / 2]'(by omega)) else g (l[idx / 2]'(by omega)) := by
  induction l generalizing idx with
  | nil => simp at hidx
  | cons a tl ih =>
    rcases idx with _ | _ | idx'
    · simp [List.flatMap_cons]
    · simp [List.flatMap_cons]
    · have hlt : idx' < 2 * tl.length := by simp at hidx; omega
      have hstep := ih idx' hlt
      have hmod : (idx' + 2) % 2 = idx' % 2 := Nat.add_mod_right idx' 2
      have hdiv : (idx' + 2) / 2 = idx' / 2 + 1 := Nat.add_div_right idx' (by decide)
      simp only [List.flatMap_cons, List.cons_append, List.nil_append,
        List.getElem_cons_succ, hstep, hmod, hdiv]

private lemma sum_fin_two_mul {M : Type*} [AddCommMonoid M] :
    ∀ (m : ℕ) (f : Fin (2 * m) → M),
      (∑ idx : Fin (2 * m), f idx) =
        ∑ k : Fin m, (f ⟨2 * k.val, by omega⟩ + f ⟨2 * k.val + 1, by omega⟩)
  | 0, f => by simp
  | m + 1, f => by
    have heq : 2 * (m + 1) = 2 * m + 2 := by ring
    let f' : Fin (2 * m + 2) → M := fun i => f ⟨i.val, by omega⟩
    have h1 : (∑ idx : Fin (2 * (m + 1)), f idx) = ∑ i : Fin (2 * m + 2), f' i :=
      Finset.sum_equiv (finCongr heq) (fun _ => by simp) (fun _ _ => rfl)
    rw [h1, Fin.sum_univ_castSucc, Fin.sum_univ_castSucc, add_assoc]
    have ih := sum_fin_two_mul m (fun idx => f ⟨idx.val, by omega⟩)
    have hhead : (∑ i : Fin (2 * m), f' i.castSucc.castSucc) =
        ∑ k : Fin m, (f ⟨2 * k.val, by omega⟩ + f ⟨2 * k.val + 1, by omega⟩) := ih
    rw [hhead, Fin.sum_univ_castSucc]
    dsimp only [f', Fin.val_castSucc, Fin.val_last]

/-- Correctness of `SubsetSum.toVectorSemigroup`. -/
theorem toVectorSemigroup_mem_iff {s : SubsetSumInstance} :
    s ∈ SubsetSum ↔ toVectorSemigroup s ∈ VectorSemigroupMembership := by
  rw [mem_SubsetSum_iff_sublist]
  by_cases ht0 : s.target = 0
  · simp only [toVectorSemigroup, ht0, Nat.cast_zero, decide_true, ↓reduceIte]
    constructor
    · intro _
      exact ⟨fun _ => 1, ⟨⟨0, by decide⟩, by decide⟩, fun j => by fin_cases j; simp⟩
    · intro _
      exact ⟨[], List.nil_sublist _, rfl⟩
  · have hcond : decide ((s.target : ℤ) = 0) = false := by simp [ht0]
    by_cases hemp : s.numbers.isEmpty = true
    · have hnil : s.numbers = [] := List.isEmpty_iff.mp hemp
      simp only [toVectorSemigroup, hcond, hemp, Bool.false_eq_true, ↓reduceIte]
      constructor
      · rintro ⟨sub, hsub, hsum⟩
        rw [hnil, List.sublist_nil] at hsub
        subst hsub; exact absurd hsum.symm ht0
      · rintro ⟨_, ⟨i, _⟩, _⟩
        exact Fin.elim0 i
    · simp only [Bool.not_eq_true] at hemp
      have hne : s.numbers ≠ [] := fun h => by simp [h] at hemp
      have hm_pos : 0 < s.numbers.length := List.length_pos_iff.mpr hne
      simp only [toVectorSemigroup, hcond, hemp, Bool.false_eq_true, ↓reduceIte,
        VectorSemigroupMembership, Set.mem_ofPred]
      rw [sublist_iff_exists_mask_sum]
      set m := s.numbers.length
      set gens := (List.range m).flatMap fun i =>
        [((s.numbers.getD i 0 : ℕ) : ℤ) :: (List.replicate i (0 : ℤ) ++ [1]),
          (0 : ℤ) :: (List.replicate i (0 : ℤ) ++ [1])]
      have hgens_len : gens.length = 2 * m := by
        dsimp only [gens]
        rw [pair_flatMap_length, List.length_range]
      have hgens_get (idx : ℕ) (hidx : idx < 2 * m) :
          gens[idx]'(by omega) =
            if idx % 2 = 0 then
              ((s.numbers.getD (idx / 2) 0 : ℕ) : ℤ) ::
                (List.replicate (idx / 2) (0 : ℤ) ++ [1])
            else
              (0 : ℤ) :: (List.replicate (idx / 2) (0 : ℤ) ++ [1]) := by
        dsimp only [gens]
        have h := pair_flatMap_getElem (List.range m)
          (fun i => ((s.numbers.getD i 0 : ℕ) : ℤ) :: (List.replicate i (0 : ℤ) ++ [1]))
          (fun i => (0 : ℤ) :: (List.replicate i (0 : ℤ) ++ [1]))
          idx (by rw [List.length_range]; exact hidx)
        simpa [List.getElem_range] using h
      constructor
      · rintro ⟨b, hb⟩
        let n0 : Fin (2 * m) → ℕ := fun idx =>
          if idx.val % 2 = 0 then
            if b ⟨idx.val / 2, by omega⟩ then 1 else 0
          else
            if b ⟨idx.val / 2, by omega⟩ then 0 else 1
        let n : Fin gens.length → ℕ := fun idx => n0 ⟨idx.val, by omega⟩
        have hex : ∃ idx : Fin gens.length, 0 < n idx := by
          by_cases hb0 : b ⟨0, hm_pos⟩
          · refine ⟨⟨0, by omega⟩, ?_⟩
            dsimp only [n, n0]; simp [hb0]
          · refine ⟨⟨1, by omega⟩, ?_⟩
            dsimp only [n, n0]; simp [hb0]
        refine ⟨n, hex, fun j => ?_⟩
        have hsum_eq : (∑ i : Fin gens.length, (n i : ℤ) * (gens[i.val]).getD j.val 0) =
            ∑ idx : Fin (2 * m),
              (n0 idx : ℤ) * (gens[idx.val]'(by omega)).getD j.val 0 :=
          Finset.sum_equiv (finCongr hgens_len) (fun _ => by simp)
            (fun i _ => by
              simp only [List.getD_eq_getElem?_getD, finCongr_apply, Fin.val_cast,
                mul_eq_mul_right_iff, Nat.cast_inj]
              exact Or.inl rfl)
        rw [hsum_eq, sum_fin_two_mul]
        cases j using Fin.cases with
        | zero =>
          simp only [Fin.val_zero, List.getD_cons_zero]
          have hpair : (∑ k : Fin m,
              ((n0 ⟨2 * k.val, by omega⟩ : ℤ) *
                  (gens[2 * k.val]'(by omega)).getD 0 0 +
                (n0 ⟨2 * k.val + 1, by omega⟩ : ℤ) *
                  (gens[2 * k.val + 1]'(by omega)).getD 0 0)) =
              ∑ k : Fin m, if b k then (s.numbers[k.val] : ℤ) else 0 := by
            refine Finset.sum_congr rfl fun k _ => ?_
            have hg0 := hgens_get (2 * k.val) (by omega)
            have hg1 := hgens_get (2 * k.val + 1) (by omega)
            have hm0 : (2 * k.val) % 2 = 0 := by omega
            have hd0 : (2 * k.val) / 2 = k.val := by omega
            have hm1 : (2 * k.val + 1) % 2 = 1 := by omega
            simp only [hg0, hg1, hm0, hd0, hm1, one_ne_zero, ↓reduceIte, List.getD_cons_zero,
              mul_zero, add_zero, n0]
            rw [List.getD_eq_getElem _ _ k.isLt]
            cases b k <;> simp
          rw [hpair]
          have hbZ : (∑ k : Fin m, if b k then (s.numbers[k.val] : ℤ) else 0) = (s.target : ℤ) := by
            have := congrArg (Nat.cast (R := ℤ)) hb
            simpa [Nat.cast_sum] using this
          exact hbZ
        | succ k =>
          have hrep1 : ((s.target : ℤ) :: List.replicate s.numbers.length (1 : ℤ)).getD
              k.succ.val 0 = 1 := by
            rw [Fin.val_succ, List.getD_cons_succ,
              List.getD_eq_getElem _ _ (by simp [k.isLt]), List.getElem_replicate]
          rw [hrep1]
          calc ∑ r : Fin m,
                  ((n0 ⟨2 * r.val, by omega⟩ : ℤ) *
                      (gens[2 * r.val]'(by omega)).getD (k.val + 1) 0 +
                    (n0 ⟨2 * r.val + 1, by omega⟩ : ℤ) *
                      (gens[2 * r.val + 1]'(by omega)).getD (k.val + 1) 0)
              = ∑ r : Fin m, if r = k then (1 : ℤ) else 0 := by
                refine Finset.sum_congr rfl fun r _ => ?_
                have hg0 := hgens_get (2 * r.val) (by omega)
                have hg1 := hgens_get (2 * r.val + 1) (by omega)
                have hm0 : (2 * r.val) % 2 = 0 := by omega
                have hd0 : (2 * r.val) / 2 = r.val := by omega
                have hm1 : (2 * r.val + 1) % 2 = 1 := by omega
                have hd1 : (2 * r.val + 1) / 2 = r.val := by omega
                simp only [hg0, hg1, hm0, hd0, hm1, hd1, one_ne_zero, ↓reduceIte,
                  List.getD_cons_succ, VectorSemigroupMembership.getD_replicate_zero_snoc, n0]
                by_cases hrk : r = k
                · subst hrk; cases b r <;> simp
                · have hne_val : k.val ≠ r.val := fun h => hrk (Fin.ext h.symm)
                  simp [hrk, hne_val]
            _ = 1 := by simp [Finset.sum_ite_eq']
      · rintro ⟨n, _, hsum⟩
        let n0 : Fin (2 * m) → ℕ := fun idx => n ⟨idx.val, by omega⟩
        have hsum0 : ∀ j : Fin (s.numbers.length + 1),
            (∑ k : Fin m,
              ((n0 ⟨2 * k.val, by omega⟩ : ℤ) *
                  (gens[2 * k.val]'(by omega)).getD j.val 0 +
                (n0 ⟨2 * k.val + 1, by omega⟩ : ℤ) *
                  (gens[2 * k.val + 1]'(by omega)).getD j.val 0)) =
              ((s.target : ℤ) :: List.replicate s.numbers.length (1 : ℤ)).getD j.val 0 :=
          fun j => by
            rw [← sum_fin_two_mul m
              (fun idx => (n0 idx : ℤ) * (gens[idx.val]'(by omega)).getD j.val 0),
              ← hsum j]
            exact Finset.sum_equiv (finCongr hgens_len.symm) (fun _ => by simp)
              (fun idx _ => by
                simp only [List.getD_eq_getElem?_getD, finCongr_apply, Fin.val_cast,
                  mul_eq_mul_right_iff, Nat.cast_inj]
                exact Or.inl rfl)
        have hunit : ∀ k : Fin m,
            n0 ⟨2 * k.val, by omega⟩ + n0 ⟨2 * k.val + 1, by omega⟩ = 1 := fun k => by
          have hk := hsum0 k.succ
          rw [Fin.val_succ, List.getD_cons_succ,
            List.getD_eq_getElem _ _ (by simp only [List.length_replicate]; exact k.isLt),
            List.getElem_replicate] at hk
          have hlhs : (∑ r : Fin m,
              ((n0 ⟨2 * r.val, by omega⟩ : ℤ) *
                  (gens[2 * r.val]'(by omega)).getD (k.val + 1) 0 +
                (n0 ⟨2 * r.val + 1, by omega⟩ : ℤ) *
                  (gens[2 * r.val + 1]'(by omega)).getD (k.val + 1) 0)) =
              (n0 ⟨2 * k.val, by omega⟩ : ℤ) + (n0 ⟨2 * k.val + 1, by omega⟩ : ℤ) := by
            calc _
                = ∑ r : Fin m,
                    if r = k then
                      (n0 ⟨2 * r.val, by omega⟩ : ℤ) + (n0 ⟨2 * r.val + 1, by omega⟩ : ℤ)
                    else 0 := by
                  refine Finset.sum_congr rfl fun r _ => ?_
                  have hg0 := hgens_get (2 * r.val) (by omega)
                  have hg1 := hgens_get (2 * r.val + 1) (by omega)
                  have hm0 : (2 * r.val) % 2 = 0 := by omega
                  have hd0 : (2 * r.val) / 2 = r.val := by omega
                  have hm1 : (2 * r.val + 1) % 2 = 1 := by omega
                  have hd1 : (2 * r.val + 1) / 2 = r.val := by omega
                  simp only [hg0, hg1, hm0, hd0, hm1, hd1, one_ne_zero, ↓reduceIte,
                    List.getD_cons_succ, VectorSemigroupMembership.getD_replicate_zero_snoc]
                  by_cases hrk : r = k
                  · subst hrk; simp
                  · have hne_val : k.val ≠ r.val := fun h => hrk (Fin.ext h.symm)
                    simp [hrk, hne_val]
              _ = (n0 ⟨2 * k.val, by omega⟩ : ℤ) + (n0 ⟨2 * k.val + 1, by omega⟩ : ℤ) := by
                simp [Finset.sum_ite_eq']
          rw [hlhs] at hk
          omega
        refine ⟨fun k => decide (n0 ⟨2 * k.val, by omega⟩ = 1), ?_⟩
        have h0 := hsum0 0
        simp only [Fin.val_zero, List.getD_cons_zero] at h0
        have hlhs0 : (∑ k : Fin m,
            ((n0 ⟨2 * k.val, by omega⟩ : ℤ) *
                (gens[2 * k.val]'(by omega)).getD 0 0 +
              (n0 ⟨2 * k.val + 1, by omega⟩ : ℤ) *
                (gens[2 * k.val + 1]'(by omega)).getD 0 0)) =
            ∑ k : Fin m,
              (if decide (n0 ⟨2 * k.val, by omega⟩ = 1) then (s.numbers[k.val] : ℤ) else 0) := by
          refine Finset.sum_congr rfl fun k _ => ?_
          have hg0 := hgens_get (2 * k.val) (by omega)
          have hg1 := hgens_get (2 * k.val + 1) (by omega)
          have hm0 : (2 * k.val) % 2 = 0 := by omega
          have hd0 : (2 * k.val) / 2 = k.val := by omega
          have hm1 : (2 * k.val + 1) % 2 = 1 := by omega
          simp only [hg0, hg1, hm0, hd0, hm1, one_ne_zero, ↓reduceIte, List.getD_cons_zero,
            mul_zero, add_zero]
          rw [List.getD_eq_getElem _ _ k.isLt]
          have huk := hunit k
          have h01 : n0 ⟨2 * k.val, by omega⟩ = 0 ∨ n0 ⟨2 * k.val, by omega⟩ = 1 := by omega
          rcases h01 with hz | ho
          · simp [hz]
          · simp [ho]
        rw [hlhs0] at h0
        have h0N : ((∑ k : Fin m,
            if decide (n0 ⟨2 * k.val, by omega⟩ = 1) then s.numbers[k.val] else 0 : ℕ) : ℤ) =
            (s.target : ℤ) := by
          simpa [Nat.cast_sum] using h0
        exact Int.ofNat.inj h0N

/-- `SubsetSum.toVectorSemigroup` runs in polynomial time. -/
@[fun_prop]
theorem computableInPolyTime_toVectorSemigroup :
    ComputableInPolyTime toVectorSemigroup encSubsetSum encVectorSemigroup := by
  unfold toVectorSemigroup
  fun_prop

end SubsetSum

/-- `SubsetSum` reduces in polynomial time to `VectorSemigroupMembership`. -/
theorem polyTimeReducible_SubsetSum_VectorSemigroupMembership :
    PolyTimeReducible encSubsetSum encVectorSemigroup SubsetSum VectorSemigroupMembership :=
  ⟨SubsetSum.toVectorSemigroup, SubsetSum.computableInPolyTime_toVectorSemigroup,
    fun _ => SubsetSum.toVectorSemigroup_mem_iff⟩

/-- `VectorSemigroupMembership` is `NP`-hard. -/
theorem VectorSemigroupMembership_npHard :
    NPHard encVectorSemigroup VectorSemigroupMembership :=
  SubsetSum_npHard.trans polyTimeReducible_SubsetSum_VectorSemigroupMembership

/-- `VectorSemigroupMembership` is `NP`-complete. -/
theorem VectorSemigroupMembership_npComplete :
    NPComplete encVectorSemigroup VectorSemigroupMembership :=
  ⟨VectorSemigroupMembership.mem_NP, VectorSemigroupMembership_npHard⟩

end Cslib.Complexity
