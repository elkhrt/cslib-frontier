/-!
# Simon's Factorization Forest Theorem and Bojańczyk's Well-Typed Regular Expressions

This module formalizes Imre Simon's Factorization Forest Theorem for finite monoids and
Mikołaj Bojańczyk's corollary on covering free monoids by finite unions of well-typed regular
expressions, building on `CslibFrontier.Computability.Languages.FactorizationTree` under
standard Lean axioms.

## Main definitions

* `CslibFrontier.Computability.Languages.PlusRegex`: regular expressions built from letters, union,
  concatenation, and Kleene plus.
* `CslibFrontier.Computability.Languages.PlusRegex.lang`: language of nonempty words generated by a
  `PlusRegex`.
* `CslibFrontier.Computability.Languages.PlusRegex.IsWellTyped`: well-typedness of a `PlusRegex`
  with respect to `f : α → M`, requiring every subexpression to be monochromatic under
  `evalWord f`.

## Main results

* `CslibFrontier.Computability.Languages.exists_factorizationTree_of_finite`: **Simon's
  Factorization Forest Theorem** — for any monoid homomorphism from `List α` into a finite monoid
  `M`, there is a uniform height bound `H` such that every nonempty word admits a valid
  factorization tree of height at most `H`.
* `CslibFrontier.Computability.Languages.exists_wellTyped_plusRegex_covering`: **Bojańczyk's
  Theorem** — for any finite alphabet `α` and homomorphism into a finite monoid `M`, there is a
  finite family of well-typed `PlusRegex` expressions covering all nonempty words in `List α`.
-/

public section

namespace CslibFrontier.Computability.Languages

universe u v

/-! ### Stage 2: Single `J`-Class -/

section JClassStage

variable {α : Type u} {M : Type v} [Monoid M]

private def AllInJ (S : Finset M) (x₀ : M) (f : α → M) (w : List α) : Prop :=
  ∀ a b c : List α, a ++ b ++ c = w → b ≠ [] → evalWord f b ∈ S ∧ GreenJEq S (evalWord f b) x₀

private lemma allInJ_subword {S : Finset M} {x₀ : M} {f : α → M} {w a b c : List α}
    (hw : AllInJ S x₀ f w) (h : a ++ b ++ c = w) : AllInJ S x₀ f b := by
  intro a' b' c' h' hb'
  have : (a ++ a') ++ b' ++ (c' ++ c) = w := by
    rw [← h, ← h']; simp [List.append_assoc]
  exact hw (a ++ a') b' (c' ++ c) this hb'

private lemma allInJ_take {S : Finset M} {x₀ : M} {f : α → M} {w : List α}
    (hw : AllInJ S x₀ f w) (k : ℕ) : AllInJ S x₀ f (w.take k) :=
  allInJ_subword hw (a := []) (c := w.drop k) (by simp)

private lemma allInJ_drop {S : Finset M} {x₀ : M} {f : α → M} {w : List α}
    (hw : AllInJ S x₀ f w) (k : ℕ) : AllInJ S x₀ f (w.drop k) :=
  allInJ_subword hw (a := w.take k) (c := []) (by simp)

private lemma allInJ_self {S : Finset M} {x₀ : M} {f : α → M} {w : List α}
    (hw : AllInJ S x₀ f w) (hne : w ≠ []) : evalWord f w ∈ S ∧ GreenJEq S (evalWord f w) x₀ :=
  hw [] w [] (by simp) hne

private lemma allInJ_letter {S : Finset M} {x₀ : M} {f : α → M} {w : List α}
    (hw : AllInJ S x₀ f w) {i : ℕ} (hi : i < w.length) :
    f w[i] ∈ S ∧ GreenJEq S (f w[i]) x₀ := by
  have hsplit : w.take i ++ [w[i]] ++ w.drop (i + 1) = w := by
    have htake : w.take (i + 1) = w.take i ++ [w[i]'hi] := by
      rw [List.take_add_one, List.getElem?_eq_getElem hi, Option.toList_some]
    rw [← htake]
    exact List.take_append_drop (i + 1) w
  simpa using hw (w.take i) [w[i]] (w.drop (i + 1)) hsplit (by simp)

private lemma allInJ_rEq_first {S : Finset M} (hS : ∀ x ∈ S, ∀ y ∈ S, x * y ∈ S)
    {x₀ : M} {f : α → M} {w : List α} (hw : AllInJ S x₀ f w) (hne : w ≠ []) :
    GreenREq S (evalWord f w) (f (w[0]'(List.length_pos_of_ne_nil hne))) := by
  cases w with
  | nil => contradiction
  | cons a ws =>
    cases ws with
    | nil =>
      simp only [evalWord_singleton, List.getElem_cons_zero]
      exact greenREq_refl S _
    | cons b bs =>
      have ha := allInJ_letter hw (i := 0) (by simp)
      have htail := allInJ_self (allInJ_drop hw 1) (by simp)
      have hall := allInJ_self hw (by simp)
      rw [evalWord_cons] at hall ⊢
      have hj : GreenJEq S (f a * evalWord f (b :: bs)) (f a) :=
        greenJEq_trans hS hall.2 (greenJEq_symm ha.2)
      exact greenREq_of_rLe_of_jEq hS
        (greenRLe_mul_left (mem_subsemigroupUnit_of_mem htail.1)) hj

private noncomputable def rClass (S : Finset M) (a : M) : Finset M :=
  let _ : DecidablePred (fun y : M ↦ GreenREq S y a) := Classical.decPred _
  S.filter (fun y ↦ GreenREq S y a)

private lemma mem_rClass_iff (S : Finset M) (a y : M) :
    y ∈ rClass S a ↔ y ∈ S ∧ GreenREq S y a := by
  classical
  simp [rClass]

private lemma rClass_eq_iff {S : Finset M} (hS : ∀ x ∈ S, ∀ y ∈ S, x * y ∈ S)
    {a b : M} (ha : a ∈ S) :
    rClass S a = rClass S b ↔ GreenREq S a b := by
  constructor
  · intro h
    have ha_mem : a ∈ rClass S a := (mem_rClass_iff S a a).mpr ⟨ha, greenREq_refl S a⟩
    rw [h, mem_rClass_iff] at ha_mem
    exact ha_mem.2
  · intro h
    ext y
    simp only [mem_rClass_iff]
    constructor
    · rintro ⟨hy, hr⟩
      exact ⟨hy, greenREq_trans hS hr h⟩
    · rintro ⟨hy, hr⟩
      exact ⟨hy, greenREq_trans hS hr (greenREq_symm h)⟩

private noncomputable def jColorAt (S : Finset M) (f : α → M) (w : List α)
    (i : Fin (w.length - 1)) : M × Finset M :=
  (evalWord f (w.take (i.val + 1)), rClass S (f w[i.val + 1]))

private noncomputable def jColors (S : Finset M) (f : α → M) (w : List α) :
    Finset (M × Finset M) :=
  let _ : DecidableEq M := Classical.decEq M
  Finset.univ.image (jColorAt S f w)

private lemma jColors_card_le (S : Finset M) (f : α → M) {x₀ : M} {w : List α}
    (hw : AllInJ S x₀ f w) :
    (jColors S f w).card ≤ S.card * S.card := by
  classical
  have hsub : jColors S f w ⊆ S ×ˢ S.image (rClass S) := by
    intro c hc
    rcases Finset.mem_image.mp hc with ⟨i, _, rfl⟩
    rw [Finset.mem_product]
    have htake_ne : w.take (i.val + 1) ≠ [] := by
      have hi := i.isLt
      rw [ne_eq, List.take_eq_nil_iff]
      push Not
      refine ⟨by omega, ?_⟩
      intro h; subst h; simp at hi
    have hp := (allInJ_self (allInJ_take hw (i.val + 1)) htake_ne).1
    have ha := (allInJ_letter hw (i := i.val + 1) (by have := i.isLt; omega)).1
    exact ⟨hp, Finset.mem_image.mpr ⟨f w[i.val + 1], ha, rfl⟩⟩
  calc (jColors S f w).card ≤ (S ×ˢ S.image (rClass S)).card := Finset.card_le_card hsub
    _ = S.card * (S.image (rClass S)).card := Finset.card_product _ _
    _ ≤ S.card * S.card := Nat.mul_le_mul_left _ Finset.card_image_le

private lemma jClass_split_mid {S : Finset M}
    {x₀ p : M} {R₀ : Finset M} {f : α → M} :
    ∀ (w : List α) (hw : w ≠ []), AllInJ S x₀ f w →
      p ∈ S → GreenJEq S p x₀ →
      p * evalWord f w = p →
      rClass S (f (w[0]'(List.length_pos_of_ne_nil hw))) = R₀ →
      ∃ us : List (List α),
        us.flatten = w ∧ us ≠ [] ∧
        (∀ u ∈ us, ∃ (hu : u ≠ []),
          p * evalWord f u = p ∧
          rClass S (f (u[0]'(List.length_pos_of_ne_nil hu))) = R₀ ∧
          (∀ k, 0 < k → (hk : k < u.length) →
            (p * evalWord f (u.take k), rClass S (f u[k])) ≠ (p, R₀))) := by
  intro w
  induction hlen : w.length using Nat.strong_induction_on generalizing w with
  | ind n ih =>
    intro hw hJ hp hpJ hpw hR0
    classical
    by_cases hex : ∃ k, 0 < k ∧ ∃ hk : k < w.length,
        (p * evalWord f (w.take k), rClass S (f w[k])) = (p, R₀)
    · let k := Nat.find hex
      have hk_spec := Nat.find_spec hex
      rcases hk_spec with ⟨hk_pos, hk_lt, hk_eq⟩
      have hk_min : ∀ j, 0 < j → j < k →
          ∀ hj : j < w.length, (p * evalWord f (w.take j), rClass S (f w[j])) ≠ (p, R₀) := by
        intro j hj1 hj2 hj_lt heq
        exact Nat.find_min hex hj2 ⟨hj1, hj_lt, heq⟩
      let u := w.take k
      let v := w.drop k
      have hu_ne : u ≠ [] := by
        dsimp only [u]; rw [ne_eq, List.take_eq_nil_iff]; push Not; exact ⟨by omega, hw⟩
      have hv_ne : v ≠ [] := by
        intro h; have := congrArg List.length h; simp [v] at this; omega
      have hp_u : p * evalWord f u = p := (Prod.mk.inj hk_eq).1
      have hR_v : rClass S (f (v[0]'(List.length_pos_of_ne_nil hv_ne))) = R₀ := by
        have hget : v[0]'(List.length_pos_of_ne_nil hv_ne) = w[k]'hk_lt := by
          simp [v]
        rw [hget]
        exact (Prod.mk.inj hk_eq).2
      have hp_v : p * evalWord f v = p := by
        have hcat := congrArg (fun l ↦ p * evalWord f l) (List.take_append_drop k w)
        simp only [evalWord_append, ← mul_assoc] at hcat
        rw [hp_u] at hcat
        exact hcat.trans hpw
      have hv_len : v.length < n := by
        simp [v, ← hlen]; omega
      obtain ⟨us, hus_flat, hus_ne, hus_prop⟩ :=
        ih v.length hv_len v rfl hv_ne (allInJ_drop hJ k) hp hpJ hp_v hR_v
      refine ⟨u :: us, by simp [hus_flat, u, v], by simp, ?_⟩
      intro x hx
      rcases List.mem_cons.mp hx with rfl | hx'
      · refine ⟨hu_ne, hp_u, ?_, ?_⟩
        · have hget : u[0]'(List.length_pos_of_ne_nil hu_ne) =
              w[0]'(List.length_pos_of_ne_nil hw) := by
            simp [u]
          rw [hget]; exact hR0
        · intro j hj1 hj2
          have hlen_u : u.length = k := by simp [u]; omega
          have hj_lt_k : j < k := by omega
          have hj_lt_w : j < w.length := by omega
          have hget : u[j]'hj2 = w[j]'hj_lt_w := by simp [u]
          have htake : u.take j = w.take j := by
            rw [List.take_take, Nat.min_eq_left (by omega)]
          rw [hget, htake]
          exact hk_min j hj1 hj_lt_k hj_lt_w
      · exact hus_prop x hx'
    · refine ⟨[w], by simp, by simp, ?_⟩
      intro x hx
      rcases List.mem_singleton.mp hx with rfl
      refine ⟨hw, hpw, hR0, ?_⟩
      intro k hk1 hk2 heq
      exact hex ⟨k, hk1, hk2, heq⟩

private lemma exists_factorizationTree_jClass {S : Finset M}
    (hS : ∀ x ∈ S, ∀ y ∈ S, x * y ∈ S) {x₀ : M} (f : α → M) :
    ∀ (r : ℕ) (w : List α), w ≠ [] → AllInJ S x₀ f w → (jColors S f w).card ≤ r →
      ∃ t : FactorizationTree α,
        t.IsWellFormed f ∧ t.word = w ∧ t.height ≤ (4 * S.card + 4) * r := by
  intro r
  classical
  induction r with
  | zero =>
    intro w hw hJ hr
    have hcard0 : (jColors S f w).card = 0 := by omega
    have hemp : jColors S f w = ∅ := Finset.card_eq_zero.mp hcard0
    have hlen1 : w.length = 1 := by
      by_contra hne1
      have hlen_pos : 0 < w.length := List.length_pos_of_ne_nil hw
      have hge2 : 0 < w.length - 1 := by omega
      have hmem : jColorAt S f w ⟨0, hge2⟩ ∈ jColors S f w := by
        simp only [jColors]; exact Finset.mem_image.mpr ⟨⟨0, hge2⟩, Finset.mem_univ _, rfl⟩
      rw [hemp] at hmem
      exact Finset.notMem_empty _ hmem
    cases w with
    | nil => contradiction
    | cons a ws =>
      cases ws with
      | nil => exact ⟨.leaf a, FactorizationTree.isWellFormed_leaf f a, by simp, by simp⟩
      | cons _ _ => simp at hlen1
  | succ r ih =>
    intro w hw hJ hr
    classical
    by_cases hlt : (jColors S f w).card ≤ r
    · obtain ⟨t, htv, htw, hth⟩ := ih w hw hJ hlt
      exact ⟨t, htv, htw, le_trans hth (Nat.mul_le_mul_left (4 * S.card + 4) (Nat.le_succ r))⟩
    · have hne_col : (jColors S f w).Nonempty :=
        Finset.card_pos.mp (by omega)
      obtain ⟨c₀, hc₀⟩ := hne_col
      rcases c₀ with ⟨p, R₀⟩
      have hdrop_card : ∀ (u : List α) (pre suf : List α),
          pre ++ u ++ suf = w → pre ≠ [] → u ≠ [] →
          (∀ j : Fin (u.length - 1),
            (evalWord f pre * evalWord f (u.take (j.val + 1)), rClass S (f u[j.val + 1])) ≠
              (p, R₀)) →
          (jColors S f u).card ≤ r := by
        intro u pre suf hdecomp hpre_ne hu_ne hno_c0
        let φ : M × Finset M → M × Finset M := fun c ↦ (evalWord f pre * c.1, c.2)
        have hsub : (jColors S f u).image φ ⊆ (jColors S f w).erase (p, R₀) := by
          intro y hy
          rcases Finset.mem_image.mp hy with ⟨c, hc, rfl⟩
          rcases Finset.mem_image.mp hc with ⟨j, _, rfl⟩
          rw [Finset.mem_erase]
          have hj_w : pre.length + j.val + 1 < w.length := by
            have := congrArg List.length hdecomp
            simp at this; omega
          have htake_w : w.take (pre.length + j.val + 1) = pre ++ u.take (j.val + 1) := by
            rw [← hdecomp, List.take_append_of_le_length (by simp; omega),
              show pre.length + j.val + 1 = pre.length + (j.val + 1) by omega, List.take_add]
            simp
          have hget_w : w[pre.length + j.val + 1]'hj_w = u[j.val + 1]'(by omega) := by
            simp only [← hdecomp, List.append_assoc]
            rw [List.getElem_append_right (by omega)]
            have h1 : pre.length + j.val + 1 - pre.length = j.val + 1 := by omega
            simp only [h1]
            rw [List.getElem_append_left (by omega)]
          have hφ_eq : φ (jColorAt S f u j) =
              jColorAt S f w ⟨pre.length + j.val, by omega⟩ := by
            simp only [φ, jColorAt, htake_w, evalWord_append, hget_w]
          refine ⟨?_, ?_⟩
          · exact hno_c0 j
          · rw [hφ_eq]
            exact Finset.mem_image.mpr ⟨⟨pre.length + j.val, by omega⟩, Finset.mem_univ _, rfl⟩
        have hinj : Set.InjOn φ (jColors S f u : Set (M × Finset M)) := by
          intro c₁ hc₁ c₂ hc₂ hφeq
          rcases Finset.mem_image.mp hc₁ with ⟨j₁, _, rfl⟩
          rcases Finset.mem_image.mp hc₂ with ⟨j₂, _, rfl⟩
          have heq1 : evalWord f pre * evalWord f (u.take (j₁.val + 1)) =
              evalWord f pre * evalWord f (u.take (j₂.val + 1)) := (Prod.mk.inj hφeq).1
          have heq2 : rClass S (f u[j₁.val + 1]) = rClass S (f u[j₂.val + 1]) :=
            (Prod.mk.inj hφeq).2
          have hu_J : AllInJ S x₀ f u := allInJ_subword hJ hdecomp
          have hpre_J := allInJ_self (allInJ_subword hJ (a := []) (c := u ++ suf)
            (by simpa [List.append_assoc] using hdecomp)) hpre_ne
          have hq1_ne : u.take (j₁.val + 1) ≠ [] := by
            rw [ne_eq, List.take_eq_nil_iff]; push Not; exact ⟨by omega, hu_ne⟩
          have hq2_ne : u.take (j₂.val + 1) ≠ [] := by
            rw [ne_eq, List.take_eq_nil_iff]; push Not; exact ⟨by omega, hu_ne⟩
          have hq1_J := allInJ_self (allInJ_take hu_J (j₁.val + 1)) hq1_ne
          have hq2_J := allInJ_self (allInJ_take hu_J (j₂.val + 1)) hq2_ne
          have hpreq1_J : GreenJEq S (evalWord f (pre ++ u.take (j₁.val + 1))) x₀ := by
            have hsub_pu :
                [] ++ (pre ++ u.take (j₁.val + 1)) ++ (u.drop (j₁.val + 1) ++ suf) = w := by
              rw [← hdecomp]
              simp only [List.nil_append, List.append_assoc]
              rw [← List.append_assoc (u.take (j₁.val + 1)), List.take_append_drop]
            exact (allInJ_self (allInJ_subword hJ hsub_pu) (by simp [hpre_ne])).2
          have hR1 : GreenREq S (evalWord f (u.take (j₁.val + 1)))
              (f (u[0]'(List.length_pos_of_ne_nil hu_ne))) := by
            have := allInJ_rEq_first hS (allInJ_take hu_J (j₁.val + 1)) hq1_ne
            simpa using this
          have hR2 : GreenREq S (evalWord f (u.take (j₂.val + 1)))
              (f (u[0]'(List.length_pos_of_ne_nil hu_ne))) := by
            have := allInJ_rEq_first hS (allInJ_take hu_J (j₂.val + 1)) hq2_ne
            simpa using this
          have hR12 : GreenREq S (evalWord f (u.take (j₁.val + 1)))
              (evalWord f (u.take (j₂.val + 1))) :=
            greenREq_trans hS hR1 (greenREq_symm hR2)
          have hJ_q1_pq1 : GreenJEq S (evalWord f (u.take (j₁.val + 1)))
              (evalWord f pre * evalWord f (u.take (j₁.val + 1))) := by
            rw [← evalWord_append]
            exact greenJEq_trans hS hq1_J.2 (greenJEq_symm hpreq1_J)
          have hq_eq := eq_of_mul_eq_of_greenREq hS hpre_J.1 heq1 hJ_q1_pq1 hR12
          exact Prod.ext hq_eq heq2
        have hcard_img : ((jColors S f u).image φ).card = (jColors S f u).card :=
          Finset.card_image_of_injOn hinj
        have hle1 := Finset.card_le_card hsub
        have hle2 : ((jColors S f w).erase (p, R₀)).card = (jColors S f w).card - 1 :=
          Finset.card_erase_of_mem hc₀
        omega
      let hitIdxs := Finset.univ.filter (fun i : Fin (w.length - 1) ↦ jColorAt S f w i = (p, R₀))
      have hhit_ne : hitIdxs.Nonempty := by
        rcases Finset.mem_image.mp hc₀ with ⟨i, _, hi⟩
        exact ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩⟩
      let i_first := hitIdxs.min' hhit_ne
      let i_last := hitIdxs.max' hhit_ne
      have hfirst_eq : jColorAt S f w i_first = (p, R₀) :=
        (Finset.mem_filter.mp (Finset.min'_mem hitIdxs hhit_ne)).2
      have hlast_eq : jColorAt S f w i_last = (p, R₀) :=
        (Finset.mem_filter.mp (Finset.max'_mem hitIdxs hhit_ne)).2
      have hfirst_le_last : i_first.val ≤ i_last.val :=
        Finset.min'_le hitIdxs i_last (Finset.max'_mem hitIdxs hhit_ne)
      let w_left := w.take (i_first.val + 1)
      let w_right := w.drop (i_last.val + 1)
      have hw_left_ne : w_left ≠ [] := by
        dsimp only [w_left]; rw [ne_eq, List.take_eq_nil_iff]; push Not; exact ⟨by omega, hw⟩
      have hw_right_ne : w_right ≠ [] := by
        intro h; have := congrArg List.length h; simp [w_right] at this; omega
      have hp_left : evalWord f w_left = p := (Prod.mk.inj hfirst_eq).1
      have hp_last : evalWord f (w.take (i_last.val + 1)) = p := (Prod.mk.inj hlast_eq).1
      have hcard_left : (jColors S f w_left).card ≤ r := by
        have hsub : jColors S f w_left ⊆ (jColors S f w).erase (p, R₀) := by
          intro c hc
          rcases Finset.mem_image.mp hc with ⟨j, _, rfl⟩
          have hlen_l : w_left.length = i_first.val + 1 := by simp [w_left]; omega
          have hj_lt : j.val < i_first.val := by omega
          have htake : w_left.take (j.val + 1) = w.take (j.val + 1) := by
            rw [List.take_take, Nat.min_eq_left (by omega)]
          have hget : w_left[j.val + 1]'(by omega) = w[j.val + 1]'(by omega) := by
            simp [w_left]
          have hcol_eq : jColorAt S f w_left j =
              jColorAt S f w ⟨j.val, by omega⟩ := by
            simp [jColorAt, htake, hget]
          rw [Finset.mem_erase, hcol_eq]
          refine ⟨?_, Finset.mem_image.mpr ⟨⟨j.val, by omega⟩, Finset.mem_univ _, rfl⟩⟩
          intro heq
          have hmem : (⟨j.val, by omega⟩ : Fin (w.length - 1)) ∈ hitIdxs :=
            Finset.mem_filter.mpr ⟨Finset.mem_univ _, heq⟩
          have hle := Finset.min'_le hitIdxs ⟨j.val, by omega⟩ hmem
          change i_first.val ≤ j.val at hle
          omega
        have hle1 := Finset.card_le_card hsub
        have hle2 : ((jColors S f w).erase (p, R₀)).card = (jColors S f w).card - 1 :=
          Finset.card_erase_of_mem hc₀
        omega
      have hcard_right : (jColors S f w_right).card ≤ r := by
        refine hdrop_card w_right (w.take (i_last.val + 1)) [] (by simp [w_right])
          (by rw [ne_eq, List.take_eq_nil_iff]; push Not; exact ⟨by omega, hw⟩) hw_right_ne ?_
        intro j heq
        have hlen_r : w_right.length = w.length - (i_last.val + 1) := by simp [w_right]
        have hj_w : i_last.val + 1 + j.val + 1 < w.length := by omega
        have htake_w : w.take (i_last.val + 1) ++ w_right.take (j.val + 1) =
            w.take (i_last.val + 1 + j.val + 1) := by
          dsimp only [w_right]
          rw [show i_last.val + 1 + j.val + 1 = (i_last.val + 1) + (j.val + 1) by omega]
          exact (List.take_add).symm
        have hget_w : w_right[j.val + 1]'(by omega) = w[i_last.val + 1 + j.val + 1]'hj_w := by
          simp only [w_right, List.getElem_drop, Nat.add_assoc]
        have hcol_w : jColorAt S f w ⟨i_last.val + 1 + j.val, by omega⟩ = (p, R₀) := by
          simp only [jColorAt, ← htake_w, evalWord_append, ← hget_w]
          exact heq
        have hmem : (⟨i_last.val + 1 + j.val, by omega⟩ : Fin (w.length - 1)) ∈ hitIdxs :=
          Finset.mem_filter.mpr ⟨Finset.mem_univ _, hcol_w⟩
        have hle := Finset.le_max' hitIdxs ⟨i_last.val + 1 + j.val, by omega⟩ hmem
        change i_last.val + 1 + j.val ≤ i_last.val at hle
        omega
      obtain ⟨t_left, ht_l_v, ht_l_w, ht_l_h⟩ :=
        ih w_left hw_left_ne (allInJ_take hJ _) hcard_left
      obtain ⟨t_right, ht_r_v, ht_r_w, ht_r_h⟩ :=
        ih w_right hw_right_ne (allInJ_drop hJ _) hcard_right
      by_cases hsame : i_first.val = i_last.val
      · refine ⟨.bin t_left t_right,
          FactorizationTree.isWellFormed_bin_iff.mpr ⟨ht_l_v, ht_r_v⟩, ?_, ?_⟩
        · simp [ht_l_w, ht_r_w, w_left, w_right, hsame]
        · have hmul : (4 * S.card + 4) * (r + 1) = (4 * S.card + 4) * r + (4 * S.card + 4) := by
            rw [Nat.mul_succ]
          simp only [FactorizationTree.height_bin]; omega
      · let w_mid := (w.take (i_last.val + 1)).drop (i_first.val + 1)
        have hw_mid_ne : w_mid ≠ [] := by
          intro h
          have := congrArg List.length h
          simp [w_mid] at this
          omega
        have hsplit_all : w_left ++ w_mid ++ w_right = w := by
          have h1 : w_left ++ w_mid = w.take (i_last.val + 1) := by
            have h2 := List.take_append_drop (i_first.val + 1) (w.take (i_last.val + 1))
            rwa [List.take_take, Nat.min_eq_left (by omega)] at h2
          rw [h1]
          exact List.take_append_drop (i_last.val + 1) w
        have hp_mem : p ∈ S := by
          rw [← hp_left]
          exact (allInJ_self (allInJ_take hJ _) hw_left_ne).1
        have hp_J : GreenJEq S p x₀ := by
          rw [← hp_left]
          exact (allInJ_self (allInJ_take hJ _) hw_left_ne).2
        have hp_mid : p * evalWord f w_mid = p := by
          have hcat : evalWord f (w_left ++ w_mid) = p := by
            have : w_left ++ w_mid = w.take (i_last.val + 1) := by
              rw [show w_left = (w.take (i_last.val + 1)).take (i_first.val + 1) by
                rw [List.take_take, Nat.min_eq_left (by omega)]]
              exact List.take_append_drop _ _
            rw [this, hp_last]
          rw [evalWord_append, hp_left] at hcat
          exact hcat
        have hR0_mid : rClass S (f (w_mid[0]'(List.length_pos_of_ne_nil hw_mid_ne))) = R₀ := by
          have hget : w_mid[0]'(List.length_pos_of_ne_nil hw_mid_ne) =
              w[i_first.val + 1]'(by omega) := by
            simp [w_mid]
          rw [hget]
          exact (Prod.mk.inj hfirst_eq).2
        obtain ⟨us, hus_flat, hus_ne, hus_prop⟩ :=
          jClass_split_mid w_mid hw_mid_ne (allInJ_subword hJ hsplit_all)
            hp_mem hp_J hp_mid hR0_mid
        have hus_trees : ∀ u ∈ us,
            ∃ t : FactorizationTree α,
              t.IsWellFormed f ∧ t.word = u ∧ t.height ≤ (4 * S.card + 4) * r + 2 := by
          intro u hu
          rcases hus_prop u hu with ⟨hu_ne, _, _, hu_no⟩
          by_cases hulen : u.length ≤ 2
          · cases u with
            | nil => contradiction
            | cons a u' =>
              cases u' with
              | nil => exact ⟨.leaf a, FactorizationTree.isWellFormed_leaf f a, by simp, by simp⟩
              | cons b u'' =>
                cases u'' with
                | nil =>
                  exact ⟨.bin (.leaf a) (.leaf b),
                    FactorizationTree.isWellFormed_bin_iff.mpr
                      ⟨FactorizationTree.isWellFormed_leaf f a,
                        FactorizationTree.isWellFormed_leaf f b⟩,
                    by simp, by simp⟩
                | cons _ _ => simp at hulen
          · have hlen3 : 3 ≤ u.length := by omega
            rcases List.append_of_mem hu with ⟨l₁, l₂, rfl⟩
            have hl1_eval : p * evalWord f l₁.flatten = p := by
              have hgen : ∀ l : List (List α), (∀ x ∈ l, p * evalWord f x = p) →
                  p * evalWord f l.flatten = p := by
                intro l; induction l with
                | nil => intro _; simp
                | cons x xs ihx =>
                  intro hall
                  simp only [List.flatten_cons, evalWord_append, ← mul_assoc]
                  rw [hall x (by simp)]
                  exact ihx (fun y hy ↦ hall y (List.mem_cons_of_mem _ hy))
              exact hgen l₁ fun x hx ↦ (hus_prop x (by simp [hx])).2.1
            let pre_u := w_left ++ l₁.flatten
            let suf_u := l₂.flatten ++ w_right
            have hpre_u_eval : evalWord f pre_u = p := by
              simp [pre_u, hp_left, hl1_eval]
            have hdecomp_u : pre_u ++ u ++ suf_u = w := by
              rw [← hsplit_all, ← hus_flat]
              simp [pre_u, suf_u, List.append_assoc]
            cases u with
            | nil => contradiction
            | cons a u_tail =>
              have htail_ne : u_tail ≠ [] := by intro h; simp [h] at hlen3
              let b := u_tail.getLast htail_ne
              let u'' := u_tail.dropLast
              have hu_eq : a :: u_tail = a :: (u'' ++ [b]) := by
                simp [u'', b, List.dropLast_append_getLast htail_ne]
              have hu''_ne : u'' ≠ [] := by
                intro h
                have : u_tail.length = 1 := by
                  have := congrArg List.length (List.dropLast_append_getLast htail_ne)
                  simp [u'', h] at this; omega
                simp [this] at hlen3
              have hdecomp_u'' : (pre_u ++ [a]) ++ u'' ++ ([b] ++ suf_u) = w := by
                rw [← hdecomp_u, hu_eq]; simp [List.append_assoc]
              have hcard_u'' : (jColors S f u'').card ≤ r := by
                refine hdrop_card u'' (pre_u ++ [a]) ([b] ++ suf_u) hdecomp_u'' (by simp) hu''_ne ?_
                intro j heq
                have hlen_u'' : u''.length = u_tail.length - 1 := List.length_dropLast
                have htail_len : 2 ≤ u_tail.length := by simp at hlen3; omega
                have hj_lt : j.val + 1 + 1 < (a :: u_tail).length := by
                  simp only [List.length_cons]; have := j.isLt; omega
                have htake_u : (a :: u_tail).take (j.val + 1 + 1) = a :: u''.take (j.val + 1) := by
                  have hj_le : j.val + 1 ≤ u''.length := by have := j.isLt; omega
                  rw [hu_eq, List.take_succ_cons, List.take_append_of_le_length hj_le]
                have hget_u : (a :: u_tail)[j.val + 1 + 1]'hj_lt = u''[j.val + 1]'(by omega) := by
                  simp only [hu_eq, List.getElem_cons_succ]
                  rw [List.getElem_append_left (by omega)]
                have heq' : (p * evalWord f ((a :: u_tail).take (j.val + 1 + 1)),
                    rClass S (f ((a :: u_tail)[j.val + 1 + 1]'hj_lt))) = (p, R₀) := by
                  rw [htake_u, hget_u]
                  simpa [evalWord_append, hpre_u_eval, mul_assoc] using heq
                exact hu_no (j.val + 1 + 1) (by omega) hj_lt heq'
              have hu''_J : AllInJ S x₀ f u'' := allInJ_subword hJ hdecomp_u''
              obtain ⟨t'', ht''v, ht''w, ht''h⟩ := ih u'' hu''_ne hu''_J hcard_u''
              refine ⟨.bin (.leaf a) (.bin t'' (.leaf b)),
                FactorizationTree.isWellFormed_bin_iff.mpr ⟨FactorizationTree.isWellFormed_leaf f a,
                  FactorizationTree.isWellFormed_bin_iff.mpr
                    ⟨ht''v, FactorizationTree.isWellFormed_leaf f b⟩⟩, ?_, ?_⟩
              · simp [ht''w, hu_eq]
              · simp; omega
        have hmid_tree : ∃ t_mid : FactorizationTree α,
            t_mid.IsWellFormed f ∧ t_mid.word = w_mid ∧
              t_mid.height ≤ (4 * S.card + 4) * r + 2 + 4 * S.card := by
          choose F hF using hus_trees
          cases hus_eq : us with
          | nil => contradiction
          | cons u₀ us' =>
            cases us' with
            | nil =>
              have hu0 : u₀ ∈ us := by rw [hus_eq]; simp
              have hw0 : u₀ = w_mid := by rw [← hus_flat, hus_eq]; simp
              exact ⟨F u₀ hu0, (hF u₀ hu0).1, (hF u₀ hu0).2.1.trans hw0,
                by have := (hF u₀ hu0).2.2; omega⟩
            | cons u₁ us'' =>
              have hu0_mem : u₀ ∈ us := by rw [hus_eq]; simp
              have hu1_mem : u₁ ∈ us := by rw [hus_eq]; simp
              rcases hus_prop u₀ hu0_mem with ⟨hu0_ne, hp_u0, hR_u0, _⟩
              rcases hus_prop u₁ hu1_mem with ⟨hu1_ne, hp_u1, hR_u1, _⟩
              have hmid_J : AllInJ S x₀ f w_mid := allInJ_subword hJ hsplit_all
              have hdecomp_01 : [] ++ (u₀ ++ u₁) ++ us''.flatten = w_mid := by
                rw [← hus_flat, hus_eq]; simp [List.append_assoc]
              have hu0_J := allInJ_self (allInJ_subword hmid_J (a := []) (b := u₀)
                (c := u₁ ++ us''.flatten) (by simpa [List.append_assoc] using hdecomp_01)) hu0_ne
              have hu1_J := allInJ_self (allInJ_subword hmid_J (a := u₀) (b := u₁)
                (c := us''.flatten) (by simpa [List.append_assoc] using hdecomp_01)) hu1_ne
              have hu01_J := allInJ_self (allInJ_subword hmid_J hdecomp_01) (by simp [hu0_ne])
              let y₀ := evalWord f u₀
              let y₁ := evalWord f u₁
              have hHEq_u : ∀ u ∈ us, GreenHEq S (evalWord f u) y₀ := by
                intro u hu
                rcases hus_prop u hu with ⟨hu_ne, hp_u, hR_u, _⟩
                rcases List.append_of_mem hu with ⟨la, lb, rfl⟩
                have hu_J := allInJ_self (allInJ_subword hmid_J (a := la.flatten) (b := u)
                  (c := lb.flatten) (by simpa [List.append_assoc] using hus_flat)) hu_ne
                have hR_u_first : GreenREq S (evalWord f u)
                    (f (u[0]'(List.length_pos_of_ne_nil hu_ne))) :=
                  allInJ_rEq_first hS (allInJ_subword hmid_J (a := la.flatten) (b := u)
                    (c := lb.flatten) (by simpa [List.append_assoc] using hus_flat)) hu_ne
                have hR_u0_first : GreenREq S y₀
                    (f (u₀[0]'(List.length_pos_of_ne_nil hu0_ne))) :=
                  allInJ_rEq_first hS (allInJ_subword hmid_J (a := []) (b := u₀)
                    (c := u₁ ++ us''.flatten)
                      (by simpa [List.append_assoc] using hdecomp_01)) hu0_ne
                have hfirst_u_S : f (u[0]'(List.length_pos_of_ne_nil hu_ne)) ∈ S :=
                  (allInJ_letter (allInJ_subword hmid_J (a := la.flatten) (b := u)
                    (c := lb.flatten) (by simpa [List.append_assoc] using hus_flat))
                    (List.length_pos_of_ne_nil hu_ne)).1
                have hfirst_u0_S : f (u₀[0]'(List.length_pos_of_ne_nil hu0_ne)) ∈ S :=
                  (allInJ_letter (allInJ_subword hmid_J (a := []) (b := u₀)
                    (c := u₁ ++ us''.flatten) (by simpa [List.append_assoc] using hdecomp_01))
                    (List.length_pos_of_ne_nil hu0_ne)).1
                have hR_firsts : GreenREq S (f (u[0]'(List.length_pos_of_ne_nil hu_ne)))
                    (f (u₀[0]'(List.length_pos_of_ne_nil hu0_ne))) :=
                  (rClass_eq_iff hS hfirst_u_S).mp (hR_u.trans hR_u0.symm)
                have hR_uy0 : GreenREq S (evalWord f u) y₀ :=
                  greenREq_trans hS hR_u_first
                    (greenREq_trans hS hR_firsts (greenREq_symm hR_u0_first))
                have hL_u_p : GreenLEq S p (evalWord f u) := by
                  have := greenLEq_of_lLe_of_jEq hS
                    (greenLLe_mul_right (mem_subsemigroupUnit_of_mem hp_mem))
                    (by rw [hp_u]; exact greenJEq_trans hS hp_J (greenJEq_symm hu_J.2))
                  rw [hp_u] at this; exact this
                have hL_y0_p : GreenLEq S p y₀ := by
                  have := greenLEq_of_lLe_of_jEq hS
                    (greenLLe_mul_right (mem_subsemigroupUnit_of_mem hp_mem))
                    (by rw [hp_u0]; exact greenJEq_trans hS hp_J (greenJEq_symm hu0_J.2))
                  rw [hp_u0] at this; exact this
                have hL_uy0 : GreenLEq S (evalWord f u) y₀ :=
                  greenLEq_trans hS (greenLEq_symm hL_u_p) hL_y0_p
                exact (greenHEq_iff S _ _).mpr ⟨hR_uy0, hL_uy0⟩
              have hH01 : GreenHEq S y₀ y₁ := greenHEq_symm (hHEq_u u₁ hu1_mem)
              have hJ0_01 : GreenJEq S y₀ (y₀ * y₁) := by
                rw [← evalWord_append]
                exact greenJEq_trans hS hu0_J.2 (greenJEq_symm hu01_J.2)
              obtain ⟨e_grp, he_id, hmul_cl, hinv_ex⟩ :=
                exists_greenHClass_group_ops hS hu0_J.1 hu1_J.1 hH01 hJ0_01
              let invFn : GreenHClass S y₀ → GreenHClass S y₀ := fun a ↦ (hinv_ex a).choose
              have hinv_spec : ∀ a, a.val * (invFn a).val = e_grp.val ∧
                  (invFn a).val * a.val = e_grp.val := fun a ↦ (hinv_ex a).choose_spec
              let instGrp : Group (GreenHClass S y₀) :=
                { mul := fun a b ↦ ⟨a.val * b.val, (hmul_cl a b).1, (hmul_cl a b).2⟩
                  mul_assoc := fun a b c ↦ by ext; exact mul_assoc _ _ _
                  one := e_grp
                  one_mul := fun a ↦ by ext; exact (he_id a).2
                  mul_one := fun a ↦ by ext; exact (he_id a).1
                  inv := invFn
                  inv_mul_cancel := fun a ↦ by ext; exact (hinv_spec a).2 }
              let _ : Group (GreenHClass S y₀) := instGrp
              let β_idx := { u : List α // u ∈ us }
              let fG : β_idx → GreenHClass S y₀ := fun u ↦
                ⟨evalWord f u.val,
                  by
                    rcases List.append_of_mem u.property with ⟨la, lb, hsp⟩
                    rcases hus_prop u.val u.property with ⟨hu_ne, _⟩
                    have hflat' : la.flatten ++ u.val ++ lb.flatten = w_mid := by
                      have h1 : (la ++ u.val :: lb).flatten = w_mid := hsp ▸ hus_flat
                      simpa [List.append_assoc] using h1
                    exact (allInJ_self (allInJ_subword hmid_J hflat') hu_ne).1,
                  hHEq_u u.val u.property⟩
              let wG : List β_idx := us.attach
              have hwG_ne : wG ≠ [] := by
                intro h
                have hlen := congrArg List.length h
                rw [List.length_attach, List.length_nil] at hlen
                exact hus_ne (List.eq_nil_of_length_eq_zero hlen)
              have hcard_G : (groupPrefixes fG wG).card ≤ S.card := by
                have hsub : (groupPrefixes fG wG).image GreenHClass.val ⊆ S := by
                  intro x hx
                  rcases Finset.mem_image.mp hx with ⟨g, _, rfl⟩
                  exact g.mem_S
                have hinj : Function.Injective (GreenHClass.val : GreenHClass S y₀ → M) := by
                  intro a b h; exact GreenHClass.ext h
                have h1 := (Finset.card_image_of_injective (groupPrefixes fG wG) hinj).symm
                have h2 := Finset.card_le_card hsub
                omega
              obtain ⟨tG, htG_v, htG_w, htG_h⟩ :=
                exists_factorizationTree_group fG S.card wG hwG_ne hcard_G
              let g_sub : β_idx → FactorizationTree α := fun u ↦ F u.val u.property
              refine ⟨tG.subst g_sub, ?_, ?_, ?_⟩
              · refine FactorizationTree.isWellFormed_subst_of_mul_map GreenHClass.val
                  (fun _ _ ↦ rfl) g_sub htG_v ?_
                intro u _
                exact ⟨(hF u.val u.property).1, (hF u.val u.property).2.1 ▸ rfl⟩
              · rw [FactorizationTree.word_subst, htG_w]
                have hmap : wG.map (fun u ↦ (g_sub u).word) = us := by
                  calc wG.map (fun u ↦ (g_sub u).word)
                      = us.attach.map Subtype.val :=
                        List.map_congr_left fun u _ ↦ (hF u.val u.property).2.1
                    _ = us := by simp
                rw [hmap, hus_flat]
              · have h1 := FactorizationTree.height_subst_le g_sub tG
                  (B := (4 * S.card + 4) * r + 2)
                  (fun u _ ↦ (hF u.val u.property).2.2)
                omega
        obtain ⟨t_mid, ht_m_v, ht_m_w, ht_m_h⟩ := hmid_tree
        refine ⟨.bin (.bin t_left t_mid) t_right,
          FactorizationTree.isWellFormed_bin_iff.mpr
            ⟨FactorizationTree.isWellFormed_bin_iff.mpr ⟨ht_l_v, ht_m_v⟩, ht_r_v⟩, ?_, ?_⟩
        · simp [ht_l_w, ht_m_w, ht_r_w, hsplit_all]
        · have hmul : (4 * S.card + 4) * (r + 1) = (4 * S.card + 4) * r + (4 * S.card + 4) := by
            rw [Nat.mul_succ]
          simp only [FactorizationTree.height_bin]; omega

end JClassStage

/-! ### Stage 3: General Finite Subsemigroups and Simon's Theorem -/

section SimonTheorem

variable {α : Type u} {M : Type v} [Monoid M]

private lemma exists_maximal_jClass {S : Finset M} (hS : ∀ x ∈ S, ∀ y ∈ S, x * y ∈ S)
    (hne : S.Nonempty) :
    ∃ x₀ ∈ S, ∀ y ∈ S, GreenJLe S x₀ y → GreenJLe S y x₀ := by
  classical
  let upset : M → Finset M := fun x ↦ S.filter (fun z ↦ GreenJLe S x z)
  obtain ⟨x₀, hx₀, hmin⟩ := S.exists_min_image (fun x ↦ (upset x).card) hne
  refine ⟨x₀, hx₀, ?_⟩
  intro y hy hxy
  have hsub : upset y ⊆ upset x₀ := by
    intro z hz
    rw [Finset.mem_filter] at hz ⊢
    exact ⟨hz.1, greenJLe_trans hS hxy hz.2⟩
  have hcard_le : (upset x₀).card ≤ (upset y).card := hmin y hy
  have heq : upset y = upset x₀ := Finset.eq_of_subset_of_card_le hsub hcard_le
  have hx0_in : x₀ ∈ upset x₀ := Finset.mem_filter.mpr ⟨hx₀, greenJLe_refl S x₀⟩
  rw [← heq, Finset.mem_filter] at hx0_in
  exact hx0_in.2

private lemma greedy_split_ideal {S T : Finset M} {f : α → M} :
    ∀ (w : List α), w ≠ [] → (∀ a ∈ w, f a ∈ S) → evalWord f w ∈ T →
      ∃ (vs : List (List α)) (rem : List α),
        vs.flatten ++ rem = w ∧ vs ≠ [] ∧
        (∀ v ∈ vs, v ≠ [] ∧ evalWord f v ∈ T ∧
          (v.dropLast = [] ∨ evalWord f v.dropLast ∉ T)) ∧
        (rem = [] ∨ evalWord f rem ∉ T) := by
  intro w
  induction hlen : w.length using Nat.strong_induction_on generalizing w with
  | ind n ih =>
    intro hw hS_w hw_T
    classical
    have hex : ∃ k, 0 < k ∧ k ≤ w.length ∧ evalWord f (w.take k) ∈ T :=
      ⟨w.length, List.length_pos_of_ne_nil hw, le_refl _, by simpa using hw_T⟩
    let k := Nat.find hex
    have hk := Nat.find_spec hex
    have hk_min : ∀ j, 0 < j → j < k → evalWord f (w.take j) ∉ T := by
      intro j hj1 hj2 hmem
      exact Nat.find_min hex hj2 ⟨hj1, by omega, hmem⟩
    let v := w.take k
    let rem := w.drop k
    have hv_ne : v ≠ [] := by
      dsimp only [v]; rw [ne_eq, List.take_eq_nil_iff]; push Not; exact ⟨by omega, hw⟩
    have hv_dl : v.dropLast = [] ∨ evalWord f v.dropLast ∉ T := by
      by_cases hk1 : k = 1
      · left
        have hlen_v : v.length = 1 := by simp [v]; omega
        have : v.dropLast.length = 0 := by simp [hlen_v]
        exact List.eq_nil_of_length_eq_zero this
      · right
        have hdl_eq : v.dropLast = w.take (k - 1) := by
          have hlen_v : v.length = k := by simp [v]; omega
          rw [List.dropLast_eq_take, hlen_v, List.take_take, Nat.min_eq_left (by omega)]
        rw [hdl_eq]
        exact hk_min (k - 1) (by omega) (by omega)
    by_cases hrem : rem = []
    · refine ⟨[v], [], ?_, by simp, ?_, Or.inl rfl⟩
      · have := List.take_append_drop k w
        simpa [v, rem, hrem] using this
      · intro x hx; rcases List.mem_singleton.mp hx with rfl
        exact ⟨hv_ne, hk.2.2, hv_dl⟩
    · by_cases hrem_T : evalWord f rem ∈ T
      · have hrem_len : rem.length < n := by simp [rem, ← hlen]; omega
        have hrem_S : ∀ a ∈ rem, f a ∈ S := fun a ha ↦
          hS_w a (List.mem_of_mem_drop ha)
        obtain ⟨vs, rem', hflat, hvs_ne, hvs_prop, hrem'_prop⟩ :=
          ih rem.length hrem_len rem rfl hrem hrem_S hrem_T
        refine ⟨v :: vs, rem', ?_, by simp, ?_, hrem'_prop⟩
        · simp only [List.flatten_cons, List.append_assoc, hflat]
          exact List.take_append_drop k w
        · intro x hx
          rcases List.mem_cons.mp hx with rfl | hx'
          · exact ⟨hv_ne, hk.2.2, hv_dl⟩
          · exact hvs_prop x hx'
      · refine ⟨[v], rem, ?_, by simp, ?_, Or.inr hrem_T⟩
        · simp [v, rem]
        · intro x hx; rcases List.mem_singleton.mp hx with rfl
          exact ⟨hv_ne, hk.2.2, hv_dl⟩

private lemma exists_factorizationTree_subsemigroup :
    ∀ (m : ℕ) (S : Finset M), S.card ≤ m → (∀ x ∈ S, ∀ y ∈ S, x * y ∈ S) →
      ∃ H : ℕ, ∀ {β : Type u} (f : β → M) (w : List β),
        w ≠ [] → (∀ a ∈ w, f a ∈ S) →
        ∃ t : FactorizationTree β, t.IsWellFormed f ∧ t.word = w ∧ t.height ≤ H := by
  intro m
  induction m with
  | zero =>
    intro S hcard _
    refine ⟨0, fun f w hw hS_w ↦ ?_⟩
    cases w with
    | nil => contradiction
    | cons a _ =>
      have : f a ∈ S := hS_w a (by simp)
      have : S = ∅ := Finset.card_eq_zero.mp (by omega)
      simp [this] at ‹f a ∈ S›
  | succ m ih =>
    intro S hcard hS
    classical
    by_cases hne : S.Nonempty
    · obtain ⟨x₀, hx₀, hmax⟩ := exists_maximal_jClass hS hne
      let T : Finset M := S.filter (fun y ↦ ¬ GreenJEq S y x₀)
      have hT_sub : T ⊆ S := Finset.filter_subset _ _
      have hT_card : T.card ≤ m := by
        have hx0_not : x₀ ∉ T := by
          simp [T, greenJEq_iff, greenJLe_refl]
        have hss : T ⊂ S := Finset.ssubset_iff_subset_ne.mpr
          ⟨hT_sub, fun heq ↦ hx0_not (heq.symm ▸ hx₀)⟩
        have hlt := Finset.card_lt_card hss
        omega
      have hT_ideal : ∀ x ∈ T, ∀ y ∈ S, x * y ∈ T ∧ y * x ∈ T := by
        intro x hx y hy
        rw [Finset.mem_filter] at hx
        have hxy_S : x * y ∈ S := hS x hx.1 y hy
        have hyx_S : y * x ∈ S := hS y hy x hx.1
        refine ⟨Finset.mem_filter.mpr ⟨hxy_S, ?_⟩, Finset.mem_filter.mpr ⟨hyx_S, ?_⟩⟩
        · intro heq
          have h1 : GreenJLe S x₀ x :=
            greenJLe_trans hS ((greenJEq_iff S _ _).mp heq).2
              (greenJLe_of_rLe (greenRLe_mul_left (mem_subsemigroupUnit_of_mem hy)))
          exact hx.2 ((greenJEq_iff S _ _).mpr ⟨hmax x hx.1 h1, h1⟩)
        · intro heq
          have h1 : GreenJLe S x₀ x :=
            greenJLe_trans hS ((greenJEq_iff S _ _).mp heq).2
              (greenJLe_of_lLe (greenLLe_mul_right (mem_subsemigroupUnit_of_mem hy)))
          exact hx.2 ((greenJEq_iff S _ _).mpr ⟨hmax x hx.1 h1, h1⟩)
      have hT_mul : ∀ x ∈ T, ∀ y ∈ T, x * y ∈ T := fun x hx y hy ↦
        (hT_ideal x hx y (hT_sub hy)).1
      obtain ⟨H_T, hIH_T⟩ := ih T hT_card hT_mul
      let H_J := (4 * S.card + 4) * (S.card * S.card)
      refine ⟨H_T + H_J + 2, fun {β} f w hw hS_w ↦ ?_⟩
      have hEval_S : ∀ u : List β, u ≠ [] → (∀ a ∈ u, f a ∈ S) → evalWord f u ∈ S := by
        intro u hu hSu
        induction u with
        | nil => contradiction
        | cons a us ihu =>
          cases us with
          | nil => simpa using hSu a (by simp)
          | cons b bs =>
            rw [evalWord_cons]
            exact hS (f a) (hSu a (by simp)) _
              (ihu (by simp) (fun x hx ↦ hSu x (List.mem_cons_of_mem _ hx)))
      have hJ_tree : ∀ u : List β, u ≠ [] → (∀ a ∈ u, f a ∈ S) → evalWord f u ∉ T →
          ∃ t : FactorizationTree β, t.IsWellFormed f ∧ t.word = u ∧ t.height ≤ H_J := by
        intro u hu hSu hu_notT
        have hu_S : evalWord f u ∈ S := hEval_S u hu hSu
        have hu_Jeq : GreenJEq S (evalWord f u) x₀ := by
          by_contra hnot
          exact hu_notT (Finset.mem_filter.mpr ⟨hu_S, hnot⟩)
        have hallJ : AllInJ S x₀ f u := by
          intro a b c hsub hb_ne
          have hb_S : evalWord f b ∈ S :=
            hEval_S b hb_ne (fun x hx ↦ hSu x (by rw [← hsub]; simp [hx]))
          have hle_b : GreenJLe S (evalWord f u) (evalWord f b) := by
            have ha_S1 : evalWord f a ∈ subsemigroupUnit S := by
              by_cases ha : a = []
              · simp [ha, one_mem_subsemigroupUnit]
              · exact mem_subsemigroupUnit_of_mem
                  (hEval_S a ha (fun x hx ↦ hSu x (by rw [← hsub]; simp [hx])))
            have hc_S1 : evalWord f c ∈ subsemigroupUnit S := by
              by_cases hc : c = []
              · simp [hc, one_mem_subsemigroupUnit]
              · exact mem_subsemigroupUnit_of_mem
                  (hEval_S c hc (fun x hx ↦ hSu x (by rw [← hsub]; simp [hx])))
            exact (greenJLe_iff S _ _).mpr ⟨evalWord f a, ha_S1, evalWord f c, hc_S1, by
              rw [← hsub]; simp [evalWord_append, mul_assoc]⟩
          have h1 : GreenJLe S x₀ (evalWord f b) :=
            greenJLe_trans hS ((greenJEq_iff S _ _).mp hu_Jeq).2 hle_b
          exact ⟨hb_S, (greenJEq_iff S _ _).mpr ⟨hmax _ hb_S h1, h1⟩⟩
        obtain ⟨t, htv, htw, hth⟩ :=
          exists_factorizationTree_jClass hS f (S.card * S.card) u hu hallJ
            (jColors_card_le S f hallJ)
        exact ⟨t, htv, htw, hth⟩
      by_cases hw_T : evalWord f w ∈ T
      · obtain ⟨vs, rem, hflat, hvs_ne, hvs_prop, hrem_prop⟩ :=
          greedy_split_ideal w hw hS_w hw_T
        have hvs_trees : ∀ v ∈ vs,
            ∃ t : FactorizationTree β, t.IsWellFormed f ∧ t.word = v ∧ t.height ≤ H_J + 1 := by
          intro v hv
          rcases hvs_prop v hv with ⟨hv_ne, _, hv_dl⟩
          have hv_S : ∀ a ∈ v, f a ∈ S := fun a ha ↦ hS_w a (by
            rw [← hflat]
            simp only [List.mem_append, List.mem_flatten]
            exact Or.inl ⟨v, hv, ha⟩)
          rcases hv_dl with hdl_nil | hdl_notT
          · cases v with
            | nil => contradiction
            | cons a v' =>
              cases v' with
              | nil => exact ⟨.leaf a, FactorizationTree.isWellFormed_leaf f a, by simp, by simp⟩
              | cons _ _ => simp at hdl_nil
          · by_cases hv1 : v.length = 1
            · cases v with
              | nil => contradiction
              | cons a v' =>
                cases v' with
                | nil => exact ⟨.leaf a, FactorizationTree.isWellFormed_leaf f a, by simp, by simp⟩
                | cons _ _ => simp at hv1
            · have hdl_ne' : v.dropLast ≠ [] := by
                intro h
                have := List.length_eq_zero_iff.mpr h
                have hlen_v := List.length_pos_of_ne_nil hv_ne
                simp at this
                omega
              have hdl_S : ∀ a ∈ v.dropLast, f a ∈ S := fun a ha ↦
                hv_S a (List.dropLast_subset v ha)
              obtain ⟨t_dl, htdlv, htdlw, htdlh⟩ := hJ_tree v.dropLast hdl_ne' hdl_S hdl_notT
              refine ⟨.bin t_dl (.leaf (v.getLast hv_ne)),
                FactorizationTree.isWellFormed_bin_iff.mpr
                  ⟨htdlv, FactorizationTree.isWellFormed_leaf f _⟩, ?_, ?_⟩
              · simp [htdlw, List.dropLast_append_getLast hv_ne]
              · simp; omega
        choose F hF using hvs_trees
        let β_v := { v : List β // v ∈ vs }
        let fT : β_v → M := fun v ↦ evalWord f v.val
        let wT : List β_v := vs.attach
        have hwT_ne : wT ≠ [] := by
          intro h
          have hlen := congrArg List.length h
          rw [List.length_attach, List.length_nil] at hlen
          exact hvs_ne (List.eq_nil_of_length_eq_zero hlen)
        have hwT_inT : ∀ v ∈ wT, fT v ∈ T := fun v _ ↦ (hvs_prop v.val v.property).2.1
        obtain ⟨tT, htT_v, htT_w, htT_h⟩ := hIH_T fT wT hwT_ne hwT_inT
        let g_sub : β_v → FactorizationTree β := fun v ↦ F v.val v.property
        have hflat_vs : ∃ t_vs : FactorizationTree β,
            t_vs.IsWellFormed f ∧ t_vs.word = vs.flatten ∧ t_vs.height ≤ H_T + H_J + 1 := by
          refine ⟨tT.subst g_sub, ?_, ?_, ?_⟩
          · refine FactorizationTree.isWellFormed_subst_of_eval_eq g_sub htT_v ?_
            intro v _
            exact ⟨(hF v.val v.property).1, (hF v.val v.property).2.1 ▸ rfl⟩
          · rw [FactorizationTree.word_subst, htT_w]
            have hmap : wT.map (fun v ↦ (g_sub v).word) = vs := by
              calc wT.map (fun v ↦ (g_sub v).word)
                  = vs.attach.map Subtype.val :=
                    List.map_congr_left fun v _ ↦ (hF v.val v.property).2.1
                _ = vs := by simp
            rw [hmap]
          · have h1 := FactorizationTree.height_subst_le g_sub tT (B := H_J + 1)
              (fun v _ ↦ (hF v.val v.property).2.2)
            omega
        obtain ⟨t_vs, htvs_v, htvs_w, htvs_h⟩ := hflat_vs
        rcases hrem_prop with hrem_nil | hrem_notT
        · have hw_eq : vs.flatten = w := by simpa [hrem_nil] using hflat
          exact ⟨t_vs, htvs_v, htvs_w.trans hw_eq, by omega⟩
        · by_cases hrem_nil : rem = []
          · have hw_eq : vs.flatten = w := by simpa [hrem_nil] using hflat
            exact ⟨t_vs, htvs_v, htvs_w.trans hw_eq, by omega⟩
          · have hrem_S : ∀ a ∈ rem, f a ∈ S := fun a ha ↦
              hS_w a (by rw [← hflat]; simp [ha])
            obtain ⟨t_rem, htrem_v, htrem_w, htrem_h⟩ := hJ_tree rem hrem_nil hrem_S hrem_notT
            refine ⟨.bin t_vs t_rem,
              FactorizationTree.isWellFormed_bin_iff.mpr ⟨htvs_v, htrem_v⟩, ?_, ?_⟩
            · simp [htvs_w, htrem_w, hflat]
            · simp; omega
      · obtain ⟨t, htv, htw, hth⟩ := hJ_tree w hw hS_w hw_T
        exact ⟨t, htv, htw, by omega⟩
    · have hemp : S = ∅ := Finset.not_nonempty_iff_eq_empty.mp hne
      refine ⟨0, fun f w hw hS_w ↦ ?_⟩
      cases w with
      | nil => contradiction
      | cons a _ =>
        have := hS_w a (by simp)
        simp [hemp] at this

end SimonTheorem

/-- **Simon's Factorization Forest Theorem**: for any finite monoid `M` and letter map `f : α → M`,
there exists a uniform height bound `H` such that every nonempty word `w : List α` admits a valid
factorization tree of height at most `H`. -/
theorem exists_factorizationTree_of_finite {α : Type u} {M : Type v} [Monoid M] [Finite M] :
    ∃ H : ℕ, ∀ (f : α → M) (w : List α), w ≠ [] →
      ∃ t : FactorizationTree α, t.IsWellFormed f ∧ t.word = w ∧ t.height ≤ H := by
  classical
  let _ : Fintype M := Fintype.ofFinite M
  obtain ⟨H, hH⟩ := exists_factorizationTree_subsemigroup (M := M) (Fintype.card M) Finset.univ
    (by simp) (fun _ _ _ _ ↦ Finset.mem_univ _)
  exact ⟨H, fun f w hw ↦ hH f w hw (fun _ _ ↦ Finset.mem_univ _)⟩

/-! ### Bojańczyk's Theorem: Well-Typed Regular Expressions -/

section Bojanczyk

/-- Regular expressions built from letters, union, concatenation, and Kleene plus (matching
nonempty words). -/
inductive PlusRegex (α : Type u) : Type u
  /-- Single letter `{[a]}`. -/
  | char (a : α) : PlusRegex α
  /-- Union of two regular expressions. -/
  | union (e₁ e₂ : PlusRegex α) : PlusRegex α
  /-- Concatenation of two regular expressions. -/
  | concat (e₁ e₂ : PlusRegex α) : PlusRegex α
  /-- Kleene plus (one or more repetitions). -/
  | plus (e : PlusRegex α) : PlusRegex α
  deriving DecidableEq

namespace PlusRegex

/-- The language of nonempty words generated by a `PlusRegex`. -/
def lang {α : Type u} : PlusRegex α → Set (List α)
  | .char a => {[a]}
  | .union e₁ e₂ => e₁.lang ∪ e₂.lang
  | .concat e₁ e₂ => { w | ∃ u ∈ e₁.lang, ∃ v ∈ e₂.lang, w = u ++ v }
  | .plus e => { w | ∃ ws : List (List α), 1 ≤ ws.length ∧ (∀ u ∈ ws, u ∈ e.lang) ∧
      w = ws.flatten }

/-- A `PlusRegex` is well-typed with type `m : M` under `f : α → M` if it and every subexpression
are monochromatic under `evalWord f` (with Kleene-plus subexpressions necessarily idempotent). -/
def IsWellTyped {α : Type u} {M : Type v} [Monoid M] (f : α → M) : PlusRegex α → M → Prop
  | .char a, m => f a = m
  | .union e₁ e₂, m => e₁.IsWellTyped f m ∧ e₂.IsWellTyped f m
  | .concat e₁ e₂, m => ∃ m₁ m₂, e₁.IsWellTyped f m₁ ∧ e₂.IsWellTyped f m₂ ∧ m₁ * m₂ = m
  | .plus e, m => m * m = m ∧ e.IsWellTyped f m

/-- Membership characterization for a single-letter `PlusRegex`. -/
@[simp]
theorem mem_lang_char_iff {α : Type u} (a : α) (w : List α) :
    w ∈ (char a).lang ↔ w = [a] := Iff.rfl

/-- Membership characterization for a union `PlusRegex`. -/
theorem mem_lang_union_iff {α : Type u} (e₁ e₂ : PlusRegex α) (w : List α) :
    w ∈ (union e₁ e₂).lang ↔ w ∈ e₁.lang ∨ w ∈ e₂.lang := Iff.rfl

/-- Membership characterization for a concatenation `PlusRegex`. -/
theorem mem_lang_concat_iff {α : Type u} (e₁ e₂ : PlusRegex α) (w : List α) :
    w ∈ (concat e₁ e₂).lang ↔ ∃ u ∈ e₁.lang, ∃ v ∈ e₂.lang, w = u ++ v := Iff.rfl

/-- Membership characterization for a Kleene-plus `PlusRegex`. -/
theorem mem_lang_plus_iff {α : Type u} (e : PlusRegex α) (w : List α) :
    w ∈ (plus e).lang ↔
      ∃ ws : List (List α), 1 ≤ ws.length ∧ (∀ u ∈ ws, u ∈ e.lang) ∧ w = ws.flatten := Iff.rfl

/-- Well-typedness characterization for a single-letter `PlusRegex`. -/
@[simp]
theorem isWellTyped_char_iff {α : Type u} {M : Type v} [Monoid M] (f : α → M) (a : α) (m : M) :
    (char a).IsWellTyped f m ↔ f a = m := Iff.rfl

/-- Well-typedness characterization for a union `PlusRegex`. -/
theorem isWellTyped_union_iff {α : Type u} {M : Type v} [Monoid M] (f : α → M)
    (e₁ e₂ : PlusRegex α) (m : M) :
    (union e₁ e₂).IsWellTyped f m ↔ e₁.IsWellTyped f m ∧ e₂.IsWellTyped f m := Iff.rfl

/-- Well-typedness characterization for a concatenation `PlusRegex`. -/
theorem isWellTyped_concat_iff {α : Type u} {M : Type v} [Monoid M] (f : α → M)
    (e₁ e₂ : PlusRegex α) (m : M) :
    (concat e₁ e₂).IsWellTyped f m ↔
      ∃ m₁ m₂, e₁.IsWellTyped f m₁ ∧ e₂.IsWellTyped f m₂ ∧ m₁ * m₂ = m := Iff.rfl

/-- Well-typedness characterization for a Kleene-plus `PlusRegex`. -/
theorem isWellTyped_plus_iff {α : Type u} {M : Type v} [Monoid M] (f : α → M)
    (e : PlusRegex α) (m : M) :
    (plus e).IsWellTyped f m ↔ m * m = m ∧ e.IsWellTyped f m := Iff.rfl

/-- Every word matched by a `PlusRegex` is nonempty. -/
theorem word_ne_nil_of_mem_lang {α : Type u} {e : PlusRegex α} {w : List α} (hw : w ∈ e.lang) :
    w ≠ [] := by
  induction e generalizing w with
  | char a =>
    rcases Set.mem_singleton_iff.mp hw with rfl
    simp
  | union e₁ e₂ ih₁ ih₂ =>
    rcases hw with h | h
    · exact ih₁ h
    · exact ih₂ h
  | concat e₁ e₂ ih₁ _ =>
    rcases hw with ⟨u, hu, v, _, rfl⟩
    simp [ih₁ hu]
  | plus e ih =>
    rcases hw with ⟨ws, hlen, hall, rfl⟩
    cases ws with
    | nil => simp at hlen
    | cons u ws' =>
      simp [ih (hall u (by simp))]

/-- Every word in the language of a well-typed `PlusRegex` evaluates to its type `m`. -/
theorem evalWord_eq_of_isWellTyped {α : Type u} {M : Type v} [Monoid M] {f : α → M}
    {e : PlusRegex α} {m : M} (ht : e.IsWellTyped f m) {w : List α} (hw : w ∈ e.lang) :
    evalWord f w = m := by
  induction e generalizing m w with
  | char a =>
    rcases Set.mem_singleton_iff.mp hw with rfl
    simpa using ht
  | union e₁ e₂ ih₁ ih₂ =>
    rcases hw with h | h
    · exact ih₁ ht.1 h
    · exact ih₂ ht.2 h
  | concat e₁ e₂ ih₁ ih₂ =>
    rcases ht with ⟨m₁, m₂, h1, h2, rfl⟩
    rcases hw with ⟨u, hu, v, hv, rfl⟩
    rw [evalWord_append, ih₁ h1 hu, ih₂ h2 hv]
  | plus e ih =>
    rcases ht with ⟨hidem, he⟩
    rcases hw with ⟨ws, hlen, hall, rfl⟩
    exact evalWord_eq_of_forall_eq f hidem hlen (fun u hu ↦ ih he (hall u hu))

end PlusRegex

private def foldUnion {α : Type u} (s : List (PlusRegex α)) (hs : s ≠ []) : PlusRegex α :=
  match s, hs with
  | [e], _ => e
  | e :: e' :: es, _ => .union e (foldUnion (e' :: es) (by simp))

private lemma mem_lang_foldUnion_iff {α : Type u} (s : List (PlusRegex α)) (hs : s ≠ [])
    (w : List α) : w ∈ (foldUnion s hs).lang ↔ ∃ e ∈ s, w ∈ e.lang := by
  induction s with
  | nil => contradiction
  | cons e es ih =>
    cases es with
    | nil => simp [foldUnion]
    | cons e' es' =>
      simp only [foldUnion, PlusRegex.lang, Set.mem_union, ih (by simp), List.mem_cons]
      constructor
      · rintro (h | ⟨e₀, he₀, hw⟩)
        · exact ⟨e, Or.inl rfl, h⟩
        · exact ⟨e₀, Or.inr he₀, hw⟩
      · rintro ⟨e₀, rfl | he₀, hw⟩
        · exact Or.inl hw
        · exact Or.inr ⟨e₀, he₀, hw⟩

private lemma isWellTyped_foldUnion {α : Type u} {M : Type v} [Monoid M] {f : α → M}
    (s : List (PlusRegex α)) (hs : s ≠ []) {m : M}
    (hall : ∀ e ∈ s, e.IsWellTyped f m) : (foldUnion s hs).IsWellTyped f m := by
  induction s with
  | nil => contradiction
  | cons e es ih =>
    cases es with
    | nil => exact hall e (by simp)
    | cons e' es' =>
      exact ⟨hall e (by simp),
        ih (by simp) (fun x hx ↦ hall x (List.mem_cons_of_mem _ hx))⟩

/-- **Bojańczyk's Theorem**: for any finite alphabet `α`, finite monoid `M`, and letter map
`f : α → M`, there exists a finite set `E` of well-typed `PlusRegex` expressions covering all
nonempty words in `List α`. -/
theorem exists_wellTyped_plusRegex_covering {α : Type u} {M : Type v}
    [Finite α] [Monoid M] [Finite M] (f : α → M) :
    ∃ E : Finset (PlusRegex α),
      (∀ e ∈ E, ∃ m : M, e.IsWellTyped f m) ∧
      (∀ w : List α, w ≠ [] → ∃ e ∈ E, w ∈ e.lang) := by
  classical
  let _ : Fintype α := Fintype.ofFinite α
  let _ : Fintype M := Fintype.ofFinite M
  obtain ⟨H, hH⟩ := exists_factorizationTree_of_finite (α := α) (M := M)
  have hstep : ∀ h : ℕ, ∃ R : Finset (PlusRegex α),
      (∀ e ∈ R, ∃ m : M, e.IsWellTyped f m) ∧
      (∀ t : FactorizationTree α, t.IsWellFormed f → t.height ≤ h →
        ∃ e ∈ R, t.word ∈ e.lang) := by
    intro h
    induction h with
    | zero =>
      refine ⟨Finset.univ.image PlusRegex.char, ?_, ?_⟩
      · intro e he
        rcases Finset.mem_image.mp he with ⟨a, _, rfl⟩
        exact ⟨f a, rfl⟩
      · intro t ht hht
        cases t with
        | leaf a =>
          exact ⟨.char a, Finset.mem_image.mpr ⟨a, Finset.mem_univ a, rfl⟩,
            by simp [PlusRegex.lang]⟩
        | bin _ _ => simp at hht
        | idem _ => simp at hht
    | succ h ih =>
      obtain ⟨R, hR_wt, hR_cov⟩ := ih
      let byType (m : M) : List (PlusRegex α) := (R.filter (fun e ↦ e.IsWellTyped f m)).toList
      let R_bin : Finset (PlusRegex α) :=
        (R ×ˢ R).image (fun p ↦ PlusRegex.concat p.1 p.2)
      let R_idem : Finset (PlusRegex α) :=
        (Finset.univ.filter (fun m : M ↦ m * m = m ∧ byType m ≠ [])).attach.image
          (fun m ↦ PlusRegex.plus (foldUnion (byType m.val)
            (Finset.mem_filter.mp m.property).2.2))
      refine ⟨R ∪ R_bin ∪ R_idem, ?_, ?_⟩
      · intro e he
        simp only [Finset.mem_union] at he
        rcases he with (he | he) | he
        · exact hR_wt e he
        · rcases Finset.mem_image.mp he with ⟨⟨e₁, e₂⟩, hp, rfl⟩
          rw [Finset.mem_product] at hp
          obtain ⟨m₁, hm₁⟩ := hR_wt e₁ hp.1
          obtain ⟨m₂, hm₂⟩ := hR_wt e₂ hp.2
          exact ⟨m₁ * m₂, m₁, m₂, hm₁, hm₂, rfl⟩
        · rcases Finset.mem_image.mp he with ⟨m, _, rfl⟩
          have hm := (Finset.mem_filter.mp m.property).2
          refine ⟨m.val, hm.1, isWellTyped_foldUnion (byType m.val) hm.2 ?_⟩
          intro x hx
          have hx' := Finset.mem_toList.mp hx
          exact (Finset.mem_filter.mp hx').2
      · intro t ht hht
        cases t with
        | leaf a =>
          obtain ⟨e, he, hw⟩ := hR_cov (.leaf a) (FactorizationTree.isWellFormed_leaf f a) (by simp)
          exact ⟨e, Finset.mem_union_left _ (Finset.mem_union_left _ he), hw⟩
        | bin t₁ t₂ =>
          simp only [FactorizationTree.height_bin] at hht
          rcases FactorizationTree.isWellFormed_bin_iff.mp ht with ⟨ht₁, ht₂⟩
          obtain ⟨e₁, he₁, hw₁⟩ := hR_cov t₁ ht₁ (by omega)
          obtain ⟨e₂, he₂, hw₂⟩ := hR_cov t₂ ht₂ (by omega)
          refine ⟨.concat e₁ e₂, Finset.mem_union_left _ (Finset.mem_union_right _ ?_), ?_⟩
          · exact Finset.mem_image.mpr ⟨(e₁, e₂), Finset.mem_product.mpr ⟨he₁, he₂⟩, rfl⟩
          · exact ⟨t₁.word, hw₁, t₂.word, hw₂, by simp⟩
        | idem ts =>
          rcases FactorizationTree.isWellFormed_idem_iff.mp ht with ⟨hlen, hval, e_m, he_m, heval⟩
          have hcov_child : ∀ t₁ ∈ ts, ∃ r₁ ∈ R, r₁.IsWellTyped f e_m ∧ t₁.word ∈ r₁.lang := by
            intro t₁ ht₁
            have ht₁_h : t₁.height ≤ h := by
              have := FactorizationTree.height_lt_of_mem_idem ht₁
              omega
            obtain ⟨r₁, hr₁, hw₁⟩ := hR_cov t₁ (hval t₁ ht₁) ht₁_h
            obtain ⟨m₁, hm₁⟩ := hR_wt r₁ hr₁
            have hm1_eq : m₁ = e_m := by
              rw [← PlusRegex.evalWord_eq_of_isWellTyped hm₁ hw₁, heval t₁ ht₁]
            exact ⟨r₁, hr₁, hm1_eq ▸ hm₁, hw₁⟩
          cases ts with
          | nil => simp at hlen
          | cons t₀ ts' =>
            obtain ⟨r₀, hr₀, hwt₀, hw₀⟩ := hcov_child t₀ (by simp)
            have hby_ne : byType e_m ≠ [] := by
              intro hnil
              have hmem : r₀ ∈ byType e_m :=
                Finset.mem_toList.mpr (Finset.mem_filter.mpr ⟨hr₀, hwt₀⟩)
              rw [hnil] at hmem; simp at hmem
            let em_sub : { m : M // m ∈ Finset.univ.filter (fun m : M ↦ m * m = m ∧
              byType m ≠ []) } :=
              ⟨e_m, Finset.mem_filter.mpr ⟨Finset.mem_univ _, he_m, hby_ne⟩⟩
            refine ⟨PlusRegex.plus (foldUnion (byType e_m) hby_ne),
              Finset.mem_union_right _ (Finset.mem_image.mpr ⟨em_sub, Finset.mem_attach _ _, rfl⟩),
              ?_⟩
            refine ⟨(t₀ :: ts').map FactorizationTree.word, by simp, ?_, by simp⟩
            intro u hu
            rcases List.mem_map.mp hu with ⟨t₁, ht₁, rfl⟩
            obtain ⟨r₁, hr₁, hwt₁, hw₁⟩ := hcov_child t₁ ht₁
            rw [mem_lang_foldUnion_iff]
            exact ⟨r₁, Finset.mem_toList.mpr (Finset.mem_filter.mpr ⟨hr₁, hwt₁⟩), hw₁⟩
  obtain ⟨R, hR_wt, hR_cov⟩ := hstep H
  refine ⟨R, hR_wt, ?_⟩
  intro w hw
  obtain ⟨t, htv, htw, hth⟩ := hH f w hw
  obtain ⟨e, he, hmem⟩ := hR_cov t htv hth
  exact ⟨e, he, htw ▸ hmem⟩

end Bojanczyk

/-! ### Private Non-Vacuity Example -/

private example : ∃ E : Finset (PlusRegex (Fin 2)),
    (∀ e ∈ E, ∃ m : ZMod 3, e.IsWellTyped (fun i ↦ if i = 0 then 0 else 2) m) ∧
    (∀ w : List (Fin 2), w ≠ [] → ∃ e ∈ E, w ∈ e.lang) :=
  exists_wellTyped_plusRegex_covering (fun i : Fin 2 ↦ if i = 0 then (0 : ZMod 3) else 2)

end CslibFrontier.Computability.Languages
