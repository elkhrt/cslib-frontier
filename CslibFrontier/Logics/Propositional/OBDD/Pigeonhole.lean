/-!
# Exponential Lower Bound on OBDD Refutations for Pigeonhole Formulas

Exponential proof-complexity lower bound for OBDD refutations of the propositional pigeonhole
formulas `Cslib.Logic.PL.CNF.pigeonhole (n + 1) n` under arbitrary total variable orderings.

## Main definitions

* `CslibFrontier.Logic.PL.OBDD.positiveClauses`: the positive (pigeon) clauses of `PHP_n`.
* `CslibFrontier.Logic.PL.OBDD.squareVars`: the `n × n` variable matrix of the first `n` pigeons.
* `CslibFrontier.Logic.PL.OBDD.lowerHalf`, `CslibFrontier.Logic.PL.OBDD.upperHalf`: the balanced
  split of `squareVars n` under variable order `ord`.
* `CslibFrontier.Logic.PL.OBDD.lowerVars`: the downward-closed variable prefix generated by
  `lowerHalf ord`.
* `CslibFrontier.Logic.PL.OBDD.splitColumns`: the set of columns having a hole clause in step `i`
  connecting an entry of `lowerHalf ord` to an entry of `upperHalf ord`.

## Main results

* `CslibFrontier.Logic.PL.OBDD.mem_formula_last_of_mem_pigeonhole`: minimal unsatisfiability of
  `PHP_n` forces every clause of `PHP_n` to appear in the final step of any OBDD refutation.
* `CslibFrontier.Logic.PL.OBDD.exists_intermediate_pigeon_clauses`: intermediate-size step for any
  subset of positive pigeon clauses of size `> 4`.
* `CslibFrontier.Logic.PL.OBDD.exists_intermediate_split_columns`: intermediate-size step for any
  subset of split columns of size `> 4`.
* `CslibFrontier.Logic.PL.OBDD.obdd_refutation_pigeonhole_exp_lower_bound`: for every `n ≥ 35`,
  every total variable order `ord`, and every OBDD refutation `R` of `PHP_n`,
  `(1.025 : ℝ) ^ n < R.size`.
* `CslibFrontier.Logic.PL.OBDD.obdd_refutation_pigeonhole_omega`: asymptotic `Ω(1.025 ^ n)` lower
  bound across all variable orderings.
* `CslibFrontier.Logic.PL.OBDD.obdd_refutation_pigeonhole_nonvacuous`: existence of valid OBDD
  refutations of `PHP_n` for every `n` and every variable order.
-/

public section

namespace CslibFrontier.Logic.PL.OBDD

open CslibFrontier.BranchingPrograms

open Cslib.Logic.PL Finset

/-! ### Minimal unsatisfiability of `PHP_n` -/

/-- `PHP_n = CNF.pigeonhole (n + 1) n` is nonempty for every `n`. -/
theorem pigeonhole_ne_nil (n : ℕ) : CNF.pigeonhole (n + 1) n ≠ [] := by
  intro h
  have hmem : CNF.pigeonClause n (0 : Fin (n + 1)) ∈ CNF.pigeonhole (n + 1) n :=
    CNF.mem_pigeonhole.2 (Or.inl ⟨0, rfl⟩)
  rw [h] at hmem
  cases hmem

/-- Removing any single pigeon clause from `PHP_n` leaves a satisfiable formula. -/
theorem satisfiable_without_pigeonClause (n : ℕ) (i₀ : Fin (n + 1)) :
    ∃ σ : Fin (n + 1) × Fin n → Bool,
      ∀ c ∈ CNF.pigeonhole (n + 1) n, c ≠ CNF.pigeonClause n i₀ → c.eval σ = true := by
  let idx : Fin (n + 1) → ℕ := fun i => if i.val < i₀.val then i.val else i.val - 1
  let σ : Fin (n + 1) × Fin n → Bool := fun p => decide (p.1 ≠ i₀ ∧ p.2.val = idx p.1)
  refine ⟨σ, fun c hc hne => ?_⟩
  rcases CNF.mem_pigeonhole.1 hc with ⟨i, rfl⟩ | ⟨i, i', j, hii', rfl⟩
  · have hi : i ≠ i₀ := fun h => hne (by rw [h])
    rw [CNF.eval_pigeonClause]
    have hlt : idx i < n := by
      dsimp only [idx]
      have h1 : i.val ≠ i₀.val := fun h => hi (Fin.ext h)
      split_ifs <;> omega
    refine ⟨⟨idx i, hlt⟩, ?_⟩
    simp [σ, hi]
  · rw [CNF.eval_holeClause]
    by_contra h
    push Not at h
    have h1 : σ (i, j) = true := by cases hs : σ (i, j) <;> simp_all
    have h2 : σ (i', j) = true := by cases hs : σ (i', j) <;> simp_all
    simp only [σ, decide_eq_true_eq] at h1 h2
    have hi : i.val ≠ i₀.val := fun he => h1.1 (Fin.ext he)
    have hi' : i'.val ≠ i₀.val := fun he => h2.1 (Fin.ext he)
    have hidx : idx i = idx i' := h1.2.symm.trans h2.2
    dsimp only [idx] at hidx
    have hlt : i.val < i'.val := hii'
    split_ifs at hidx <;> omega

/-- Removing any single hole clause from `PHP_n` leaves a satisfiable formula. -/
theorem satisfiable_without_holeClause (n : ℕ) {i₀ i₁ : Fin (n + 1)} (h01 : i₀ < i₁)
    (j₀ : Fin n) :
    ∃ σ : Fin (n + 1) × Fin n → Bool,
      ∀ c ∈ CNF.pigeonhole (n + 1) n, c ≠ CNF.holeClause i₀ i₁ j₀ → c.eval σ = true := by
  let shiftP : Fin (n + 1) → ℕ := fun i =>
    i.val - (if i₀.val < i.val then 1 else 0) - (if i₁.val < i.val then 1 else 0)
  let shiftH : ℕ → ℕ := fun k => if k < j₀.val then k else k + 1
  let dest : Fin (n + 1) → ℕ := fun i => if i = i₀ ∨ i = i₁ then j₀.val else shiftH (shiftP i)
  let σ : Fin (n + 1) × Fin n → Bool := fun p => decide (p.2.val = dest p.1)
  have h01v : i₀.val < i₁.val := h01
  have hdest_lt : ∀ i : Fin (n + 1), dest i < n := by
    intro i
    dsimp only [dest]
    split_ifs with h
    · exact j₀.isLt
    · push Not at h
      have hi0 : i.val ≠ i₀.val := fun he => h.1 (Fin.ext he)
      have hi1 : i.val ≠ i₁.val := fun he => h.2 (Fin.ext he)
      have hsp : shiftP i + 1 < n := by
        dsimp only [shiftP]
        split_ifs <;> omega
      dsimp only [shiftH]
      split_ifs <;> omega
  refine ⟨σ, fun c hc hne => ?_⟩
  rcases CNF.mem_pigeonhole.1 hc with ⟨i, rfl⟩ | ⟨i, i', j, hii', rfl⟩
  · rw [CNF.eval_pigeonClause]
    exact ⟨⟨dest i, hdest_lt i⟩, by simp [σ]⟩
  · rw [CNF.eval_holeClause]
    by_contra h
    push Not at h
    have h1 : σ (i, j) = true := by cases hs : σ (i, j) <;> simp_all
    have h2 : σ (i', j) = true := by cases hs : σ (i', j) <;> simp_all
    simp only [σ, decide_eq_true_eq] at h1 h2
    have hdeq : dest i = dest i' := h1.symm.trans h2
    have hlt : i.val < i'.val := hii'
    have hsh_ne : ∀ k, shiftH k ≠ j₀.val := by
      intro k; dsimp only [shiftH]; split_ifs <;> omega
    have hsh_inj : ∀ k₁ k₂, shiftH k₁ = shiftH k₂ → k₁ = k₂ := by
      intro k₁ k₂ hk; dsimp only [shiftH] at hk; split_ifs at hk <;> omega
    dsimp only [dest] at hdeq
    split_ifs at hdeq with hA hB hB
    · have hcase : i = i₀ ∧ i' = i₁ := by
        rcases hA with rfl | rfl <;> rcases hB with rfl | rfl
        · exact absurd rfl hii'.ne
        · exact ⟨rfl, rfl⟩
        · exact absurd (lt_trans h01 hii') (lt_irrefl _)
        · exact absurd rfl hii'.ne
      rcases hcase with ⟨rfl, rfl⟩
      have hj : j = j₀ := Fin.ext (by simpa [dest] using h1)
      subst hj
      exact hne rfl
    · exact absurd hdeq.symm (hsh_ne _)
    · exact absurd hdeq (hsh_ne _)
    · push Not at hA hB
      have hi0 : i.val ≠ i₀.val := fun he => hA.1 (Fin.ext he)
      have hi1 : i.val ≠ i₁.val := fun he => hA.2 (Fin.ext he)
      have hi'0 : i'.val ≠ i₀.val := fun he => hB.1 (Fin.ext he)
      have hi'1 : i'.val ≠ i₁.val := fun he => hB.2 (Fin.ext he)
      have hsp := hsh_inj _ _ hdeq
      dsimp only [shiftP] at hsp
      split_ifs at hsp <;> omega

/-- By minimal unsatisfiability of `PHP_n`, every clause of `PHP_n` must appear in the final step
of any OBDD refutation of `PHP_n`. -/
theorem mem_formula_last_of_mem_pigeonhole {n : ℕ}
    {ord : LinearOrder (Fin (n + 1) × Fin n)}
    (R : OBDDRefutation ord (CNF.pigeonhole (n + 1) n))
    {c : Clause (Fin (n + 1) × Fin n)} (hc : c ∈ CNF.pigeonhole (n + 1) n) :
    c ∈ R.formula ⟨R.length - 1, Nat.sub_lt R.length_pos Nat.zero_lt_one⟩ := by
  by_contra hnot
  have hsat : ∃ σ : Fin (n + 1) × Fin n → Bool,
      ∀ c' ∈ CNF.pigeonhole (n + 1) n, c' ≠ c → c'.eval σ = true := by
    rcases CNF.mem_pigeonhole.1 hc with ⟨i, rfl⟩ | ⟨i, i', j, hii', rfl⟩
    · exact satisfiable_without_pigeonClause n i
    · exact satisfiable_without_holeClause n hii' j
  obtain ⟨σ, hσ⟩ := hsat
  apply R.not_satisfiable_last
  refine ⟨σ, (CNF.eval_eq_true_iff σ _).2 fun c' hc' => ?_⟩
  exact hσ c' (R.mem_of_mem_formula _ hc') (fun heq => hnot (heq ▸ hc'))

/-- Every clause in `PHP_n` equals the clause set of the final step of any OBDD refutation. -/
theorem clauses_last_eq_pigeonhole {n : ℕ}
    {ord : LinearOrder (Fin (n + 1) × Fin n)}
    (R : OBDDRefutation ord (CNF.pigeonhole (n + 1) n)) :
    R.clauses ⟨R.length - 1, Nat.sub_lt R.length_pos Nat.zero_lt_one⟩ =
      (CNF.pigeonhole (n + 1) n).toFinset := by
  ext c
  simp only [OBDDRefutation.mem_clauses_iff, List.mem_toFinset]
  exact ⟨fun hc => R.mem_of_mem_formula _ hc, fun hc => mem_formula_last_of_mem_pigeonhole R hc⟩

/-! ### Variable partitions and clause subsets for `PHP_n` -/

/-- The positive (pigeon) clauses `Cls(PC_n)` of `PHP_n`. -/
def positiveClauses (n : ℕ) : Finset (Clause (Fin (n + 1) × Fin n)) :=
  Finset.univ.image (CNF.pigeonClause n)

/-- The `n × n` matrix of variables `Var(PC_n^*)` from the first `n` pigeons. -/
def squareVars (n : ℕ) : Finset (Fin (n + 1) × Fin n) :=
  Finset.univ.image fun p : Fin n × Fin n => (p.1.castSucc, p.2)

/-- `squareVars n` has cardinality `n ^ 2`. -/
theorem card_squareVars (n : ℕ) : (squareVars n).card = n ^ 2 := by
  unfold squareVars
  have hinj : Function.Injective (fun p : Fin n × Fin n => (p.1.castSucc, p.2)) := by
    rintro ⟨a₁, b₁⟩ ⟨a₂, b₂⟩ h
    simp only [Prod.mk.injEq] at h
    exact Prod.ext (Fin.castSucc_injective n h.1) h.2
  rw [Finset.card_image_of_injective _ hinj, Finset.card_univ, Fintype.card_prod,
    Fintype.card_fin, Nat.pow_two]

/-- The set `S_≺` of the `⌊n ^ 2 / 2⌋` smallest elements of `Var(PC_n^*)` with respect to `ord`
-/
def lowerHalf {n : ℕ} (ord : LinearOrder (Fin (n + 1) × Fin n)) :
    Finset (Fin (n + 1) × Fin n) :=
  (Finset.univ.filter fun k : Fin (n ^ 2) => k.val < n ^ 2 / 2).image
    (@Finset.orderEmbOfFin _ ord (squareVars n) _ (card_squareVars n))

/-- The complement `S_⪰ = Var(PC_n^*) \ S_≺` -/
def upperHalf {n : ℕ} (ord : LinearOrder (Fin (n + 1) × Fin n)) :
    Finset (Fin (n + 1) × Fin n) :=
  squareVars n \ lowerHalf ord

/-- The downward-closed prefix `S_≺^* = { v ∈ Var(PHP_n) | v ≼ max S_≺ }`
-/
def lowerVars {n : ℕ} (ord : LinearOrder (Fin (n + 1) × Fin n)) :
    Finset (Fin (n + 1) × Fin n) :=
  let _ : ∀ a b, Decidable (ord.le a b) := ord.toDecidableLE
  Finset.univ.filter fun v => ∃ u ∈ lowerHalf ord, ord.le v u

/-- `lowerHalf ord` is a subset of `squareVars n`. -/
theorem lowerHalf_subset_squareVars {n : ℕ} (ord : LinearOrder (Fin (n + 1) × Fin n)) :
    lowerHalf ord ⊆ squareVars n := by
  intro v hv
  unfold lowerHalf at hv
  obtain ⟨k, _, rfl⟩ := Finset.mem_image.1 hv
  exact @Finset.orderEmbOfFin_mem _ ord (squareVars n) _ (card_squareVars n) k

/-- `lowerHalf ord` has cardinality `n ^ 2 / 2`. -/
theorem card_lowerHalf {n : ℕ} (ord : LinearOrder (Fin (n + 1) × Fin n)) :
    (lowerHalf ord).card = n ^ 2 / 2 := by
  unfold lowerHalf
  rw [Finset.card_image_of_injective _
    (@Finset.orderEmbOfFin _ ord (squareVars n) _ (card_squareVars n)).injective]
  have hle : n ^ 2 / 2 ≤ n ^ 2 := Nat.div_le_self _ _
  have hbij : (Finset.univ.filter fun k : Fin (n ^ 2) => k.val < n ^ 2 / 2) =
      Finset.univ.image (Fin.castLEEmb hle) := by
    ext k
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_image]
    constructor
    · intro hk
      exact ⟨⟨k.val, hk⟩, Fin.ext rfl⟩
    · rintro ⟨j, rfl⟩
      exact j.isLt
  rw [hbij, Finset.card_image_of_injective _ (Fin.castLEEmb hle).injective, Finset.card_fin]

/-- `upperHalf ord` has cardinality `n ^ 2 - n ^ 2 / 2`. -/
theorem card_upperHalf {n : ℕ} (ord : LinearOrder (Fin (n + 1) × Fin n)) :
    (upperHalf ord).card = n ^ 2 - n ^ 2 / 2 := by
  unfold upperHalf
  rw [Finset.card_sdiff, Finset.inter_eq_left.2 (lowerHalf_subset_squareVars ord),
    card_squareVars, card_lowerHalf]

/-- Every element of `lowerHalf ord` is strictly smaller in `ord` than every element of
`upperHalf ord`. -/
theorem lowerHalf_lt_upperHalf {n : ℕ} (ord : LinearOrder (Fin (n + 1) × Fin n))
    {u w : Fin (n + 1) × Fin n} (hu : u ∈ lowerHalf ord) (hw : w ∈ upperHalf ord) :
    ord.lt u w := by
  set emb := @Finset.orderEmbOfFin _ ord (squareVars n) _ (card_squareVars n)
  have hu' : u ∈ lowerHalf ord := hu
  unfold lowerHalf at hu'
  obtain ⟨k₁, hk₁, rfl⟩ := Finset.mem_image.1 hu'
  have hk₁_lt : k₁.val < n ^ 2 / 2 := (Finset.mem_filter.1 hk₁).2
  have hw_sq : w ∈ squareVars n := (Finset.mem_sdiff.1 hw).1
  have hw_not : w ∉ lowerHalf ord := (Finset.mem_sdiff.1 hw).2
  have hrange : Set.range emb = (squareVars n : Set _) :=
    @Finset.range_orderEmbOfFin _ ord (squareVars n) _ (card_squareVars n)
  have hw_mem_range : w ∈ Set.range emb := by
    rw [hrange]; exact hw_sq
  obtain ⟨k₂, rfl⟩ := hw_mem_range
  have hk₂_ge : n ^ 2 / 2 ≤ k₂.val := by
    by_contra hlt
    apply hw_not
    unfold lowerHalf
    exact Finset.mem_image.2
      ⟨k₂, Finset.mem_filter.2 ⟨Finset.mem_univ _, Nat.lt_of_not_ge hlt⟩, rfl⟩
  have hk_lt : k₁ < k₂ := Fin.lt_def.2 (by omega)
  exact @OrderEmbedding.strictMono _ _ _ ord.toPreorder emb k₁ k₂ hk_lt

/-- `lowerVars ord` is downward-closed under `ord`. -/
theorem lowerVars_downward {n : ℕ} (ord : LinearOrder (Fin (n + 1) × Fin n))
    {u w : Fin (n + 1) × Fin n} (hu : u ∈ lowerVars ord) (hlt : ord.lt w u) :
    w ∈ lowerVars ord := by
  unfold lowerVars at hu ⊢
  obtain ⟨_, v, hv, huv⟩ := Finset.mem_filter.1 hu
  exact Finset.mem_filter.2
    ⟨Finset.mem_univ _, v, hv, ord.le_trans _ _ _ (@le_of_lt _ ord.toPreorder _ _ hlt) huv⟩

/-- `lowerHalf ord ⊆ lowerVars ord`. -/
theorem lowerHalf_subset_lowerVars {n : ℕ} (ord : LinearOrder (Fin (n + 1) × Fin n)) :
    lowerHalf ord ⊆ lowerVars ord := by
  intro u hu
  exact Finset.mem_filter.2 ⟨Finset.mem_univ _, u, hu, ord.le_refl u⟩

/-- `upperHalf ord` is disjoint from `lowerVars ord`. -/
theorem disjoint_upperHalf_lowerVars {n : ℕ} (ord : LinearOrder (Fin (n + 1) × Fin n)) :
    Disjoint (upperHalf ord) (lowerVars ord) := by
  rw [Finset.disjoint_left]
  intro w hw_up hw_lo
  obtain ⟨_, u, hu, hwu⟩ := Finset.mem_filter.1 hw_lo
  exact @not_lt_of_ge _ ord.toPreorder _ _ hwu (lowerHalf_lt_upperHalf ord hu hw_up)

/-- Column `j` is *split* in formula `φ` (under ordering `ord`) if `φ` contains a hole clause
connecting a variable of column `j` in `S_≺` to a variable of column `j` in `S_⪰`
-/
def HasSplitHoleClause {n : ℕ} (ord : LinearOrder (Fin (n + 1) × Fin n))
    (φ : CNF (Fin (n + 1) × Fin n)) (j : Fin n) : Prop :=
  ∃ a b : Fin n,
    (a.castSucc, j) ∈ lowerHalf ord ∧
    (b.castSucc, j) ∈ upperHalf ord ∧
    (CNF.holeClause a.castSucc b.castSucc j ∈ φ ∨ CNF.holeClause b.castSucc a.castSucc j ∈ φ)

/-- The set `J_i` of split columns in step `i` of an OBDD refutation of `PHP_n`
-/
noncomputable def splitColumns {n : ℕ} (ord : LinearOrder (Fin (n + 1) × Fin n))
    (R : OBDDRefutation ord (CNF.pigeonhole (n + 1) n)) (i : Fin R.length) : Finset (Fin n) := by
  classical
  exact Finset.univ.filter fun j => HasSplitHoleClause ord (R.formula i) j

/-- Membership characterization for `splitColumns`. -/
theorem mem_splitColumns_iff {n : ℕ} (ord : LinearOrder (Fin (n + 1) × Fin n))
    (R : OBDDRefutation ord (CNF.pigeonhole (n + 1) n)) (i : Fin R.length) (j : Fin n) :
    j ∈ splitColumns ord R i ↔ HasSplitHoleClause ord (R.formula i) j := by
  classical
  unfold splitColumns
  simp

/-! ### Intermediate pigeon-clause and split-column steps -/

/-- **Intermediate pigeon-clause step**:
For any OBDD refutation `R` of `PHP_n` and any subset `S ⊆ Cls(PC_n)` with `4 < |S|`, there is an
intermediate step `i < l - 1` with `|S| / 4 ≤ |Cls(B_i) ∩ S| < 2 |S| / 4`. -/
theorem exists_intermediate_pigeon_clauses {n : ℕ}
    (ord : LinearOrder (Fin (n + 1) × Fin n))
    (R : OBDDRefutation ord (CNF.pigeonhole (n + 1) n))
    (S : Finset (Clause (Fin (n + 1) × Fin n)))
    (hS_sub : S ⊆ positiveClauses n) (hS_card : 4 < S.card) :
    ∃ i : Fin R.length, i.val + 1 < R.length ∧
      (S.card : ℝ) / 4 ≤ ((R.clauses i ∩ S).card : ℝ) ∧
      ((R.clauses i ∩ S).card : ℝ) < 2 * (S.card : ℝ) / 4 := by
  have hC_sub : S ⊆ (CNF.pigeonhole (n + 1) n).toFinset := by
    intro c hc
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.1 (hS_sub hc)
    exact List.mem_toFinset.2 (CNF.mem_pigeonhole.2 (Or.inl ⟨i, rfl⟩))
  have ha_lo : (1 : ℝ) / S.card < 1 / 4 := by
    have hS_pos : (0 : ℝ) < S.card := by exact_mod_cast (show 0 < S.card by omega)
    have h4 : (4 : ℝ) < S.card := by exact_mod_cast hS_card
    rw [div_lt_div_iff₀ hS_pos (by norm_num)]
    linarith
  obtain ⟨i, hi_lt, hlo, hhi⟩ := exists_intermediate_union_card R.length_pos
    (CNF.pigeonhole (n + 1) n).toFinset S hC_sub (by omega) R.clauses
    (clauses_last_eq_pigeonhole R)
    (fun k => by
      rcases R.step k with ⟨c, hc, hform⟩ | ⟨k₁, k₂, hk₁, hk₂, hunion⟩
      · right; left
        refine ⟨c, List.mem_toFinset.2 hc, ?_⟩
        ext x
        simp [OBDDRefutation.mem_clauses_iff, hform]
      · right; right
        refine ⟨k₁, k₂, hk₁, hk₂, ?_⟩
        ext x
        simp [OBDDRefutation.mem_clauses_iff, hunion])
    ha_lo (by norm_num)
  refine ⟨i, hi_lt, by linarith, by linarith⟩

/-- **Intermediate split-column step**:
If `R` is an OBDD refutation of `PHP_n` under `ord`, and `P' ⊆ Fin n` satisfies `4 < |P'|` and
every column in `P'` contains both an entry in `S_≺` and an entry in `S_⪰`, then there exists
`i < l - 1` with `|P'| / 4 ≤ |J_i ∩ P'| < |P'| / 2`. -/
theorem exists_intermediate_split_columns {n : ℕ}
    (ord : LinearOrder (Fin (n + 1) × Fin n))
    (R : OBDDRefutation ord (CNF.pigeonhole (n + 1) n))
    (P' : Finset (Fin n)) (hP'_card : 4 < P'.card)
    (hsplit : ∀ j ∈ P',
      (∃ a : Fin n, (a.castSucc, j) ∈ lowerHalf ord) ∧
      (∃ b : Fin n, (b.castSucc, j) ∈ upperHalf ord)) :
    ∃ i : Fin R.length, i.val + 1 < R.length ∧
      (P'.card : ℝ) / 4 ≤ ((splitColumns ord R i ∩ P').card : ℝ) ∧
      ((splitColumns ord R i ∩ P').card : ℝ) < (P'.card : ℝ) / 2 := by
  classical
  let lastIdx : Fin R.length := ⟨R.length - 1, Nat.sub_lt R.length_pos Nat.zero_lt_one⟩
  let C : Finset (Fin n) := splitColumns ord R lastIdx
  have hP'_sub : P' ⊆ C := by
    intro j hj
    obtain ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ := hsplit j hj
    have hne : a ≠ b := by
      intro heq
      subst heq
      exact (Finset.mem_sdiff.1 hb).2 ha
    refine (mem_splitColumns_iff ord R lastIdx j).2 ⟨a, b, ha, hb, ?_⟩
    rcases lt_or_gt_of_ne hne with hlt | hlt
    · left
      exact mem_formula_last_of_mem_pigeonhole R
        (CNF.mem_pigeonhole.2 (Or.inr ⟨a.castSucc, b.castSucc, j,
          Fin.castSucc_lt_castSucc_iff.2 hlt, rfl⟩))
    · right
      exact mem_formula_last_of_mem_pigeonhole R
        (CNF.mem_pigeonhole.2 (Or.inr ⟨b.castSucc, a.castSucc, j,
          Fin.castSucc_lt_castSucc_iff.2 hlt, rfl⟩))
  have ha_lo : (1 : ℝ) / P'.card < 1 / 4 := by
    have hP'_pos : (0 : ℝ) < P'.card := by exact_mod_cast (show 0 < P'.card by omega)
    have h4 : (4 : ℝ) < P'.card := by exact_mod_cast hP'_card
    rw [div_lt_div_iff₀ hP'_pos (by norm_num)]
    linarith
  obtain ⟨i, hi_lt, hlo, hhi⟩ := exists_intermediate_union_card R.length_pos
    C P' hP'_sub (by omega) (splitColumns ord R) rfl
    (fun k => by
      rcases R.step k with ⟨c, hc, hform⟩ | ⟨k₁, k₂, hk₁, hk₂, hunion⟩
      · rcases CNF.mem_pigeonhole.1 hc with ⟨p, rfl⟩ | ⟨p, q, j₀, hpq, rfl⟩
        · left
          ext j
          simp only [mem_splitColumns_iff, Finset.notMem_empty, iff_false, HasSplitHoleClause,
            hform, List.mem_singleton]
          rintro ⟨a, b, -, -, h1 | h2⟩
          · have hmem : ((a.castSucc, j), false) ∈ CNF.pigeonClause n p := by
              rw [← h1]; simp [CNF.holeClause]
            simp [CNF.pigeonClause] at hmem
          · have hmem : ((b.castSucc, j), false) ∈ CNF.pigeonClause n p := by
              rw [← h2]; simp [CNF.holeClause]
            simp [CNF.pigeonClause] at hmem
        · by_cases hj₀ : j₀ ∈ splitColumns ord R k
          · right; left
            refine ⟨j₀, ?_, ?_⟩
            · simp only [C, mem_splitColumns_iff, HasSplitHoleClause] at hj₀ ⊢
              obtain ⟨a, b, ha, hb, hmem⟩ := hj₀
              refine ⟨a, b, ha, hb, ?_⟩
              rcases hmem with h1 | h2
              · exact Or.inl (mem_formula_last_of_mem_pigeonhole R (R.mem_of_mem_formula k h1))
              · exact Or.inr (mem_formula_last_of_mem_pigeonhole R (R.mem_of_mem_formula k h2))
            · ext j
              simp only [Finset.mem_singleton]
              constructor
              · intro hj
                simp only [mem_splitColumns_iff, HasSplitHoleClause, hform,
                  List.mem_singleton] at hj
                obtain ⟨a, b, -, -, h1 | h2⟩ := hj
                · simp only [CNF.holeClause, List.cons.injEq, Prod.mk.injEq, and_true] at h1
                  exact h1.1.2
                · simp only [CNF.holeClause, List.cons.injEq, Prod.mk.injEq, and_true] at h2
                  exact h2.1.2
              · rintro rfl; exact hj₀
          · left
            ext j
            simp only [Finset.notMem_empty, iff_false]
            intro hj
            have hjj₀ : j = j₀ := by
              simp only [mem_splitColumns_iff, HasSplitHoleClause, hform,
                List.mem_singleton] at hj
              obtain ⟨a, b, -, -, h1 | h2⟩ := hj
              · simp only [CNF.holeClause, List.cons.injEq, Prod.mk.injEq, and_true] at h1
                exact h1.1.2
              · simp only [CNF.holeClause, List.cons.injEq, Prod.mk.injEq, and_true] at h2
                exact h2.1.2
            exact hj₀ (hjj₀ ▸ hj)
      · right; right
        refine ⟨k₁, k₂, hk₁, hk₂, ?_⟩
        ext j
        simp only [Finset.mem_union, mem_splitColumns_iff, HasSplitHoleClause, hunion]
        constructor
        · rintro ⟨a, b, ha, hb, (h1 | h2) | (h3 | h4)⟩
          · exact Or.inl ⟨a, b, ha, hb, Or.inl h1⟩
          · exact Or.inr ⟨a, b, ha, hb, Or.inl h2⟩
          · exact Or.inl ⟨a, b, ha, hb, Or.inr h3⟩
          · exact Or.inr ⟨a, b, ha, hb, Or.inr h4⟩
        · rintro (⟨a, b, ha, hb, h1 | h2⟩ | ⟨a, b, ha, hb, h1 | h2⟩)
          · exact ⟨a, b, ha, hb, Or.inl (Or.inl h1)⟩
          · exact ⟨a, b, ha, hb, Or.inr (Or.inl h2)⟩
          · exact ⟨a, b, ha, hb, Or.inl (Or.inr h1)⟩
          · exact ⟨a, b, ha, hb, Or.inr (Or.inr h2)⟩)
    ha_lo (by norm_num)
  refine ⟨i, hi_lt, by linarith, by linarith⟩

/-! ### Exponential lower bound for `PHP_n` -/

/-- Numerical bridge: for any `n : ℕ` and `k : ℕ` with `2 ≤ k` and `⌊matrixConst * n⌋ / 4 ≤ k`,
`(1.025 : ℝ) ^ n < (2 * 2 ^ k - 3 : ℕ)`. -/
private theorem one_point_zero_two_five_pow_lt {n k : ℕ} (hk2 : 2 ≤ k)
    (hk_ge : (Nat.floor (matrixConst * n) : ℝ) / 4 ≤ k) :
    (1.025 : ℝ) ^ n < ((2 * 2 ^ k - 3 : ℕ) : ℝ) := by
  -- Step 1: `(5/4) * 2 ^ k ≤ 2 * 2 ^ k - 3` since `2 ^ k ≥ 4`.
  have h2k_ge4 : 4 ≤ 2 ^ k := by
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ k := Nat.pow_le_pow_right (by norm_num) hk2
  have hlin : (5 : ℝ) / 4 * (2 : ℝ) ^ k ≤ ((2 * 2 ^ k - 3 : ℕ) : ℝ) := by
    have hsub : ((2 * 2 ^ k - 3 : ℕ) : ℝ) = 2 * (2 : ℝ) ^ k - 3 := by
      have : 3 ≤ 2 * 2 ^ k := by omega
      rw [Nat.cast_sub this]
      push_cast
      ring
    have h2kr : (4 : ℝ) ≤ (2 : ℝ) ^ k := by exact_mod_cast h2k_ge4
    linarith
  -- Step 2: `matrixConst * n / 4 - 1 / 4 < k`, hence `2 ^ (c*n/4 - 1/4) < 2 ^ k`.
  have hfl : matrixConst * n - 1 < (Nat.floor (matrixConst * n) : ℝ) :=
    Nat.sub_one_lt_floor (matrixConst * n)
  have hexp : matrixConst / 4 * (n : ℝ) - 1 / 4 < (k : ℝ) := by linarith
  have hpow_lt : (2 : ℝ) ^ (matrixConst / 4 * (n : ℝ) - 1 / 4) < (2 : ℝ) ^ k := by
    rw [← Real.rpow_natCast (2 : ℝ) k]
    exact Real.rpow_lt_rpow_of_exponent_lt (by norm_num) hexp
  -- Step 3: `1 < (5 / 4) * 2 ^ (-1 / 4)` since `2 < (5 / 4) ^ 4 = 625 / 256`.
  have hconst_gt : (1 : ℝ) < (5 / 4 : ℝ) * (2 : ℝ) ^ (-(1 / 4 : ℝ)) := by
    have h4 : (2 : ℝ) ^ (1 / 4 : ℝ) < 5 / 4 := by
      have hpow4 : ((2 : ℝ) ^ (1 / 4 : ℝ)) ^ (4 : ℕ) < (5 / 4 : ℝ) ^ (4 : ℕ) := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
        norm_num
      exact lt_of_pow_lt_pow_left₀ 4 (by norm_num) hpow4
    have hpos2 : (0 : ℝ) < (2 : ℝ) ^ (1 / 4 : ℝ) := by positivity
    rw [Real.rpow_neg (by norm_num), ← div_eq_mul_inv, one_lt_div hpos2]
    exact h4
  -- Step 4: `1.025 < 2 ^ (matrixConst / 4)` since `1.025 ^ 28 < 2 < 2 ^ (7 * matrixConst)`.
  have hbase_lt : (1.025 : ℝ) < (2 : ℝ) ^ (matrixConst / 4) := by
    have h7c : (1 : ℝ) < 28 * (matrixConst / 4) := by
      have h := one_div_seven_lt_matrixConst
      linarith
    have h28 : (1.025 : ℝ) ^ (28 : ℕ) < ((2 : ℝ) ^ (matrixConst / 4)) ^ (28 : ℕ) := by
      rw [← Real.rpow_natCast ((2 : ℝ) ^ (matrixConst / 4)) 28, ← Real.rpow_mul (by norm_num)]
      have h1 : (1.025 : ℝ) ^ (28 : ℕ) < (2 : ℝ) := by norm_num
      have h2 : (2 : ℝ) < (2 : ℝ) ^ (matrixConst / 4 * (28 : ℕ)) := by
        calc (2 : ℝ) = (2 : ℝ) ^ (1 : ℝ) := (Real.rpow_one 2).symm
          _ < (2 : ℝ) ^ (matrixConst / 4 * (28 : ℕ)) :=
            Real.rpow_lt_rpow_of_exponent_lt (by norm_num) (by push_cast; linarith)
      exact lt_trans h1 h2
    exact lt_of_pow_lt_pow_left₀ 28 (by positivity) h28
  -- Step 5: Combine all inequalities.
  have hpow_split : (2 : ℝ) ^ (matrixConst / 4 * (n : ℝ) - 1 / 4) =
      (2 : ℝ) ^ (-(1 / 4 : ℝ)) * ((2 : ℝ) ^ (matrixConst / 4)) ^ n := by
    rw [sub_eq_add_neg, Real.rpow_add (by norm_num), mul_comm,
      ← Real.rpow_natCast ((2 : ℝ) ^ (matrixConst / 4)) n, ← Real.rpow_mul (by norm_num)]
  have hbase_pow : (1.025 : ℝ) ^ n ≤ ((2 : ℝ) ^ (matrixConst / 4)) ^ n :=
    pow_le_pow_left₀ (by norm_num) hbase_lt.le n
  have hpos_pow : (0 : ℝ) < ((2 : ℝ) ^ (matrixConst / 4)) ^ n := by positivity
  calc (1.025 : ℝ) ^ n ≤ 1 * ((2 : ℝ) ^ (matrixConst / 4)) ^ n := by linarith
    _ < ((5 / 4 : ℝ) * (2 : ℝ) ^ (-(1 / 4 : ℝ))) * ((2 : ℝ) ^ (matrixConst / 4)) ^ n :=
        mul_lt_mul_of_pos_right hconst_gt hpos_pow
    _ = (5 / 4 : ℝ) * (2 : ℝ) ^ (matrixConst / 4 * (n : ℝ) - 1 / 4) := by
        rw [hpow_split]; ring
    _ < (5 / 4 : ℝ) * (2 : ℝ) ^ k := mul_lt_mul_of_pos_left hpow_lt (by norm_num)
    _ ≤ ((2 * 2 ^ k - 3 : ℕ) : ℝ) := hlin

/-- Row-matching case: given `m ≥ 5` rows each with a `lowerHalf` and `upperHalf` entry in
`2m` distinct columns, some intermediate OBDD has size `≥ 2 * 2 ^ k - 3` for some
`k ≥ m / 4` with `k ≥ 2`. -/
private theorem theorem_main_row_case {n m : ℕ} (hm5 : 5 ≤ m)
    (ord : LinearOrder (Fin (n + 1) × Fin n))
    (R : OBDDRefutation ord (CNF.pigeonhole (n + 1) n))
    (rows cT cF : Fin m ↪ Fin n)
    (hdisj : ∀ a b, cT a ≠ cF b)
    (hcol : ∀ a, (rows a |>.castSucc, cT a) ∈ lowerHalf ord ∧
      (rows a |>.castSucc, cF a) ∈ upperHalf ord) :
    ∃ (i : Fin R.length) (k : ℕ), 2 ≤ k ∧ (m : ℝ) / 4 ≤ k ∧
      2 * 2 ^ k - 3 ≤ (R.diagram i).internalSize := by
  classical
  have hn_pos : 0 < n := by
    have : 0 < m := by omega
    exact Fin.pos (rows ⟨0, this⟩)
  -- Distinct rows have distinct pigeon clauses when `n > 0`.
  have hpigeon_inj : Function.Injective (CNF.pigeonClause n : Fin (n + 1) → _) := by
    intro r₁ r₂ heq
    have hmem : ((r₁, ⟨0, hn_pos⟩), true) ∈ CNF.pigeonClause n r₂ := by
      rw [← heq]
      exact List.mem_map.2 ⟨⟨0, hn_pos⟩, List.mem_finRange _, rfl⟩
    obtain ⟨_, _, hlit⟩ := List.mem_map.1 hmem
    simp only [Prod.mk.injEq] at hlit
    exact hlit.1.1.symm
  let rowClause : Fin m ↪ Clause (Fin (n + 1) × Fin n) :=
    (rows.trans Fin.castSuccEmb).trans ⟨CNF.pigeonClause n, hpigeon_inj⟩
  let S_rows : Finset (Clause (Fin (n + 1) × Fin n)) := Finset.univ.image rowClause
  have hS_sub : S_rows ⊆ positiveClauses n := by
    intro c hc
    obtain ⟨a, _, rfl⟩ := Finset.mem_image.1 hc
    exact Finset.mem_image.2 ⟨(rows a).castSucc, Finset.mem_univ _, rfl⟩
  have hS_card : S_rows.card = m := by
    rw [Finset.card_image_of_injective _ rowClause.injective, Finset.card_fin]
  obtain ⟨i, _, hlo, hhi⟩ :=
    exists_intermediate_pigeon_clauses ord R S_rows hS_sub (by omega)
  let R_idx : Finset (Fin m) := Finset.univ.filter fun a => rowClause a ∈ R.clauses i
  have hR_card : R_idx.card = (R.clauses i ∩ S_rows).card := by
    have himg : R_idx.image rowClause = R.clauses i ∩ S_rows := by
      ext c
      simp only [R_idx, S_rows, Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and,
        Finset.mem_inter]
      constructor
      · rintro ⟨a, ha, rfl⟩; exact ⟨ha, ⟨a, rfl⟩⟩
      · rintro ⟨hc, a, rfl⟩; exact ⟨a, hc, rfl⟩
    rw [← himg, Finset.card_image_of_injective _ rowClause.injective]
  rw [hS_card, ← hR_card] at hlo hhi
  have hk2 : 2 ≤ R_idx.card := by
    have : (5 : ℝ) / 4 ≤ (R_idx.card : ℝ) := by
      have hm_r : (5 : ℝ) ≤ m := by exact_mod_cast hm5
      linarith
    have : 5 ≤ 4 * R_idx.card := by
      have : (5 : ℝ) ≤ 4 * (R_idx.card : ℝ) := by linarith
      exact_mod_cast this
    omega
  have h2R_lt : 2 * R_idx.card + 1 ≤ m := by
    have : 2 * (R_idx.card : ℝ) < (m : ℝ) := by linarith
    have : 2 * R_idx.card < m := by exact_mod_cast this
    omega
  -- Construct `A` and `Y` (entries in `S_≺` and `S_⪰` for rows in `R_idx`).
  let varA : Fin m ↪ Fin (n + 1) × Fin n :=
    ⟨fun a => ((rows a).castSucc, cT a), fun a b h => by
      simp only [Prod.mk.injEq] at h; exact cT.injective h.2⟩
  let A : Finset (Fin (n + 1) × Fin n) := R_idx.image varA
  have hA_card : A.card = R_idx.card := Finset.card_image_of_injective _ varA.injective
  -- Count remaining positive clauses in `R.formula i` and remaining columns `J`.
  let activeRows : Finset (Fin (n + 1)) :=
    Finset.univ.filter fun r => CNF.pigeonClause n r ∈ R.formula i
  let RiRows : Finset (Fin (n + 1)) := R_idx.image fun a => (rows a).castSucc
  let remRows : Finset (Fin (n + 1)) := activeRows \ RiRows
  let usedCols : Finset (Fin n) := R_idx.image cT ∪ R_idx.image cF
  let remCols : Finset (Fin n) := Finset.univ \ usedCols
  have hRi_sub_act : RiRows ⊆ activeRows := by
    intro r hr
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.1 hr
    have hmem : rowClause a ∈ R.clauses i := (Finset.mem_filter.1 ha).2
    exact Finset.mem_filter.2 ⟨Finset.mem_univ _, (OBDDRefutation.mem_clauses_iff R i _).1 hmem⟩
  have hRnot_sub : ((Finset.univ \ R_idx).image fun a => (rows a).castSucc) ⊆
      Finset.univ \ activeRows := by
    intro r hr
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.1 hr
    have hna : a ∉ R_idx := (Finset.mem_sdiff.1 ha).2
    refine Finset.mem_sdiff.2 ⟨Finset.mem_univ _, fun hact => hna ?_⟩
    have hf : CNF.pigeonClause n (rows a).castSucc ∈ R.formula i := (Finset.mem_filter.1 hact).2
    exact Finset.mem_filter.2 ⟨Finset.mem_univ _, (OBDDRefutation.mem_clauses_iff R i _).2 hf⟩
  have hinj_rc : Function.Injective (fun a : Fin m => (rows a).castSucc) :=
    (Fin.castSucc_injective n).comp rows.injective
  have hact_le : activeRows.card ≤ n + 1 - (m - R_idx.card) := by
    have hnot_card : (Finset.univ \ activeRows).card ≥ m - R_idx.card := by
      have h1 := Finset.card_le_card hRnot_sub
      rw [Finset.card_image_of_injective _ hinj_rc, Finset.card_sdiff, Finset.inter_univ,
        Finset.card_fin] at h1
      exact h1
    have h2 : (Finset.univ \ activeRows).card = n + 1 - activeRows.card := by
      rw [Finset.card_sdiff, Finset.inter_univ, Finset.card_univ, Fintype.card_fin]
    have hle_n1 : activeRows.card ≤ n + 1 :=
      (Finset.card_le_univ _).trans_eq (Fintype.card_fin _)
    omega
  have hRi_card : RiRows.card = R_idx.card := Finset.card_image_of_injective _ hinj_rc
  have hremR_le : remRows.card ≤ n - 2 * R_idx.card := by
    have h1 : remRows.card = activeRows.card - RiRows.card := by
      rw [Finset.card_sdiff, Finset.inter_eq_left.2 hRi_sub_act]
    omega
  have husedC_card : usedCols.card = 2 * R_idx.card := by
    have hdisj_c : Disjoint (R_idx.image cT) (R_idx.image cF) := by
      rw [Finset.disjoint_left]
      rintro j hjT hjF
      obtain ⟨a, _, rfl⟩ := Finset.mem_image.1 hjT
      obtain ⟨b, _, hba⟩ := Finset.mem_image.1 hjF
      exact hdisj a b hba.symm
    rw [Finset.card_union_of_disjoint hdisj_c,
      Finset.card_image_of_injective _ cT.injective,
      Finset.card_image_of_injective _ cF.injective]
    omega
  have hremC_card : remCols.card = n - 2 * R_idx.card := by
    rw [Finset.card_sdiff, Finset.inter_univ, Finset.card_univ, Fintype.card_fin, husedC_card]
  have hrem_le : remRows.card ≤ remCols.card := by omega
  obtain ⟨chosenCols, hchSub, hchCard⟩ := Finset.exists_subset_card_eq hrem_le
  let colMap : remRows ≃ chosenCols :=
    (remRows.equivFinOfCardEq rfl).trans (chosenCols.equivFinOfCardEq hchCard).symm
  let colOf : ∀ r : Fin (n + 1), r ∈ remRows → Fin n := fun r hr => (colMap ⟨r, hr⟩).val
  have hcolOf_mem : ∀ r (hr : r ∈ remRows), colOf r hr ∈ remCols := fun r hr =>
    hchSub (colMap ⟨r, hr⟩).2
  have hcolOf_inj : ∀ r₁ (hr₁ : r₁ ∈ remRows) r₂ (hr₂ : r₂ ∈ remRows),
      colOf r₁ hr₁ = colOf r₂ hr₂ → r₁ = r₂ := by
    intro r₁ hr₁ r₂ hr₂ heq
    have hsub : colMap ⟨r₁, hr₁⟩ = colMap ⟨r₂, hr₂⟩ := Subtype.ext heq
    exact congrArg Subtype.val (colMap.injective hsub)
  let Xset : Finset (Fin (n + 1) × Fin n) :=
    remRows.attach.image fun r => (r.1, colOf r.1 r.2)
  let z : Fin (n + 1) × Fin n → Bool := fun v => decide (v ∈ A ∨ v ∈ Xset)
  refine ⟨i, R_idx.card, hk2, hlo, ?_⟩
  rw [← hA_card]
  refine OBDD.two_mul_two_pow_sub_three_le_internalSize (R.diagram i)
    (S := lowerVars ord) (A := A) (fun _ hu _ hlt => lowerVars_downward ord hu hlt)
    (by omega) z ?_
  intro x₁ x₂ hx₁ hx₂ hdiff
  obtain ⟨vstar, hvstarA, hvstar_ne⟩ := hdiff
  obtain ⟨astar, hastarR, rfl⟩ := Finset.mem_image.1 hvstarA
  let y : Fin (n + 1) × Fin n → Bool := fun v =>
    decide (v ∈ Xset ∨ ∃ a ∈ R_idx, a ≠ astar ∧ v = ((rows a).castSucc, cF a))
  refine ⟨y, ?_⟩
  -- For any `x` agreeing with `z` outside `A`, `(R.formula i).eval (combine x y) = x (varA astar)`.
  have heval_eq : ∀ (x : Fin (n + 1) × Fin n → Bool), (∀ v, v ∉ A → x v = z v) →
      (R.diagram i).eval (fun v => if v ∈ lowerVars ord then x v else y v) = x (varA astar) := by
    intro x hx
    rw [R.represents i]
    let σ : Fin (n + 1) × Fin n → Bool := fun v => if v ∈ lowerVars ord then x v else y v
    have hσ_of_X : ∀ v ∈ Xset, σ v = true := by
      intro v hvX
      dsimp only [σ]
      split_ifs with hvL
      · by_cases hvA : v ∈ A
        · -- Impossible: `Xset` uses columns in `remCols`, while `A` uses `R_idx.image cT`.
          obtain ⟨r, _, rfl⟩ := Finset.mem_image.1 hvX
          obtain ⟨a, ha, heq⟩ := Finset.mem_image.1 hvA
          change ((rows a).castSucc, cT a) = (r.1, colOf r.1 r.2) at heq
          simp only [Prod.mk.injEq] at heq
          have hmem_rem := hcolOf_mem r.1 r.2
          have hmem_used : colOf r.1 r.2 ∈ usedCols :=
            Finset.mem_union_left _ (Finset.mem_image.2 ⟨a, ha, heq.2⟩)
          exact absurd hmem_used (Finset.mem_sdiff.1 hmem_rem).2
        · rw [hx v hvA]; simp [z, hvX]
      · simp [y, hvX]
    have hσ_of_Y : ∀ a ∈ R_idx, a ≠ astar → σ ((rows a).castSucc, cF a) = true := by
      intro a ha hne
      have hnotL : ((rows a).castSucc, cF a) ∉ lowerVars ord :=
        Finset.disjoint_left.1 (disjoint_upperHalf_lowerVars ord) (hcol a).2
      simp [σ, hnotL, y, ha, hne]
    -- At most one entry per column is `true` under `σ`, so all hole clauses hold.
    have hσ_true_mem : ∀ p j, σ (p, j) = true →
        (p, j) ∈ A ∨ (p, j) ∈ Xset ∨
          ∃ a ∈ R_idx, a ≠ astar ∧ (p, j) = ((rows a).castSucc, cF a) := by
      intro p j htrue
      dsimp only [σ] at htrue
      split_ifs at htrue with hL
      · by_cases hA : (p, j) ∈ A
        · exact Or.inl hA
        · rw [hx _ hA] at htrue
          simp only [z, decide_eq_true_eq] at htrue
          rcases htrue with h1 | h2
          · exact Or.inl h1
          · exact Or.inr (Or.inl h2)
      · simp only [y, decide_eq_true_eq] at htrue
        exact Or.inr htrue
    have hcol_unique : ∀ p₁ p₂ j, σ (p₁, j) = true → σ (p₂, j) = true → p₁ = p₂ := by
      intro p₁ p₂ j h1 h2
      have htag : ∀ p, σ (p, j) = true →
          (∃ a ∈ R_idx, p = (rows a).castSucc ∧ j = cT a) ∨
          (∃ hp : p ∈ remRows, j = colOf p hp) ∨
          (∃ a ∈ R_idx, p = (rows a).castSucc ∧ j = cF a) := by
        intro p hp
        rcases hσ_true_mem p j hp with hA | hX | ⟨a, ha, _, heq⟩
        · obtain ⟨a, ha, heq⟩ := Finset.mem_image.1 hA
          change ((rows a).castSucc, cT a) = (p, j) at heq
          simp only [Prod.mk.injEq] at heq
          exact Or.inl ⟨a, ha, heq.1.symm, heq.2.symm⟩
        · obtain ⟨r, _, heq⟩ := Finset.mem_image.1 hX
          simp only [Prod.mk.injEq] at heq
          rcases heq with ⟨rfl, hj⟩
          exact Or.inr (Or.inl ⟨r.2, hj.symm⟩)
        · simp only [Prod.mk.injEq] at heq
          exact Or.inr (Or.inr ⟨a, ha, heq.1, heq.2⟩)
      rcases htag p₁ h1 with ⟨a₁, ha₁, rfl, rfl⟩ | ⟨hp₁, rfl⟩ | ⟨a₁, ha₁, rfl, rfl⟩ <;>
        rcases htag p₂ h2 with ⟨a₂, ha₂, rfl, hjeq⟩ | ⟨hp₂, hjeq⟩ | ⟨a₂, ha₂, rfl, hjeq⟩
      · rw [cT.injective hjeq]
      · exfalso
        have hmem_rem := hcolOf_mem p₂ hp₂
        exact (Finset.mem_sdiff.1 hmem_rem).2
          (Finset.mem_union_left _ (Finset.mem_image.2 ⟨a₁, ha₁, hjeq⟩))
      · exact absurd hjeq (hdisj a₁ a₂)
      · exfalso
        have hmem_rem := hcolOf_mem p₁ hp₁
        exact (Finset.mem_sdiff.1 hmem_rem).2
          (Finset.mem_union_left _ (Finset.mem_image.2 ⟨a₂, ha₂, hjeq.symm⟩))
      · exact hcolOf_inj p₁ hp₁ p₂ hp₂ hjeq
      · exfalso
        have hmem_rem := hcolOf_mem p₁ hp₁
        exact (Finset.mem_sdiff.1 hmem_rem).2
          (Finset.mem_union_right _ (Finset.mem_image.2 ⟨a₂, ha₂, hjeq.symm⟩))
      · exact absurd hjeq.symm (hdisj a₂ a₁)
      · exfalso
        have hmem_rem := hcolOf_mem p₂ hp₂
        exact (Finset.mem_sdiff.1 hmem_rem).2
          (Finset.mem_union_right _ (Finset.mem_image.2 ⟨a₁, ha₁, hjeq⟩))
      · rw [cF.injective hjeq]
    -- Check `varA astar` value under `σ`.
    have hσ_star : σ (varA astar) = x (varA astar) := by
      have hL : varA astar ∈ lowerVars ord :=
        lowerHalf_subset_lowerVars ord (hcol astar).1
      simp [σ, hL]
    -- Check row `(rows astar).castSucc`: only column `cT astar` can be `true`.
    have hrow_star_only : ∀ j : Fin n, σ ((rows astar).castSucc, j) = true → j = cT astar := by
      intro j hj
      rcases hσ_true_mem _ j hj with hA | hX | ⟨a, _, hne, heq⟩
      · obtain ⟨a, _, heq⟩ := Finset.mem_image.1 hA
        change ((rows a).castSucc, cT a) = ((rows astar).castSucc, j) at heq
        simp only [Prod.mk.injEq] at heq
        have ha : a = astar := rows.injective (Fin.castSucc_injective n heq.1)
        subst ha
        exact heq.2.symm
      · obtain ⟨r, _, heq⟩ := Finset.mem_image.1 hX
        simp only [Prod.mk.injEq] at heq
        have hr_in : (rows astar).castSucc ∈ remRows := heq.1 ▸ r.2
        have hr_Ri : (rows astar).castSucc ∈ RiRows :=
          Finset.mem_image.2 ⟨astar, hastarR, rfl⟩
        exact absurd hr_Ri (Finset.mem_sdiff.1 hr_in).2
      · simp only [Prod.mk.injEq] at heq
        have ha : astar = a := rows.injective (Fin.castSucc_injective n heq.1)
        exact absurd ha.symm hne
    rw [Bool.eq_iff_iff, CNF.eval_eq_true_iff]
    constructor
    · intro hall
      have hcl_mem : CNF.pigeonClause n (rows astar).castSucc ∈ R.formula i :=
        (OBDDRefutation.mem_clauses_iff R i _).1 (Finset.mem_filter.1 hastarR).2
      obtain ⟨j, hj⟩ := (CNF.eval_pigeonClause σ _).1 (hall _ hcl_mem)
      have hj_eq := hrow_star_only j hj
      rw [hj_eq] at hj
      exact hσ_star ▸ hj
    · intro hxtrue c hc
      rcases CNF.mem_pigeonhole.1 (R.mem_of_mem_formula i hc) with ⟨r, rfl⟩ | ⟨p, q, j, hpq, rfl⟩
      · rw [CNF.eval_pigeonClause]
        by_cases hrRi : r ∈ RiRows
        · obtain ⟨a, haR, rfl⟩ := Finset.mem_image.1 hrRi
          by_cases ha_eq : a = astar
          · subst ha_eq
            exact ⟨cT a, hσ_star.trans hxtrue⟩
          · exact ⟨cF a, hσ_of_Y a haR ha_eq⟩
        · have hr_rem : r ∈ remRows :=
            Finset.mem_sdiff.2 ⟨Finset.mem_filter.2 ⟨Finset.mem_univ _, hc⟩, hrRi⟩
          exact ⟨colOf r hr_rem, hσ_of_X _ (Finset.mem_image.2 ⟨⟨r, hr_rem⟩, by simp, rfl⟩)⟩
      · rw [CNF.eval_holeClause]
        cases hp1 : σ (p, j)
        · exact Or.inl hp1
        · cases hq1 : σ (q, j)
          · exact Or.inr hq1
          · exact (hpq.ne (hcol_unique p q j hp1 hq1)).elim
  rw [heval_eq x₁ hx₁, heval_eq x₂ hx₂]
  exact hvstar_ne

/-- Column-matching case: given `m ≥ 5` columns each with a `lowerHalf` and `upperHalf` entry
in `2m` distinct rows, some intermediate OBDD has size `≥ 2 * 2 ^ k - 3` for some
`k ≥ m / 4` with `k ≥ 2`. -/
private theorem theorem_main_col_case {n m : ℕ} (hm5 : 5 ≤ m)
    (ord : LinearOrder (Fin (n + 1) × Fin n))
    (R : OBDDRefutation ord (CNF.pigeonhole (n + 1) n))
    (cols rT rF : Fin m ↪ Fin n)
    (hdisj : ∀ a b, rT a ≠ rF b)
    (hcol : ∀ a, ((rT a).castSucc, cols a) ∈ lowerHalf ord ∧
      ((rF a).castSucc, cols a) ∈ upperHalf ord) :
    ∃ (i : Fin R.length) (k : ℕ), 2 ≤ k ∧ (m : ℝ) / 4 ≤ k ∧
      2 * 2 ^ k - 3 ≤ (R.diagram i).internalSize := by
  classical
  let Q : Finset (Fin n) := Finset.univ.image cols
  have hQ_card : Q.card = m := by
    rw [Finset.card_image_of_injective _ cols.injective, Finset.card_fin]
  have hQ_split : ∀ j ∈ Q,
      (∃ a : Fin n, (a.castSucc, j) ∈ lowerHalf ord) ∧
      (∃ b : Fin n, (b.castSucc, j) ∈ upperHalf ord) := by
    intro j hj
    obtain ⟨a, _, rfl⟩ := Finset.mem_image.1 hj
    exact ⟨⟨rT a, (hcol a).1⟩, ⟨rF a, (hcol a).2⟩⟩
  obtain ⟨i, _, hlo, hhi⟩ :=
    exists_intermediate_split_columns ord R Q (by omega) hQ_split
  let Qc : Finset (Fin n) := splitColumns ord R i ∩ Q
  rw [hQ_card] at hlo hhi
  have hk2 : 2 ≤ Qc.card := by
    have : (5 : ℝ) / 4 ≤ (Qc.card : ℝ) := by
      have hm_r : (5 : ℝ) ≤ m := by exact_mod_cast hm5
      linarith
    have : 5 ≤ 4 * Qc.card := by
      have : (5 : ℝ) ≤ 4 * (Qc.card : ℝ) := by linarith
      exact_mod_cast this
    omega
  have hQc_lt : 2 * Qc.card < m := by
    have : 2 * (Qc.card : ℝ) < (m : ℝ) := by linarith
    exact_mod_cast this
  -- For each `j ∈ Qc`, choose a witness split hole clause in `R.formula i`.
  have hwit : ∀ j : Qc, HasSplitHoleClause ord (R.formula i) j.1 := fun j =>
    (mem_splitColumns_iff ord R i j.1).1 (Finset.mem_inter.1 j.2).1
  let α : Qc → Fin n := fun j => (hwit j).choose
  let β : Qc → Fin n := fun j => (hwit j).choose_spec.choose
  have hα_lo : ∀ j : Qc, ((α j).castSucc, j.1) ∈ lowerHalf ord := fun j =>
    (hwit j).choose_spec.choose_spec.1
  have hβ_up : ∀ j : Qc, ((β j).castSucc, j.1) ∈ upperHalf ord := fun j =>
    (hwit j).choose_spec.choose_spec.2.1
  have hαβ_cl : ∀ j : Qc,
      CNF.holeClause (α j).castSucc (β j).castSucc j.1 ∈ R.formula i ∨
        CNF.holeClause (β j).castSucc (α j).castSucc j.1 ∈ R.formula i := fun j =>
    (hwit j).choose_spec.choose_spec.2.2
  -- Build `A` (card = `Qc.card`).
  let varA : Qc ↪ Fin (n + 1) × Fin n :=
    ⟨fun j => ((α j).castSucc, j.1), fun j₁ j₂ h => by
      simp only [Prod.mk.injEq] at h; exact Subtype.ext h.2⟩
  let A : Finset (Fin (n + 1) × Fin n) := Finset.univ.image varA
  have hA_card : A.card = Qc.card := by
    rw [Finset.card_image_of_injective _ varA.injective, Finset.card_univ, Fintype.card_coe]
  -- Complement `Qbar = Q \ Qc` and its indices `QbarIdx`.
  let QbarIdx : Finset (Fin m) := Finset.univ.filter fun a => cols a ∉ Qc
  have hQbar_card : QbarIdx.card = m - Qc.card := by
    have himg : QbarIdx.image cols = Q \ Qc := by
      ext j
      simp only [QbarIdx, Q, Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and,
        Finset.mem_sdiff]
      constructor
      · rintro ⟨a, ha, rfl⟩; exact ⟨⟨a, rfl⟩, ha⟩
      · rintro ⟨⟨a, rfl⟩, hnj⟩; exact ⟨a, hnj, rfl⟩
    have hsub : Qc ⊆ Q := Finset.inter_subset_right
    rw [← Finset.card_image_of_injective _ cols.injective, himg, Finset.card_sdiff,
      Finset.inter_eq_left.2 hsub, hQ_card]
  -- Rows covered by `Xset` (`Q̄^r`).
  let Xrows : Finset (Fin (n + 1)) :=
    QbarIdx.image (fun a => (rT a).castSucc) ∪ QbarIdx.image (fun a => (rF a).castSucc)
  have hXrows_card : Xrows.card = 2 * QbarIdx.card := by
    have hdisj_r : Disjoint (QbarIdx.image fun a => (rT a).castSucc)
        (QbarIdx.image fun a => (rF a).castSucc) := by
      rw [Finset.disjoint_left]
      rintro r hrT hrF
      obtain ⟨a, _, rfl⟩ := Finset.mem_image.1 hrT
      obtain ⟨b, _, hba⟩ := Finset.mem_image.1 hrF
      exact hdisj a b (Fin.castSucc_injective n hba.symm)
    have hinjT : Function.Injective (fun a : Fin m => (rT a).castSucc) :=
      fun _ _ h => rT.injective (Fin.castSucc_injective n h)
    have hinjF : Function.Injective (fun a : Fin m => (rF a).castSucc) :=
      fun _ _ h => rF.injective (Fin.castSucc_injective n h)
    rw [Finset.card_union_of_disjoint hdisj_r,
      Finset.card_image_of_injective _ hinjT,
      Finset.card_image_of_injective _ hinjF]
    omega
  have hXrows_ge : m + 1 ≤ Xrows.card := by omega
  -- Remaining active rows `Qstar` and unused columns `J = univ \ Q`.
  let activeRows : Finset (Fin (n + 1)) :=
    Finset.univ.filter fun r => CNF.pigeonClause n r ∈ R.formula i
  let Qstar : Finset (Fin (n + 1)) := activeRows \ Xrows
  let J : Finset (Fin n) := Finset.univ \ Q
  have hJ_card : J.card = n - m := by
    rw [Finset.card_sdiff, Finset.inter_univ, Finset.card_univ, Fintype.card_fin, hQ_card]
  have hQstar_le : Qstar.card ≤ J.card := by
    have hsub : Qstar ⊆ Finset.univ \ Xrows :=
      Finset.sdiff_subset_sdiff (Finset.subset_univ _) (Finset.Subset.refl _)
    have h1 := Finset.card_le_card hsub
    have h2 : (Finset.univ \ Xrows).card = n + 1 - Xrows.card := by
      rw [Finset.card_sdiff, Finset.inter_univ, Finset.card_univ, Fintype.card_fin]
    omega
  obtain ⟨chosenJ, hchJSub, hchJCard⟩ := Finset.exists_subset_card_eq hQstar_le
  let wMap : Qstar ≃ chosenJ :=
    (Qstar.equivFinOfCardEq rfl).trans (chosenJ.equivFinOfCardEq hchJCard).symm
  let wCol : ∀ r : Fin (n + 1), r ∈ Qstar → Fin n := fun r hr => (wMap ⟨r, hr⟩).val
  have hwCol_mem : ∀ r (hr : r ∈ Qstar), wCol r hr ∈ J := fun r hr =>
    hchJSub (wMap ⟨r, hr⟩).2
  have hwCol_inj : ∀ r₁ (hr₁ : r₁ ∈ Qstar) r₂ (hr₂ : r₂ ∈ Qstar),
      wCol r₁ hr₁ = wCol r₂ hr₂ → r₁ = r₂ := by
    intro r₁ hr₁ r₂ hr₂ heq
    exact congrArg Subtype.val (wMap.injective (Subtype.ext heq))
  let Xset : Finset (Fin (n + 1) × Fin n) :=
    QbarIdx.image (fun a => ((rT a).castSucc, cols a)) ∪
      QbarIdx.image (fun a => ((rF a).castSucc, cols a))
  let Wset : Finset (Fin (n + 1) × Fin n) :=
    Qstar.attach.image fun r => (r.1, wCol r.1 r.2)
  let z : Fin (n + 1) × Fin n → Bool := fun v => decide (v ∈ A ∨ v ∈ Xset ∨ v ∈ Wset)
  refine ⟨i, Qc.card, hk2, hlo, ?_⟩
  rw [← hA_card]
  refine OBDD.two_mul_two_pow_sub_three_le_internalSize (R.diagram i)
    (S := lowerVars ord) (A := A) (fun _ hu _ hlt => lowerVars_downward ord hu hlt)
    (by omega) z ?_
  intro x₁ x₂ hx₁ hx₂ hdiff
  obtain ⟨vstar, hvstarA, hvstar_ne⟩ := hdiff
  obtain ⟨jstar, _, rfl⟩ := Finset.mem_image.1 hvstarA
  let wstar : Fin (n + 1) × Fin n := ((β jstar).castSucc, jstar.1)
  let y : Fin (n + 1) × Fin n → Bool := fun v => decide (v ∈ Xset ∨ v ∈ Wset ∨ v = wstar)
  refine ⟨y, ?_⟩
  -- For any `x` agreeing with `z` outside `A`,
  -- `(R.formula i).eval (combine x y) = !x (varA jstar)`.
  have heval_eq : ∀ (x : Fin (n + 1) × Fin n → Bool), (∀ v, v ∉ A → x v = z v) →
      (R.diagram i).eval (fun v => if v ∈ lowerVars ord then x v else y v) = !x (varA jstar) := by
    intro x hx
    rw [R.represents i]
    let σ : Fin (n + 1) × Fin n → Bool := fun v => if v ∈ lowerVars ord then x v else y v
    -- Disjointness of `A` from `Xset` and `Wset` (by columns: `Qc`, `Q \ Qc`, `J`).
    have hX_not_A : ∀ v ∈ Xset, v ∉ A := by
      intro v hvX hvA
      obtain ⟨j, _, rfl⟩ := Finset.mem_image.1 hvA
      rcases Finset.mem_union.1 hvX with h1 | h2
      · obtain ⟨a, ha, heq⟩ := Finset.mem_image.1 h1
        have hcol_eq : cols a = j.1 := (Prod.mk.inj heq).2
        exact (Finset.mem_filter.1 ha).2 (hcol_eq ▸ j.2)
      · obtain ⟨a, ha, heq⟩ := Finset.mem_image.1 h2
        have hcol_eq : cols a = j.1 := (Prod.mk.inj heq).2
        exact (Finset.mem_filter.1 ha).2 (hcol_eq ▸ j.2)
    have hW_not_A : ∀ v ∈ Wset, v ∉ A := by
      intro v hvW hvA
      obtain ⟨r, _, rfl⟩ := Finset.mem_image.1 hvW
      obtain ⟨j, _, heq⟩ := Finset.mem_image.1 hvA
      have hcol_eq : j.1 = wCol r.1 r.2 := (Prod.mk.inj heq).2
      have hjQ : j.1 ∈ Q := (Finset.mem_inter.1 j.2).2
      exact (Finset.mem_sdiff.1 (hwCol_mem r.1 r.2)).2 (hcol_eq ▸ hjQ)
    have hσ_of_X : ∀ v ∈ Xset, σ v = true := by
      intro v hvX
      dsimp only [σ]
      split_ifs with hL
      · rw [hx v (hX_not_A v hvX)]; simp [z, hvX]
      · simp [y, hvX]
    have hσ_of_W : ∀ v ∈ Wset, σ v = true := by
      intro v hvW
      dsimp only [σ]
      split_ifs with hL
      · rw [hx v (hW_not_A v hvW)]; simp [z, hvW]
      · simp [y, hvW]
    have hσ_vstar : σ (varA jstar) = x (varA jstar) := by
      have hL : varA jstar ∈ lowerVars ord := lowerHalf_subset_lowerVars ord (hα_lo jstar)
      simp [σ, hL]
    have hσ_wstar : σ wstar = true := by
      have hnotL : wstar ∉ lowerVars ord :=
        Finset.disjoint_left.1 (disjoint_upperHalf_lowerVars ord) (hβ_up jstar)
      simp [σ, hnotL, y]
    have hσ_true_mem : ∀ p j, σ (p, j) = true →
        (p, j) ∈ A ∨ (p, j) ∈ Xset ∨ (p, j) ∈ Wset ∨ (p, j) = wstar := by
      intro p j htrue
      dsimp only [σ] at htrue
      split_ifs at htrue with hL
      · by_cases hA : (p, j) ∈ A
        · exact Or.inl hA
        · rw [hx _ hA] at htrue
          simp only [z, decide_eq_true_eq] at htrue
          rcases htrue with h1 | h2 | h3
          · exact Or.inl h1
          · exact Or.inr (Or.inl h2)
          · exact Or.inr (Or.inr (Or.inl h3))
      · simp only [y, decide_eq_true_eq] at htrue
        exact Or.inr htrue
    -- Check that every positive clause in `R.formula i` holds under `σ`.
    have hpos_sat : ∀ r : Fin (n + 1), CNF.pigeonClause n r ∈ R.formula i →
        (CNF.pigeonClause n r).eval σ = true := by
      intro r hr
      rw [CNF.eval_pigeonClause]
      by_cases hrX : r ∈ Xrows
      · rcases Finset.mem_union.1 hrX with h1 | h2
        · obtain ⟨a, ha, rfl⟩ := Finset.mem_image.1 h1
          exact ⟨cols a, hσ_of_X _ (Finset.mem_union_left _ (Finset.mem_image.2 ⟨a, ha, rfl⟩))⟩
        · obtain ⟨a, ha, rfl⟩ := Finset.mem_image.1 h2
          exact ⟨cols a, hσ_of_X _ (Finset.mem_union_right _ (Finset.mem_image.2 ⟨a, ha, rfl⟩))⟩
      · have hrQ : r ∈ Qstar :=
          Finset.mem_sdiff.2 ⟨Finset.mem_filter.2 ⟨Finset.mem_univ _, hr⟩, hrX⟩
        exact ⟨wCol r hrQ, hσ_of_W _ (Finset.mem_image.2 ⟨⟨r, hrQ⟩, by simp, rfl⟩)⟩
    -- Check every hole clause in `R.formula i` when `x (varA jstar) = false` (so `!x = true`).
    rw [Bool.eq_iff_iff, CNF.eval_eq_true_iff]
    constructor
    · intro hall
      have hcl_true : σ (varA jstar) = false ∨ σ wstar = false := by
        rcases hαβ_cl jstar with h1 | h2
        · exact (CNF.eval_holeClause σ _ _ _).1 (hall _ h1)
        · exact ((CNF.eval_holeClause σ _ _ _).1 (hall _ h2)).symm
      rw [hσ_vstar, hσ_wstar] at hcl_true
      rcases hcl_true with hfalse | hbad
      · simp [hfalse]
      · cases hbad
    · intro hnotx c hc
      have hxfalse : x (varA jstar) = false := by cases hx' : x (varA jstar) <;> simp_all
      rcases CNF.mem_pigeonhole.1 (R.mem_of_mem_formula i hc) with ⟨r, rfl⟩ | ⟨p, q, j, hpq, rfl⟩
      · exact hpos_sat r hc
      · rw [CNF.eval_holeClause]
        cases hp1 : σ (p, j)
        · exact Or.inl hp1
        · cases hq1 : σ (q, j)
          · exact Or.inr hq1
          · exfalso
            -- Split by column `j` ∈ `Qc`, `Q \ Qc`, or `J`.
            by_cases hjQc : j ∈ Qc
            · -- In column `j ∈ Qc`, no entry of `Xset` or `Wset` lies in column `j`.
              have hnotXW : ∀ r, (r, j) ∈ Xset ∨ (r, j) ∈ Wset → False := by
                intro r hxw
                rcases hxw with hX | hW
                · rcases Finset.mem_union.1 hX with h1 | h2
                  · obtain ⟨a, ha, heq⟩ := Finset.mem_image.1 h1
                    exact (Finset.mem_filter.1 ha).2 ((Prod.mk.inj heq).2 ▸ hjQc)
                  · obtain ⟨a, ha, heq⟩ := Finset.mem_image.1 h2
                    exact (Finset.mem_filter.1 ha).2 ((Prod.mk.inj heq).2 ▸ hjQc)
                · obtain ⟨r₀, _, heq⟩ := Finset.mem_image.1 hW
                  have hjJ : j ∈ J := (Prod.mk.inj heq).2 ▸ hwCol_mem r₀.1 r₀.2
                  exact (Finset.mem_sdiff.1 hjJ).2 (Finset.mem_inter.1 hjQc).2
              have hmemA_or_w : ∀ r, σ (r, j) = true →
                  r = (α ⟨j, hjQc⟩).castSucc ∨ (j = jstar.1 ∧ r = (β jstar).castSucc) := by
                intro r hr
                rcases hσ_true_mem r j hr with hA | hX | hW | hw
                · obtain ⟨j', _, heq⟩ := Finset.mem_image.1 hA
                  change ((α j').castSucc, j'.1) = (r, j) at heq
                  simp only [Prod.mk.injEq] at heq
                  have hj' : j' = ⟨j, hjQc⟩ := Subtype.ext heq.2
                  subst hj'
                  exact Or.inl heq.1.symm
                · exact (hnotXW r (Or.inl hX)).elim
                · exact (hnotXW r (Or.inr hW)).elim
                · simp only [wstar, Prod.mk.injEq] at hw
                  exact Or.inr ⟨hw.2, hw.1⟩
              -- If `j = jstar.1`, then `σ (varA jstar) = false`, so `r ≠ (α jstar).castSucc`.
              have hne_alpha_star : ∀ r, σ (r, j) = true → j = jstar.1 →
                  r = (β jstar).castSucc := by
                intro r hr hj_eq
                rcases hmemA_or_w r hr with rfl | ⟨_, rfl⟩
                · have hsub : (⟨j, hjQc⟩ : Qc) = jstar := Subtype.ext hj_eq
                  rw [hsub] at hr
                  have : σ (varA jstar) = true := by
                    change σ ((α jstar).castSucc, jstar.1) = true
                    rwa [← hj_eq]
                  rw [hσ_vstar, hxfalse] at this
                  cases this
                · rfl
              by_cases hj_star : j = jstar.1
              · exact hpq.ne
                  ((hne_alpha_star p hp1 hj_star).trans (hne_alpha_star q hq1 hj_star).symm)
              · rcases hmemA_or_w p hp1 with rfl | ⟨hbad, _⟩
                · rcases hmemA_or_w q hq1 with rfl | ⟨hbad, _⟩
                  · exact hpq.ne rfl
                  · exact hj_star hbad
                · exact hj_star hbad
            · by_cases hjQ : j ∈ Q
              · -- Column `j ∈ Q \ Qc`: only `Xset` entries can be `true`!
                obtain ⟨a, _, rfl⟩ := Finset.mem_image.1 hjQ
                have honlyX : ∀ r, σ (r, cols a) = true →
                    r = (rT a).castSucc ∨ r = (rF a).castSucc := by
                  intro r hr
                  rcases hσ_true_mem r (cols a) hr with hA | hX | hW | hw
                  · obtain ⟨j', _, heq⟩ := Finset.mem_image.1 hA
                    have hcol_eq : j'.1 = cols a := (Prod.mk.inj heq).2
                    exact (hjQc (hcol_eq ▸ j'.2)).elim
                  · rcases Finset.mem_union.1 hX with h1 | h2
                    · obtain ⟨a', _, heq⟩ := Finset.mem_image.1 h1
                      have ha' : a' = a := cols.injective (Prod.mk.inj heq).2
                      subst ha'
                      exact Or.inl (Prod.mk.inj heq).1.symm
                    · obtain ⟨a', _, heq⟩ := Finset.mem_image.1 h2
                      have ha' : a' = a := cols.injective (Prod.mk.inj heq).2
                      subst ha'
                      exact Or.inr (Prod.mk.inj heq).1.symm
                  · obtain ⟨r₀, _, heq⟩ := Finset.mem_image.1 hW
                    have hjJ : cols a ∈ J := (Prod.mk.inj heq).2 ▸ hwCol_mem r₀.1 r₀.2
                    exact ((Finset.mem_sdiff.1 hjJ).2
                      (Finset.mem_image.2 ⟨a, by simp, rfl⟩)).elim
                  · have hcol_eq : cols a = jstar.1 := (Prod.mk.inj hw).2
                    exact (hjQc (hcol_eq ▸ jstar.2)).elim
                -- Since `p ≠ q`, `{p, q} = {(rT a).castSucc, (rF a).castSucc}`,
                -- forcing `cols a ∈ Qc`.
                have hsplit_a : HasSplitHoleClause ord (R.formula i) (cols a) := by
                  rcases honlyX p hp1 with rfl | rfl <;> rcases honlyX q hq1 with rfl | rfl
                  · exact (hpq.ne rfl).elim
                  · exact ⟨rT a, rF a, (hcol a).1, (hcol a).2, Or.inl hc⟩
                  · exact ⟨rT a, rF a, (hcol a).1, (hcol a).2, Or.inr hc⟩
                  · exact (hpq.ne rfl).elim
                exact hjQc (Finset.mem_inter.2
                  ⟨(mem_splitColumns_iff ord R i (cols a)).2 hsplit_a,
                    Finset.mem_image.2 ⟨a, by simp, rfl⟩⟩)
              · -- Column `j ∈ J`: only `Wset` entries can be `true`, and `wCol` is injective!
                have honlyW : ∀ r, σ (r, j) = true → ∃ hr : r ∈ Qstar, wCol r hr = j := by
                  intro r hr
                  rcases hσ_true_mem r j hr with hA | hX | hW | hw
                  · obtain ⟨j', _, heq⟩ := Finset.mem_image.1 hA
                    have hj_eq : j'.1 = j := (Prod.mk.inj heq).2
                    exact (hjQ (hj_eq ▸ (Finset.mem_inter.1 j'.2).2)).elim
                  · rcases Finset.mem_union.1 hX with h1 | h2
                    · obtain ⟨a, _, heq⟩ := Finset.mem_image.1 h1
                      have hj_eq : cols a = j := (Prod.mk.inj heq).2
                      exact (hjQ (hj_eq ▸ Finset.mem_image.2 ⟨a, by simp, rfl⟩)).elim
                    · obtain ⟨a, _, heq⟩ := Finset.mem_image.1 h2
                      have hj_eq : cols a = j := (Prod.mk.inj heq).2
                      exact (hjQ (hj_eq ▸ Finset.mem_image.2 ⟨a, by simp, rfl⟩)).elim
                  · obtain ⟨r₀, _, heq⟩ := Finset.mem_image.1 hW
                    rcases Prod.mk.inj heq with ⟨rfl, hj_eq⟩
                    exact ⟨r₀.2, hj_eq⟩
                  · have hj_eq : j = jstar.1 := (Prod.mk.inj hw).2
                    exact (hjQ (hj_eq ▸ (Finset.mem_inter.1 jstar.2).2)).elim
                obtain ⟨hpQ, hpcol⟩ := honlyW p hp1
                obtain ⟨hqQ, hqcol⟩ := honlyW q hq1
                exact hpq.ne (hwCol_inj p hpQ q hqQ (hpcol.trans hqcol.symm))
  rw [heval_eq x₁ hx₁, heval_eq x₂ hx₂]
  cases hx1 : x₁ (varA jstar) <;> cases hx2 : x₂ (varA jstar) <;> simp_all

/-- **Intermediate OBDD exponential lower bound**:
For every `n ≥ 35`, every total variable order `ord`, and every OBDD refutation `R` of `PHP_n`,
there exists an intermediate OBDD `R.diagram i` whose internal node count strictly exceeds
`1.025 ^ n`. -/
theorem exists_large_intermediate_obdd_pigeonhole {n : ℕ} (hn : 35 ≤ n)
    (ord : LinearOrder (Fin (n + 1) × Fin n))
    (R : OBDDRefutation ord (CNF.pigeonhole (n + 1) n)) :
    ∃ i : Fin R.length, (1.025 : ℝ) ^ n < ((R.diagram i).internalSize : ℝ) := by
  classical
  let M : Fin n → Fin n → Bool := fun a b => decide ((a.castSucc, b) ∈ lowerHalf ord)
  have hbal :
      let w := (Finset.univ.filter (fun p : Fin n × Fin n => M p.1 p.2 = true)).card
      let b := (Finset.univ.filter (fun p : Fin n × Fin n => M p.1 p.2 = false)).card
      w ≤ b + 1 ∧ b ≤ w + 1 := by
    dsimp only
    let emb : Fin n × Fin n ↪ Fin (n + 1) × Fin n :=
      ⟨fun p => (p.1.castSucc, p.2), fun a b h => by
        simp only [Prod.mk.injEq] at h
        exact Prod.ext (Fin.castSucc_injective n h.1) h.2⟩
    have hw_eq : (Finset.univ.filter (fun p : Fin n × Fin n => M p.1 p.2 = true)).card =
        n ^ 2 / 2 := by
      have himg : (Finset.univ.filter (fun p : Fin n × Fin n => M p.1 p.2 = true)).image emb =
          lowerHalf ord := by
        ext v
        simp only [M, emb, Finset.mem_image, Finset.mem_filter,
          Finset.mem_univ, true_and, decide_eq_true_eq]
        constructor
        · rintro ⟨p, hp, rfl⟩; exact hp
        · intro hv
          obtain ⟨p, _, rfl⟩ := Finset.mem_image.1 (lowerHalf_subset_squareVars ord hv)
          exact ⟨p, hv, rfl⟩
      rw [← Finset.card_image_of_injective _ emb.injective, himg, card_lowerHalf]
    have hb_eq : (Finset.univ.filter (fun p : Fin n × Fin n => M p.1 p.2 = false)).card =
        n ^ 2 - n ^ 2 / 2 := by
      have himg : (Finset.univ.filter (fun p : Fin n × Fin n => M p.1 p.2 = false)).image emb =
          upperHalf ord := by
        ext v
        simp only [M, emb, Finset.mem_image, Finset.mem_filter,
          Finset.mem_univ, true_and, decide_eq_false_iff_not, upperHalf, Finset.mem_sdiff]
        constructor
        · rintro ⟨p, hp, rfl⟩
          exact ⟨Finset.mem_image.2 ⟨p, Finset.mem_univ _, rfl⟩, hp⟩
        · rintro ⟨hvsq, hvnot⟩
          obtain ⟨p, _, rfl⟩ := Finset.mem_image.1 hvsq
          exact ⟨p, hvnot, rfl⟩
      rw [← Finset.card_image_of_injective _ emb.injective, himg, card_upperHalf]
    rw [hw_eq, hb_eq]
    omega
  have hm5 : 5 ≤ Nat.floor (matrixConst * n) := by
    refine Nat.le_floor ?_
    have h7 := one_div_seven_lt_matrixConst
    have hnr : (35 : ℝ) ≤ n := by exact_mod_cast hn
    push_cast
    nlinarith
  rcases balanced_matrix_bicolored_matching M hbal with
    ⟨rows, cT, cF, hdisj, hcol⟩ | ⟨cols, rT, rF, hdisj, hcol⟩
  · have hcol' : ∀ a, ((rows a).castSucc, cT a) ∈ lowerHalf ord ∧
        ((rows a).castSucc, cF a) ∈ upperHalf ord := fun a => by
      have h1 : ((rows a).castSucc, cT a) ∈ lowerHalf ord := by
        simpa [M] using (hcol a).1
      have h2 : ((rows a).castSucc, cF a) ∉ lowerHalf ord := by
        simpa [M] using (hcol a).2
      exact ⟨h1, Finset.mem_sdiff.2 ⟨Finset.mem_image.2 ⟨(rows a, cF a), by simp, rfl⟩, h2⟩⟩
    obtain ⟨i, k, hk2, hk_ge, hsz⟩ := theorem_main_row_case hm5 ord R rows cT cF hdisj hcol'
    refine ⟨i, lt_of_lt_of_le (one_point_zero_two_five_pow_lt hk2 hk_ge) (by exact_mod_cast hsz)⟩
  · have hcol' : ∀ a, ((rT a).castSucc, cols a) ∈ lowerHalf ord ∧
        ((rF a).castSucc, cols a) ∈ upperHalf ord := fun a => by
      have h1 : ((rT a).castSucc, cols a) ∈ lowerHalf ord := by
        simpa [M] using (hcol a).1
      have h2 : ((rF a).castSucc, cols a) ∉ lowerHalf ord := by
        simpa [M] using (hcol a).2
      exact ⟨h1, Finset.mem_sdiff.2 ⟨Finset.mem_image.2 ⟨(rF a, cols a), by simp, rfl⟩, h2⟩⟩
    obtain ⟨i, k, hk2, hk_ge, hsz⟩ := theorem_main_col_case hm5 ord R cols rT rF hdisj hcol'
    refine ⟨i, lt_of_lt_of_le (one_point_zero_two_five_pow_lt hk2 hk_ge) (by exact_mod_cast hsz)⟩

/-- **Exponential OBDD refutation lower bound for `PHP_n` (explicit form)**:
For every `n ≥ 35`, every total variable order `ord`, and every OBDD refutation `R` of `PHP_n`,
the total size of `R` strictly exceeds `1.025 ^ n`. -/
theorem obdd_refutation_pigeonhole_exp_lower_bound {n : ℕ} (hn : 35 ≤ n)
    (ord : LinearOrder (Fin (n + 1) × Fin n))
    (R : OBDDRefutation ord (CNF.pigeonhole (n + 1) n)) :
    (1.025 : ℝ) ^ n < (R.size : ℝ) := by
  obtain ⟨i, hi⟩ := exists_large_intermediate_obdd_pigeonhole hn ord R
  exact lt_of_lt_of_le hi (by exact_mod_cast R.internalSize_le_size i)

/-- **Exponential OBDD refutation lower bound for `PHP_n` (asymptotic `Ω(1.025 ^ n)` form)**:
For every total variable order on `Var(PHP_n)`, the size of every OBDD refutation of `PHP_n` is
`Ω(1.025 ^ n)`. -/
theorem obdd_refutation_pigeonhole_omega :
    ∃ C : ℝ, 0 < C ∧ ∃ N : ℕ, ∀ n ≥ N,
      ∀ (ord : LinearOrder (Fin (n + 1) × Fin n))
        (R : OBDDRefutation ord (CNF.pigeonhole (n + 1) n)),
        C * (1.025 : ℝ) ^ n ≤ (R.size : ℝ) :=
  ⟨1, one_pos, 35, fun _ hn ord R => by
    simpa using (obdd_refutation_pigeonhole_exp_lower_bound hn ord R).le⟩

/-- **Non-vacuity witness**: for every `n : ℕ` (in particular for `n ≥ 35`)
and every total order `ord` on `Fin (n + 1) × Fin n`, a valid OBDD refutation of `PHP_n` exists. -/
theorem obdd_refutation_pigeonhole_nonvacuous (n : ℕ)
    (ord : LinearOrder (Fin (n + 1) × Fin n)) :
    Nonempty (OBDDRefutation ord (CNF.pigeonhole (n + 1) n)) :=
  ⟨OBDDRefutation.ofUnsat ord (pigeonhole_ne_nil n) (CNF.not_satisfiable_pigeonhole (by omega))⟩

