/-! ### Truncated SoS Cone and Even-Degree Boolean Strong Duality -/

section ConeHelpers

variable {σ : Type*}

/-- Degree-`d` truncated SoS cone generated by `F` over `ℝ`. -/
private def sosCone (F : List (MvPolynomial σ ℝ)) (d : ℕ) : Set (MvPolynomial σ ℝ) :=
  {p | ∃ (mult : Fin F.length → MvPolynomial σ ℝ) (squares : List (ℝ × MvPolynomial σ ℝ)),
    ∑ i, mult i * F.get i + (squares.map fun q ↦ C q.1 * q.2 ^ 2).sum = p ∧
    (∀ i, (mult i * F.get i).totalDegree ≤ d) ∧
    (∀ q ∈ squares, 0 ≤ q.1) ∧
    (∀ q ∈ squares, 2 * q.2.totalDegree ≤ d)}

private theorem zero_mem_sosCone (F : List (MvPolynomial σ ℝ)) (d : ℕ) :
    0 ∈ sosCone F d :=
  ⟨0, [], by simp, by simp, by simp, by simp⟩

private theorem one_mem_sosCone (F : List (MvPolynomial σ ℝ)) (d : ℕ) :
    1 ∈ sosCone F d :=
  ⟨0, [(1, 1)], by simp, by simp, by simp, by simp⟩

private theorem sq_mem_sosCone {F : List (MvPolynomial σ ℝ)} {d : ℕ}
    {s : MvPolynomial σ ℝ} (hs : 2 * s.totalDegree ≤ d) :
    s ^ 2 ∈ sosCone F d :=
  ⟨0, [(1, s)], by simp, by simp, by simp, by simpa using hs⟩

private theorem mul_mem_sosCone {F : List (MvPolynomial σ ℝ)} {d : ℕ}
    {f : MvPolynomial σ ℝ} (hf : f ∈ F) (q : MvPolynomial σ ℝ)
    (hdeg : (q * f).totalDegree ≤ d) :
    q * f ∈ sosCone F d := by
  classical
  obtain ⟨i₀, rfl⟩ := List.mem_iff_get.mp hf
  refine ⟨fun i ↦ if i = i₀ then q else 0, [], ?_, ?_, by simp, by simp⟩
  · simp [ite_mul]
  · intro i
    by_cases h : i = i₀
    · subst h; simpa using hdeg
    · simp [h]

private theorem add_mem_sosCone {F : List (MvPolynomial σ ℝ)} {d : ℕ}
    {p₁ p₂ : MvPolynomial σ ℝ} (h₁ : p₁ ∈ sosCone F d) (h₂ : p₂ ∈ sosCone F d) :
    p₁ + p₂ ∈ sosCone F d := by
  obtain ⟨m₁, s₁, rfl, hm₁, hw₁, hs₁⟩ := h₁
  obtain ⟨m₂, s₂, rfl, hm₂, hw₂, hs₂⟩ := h₂
  refine ⟨m₁ + m₂, s₁ ++ s₂, ?_, ?_, ?_, ?_⟩
  · simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib, List.map_append, List.sum_append]
    ring
  · intro i
    simp only [Pi.add_apply, add_mul]
    exact (totalDegree_add _ _).trans (max_le (hm₁ i) (hm₂ i))
  · intro q hq
    exact (List.mem_append.mp hq).elim (hw₁ q) (hw₂ q)
  · intro q hq
    exact (List.mem_append.mp hq).elim (hs₁ q) (hs₂ q)

private theorem smul_mem_sosCone {F : List (MvPolynomial σ ℝ)} {d : ℕ}
    {a : ℝ} (ha : 0 ≤ a) {p : MvPolynomial σ ℝ} (hp : p ∈ sosCone F d) :
    a • p ∈ sosCone F d := by
  obtain ⟨m, s, rfl, hm, hw, hs⟩ := hp
  refine ⟨fun i ↦ a • m i, s.map fun q ↦ (a * q.1, q.2), ?_, ?_, ?_, ?_⟩
  · rw [smul_add, Finset.smul_sum, List.map_map]
    congr 1
    · exact Finset.sum_congr rfl fun i _ ↦ by dsimp only; rw [smul_mul_assoc]
    · clear hm hw hs
      induction s with
      | nil => simp
      | cons q qs ih =>
        simp only [List.map_cons, List.sum_cons, Function.comp_apply, smul_add, ih]
        simp [C_mul']
  · intro i
    rw [smul_mul_assoc, ← C_mul']
    exact (totalDegree_mul _ _).trans (by simpa using hm i)
  · intro q hq; obtain ⟨q₀, hq₀, rfl⟩ := List.mem_map.mp hq; exact mul_nonneg ha (hw q₀ hq₀)
  · intro q hq; obtain ⟨q₀, hq₀, rfl⟩ := List.mem_map.mp hq; exact hs q₀ hq₀

private theorem sum_mem_sosCone {F : List (MvPolynomial σ ℝ)} {d : ℕ} {ι : Type*}
    (s : Finset ι) (g : ι → MvPolynomial σ ℝ) (hg : ∀ i ∈ s, g i ∈ sosCone F d) :
    ∑ i ∈ s, g i ∈ sosCone F d := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using zero_mem_sosCone F d
  | insert a s ha ih =>
    rw [Finset.sum_insert ha]
    exact add_mem_sosCone (hg a (Finset.mem_insert_self a s))
      (ih fun i hi ↦ hg i (Finset.mem_insert_of_mem hi))

private theorem sosCone_mono {F : List (MvPolynomial σ ℝ)} {d d' : ℕ} (hd : d ≤ d') :
    sosCone F d ⊆ sosCone F d' := fun _ ⟨m, s, heq, hm, hw, hs⟩ ↦
  ⟨m, s, heq, fun i ↦ (hm i).trans hd, hw, fun q hq ↦ (hs q hq).trans hd⟩

private theorem totalDegree_prod_X_le (S : Finset σ) :
    (∏ i ∈ S, (X i : MvPolynomial σ ℝ)).totalDegree ≤ S.card := by
  refine (totalDegree_finsetProd _ _).trans ?_
  rw [Finset.card_eq_sum_ones]
  exact Finset.sum_le_sum fun i _ ↦ totalDegree_var_le i

private theorem one_sub_prod_X_sq_mem_sosCone {F : List (MvPolynomial σ ℝ)}
    (S : Finset σ) (hbool : ∀ i ∈ S, boolAxiom ℝ i ∈ F) :
    1 - (∏ i ∈ S, (X i : MvPolynomial σ ℝ)) ^ 2 ∈ sosCone F (2 * S.card) := by
  classical
  induction S using Finset.induction_on with
  | empty => simpa using zero_mem_sosCone F 0
  | insert u S hu ih =>
    have hcard : (insert u S).card = S.card + 1 := Finset.card_insert_of_notMem hu
    rw [Finset.prod_insert hu, hcard]
    set P : MvPolynomial σ ℝ := ∏ i ∈ S, X i
    have hP : P.totalDegree ≤ S.card := totalDegree_prod_X_le S
    have hid : 1 - (X u * P) ^ 2 =
        (1 - P ^ 2) + ((1 - X u) * P) ^ 2 + (C (-2) * P ^ 2) * boolAxiom ℝ u := by
      rw [boolAxiom_eq_sub]; simp only [map_neg, map_ofNat]; ring
    rw [hid]
    refine add_mem_sosCone (add_mem_sosCone ?_ ?_) ?_
    · exact sosCone_mono (by omega) (ih fun i hi ↦ hbool i (Finset.mem_insert_of_mem hi))
    · refine sq_mem_sosCone ?_
      have h1u : (1 - (X u : MvPolynomial σ ℝ)).totalDegree ≤ 1 :=
        (totalDegree_sub _ _).trans (max_le (by simp) (totalDegree_var_le u))
      have := (totalDegree_mul (1 - X u) P).trans (Nat.add_le_add h1u hP)
      omega
    · refine mul_mem_sosCone (hbool u (Finset.mem_insert_self u S)) _ ?_
      have h1 : (C (-2 : ℝ) * P ^ 2).totalDegree ≤ 2 * S.card :=
        (totalDegree_mul _ _).trans (by simpa using (totalDegree_pow P 2).trans (by omega))
      have h2 := totalDegree_boolAxiom_le (R := ℝ) u
      have := totalDegree_mul (C (-2 : ℝ) * P ^ 2) (boolAxiom ℝ u)
      omega

private theorem mul_sq_mem_sosCone {F : List (MvPolynomial σ ℝ)} {d : ℕ}
    (r : MvPolynomial σ ℝ) {p : MvPolynomial σ ℝ} (hp : p ∈ sosCone F d) :
    r ^ 2 * p ∈ sosCone F (d + 2 * r.totalDegree) := by
  obtain ⟨m, s, rfl, hm, hw, hs⟩ := hp
  refine ⟨fun i ↦ r ^ 2 * m i, s.map fun q ↦ (q.1, r * q.2), ?_, ?_, ?_, ?_⟩
  · rw [mul_add, Finset.mul_sum, List.map_map]
    congr 1
    · exact Finset.sum_congr rfl fun i _ ↦ by dsimp only; rw [mul_assoc]
    · clear hm hw hs
      induction s with
      | nil => simp
      | cons q qs ih =>
        simp only [List.map_cons, List.sum_cons, Function.comp_apply, mul_add, ih]
        ring
  · intro i
    rw [mul_assoc]
    have hr2 : (r ^ 2).totalDegree ≤ 2 * r.totalDegree := totalDegree_pow r 2
    have hmi := hm i
    have := totalDegree_mul (r ^ 2) (m i * F.get i)
    omega
  · intro q hq
    obtain ⟨q₀, hq₀, rfl⟩ := List.mem_map.mp hq
    exact hw q₀ hq₀
  · intro q hq
    obtain ⟨q₀, hq₀, rfl⟩ := List.mem_map.mp hq
    have hmul : (r * q₀.2).totalDegree ≤ r.totalDegree + q₀.2.totalDegree := totalDegree_mul _ _
    have hq0 := hs q₀ hq₀
    exact (Nat.mul_le_mul_left 2 hmul).trans (by omega)

private theorem finset_prod_X_pow (s : σ →₀ ℕ) :
    (∏ i ∈ s.support, (X i : MvPolynomial σ ℝ) ^ s i) = monomial s 1 := by
  rw [monomial_eq, C_1, one_mul, Finsupp.prod]

private theorem monomial_multilinExp_eq_prod (m : σ →₀ ℕ) :
    monomial (multilinExp m) (1 : ℝ) = ∏ i ∈ m.support, X i := by
  rw [← finset_prod_X_pow (multilinExp m), support_multilinExp]
  refine Finset.prod_congr rfl fun i hi ↦ ?_
  have h1 : min (m i) 1 = 1 := by have := Finsupp.mem_support_iff.mp hi; omega
  simp [h1]

end ConeHelpers

section StrongDuality

variable {σ : Type*} [Finite σ]

private theorem two_add_monomial_mem_sosCone {F : List (MvPolynomial σ ℝ)}
    (hbool : ∀ i : σ, boolAxiom ℝ i ∈ F) {m : ℕ}
    {α : σ →₀ ℕ} (hα : (α.sum fun _ e ↦ e) ≤ 2 * m) (sgn : ℝ) (hsgn : sgn = 1 ∨ sgn = -1) :
    (2 : MvPolynomial σ ℝ) + C sgn * monomial α 1 ∈ sosCone F (2 * m) := by
  classical
  cases nonempty_fintype σ
  obtain ⟨q, hq_eq, hq_deg, _⟩ := monomial_sub_multilin α sgn
  have hcard : α.support.card ≤ 2 * m := by
    rw [← sum_multilinExp α]
    exact (sum_multilinExp_le α).trans hα
  obtain ⟨S₁, hsub, hS₁⟩ := α.support.exists_subset_card_eq (Nat.min_le_left α.support.card m)
  have hS₁_le : S₁.card ≤ m := hS₁.trans_le (Nat.min_le_right _ _)
  let S₂ := α.support \ S₁
  have hS₂ : S₂.card ≤ m := by rw [Finset.card_sdiff_of_subset hsub, hS₁]; omega
  set P₁ : MvPolynomial σ ℝ := ∏ i ∈ S₁, X i
  set P₂ : MvPolynomial σ ℝ := ∏ i ∈ S₂, X i
  have hPprod : monomial (multilinExp α) sgn = C sgn * (P₁ * P₂) := by
    have h1 : P₁ * P₂ = monomial (multilinExp α) 1 := by
      rw [← Finset.prod_union disjoint_sdiff, Finset.union_sdiff_of_subset hsub,
        monomial_multilinExp_eq_prod]
    rw [h1, C_mul_monomial, mul_one]
  have hP₁deg : P₁.totalDegree ≤ m := (totalDegree_prod_X_le S₁).trans hS₁_le
  have hP₂deg : P₂.totalDegree ≤ m := (totalDegree_prod_X_le S₂).trans hS₂
  have h1P₁ : 1 - P₁ ^ 2 ∈ sosCone F (2 * m) :=
    sosCone_mono (by omega) (one_sub_prod_X_sq_mem_sosCone S₁ fun i _ ↦ hbool i)
  have h1P₂ : 1 - P₂ ^ 2 ∈ sosCone F (2 * m) :=
    sosCone_mono (by omega) (one_sub_prod_X_sq_mem_sosCone S₂ fun i _ ↦ hbool i)
  have hch : (C (1 / 2 : ℝ) : MvPolynomial σ ℝ) * 2 = 1 := by
    rw [show (2 : MvPolynomial σ ℝ) = C 2 from map_ofNat C 2, ← map_mul]; norm_num
  have hbase : 2 + monomial (multilinExp α) sgn ∈ sosCone F (2 * m) := by
    rw [hPprod]
    rcases hsgn with rfl | rfl
    · have hid : (2 : MvPolynomial σ ℝ) + C 1 * (P₁ * P₂) =
          (1 / 2 : ℝ) • ((P₁ + P₂) ^ 2 + (1 - P₁ ^ 2) + (1 - P₂ ^ 2)) + 1 := by
        rw [map_one, Algebra.smul_def, algebraMap_eq]
        calc
          (2 : MvPolynomial σ ℝ) + 1 * (P₁ * P₂)
              = 1 + (C (1 / 2 : ℝ) * 2) * (1 + P₁ * P₂) := by rw [hch]; ring
          _ = C (1 / 2 : ℝ) * ((P₁ + P₂) ^ 2 + (1 - P₁ ^ 2) + (1 - P₂ ^ 2)) + 1 := by ring
      rw [hid]
      refine add_mem_sosCone (smul_mem_sosCone (by positivity)
        (add_mem_sosCone (add_mem_sosCone (sq_mem_sosCone ?_) h1P₁) h1P₂)) (one_mem_sosCone F _)
      have := (totalDegree_add P₁ P₂).trans (max_le hP₁deg hP₂deg); omega
    · have hid : (2 : MvPolynomial σ ℝ) + C (-1) * (P₁ * P₂) =
          (1 / 2 : ℝ) • ((P₁ - P₂) ^ 2 + (1 - P₁ ^ 2) + (1 - P₂ ^ 2)) + 1 := by
        rw [map_neg, map_one, Algebra.smul_def, algebraMap_eq]
        calc
          (2 : MvPolynomial σ ℝ) + -1 * (P₁ * P₂)
              = 1 + (C (1 / 2 : ℝ) * 2) * (1 - P₁ * P₂) := by rw [hch]; ring
          _ = C (1 / 2 : ℝ) * ((P₁ - P₂) ^ 2 + (1 - P₁ ^ 2) + (1 - P₂ ^ 2)) + 1 := by ring
      rw [hid]
      refine add_mem_sosCone (smul_mem_sosCone (by positivity)
        (add_mem_sosCone (add_mem_sosCone (sq_mem_sosCone ?_) h1P₁) h1P₂)) (one_mem_sosCone F _)
      have := (totalDegree_sub P₁ P₂).trans (max_le hP₁deg hP₂deg); omega
  have hrewrite : (2 : MvPolynomial σ ℝ) + C sgn * monomial α 1 =
      (2 + monomial (multilinExp α) sgn) + ∑ i, q i * boolAxiom ℝ i := by
    rw [C_mul_monomial, mul_one, ← hq_eq]; ring
  rw [hrewrite]
  exact add_mem_sosCone hbase (sum_mem_sosCone Finset.univ _ fun i _ ↦
    mul_mem_sosCone (hbool i) (q i) ((hq_deg i).trans hα))

/-- **Boolean Sum-of-Squares Strong Duality (even degree)**: if `F` contains `X i ^ 2 - X i` for
every variable `i : σ` and admits no SoS refutation of degree `2 * m` (`1 ≤ m`), then `F` admits
a degree-`2 * m` pseudo-expectation over `ℝ`. -/
theorem exists_pseudoExpectation_of_not_refutableInDegree {F : List (MvPolynomial σ ℝ)}
    (hbool : ∀ i : σ, boolAxiom ℝ i ∈ F) {m : ℕ}
    (hnref : ¬ SOS.RefutableInDegree F (2 * m)) :
    Nonempty (SOS.PseudoExpectation F (2 * m)) := by
  classical
  cases nonempty_fintype σ
  let Idx := {α : σ →₀ ℕ // (α.sum fun _ e ↦ e) ≤ 2 * m}
  have hle_sum : ∀ (α : σ →₀ ℕ) (i : σ), α i ≤ (α.sum fun _ e ↦ e) := fun α i ↦ by
    by_cases hi : i ∈ α.support
    · exact Finset.single_le_sum (f := fun j ↦ α j) (fun _ _ ↦ Nat.zero_le _) hi
    · rw [Finsupp.notMem_support_iff.mp hi]; exact Nat.zero_le _
  have hfin : Finite Idx :=
    Finite.of_injective
      (fun (α : Idx) (i : σ) ↦ (⟨α.1 i, Nat.lt_succ_of_le ((hle_sum α.1 i).trans α.2)⟩ :
        Fin (2 * m + 1)))
      fun a b hab ↦ Subtype.ext (Finsupp.ext fun i ↦ congrArg Fin.val (congrFun hab i))
  let _ : Fintype Idx := Fintype.ofFinite Idx
  let toPoly : (Idx → ℝ) →ₗ[ℝ] MvPolynomial σ ℝ :=
    { toFun := fun v ↦ ∑ α : Idx, monomial α.1 (v α)
      map_add' := fun u v ↦ by simp [Finset.sum_add_distrib]
      map_smul' := fun r v ↦ by simp [Finset.smul_sum, smul_monomial] }
  let ofPoly : MvPolynomial σ ℝ →ₗ[ℝ] (Idx → ℝ) :=
    { toFun := fun p α ↦ p.coeff α.1
      map_add' := fun _ _ ↦ by ext; simp
      map_smul' := fun _ _ ↦ by ext; simp }
  have hleft : ∀ p : MvPolynomial σ ℝ, p.totalDegree ≤ 2 * m → toPoly (ofPoly p) = p := by
    intro p hp
    ext β
    simp only [toPoly, ofPoly, LinearMap.coe_mk, AddHom.coe_mk, coeff_sum, coeff_monomial]
    by_cases hβ : (β.sum fun _ e ↦ e) ≤ 2 * m
    · rw [Finset.sum_eq_single (⟨β, hβ⟩ : Idx)
        (fun γ _ hne ↦ ite_eq_right fun h ↦ hne (Subtype.ext h)) (by simp), ite_eq_left rfl]
    · rw [Finset.sum_eq_zero fun γ _ ↦ ite_eq_right fun h ↦ hβ (by rw [← h]; exact γ.2)]
      symm
      rw [← notMem_support_iff]
      exact fun hmβ ↦ hβ ((le_totalDegree hmβ).trans hp)
  let vOne : Idx → ℝ := ofPoly 1
  have hvOne : toPoly vOne = 1 := hleft 1 (by simp)
  let K : Set (Idx → ℝ) := {v | toPoly v ∈ sosCone F (2 * m)}
  have hK_add : ∀ {u v}, u ∈ K → v ∈ K → u + v ∈ K := by
    intro u v hu hv
    change toPoly (u + v) ∈ sosCone F (2 * m); rw [map_add]; exact add_mem_sosCone hu hv
  have hK_smul : ∀ {a : ℝ} {v}, 0 ≤ a → v ∈ K → a • v ∈ K := by
    intro a v ha hv
    change toPoly (a • v) ∈ sosCone F (2 * m); rw [map_smul]; exact smul_mem_sosCone ha hv
  have hK_conv : Convex ℝ K := fun _ hu _ hv _ _ ha hb _ ↦
    hK_add (hK_smul ha hu) (hK_smul hb hv)
  let N : ℕ := Fintype.card Idx
  let r₀ : ℝ := 1 / (2 * (N : ℝ) + 1)
  have hr₀ : 0 < r₀ := by positivity
  have hball : ∀ u : Idx → ℝ, ‖u‖ < r₀ → vOne + u ∈ K := by
    intro u hu
    have hle : ∀ α : Idx, |u α| ≤ r₀ := fun α ↦ (norm_le_pi_norm u α).trans hu.le
    have hsum_le : ∑ α : Idx, 2 * |u α| ≤ 1 := by
      calc
        ∑ α : Idx, 2 * |u α| ≤ ∑ _α : Idx, 2 * r₀ :=
          Finset.sum_le_sum fun α _ ↦ by linarith [hle α]
        _ = 2 * (N : ℝ) * r₀ := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]; dsimp [N]; ring
        _ ≤ 1 := by
          simp only [r₀, one_div]
          rw [mul_inv_le_iff₀ (by positivity)]
          linarith
    change toPoly (vOne + u) ∈ sosCone F (2 * m)
    rw [map_add, hvOne]
    let sgn (α : Idx) : ℝ := if 0 ≤ u α then 1 else -1
    have hu_term (α : Idx) : monomial α.1 (u α) = |u α| • (C (sgn α) * monomial α.1 1) := by
      rw [C_mul_monomial, mul_one, smul_monomial, smul_eq_mul]
      congr 1
      dsimp only [sgn]
      split_ifs with h
      · rw [abs_of_nonneg h, mul_one]
      · rw [abs_of_neg (lt_of_not_ge h), mul_neg_one, neg_neg]
    have hdecomp : (1 : MvPolynomial σ ℝ) + toPoly u =
        (1 - ∑ α : Idx, 2 * |u α|) • (1 : MvPolynomial σ ℝ) +
        ∑ α : Idx, |u α| • ((2 : MvPolynomial σ ℝ) + C (sgn α) * monomial α.1 1) := by
      have hsum_rhs : ∑ α : Idx, |u α| • ((2 : MvPolynomial σ ℝ) + C (sgn α) * monomial α.1 1) =
          (∑ α : Idx, 2 * |u α|) • (1 : MvPolynomial σ ℝ) + toPoly u := by
        simp_rw [smul_add, Finset.sum_add_distrib, ← hu_term]
        congr 1
        rw [Finset.sum_smul]
        refine Finset.sum_congr rfl fun α _ ↦ ?_
        simp [Algebra.smul_def, algebraMap_eq, mul_comm, map_ofNat]
      rw [hsum_rhs, ← add_assoc, ← add_smul, sub_add_cancel, one_smul]
    rw [hdecomp]
    refine add_mem_sosCone (smul_mem_sosCone (by linarith) (one_mem_sosCone F _))
      (sum_mem_sosCone Finset.univ _ fun α _ ↦ smul_mem_sosCone (abs_nonneg _)
        (two_add_monomial_mem_sosCone hbool α.2 (sgn α) ?_))
    dsimp only [sgn]; split_ifs <;> simp
  have hvOne_int : vOne ∈ interior K :=
    mem_interior.mpr ⟨Metric.ball vOne r₀, fun w hw ↦ by
      simpa using hball (w - vOne) (by simpa [dist_eq_norm] using hw),
      Metric.isOpen_ball, Metric.mem_ball_self hr₀⟩
  have hneg_not_int : -vOne ∉ interior K := fun hint ↦ by
    have hmemK : -vOne ∈ K := interior_subset hint
    have hmem : toPoly (-vOne) ∈ sosCone F (2 * m) := hmemK
    rw [map_neg, hvOne] at hmem
    obtain ⟨mult, sq, heq, hmd, hw, hsd⟩ := hmem
    exact hnref (SOS.Refutation.refutableInDegree ⟨mult, sq, heq, hmd, hw, hsd⟩)
  obtain ⟨L, hL⟩ := geometric_hahn_banach_point_open hK_conv.interior isOpen_interior hneg_not_int
  have hL1_pos : 0 < L vOne := by
    have := hL vOne hvOne_int
    rw [map_neg] at this; linarith
  have hLK_nonneg : ∀ v ∈ K, 0 ≤ L v := by
    intro v hv
    by_contra hlt
    push Not at hlt
    let t : ℝ := (2 * L vOne + 1) / (-L v)
    have ht : 0 < t := div_pos (by linarith) (by linarith)
    have hint : vOne + t • v ∈ interior K :=
      mem_interior.mpr ⟨Metric.ball (vOne + t • v) r₀, fun w hw ↦ by
        have hnorm : ‖w - (vOne + t • v)‖ < r₀ := by simpa [dist_eq_norm] using hw
        have hweq : w = (vOne + (w - (vOne + t • v))) + t • v := by abel
        rw [hweq]
        exact hK_add (hball _ hnorm) (hK_smul ht.le hv),
        Metric.isOpen_ball, Metric.mem_ball_self hr₀⟩
    have hsep := hL (vOne + t • v) hint
    rw [map_neg, map_add, map_smul, smul_eq_mul] at hsep
    have hne : -L v ≠ 0 := by linarith
    have htv : t * L v = -(2 * L vOne + 1) := by
      dsimp only [t]; rw [div_mul_eq_mul_div, div_eq_iff hne]; ring
    linarith
  refine ⟨{
    toLinearMap := (L vOne)⁻¹ • (L.toLinearMap.comp ofPoly)
    map_one := inv_mul_cancel₀ hL1_pos.ne'
    map_sq_nonneg := fun s hs ↦
      mul_nonneg (inv_nonneg.mpr hL1_pos.le) (hLK_nonneg _ (by
        change toPoly (ofPoly (s ^ 2)) ∈ sosCone F (2 * m)
        rw [hleft (s ^ 2) ((totalDegree_pow s 2).trans hs)]
        exact sq_mem_sosCone hs))
    map_mul_eq_zero := fun f hf q hq ↦ by
      change (L vOne)⁻¹ * L (ofPoly (q * f)) = 0
      have h1 : 0 ≤ L (ofPoly (q * f)) := hLK_nonneg _ (by
        change toPoly (ofPoly (q * f)) ∈ sosCone F (2 * m)
        rw [hleft (q * f) hq]; exact mul_mem_sosCone hf q hq)
      have h2 : 0 ≤ L (ofPoly (-q * f)) := hLK_nonneg _ (by
        change toPoly (ofPoly (-q * f)) ∈ sosCone F (2 * m)
        rw [hleft (-q * f) (by simpa [neg_mul] using hq)]
        exact mul_mem_sosCone hf (-q) (by simpa [neg_mul] using hq))
      rw [neg_mul, map_neg, map_neg] at h2
      have h0 : L (ofPoly (q * f)) = 0 := by linarith
      rw [h0, mul_zero] }⟩

end StrongDuality

/-! ### The Atserias–Hakoniemi Greedy Restriction and Size-Degree Trade-Off -/

section AtseriasHakoniemi

/-- Pseudo-expectation invariant along the greedy restriction walk. -/
private structure WalkPE {σ : Type*} [DecidableEq σ] (F : List (MvPolynomial σ ℝ)) (k : ℕ)
    (A B : Finset σ) (r : ℕ) where
  fn : MvPolynomial σ ℝ →ₗ[ℝ] ℝ
  map_one : fn 1 = 1
  map_sq_nonneg : ∀ s : MvPolynomial σ ℝ, 2 * s.totalDegree ≤ 2 * r → 0 ≤ fn (s ^ 2)
  map_bool_zero : ∀ u : σ, u ∉ A → ∀ q : MvPolynomial σ ℝ,
    (q * boolAxiom ℝ u).totalDegree ≤ 2 * r → fn (q * boolAxiom ℝ u) = 0
  map_axiom_zero : ∀ f ∈ F, ∀ q : MvPolynomial σ ℝ, q.totalDegree + k ≤ 2 * r →
    fn (q * aeval (fun i : σ ↦ if i ∈ A then 0 else X i) f) = 0
  map_one_sub_zero : ∀ w ∈ B, fn (1 - X w) = 0

private theorem WalkPE.apply_sosCone_nonneg {σ : Type*} [DecidableEq σ]
    {F : List (MvPolynomial σ ℝ)} {k : ℕ} {A B : Finset σ} {r : ℕ}
    (E : WalkPE F k A B r) {G : List (MvPolynomial σ ℝ)}
    (hG : ∀ g ∈ G, ∃ u ∉ A, g = boolAxiom ℝ u) {p : MvPolynomial σ ℝ}
    (hp : p ∈ sosCone G (2 * r)) : 0 ≤ E.fn p := by
  obtain ⟨mult, sq, rfl, hm, hw, hs⟩ := hp
  rw [map_add, map_sum, map_list_sum, List.map_map]
  have h1 : ∑ i : Fin G.length, E.fn (mult i * G.get i) = 0 :=
    Finset.sum_eq_zero fun i _ ↦ by
      obtain ⟨u, hu, heq⟩ := hG _ (List.get_mem G i)
      rw [heq]; exact E.map_bool_zero u hu (mult i) (heq ▸ hm i)
  rw [h1, zero_add]
  refine List.sum_nonneg fun x hx ↦ ?_
  obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hx
  simp only [Function.comp_apply, C_mul', map_smul, smul_eq_mul]
  exact mul_nonneg (hw q hq) (E.map_sq_nonneg q.2 (hs q hq))

private theorem WalkPE.map_mul_eq_zero_of_sq_zero {σ : Type*} [DecidableEq σ]
    {F : List (MvPolynomial σ ℝ)} {k : ℕ} {A B : Finset σ} {r : ℕ}
    (E : WalkPE F k A B r) {f g : MvPolynomial σ ℝ}
    (hf : f.totalDegree ≤ r) (hg : g.totalDegree ≤ r) (hf0 : E.fn (f ^ 2) = 0) :
    E.fn (f * g) = 0 := by
  by_contra hne
  let t : ℝ := -(E.fn (g ^ 2) + 1) / (2 * E.fn (f * g))
  have hdeg : 2 * (C t * f + g).totalDegree ≤ 2 * r := by
    have h1 : (C t * f).totalDegree ≤ r := (totalDegree_mul _ _).trans (by simpa using hf)
    have := (totalDegree_add (C t * f) g).trans (max_le h1 hg); omega
  have hnn := E.map_sq_nonneg (C t * f + g) hdeg
  have hexp : (C t * f + g) ^ 2 = C (t ^ 2) * f ^ 2 + C (2 * t) * (f * g) + g ^ 2 := by
    simp only [map_pow, map_mul, map_ofNat]; ring
  rw [hexp, map_add, map_add, C_mul', C_mul', map_smul, map_smul, smul_eq_mul, smul_eq_mul,
    hf0, mul_zero, zero_add] at hnn
  have h2 : 2 * E.fn (f * g) ≠ 0 := mul_ne_zero two_ne_zero hne
  have hval : 2 * t * E.fn (f * g) = -(E.fn (g ^ 2) + 1) := by
    dsimp only [t]; rw [mul_div_assoc', div_mul_eq_mul_div, div_eq_iff h2]; ring
  linarith

/-- Full-degree Boolean zero-variance absorption for `1 - X w`. -/
private theorem WalkPE.map_one_sub_mul_eq_zero {σ : Type*} [Finite σ] [DecidableEq σ]
    {F : List (MvPolynomial σ ℝ)} {k : ℕ} {A B : Finset σ} {r : ℕ}
    (E : WalkPE F k A B r) (hr : 1 ≤ r) {w : σ} (hwA : w ∉ A)
    (hw0 : E.fn (1 - X w) = 0) {q : MvPolynomial σ ℝ} (hq_deg : q.totalDegree ≤ 2 * r - 1)
    (hq_vars : ∀ u ∈ q.vars, u ∉ A) :
    E.fn ((1 - X w) * q) = 0 := by
  classical
  cases nonempty_fintype σ
  have h1w_deg : (1 - (X w : MvPolynomial σ ℝ)).totalDegree ≤ 1 :=
    (totalDegree_sub _ _).trans (max_le (by simp) (totalDegree_var_le w))
  have h1w_sq : E.fn ((1 - X w) ^ 2) = 0 := by
    have hid : (1 - (X w : MvPolynomial σ ℝ)) ^ 2 = (1 - X w) + 1 * boolAxiom ℝ w := by
      rw [boolAxiom_eq_sub]; ring
    rw [hid, map_add, hw0, E.map_bool_zero w hwA 1 (by
      rw [one_mul]; exact (totalDegree_boolAxiom_le w).trans (by omega)), add_zero]
  obtain ⟨qb, hqb_eq, hqb_deg, hqb_supp⟩ := eq_multilin_add_sum_mul_boolAxiom q
  rw [hqb_eq, mul_add, map_add]
  have hbool_part : E.fn ((1 - X w) * ∑ i, qb i * boolAxiom ℝ i) = 0 := by
    rw [mul_sum, map_sum]
    refine Finset.sum_eq_zero fun i _ ↦ ?_
    by_cases hi : i ∈ q.vars
    · rw [← mul_assoc]
      refine E.map_bool_zero i (hq_vars i hi) _ ?_
      rw [mul_assoc]
      have h1 := (hqb_deg i).trans hq_deg
      have := totalDegree_mul (1 - X w) (qb i * boolAxiom ℝ i)
      omega
    · simp [hqb_supp i hi]
  rw [hbool_part, add_zero, multilin_eq_sum, mul_sum, map_sum]
  refine Finset.sum_eq_zero fun m hm ↦ ?_
  have hmA : ∀ u ∈ m.support, u ∉ A := fun u hu ↦ hq_vars u (mem_vars_of_mem_support hm hu)
  have hmcard : m.support.card ≤ 2 * r - 1 := by
    rw [← sum_multilinExp m]
    exact (sum_multilinExp_le m).trans ((le_totalDegree hm).trans hq_deg)
  obtain ⟨S₁, hsub, hS₁⟩ := m.support.exists_subset_card_eq (Nat.min_le_left m.support.card (r - 1))
  have hS₁_le : S₁.card ≤ r - 1 := hS₁.trans_le (Nat.min_le_right _ _)
  let S₂ := m.support \ S₁
  have hS₂ : S₂.card ≤ r := by rw [Finset.card_sdiff_of_subset hsub, hS₁]; omega
  set P₁ : MvPolynomial σ ℝ := ∏ u ∈ S₁, X u
  set P₂ : MvPolynomial σ ℝ := ∏ u ∈ S₂, X u
  have hmon : monomial (multilinExp m) (q.coeff m) = C (q.coeff m) * (P₁ * P₂) := by
    have hp : P₁ * P₂ = monomial (multilinExp m) 1 := by
      rw [← Finset.prod_union disjoint_sdiff, Finset.union_sdiff_of_subset hsub,
        monomial_multilinExp_eq_prod]
    rw [hp, C_mul_monomial, mul_one]
  rw [hmon, mul_left_comm, C_mul', map_smul, smul_eq_mul, ← mul_assoc]
  suffices h0 : E.fn (((1 - X w) * P₁) * P₂) = 0 by rw [h0, mul_zero]
  have hf_deg : ((1 - X w) * P₁).totalDegree ≤ r := by
    have hP₁ : P₁.totalDegree ≤ r - 1 := (totalDegree_prod_X_le S₁).trans hS₁_le
    have := totalDegree_mul (1 - X w) P₁
    omega
  have hg_deg : P₂.totalDegree ≤ r := (totalDegree_prod_X_le S₂).trans hS₂
  refine E.map_mul_eq_zero_of_sq_zero hf_deg hg_deg ?_
  have hnn : 0 ≤ E.fn (((1 - X w) * P₁) ^ 2) := E.map_sq_nonneg _ (by omega)
  let G : List (MvPolynomial σ ℝ) := S₁.toList.map (boolAxiom ℝ)
  have hcone : (1 - X w) ^ 2 * (1 - P₁ ^ 2) ∈ sosCone G (2 * r) :=
    sosCone_mono (by omega)
      (mul_sq_mem_sosCone (1 - X w) (one_sub_prod_X_sq_mem_sosCone S₁ fun u hu ↦
        List.mem_map_of_mem (Finset.mem_toList.mpr hu)))
  have hdiff_nn : 0 ≤ E.fn ((1 - X w) ^ 2 - ((1 - X w) * P₁) ^ 2) := by
    rw [show (1 - X w) ^ 2 - ((1 - X w) * P₁) ^ 2 = (1 - X w) ^ 2 * (1 - P₁ ^ 2) by ring]
    refine E.apply_sosCone_nonneg (fun g hg ↦ ?_) hcone
    obtain ⟨u, hu, rfl⟩ := List.mem_map.mp hg
    exact ⟨u, hmA u (hsub (Finset.mem_toList.mp hu)), rfl⟩
  rw [map_sub, h1w_sq] at hdiff_nn
  linarith

private theorem sub_evalZero_eq_X_mul {σ : Type*} [DecidableEq σ] (v : σ)
    (p : MvPolynomial σ ℝ) :
    ∃ h : MvPolynomial σ ℝ,
      p - aeval (fun i : σ ↦ if i = v then (0 : MvPolynomial σ ℝ) else X i) p = X v * h ∧
      (h = 0 ∨ h.totalDegree + 1 ≤ p.totalDegree) := by
  let ρ0 : σ → MvPolynomial σ ℝ := fun i ↦ if i = v then 0 else X i
  let h : MvPolynomial σ ℝ :=
    ∑ m ∈ p.support.filter (fun m ↦ 0 < m v), monomial (m - Finsupp.single v 1) (p.coeff m)
  refine ⟨h, ?_, ?_⟩
  · have hmon : ∀ m : σ →₀ ℕ, aeval ρ0 (monomial m (p.coeff m)) =
        if m v = 0 then monomial m (p.coeff m) else 0 := fun m ↦ by
      split_ifs with hmv
      · rw [aeval_monomial, algebraMap_eq]
        have hprod : m.prod (fun i e ↦ ρ0 i ^ e) = monomial m 1 := by
          rw [Finsupp.prod]
          have hfac : ∀ i ∈ m.support, ρ0 i ^ m i = X i ^ m i := fun i hi ↦ by
            have hne : i ≠ v := fun he ↦ Finsupp.mem_support_iff.mp hi (he ▸ hmv)
            simp [ρ0, hne]
          rw [Finset.prod_congr rfl hfac]
          exact finset_prod_X_pow m
        rw [hprod, C_mul_monomial, mul_one]
      · rw [aeval_monomial, algebraMap_eq, Finsupp.prod,
          Finset.prod_eq_zero (Finsupp.mem_support_iff.mpr hmv) (by simp [ρ0, zero_pow hmv]),
          mul_zero]
    have hp0 : aeval ρ0 p = ∑ m ∈ p.support.filter (fun m ↦ m v = 0), monomial m (p.coeff m) := by
      conv_lhs => rw [p.as_sum, map_sum]
      simp_rw [hmon]; rw [Finset.sum_filter]
    have hsplit : p - aeval ρ0 p =
        ∑ m ∈ p.support.filter (fun m ↦ 0 < m v), monomial m (p.coeff m) := by
      rw [hp0]
      conv_lhs => arg 1; rw [p.as_sum]
      rw [← Finset.sum_filter_add_sum_filter_not p.support (fun m ↦ m v = 0), add_sub_cancel_left]
      exact Finset.sum_congr (by ext m; simp [Nat.pos_iff_ne_zero]) fun _ _ ↦ rfl
    rw [hsplit]
    simp only [h, Finset.mul_sum, X, monomial_mul_monomial, one_mul]
    refine Finset.sum_congr rfl fun m hm ↦ ?_
    have hpos : 0 < m v := (Finset.mem_filter.mp hm).2
    congr 2; ext j
    rcases eq_or_ne j v with rfl | hj
    · simp only [Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_eq_same]; omega
    · simp [hj]
  · by_cases hh : h = 0
    · exact .inl hh
    · right
      obtain ⟨d, hd⟩ := support_nonempty.mpr hh
      obtain ⟨m₀, hm₀, _⟩ := Finset.mem_biUnion.mp (support_sum hd)
      obtain ⟨hm₀p, hpos₀⟩ := Finset.mem_filter.mp hm₀
      have hp1 : 1 ≤ p.totalDegree := by
        have hv0 : m₀ v ≤ (m₀.sum fun _ e ↦ e) :=
          Finset.single_le_sum (f := fun j ↦ m₀ j) (fun _ _ ↦ Nat.zero_le _)
            (Finsupp.mem_support_iff.mpr hpos₀.ne')
        have := hv0.trans (le_totalDegree hm₀p); omega
      have hle : h.totalDegree ≤ p.totalDegree - 1 := by
        refine totalDegree_finsetSum_le fun m hm ↦ ?_
        have htm : (monomial (m - Finsupp.single v 1) (p.coeff m)).totalDegree ≤
            ((m - Finsupp.single v 1).sum fun _ e ↦ e) := totalDegree_monomial_le _ _
        obtain ⟨hmp, hpos⟩ := Finset.mem_filter.mp hm
        have hadd : (m - Finsupp.single v 1) + Finsupp.single v 1 = m := by
          ext j
          rcases eq_or_ne j v with rfl | hj
          · simp only [Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_eq_same]; omega
          · simp [hj]
        have hdeg : ((m - Finsupp.single v 1).sum fun _ e ↦ e) + 1 = (m.sum fun _ e ↦ e) := by
          conv_rhs => rw [← hadd]
          rw [Finsupp.sum_add_index' (fun _ ↦ rfl) (fun _ _ _ ↦ rfl), Finsupp.sum_single_index rfl]
        have h3 : (m.sum fun _ e ↦ e) ≤ p.totalDegree := le_totalDegree hmp
        omega
      omega

private theorem sub_evalOne_eq_one_sub_X_mul {σ : Type*} [DecidableEq σ] (w : σ)
    (p : MvPolynomial σ ℝ) :
    ∃ h : MvPolynomial σ ℝ,
      p - aeval (fun i : σ ↦ if i = w then (1 : MvPolynomial σ ℝ) else X i) p =
        (1 - X w) * h ∧
      h.totalDegree ≤ p.totalDegree - 1 ∧
      ∀ u ∈ h.vars, u ∈ p.vars := by
  have hpow : ∀ e : ℕ, ∃ g : MvPolynomial σ ℝ,
      (X w : MvPolynomial σ ℝ) ^ e - 1 = (1 - X w) * g ∧
      g.totalDegree ≤ e - 1 ∧ g.vars ⊆ {w} := by
    intro e
    induction e with
    | zero => exact ⟨0, by simp, by simp, by simp⟩
    | succ e ih =>
      rcases e with _ | e'
      · exact ⟨-1, by ring, by simp, by simp [vars_neg]⟩
      · obtain ⟨g, hg, hgd, hgv⟩ := ih
        refine ⟨X w * g - 1, ?_, ?_, ?_⟩
        · rw [show (X w : MvPolynomial σ ℝ) ^ (e' + 1 + 1) - 1 =
              X w * (X w ^ (e' + 1) - 1) - (1 - X w) by ring, hg]; ring
        · refine (totalDegree_sub _ _).trans (max_le ?_ (by simp))
          have := totalDegree_var_le (R := ℝ) w
          exact (totalDegree_mul _ _).trans (by omega)
        · refine (vars_sub_le _ _).trans (Finset.union_subset ?_ (by simp))
          exact (vars_mul _ _).trans (Finset.union_subset (vars_X_subset_singleton w) hgv)
  choose ge hge hge_deg hge_vars using hpow
  let ρ1 : σ → MvPolynomial σ ℝ := fun i ↦ if i = w then 1 else X i
  let term (m : σ →₀ ℕ) : MvPolynomial σ ℝ :=
    monomial (m.erase w) (p.coeff m) * ge (m w)
  refine ⟨∑ m ∈ p.support.filter (fun m ↦ 0 < m w), term m, ?_, ?_, ?_⟩
  · rw [Finset.mul_sum]
    conv_lhs => rw [p.as_sum, map_sum, ← Finset.sum_sub_distrib]
    have hterm : ∀ m ∈ p.support,
        monomial m (p.coeff m) - aeval ρ1 (monomial m (p.coeff m)) =
        if 0 < m w then (1 - X w) * term m else 0 := fun m _ ↦ by
      have herase : monomial m (p.coeff m) = monomial (m.erase w) (p.coeff m) * X w ^ m w := by
        rw [X_pow_eq_monomial, monomial_mul_monomial, mul_one, Finsupp.erase_add_single w m]
      have haev : aeval ρ1 (monomial m (p.coeff m)) = monomial (m.erase w) (p.coeff m) := by
        rw [herase, map_mul, map_pow, aeval_X]
        simp only [ρ1, ite_true, one_pow, mul_one, aeval_monomial, algebraMap_eq]
        have hprod : (m.erase w).prod (fun i e ↦ ρ1 i ^ e) = monomial (m.erase w) 1 := by
          rw [Finsupp.prod]
          have hfac : ∀ i ∈ (m.erase w).support, ρ1 i ^ (m.erase w) i = X i ^ (m.erase w) i :=
            fun i hi ↦ by
              have hne : i ≠ w := fun he ↦ by simp [he] at hi
              simp [ρ1, hne]
          rw [Finset.prod_congr rfl hfac]
          exact finset_prod_X_pow (m.erase w)
        rw [hprod, C_mul_monomial, mul_one]
      rw [haev]
      split_ifs with hpos
      · rw [herase, ← mul_sub_one, hge (m w)]; dsimp only [term]; ring
      · have h0 : m w = 0 := by omega
        rw [herase, h0, pow_zero, mul_one, sub_self]
    rw [Finset.sum_congr rfl hterm, Finset.sum_filter]
  · refine totalDegree_finsetSum_le fun m hm ↦ (totalDegree_mul _ _).trans ?_
    obtain ⟨hmp, hpos⟩ := Finset.mem_filter.mp hm
    have h1 : (monomial (m.erase w) (p.coeff m)).totalDegree ≤
        ((m.erase w).sum fun _ e ↦ e) := totalDegree_monomial_le _ _
    have h2 := hge_deg (m w)
    have hsplit : ((m.erase w).sum fun _ e ↦ e) + m w = (m.sum fun _ e ↦ e) := by
      have := Finsupp.erase_add_single w m
      conv_rhs => rw [← this]
      rw [Finsupp.sum_add_index' (fun _ ↦ rfl) (fun _ _ _ ↦ rfl), Finsupp.sum_single_index rfl]
    have h3 : (m.sum fun _ e ↦ e) ≤ p.totalDegree := le_totalDegree hmp
    omega
  · intro u hu
    obtain ⟨m, hm, hum⟩ := Finset.mem_biUnion.mp (vars_sum_subset _ _ hu)
    obtain ⟨hmp, hpos⟩ := Finset.mem_filter.mp hm
    rcases Finset.mem_union.mp (vars_mul _ _ hum) with h1 | h2
    · obtain ⟨d, hd, hdu⟩ := mem_vars_iff.mp h1
      have hus : u ∈ (m.erase w).support :=
        (Finset.mem_singleton.mp (support_monomial_subset hd)) ▸ hdu
      rw [Finsupp.support_erase] at hus
      exact mem_vars_of_mem_support hmp (Finset.mem_erase.mp hus).2
    · have huw : u = w := Finset.mem_singleton.mp (hge_vars (m w) h2)
      exact mem_vars_of_mem_support hmp (huw ▸ Finsupp.mem_support_iff.mpr hpos.ne')

private theorem vars_aeval_subset {σ : Type*}
    (ρ : σ → MvPolynomial σ ℝ) (p : MvPolynomial σ ℝ) {S : Finset σ}
    (hρ : ∀ i ∈ p.vars, (ρ i).vars ⊆ S) : (aeval ρ p).vars ⊆ S := by
  classical
  intro u hu
  have hsum : aeval ρ p = ∑ m ∈ p.support, aeval ρ (monomial m (p.coeff m)) := by
    conv_lhs => rw [p.as_sum, map_sum]
  rw [hsum] at hu
  obtain ⟨m, hm, hum⟩ := Finset.mem_biUnion.mp (vars_sum_subset _ _ hu)
  rw [aeval_monomial, algebraMap_eq] at hum
  rcases Finset.mem_union.mp (vars_mul _ _ hum) with hc | hp
  · simp [vars_C] at hc
  · rw [Finsupp.prod] at hp
    obtain ⟨i, him, hiu⟩ := Finset.mem_biUnion.mp (vars_prod_le m.support _ hp)
    exact hρ i (mem_vars_of_mem_support hm him) (vars_pow _ _ hiu)

private noncomputable def WalkPE.condZero {σ : Type*} [Finite σ] [DecidableEq σ]
    {F : List (MvPolynomial σ ℝ)} {k : ℕ} (hFk : ∀ f ∈ F, f.totalDegree ≤ k)
    {A B : Finset σ} (hAB : Disjoint A B) {r : ℕ}
    (E : WalkPE F k A B r) (hr : 2 ≤ r) {v : σ} (hvA : v ∉ A)
    (hpos : 0 < E.fn (1 - X v)) :
    WalkPE F k (insert v A) B (r - 1) := by
  have h1v_deg : (1 - (X v : MvPolynomial σ ℝ)).totalDegree ≤ 1 :=
    (totalDegree_sub _ _).trans (max_le (by simp) (totalDegree_var_le v))
  have h1v2_deg : ((1 - (X v : MvPolynomial σ ℝ)) ^ 2).totalDegree ≤ 2 :=
    (totalDegree_pow _ 2).trans (by omega)
  have hc_pos : 0 < E.fn ((1 - X v) ^ 2) := by
    have hid : (1 - (X v : MvPolynomial σ ℝ)) ^ 2 = (1 - X v) + 1 * boolAxiom ℝ v := by
      rw [boolAxiom_eq_sub]; ring
    rwa [hid, map_add, E.map_bool_zero v hvA 1
      (by rw [one_mul]; exact (totalDegree_boolAxiom_le v).trans (by omega)), add_zero]
  let fn' : MvPolynomial σ ℝ →ₗ[ℝ] ℝ :=
    { toFun := fun q ↦ (E.fn ((1 - X v) ^ 2))⁻¹ * E.fn ((1 - X v) ^ 2 * q)
      map_add' := fun p q ↦ by rw [mul_add, map_add, mul_add]
      map_smul' := fun a p ↦ by simp [mul_left_comm] }
  refine
    { fn := fn'
      map_one := by
        change _ * E.fn ((1 - X v) ^ 2 * 1) = 1
        rw [mul_one, inv_mul_cancel₀ hc_pos.ne']
      map_sq_nonneg := fun s hs ↦ mul_nonneg (inv_nonneg.mpr hc_pos.le) (by
        rw [← mul_pow]
        exact E.map_sq_nonneg ((1 - X v) * s) (by have := totalDegree_mul (1 - X v) s; omega))
      map_bool_zero := fun u hu q hq ↦ by
        have huA : u ∉ A := fun h ↦ hu (Finset.mem_insert_of_mem h)
        change _ * E.fn ((1 - X v) ^ 2 * (q * boolAxiom ℝ u)) = 0
        rw [← mul_assoc, E.map_bool_zero u huA _ (by
          rw [mul_assoc]; have := totalDegree_mul ((1 - X v) ^ 2) (q * boolAxiom ℝ u); omega),
          mul_zero]
      map_axiom_zero := fun f hf q hq ↦ ?_
      map_one_sub_zero := fun w hw ↦ ?_ }
  · change _ * E.fn ((1 - X v) ^ 2 * (q * aeval _ f)) = 0
    set g := aeval (fun i : σ ↦ if i ∈ A then (0 : MvPolynomial σ ℝ) else X i) f
    have hcomp : aeval (fun i : σ ↦ if i ∈ insert v A then (0 : MvPolynomial σ ℝ) else X i) f =
        aeval (fun i : σ ↦ if i = v then (0 : MvPolynomial σ ℝ) else X i) g := by
      simp only [g, ← AlgHom.comp_apply]; congr 1; refine MvPolynomial.algHom_ext fun i ↦ ?_
      simp only [AlgHom.comp_apply, aeval_X, Finset.mem_insert]
      by_cases hiA : i ∈ A
      · simp [hiA]
      · rcases eq_or_ne i v with rfl | hiv <;> simp_all
    have h1_bd : ∀ i : σ, (if i ∈ A then (0 : MvPolynomial σ ℝ) else X i).totalDegree ≤ 1 :=
      fun i ↦ by
        by_cases h : i ∈ A; · simp [h]
        simp only [h, ite_false]; exact totalDegree_var_le i
    have hg_deg : g.totalDegree ≤ k :=
      le_trans (by simpa using totalDegree_aeval_le_mul h1_bd f) (hFk f hf)
    obtain ⟨h, hh_eq, hh_deg⟩ := sub_evalZero_eq_X_mul v g
    have hid : (1 - X v) ^ 2 * (q * aeval (fun i ↦ if i = v then 0 else X i) g) =
        ((1 - X v) ^ 2 * q) * g + ((1 - X v) * q * h) * boolAxiom ℝ v := by
      have : aeval (fun i : σ ↦ if i = v then (0 : MvPolynomial σ ℝ) else X i) g = g - X v * h :=
        by rw [← hh_eq]; ring
      rw [this, boolAxiom_eq_sub]; ring
    rw [hcomp, hid, map_add, E.map_axiom_zero f hf ((1 - X v) ^ 2 * q)
      (by have := totalDegree_mul ((1 - X v) ^ 2) q; omega), zero_add]
    have ht2 : E.fn (((1 - X v) * q * h) * boolAxiom ℝ v) = 0 := by
      rcases hh_deg with rfl | hhd
      · simp
      · refine E.map_bool_zero v hvA _ ?_
        have h1q := (totalDegree_mul (1 - X v) q).trans (Nat.add_le_add h1v_deg le_rfl)
        have h1qh := (totalDegree_mul ((1 - X v) * q) h).trans (Nat.add_le_add h1q le_rfl)
        have := (totalDegree_mul ((1 - X v) * q * h) (boolAxiom ℝ v)).trans
          (Nat.add_le_add h1qh (totalDegree_boolAxiom_le v)); omega
    rw [ht2, mul_zero]
  · have hwA : w ∉ A := Finset.disjoint_right.mp hAB hw
    change _ * E.fn ((1 - X v) ^ 2 * (1 - X w)) = 0
    rw [mul_comm ((1 - X v) ^ 2), E.map_one_sub_mul_eq_zero (by omega) hwA
      (E.map_one_sub_zero w hw) (by omega) ?_, mul_zero]
    intro u hu
    have hsub : ((1 - (X v : MvPolynomial σ ℝ)) ^ 2).vars ⊆ {v} :=
      (vars_pow _ 2).trans ((vars_sub_le _ _).trans
        (Finset.union_subset (by simp) (vars_X_subset_singleton v)))
    exact (Finset.mem_singleton.mp (hsub hu)) ▸ hvA

private def WalkPE.condOne {σ : Type*} [DecidableEq σ]
    {F : List (MvPolynomial σ ℝ)} {k : ℕ} {A B : Finset σ} {r : ℕ}
    (E : WalkPE F k A B r) {v : σ} (hv0 : E.fn (1 - X v) = 0) :
    WalkPE F k A (insert v B) r :=
  { E with map_one_sub_zero := fun w hw ↦
      (Finset.mem_insert.mp hw).elim (fun h ↦ h ▸ hv0) (E.map_one_sub_zero w) }

private theorem WalkPE.map_leaf_axiom_zero {σ : Type*} [Finite σ] [DecidableEq σ]
    {F : List (MvPolynomial σ ℝ)} {k : ℕ} (hFk : ∀ f ∈ F, f.totalDegree ≤ k)
    {A B : Finset σ} (hAB : Disjoint A B) {r : ℕ} (E : WalkPE F k A B r) (hr : 1 ≤ r)
    {f : MvPolynomial σ ℝ} (hf : f ∈ F) {q : MvPolynomial σ ℝ}
    (hq_deg : q.totalDegree + k ≤ 2 * r) (hq_vars : ∀ u ∈ q.vars, u ∉ A) :
    E.fn (q * aeval (fun i : σ ↦
      if i ∈ A then (0 : MvPolynomial σ ℝ) else if i ∈ B then 1 else X i) f) = 0 := by
  cases nonempty_fintype σ
  let g₀ := aeval (fun i : σ ↦ if i ∈ A then (0 : MvPolynomial σ ℝ) else X i) f
  have hrew : aeval (fun i : σ ↦
      if i ∈ A then (0 : MvPolynomial σ ℝ) else if i ∈ B then 1 else X i) f =
      aeval (fun i : σ ↦ if i ∈ B then (1 : MvPolynomial σ ℝ) else X i) g₀ := by
    simp only [g₀, ← AlgHom.comp_apply]; congr 1; refine MvPolynomial.algHom_ext fun i ↦ ?_
    simp only [AlgHom.comp_apply, aeval_X]
    by_cases hiA : i ∈ A
    · simp [hiA]
    · by_cases hiB : i ∈ B <;> simp [hiA, hiB]
  rw [hrew]
  have hA_bd : ∀ i : σ, (if i ∈ A then (0 : MvPolynomial σ ℝ) else X i).totalDegree ≤ 1 :=
    fun i ↦ by
      by_cases h : i ∈ A; · simp [h]
      simp only [h, ite_false]; exact totalDegree_var_le i
  have hg₀_deg : g₀.totalDegree ≤ k :=
    le_trans (by simpa using totalDegree_aeval_le_mul hA_bd f) (hFk f hf)
  have hg₀_vars : g₀.vars ⊆ Finset.univ.filter (· ∉ A) :=
    vars_aeval_subset _ f fun i _ ↦ by
      by_cases hi : i ∈ A
      · simp [hi]
      · simp only [hi, ite_false]
        exact (vars_X_subset_singleton i).trans (Finset.singleton_subset_iff.mpr (by simp [hi]))
  suffices htel : ∀ S : Finset σ, S ⊆ B →
      E.fn (q * g₀ - q * aeval (fun i : σ ↦ if i ∈ S then (1 : MvPolynomial σ ℝ) else X i) g₀) =
        0 by
    have h0 := htel B subset_rfl
    rwa [map_sub, E.map_axiom_zero f hf q hq_deg, zero_sub, neg_eq_zero] at h0
  intro S; induction S using Finset.induction_on with
  | empty => intro _; simp [aeval_X_left_apply]
  | insert w S hw ih =>
    intro hSB
    have hSsub : S ⊆ B := (Finset.subset_insert w S).trans hSB
    have hwB : w ∈ B := hSB (Finset.mem_insert_self w S)
    have hwA : w ∉ A := Finset.disjoint_right.mp hAB hwB
    set gS := aeval (fun i : σ ↦ if i ∈ S then (1 : MvPolynomial σ ℝ) else X i) g₀
    have hcomp : aeval (fun i : σ ↦ if i ∈ insert w S then (1 : MvPolynomial σ ℝ) else X i) g₀ =
        aeval (fun i : σ ↦ if i = w then (1 : MvPolynomial σ ℝ) else X i) gS := by
      simp only [gS, ← AlgHom.comp_apply]; congr 1; refine MvPolynomial.algHom_ext fun i ↦ ?_
      simp only [AlgHom.comp_apply, aeval_X, Finset.mem_insert]
      by_cases hiS : i ∈ S
      · simp [hiS]
      · rcases eq_or_ne i w with rfl | hiw <;> simp_all
    have hS_bd : ∀ i : σ, (if i ∈ S then (1 : MvPolynomial σ ℝ) else X i).totalDegree ≤ 1 :=
      fun i ↦ by
        by_cases h : i ∈ S; · simp [h]
        simp only [h, ite_false]; exact totalDegree_var_le i
    have hgS_deg : gS.totalDegree ≤ k :=
      le_trans (by simpa using totalDegree_aeval_le_mul hS_bd g₀) hg₀_deg
    have hgS_vars : gS.vars ⊆ Finset.univ.filter (· ∉ A) :=
      vars_aeval_subset _ g₀ fun i hi ↦ by
        by_cases hiS : i ∈ S
        · simp [hiS]
        · simp only [hiS, ite_false]
          exact (vars_X_subset_singleton i).trans (Finset.singleton_subset_iff.mpr (hg₀_vars hi))
    obtain ⟨h, hh_eq, hh_deg, hh_vars⟩ := sub_evalOne_eq_one_sub_X_mul w gS
    have hsplit : q * g₀ -
        q * aeval (fun i : σ ↦ if i ∈ insert w S then (1 : MvPolynomial σ ℝ) else X i) g₀ =
        (q * g₀ - q * gS) + (1 - X w) * (q * h) := by
      rw [hcomp]
      have : aeval (fun i ↦ if i = w then (1 : MvPolynomial σ ℝ) else X i) gS =
          gS - (1 - X w) * h := by rw [← hh_eq]; ring
      rw [this]; ring
    rw [hsplit, map_add, ih hSsub, zero_add]
    by_cases hh0 : h = 0
    · simp [hh0]
    · have hk1 : 1 ≤ gS.totalDegree := by
        by_contra h0
        have hc := totalDegree_eq_zero_iff_eq_C.mp (by omega : gS.totalDegree = 0)
        rw [hc, aeval_C, algebraMap_eq, sub_self] at hh_eq
        rcases mul_eq_zero.mp hh_eq.symm with h1 | h2
        · have := congrArg (eval (0 : σ → ℝ)) h1; simp at this
        · exact hh0 h2
      exact E.map_one_sub_mul_eq_zero hr hwA (E.map_one_sub_zero w hwB)
        ((totalDegree_mul _ _).trans (by omega)) fun u hu ↦
        (Finset.mem_union.mp (vars_mul _ _ hu)).elim (hq_vars u)
          fun h2 ↦ (Finset.mem_filter.mp (hgS_vars (hh_vars u h2))).2

private theorem WalkPE.false_of_no_wide {σ : Type*} [Finite σ] [DecidableEq σ]
    {F : List (MvPolynomial σ ℝ)} {k b : ℕ} (hFk : ∀ f ∈ F, f.totalDegree ≤ k)
    (hb : 1 ≤ b) {A B : Finset σ} (hAB : Disjoint A B) {r : ℕ}
    (hr : max (b + k) (2 * b) ≤ 2 * r) (E : WalkPE F k A B r) (π : SosRefutation F)
    (hnowide_mult : ∀ i : Fin F.length, ∀ m ∈ (π.mult i).support,
      Disjoint m.support A → (m.support \ B).card < b)
    (hnowide_sq : ∀ s ∈ π.squares, ∀ m ∈ s.support,
      Disjoint m.support A → (m.support \ B).card < b) : False := by
  cases nonempty_fintype σ
  let ρ : σ → MvPolynomial σ ℝ := fun i ↦ if i ∈ A then 0 else if i ∈ B then 1 else X i
  have hρ_vars : ∀ p : MvPolynomial σ ℝ, ∀ u ∈ (aeval ρ p).vars, u ∉ A := fun p u hu ↦ by
    have hsub : (aeval ρ p).vars ⊆ Finset.univ.filter (· ∉ A) :=
      vars_aeval_subset ρ p fun i _ ↦ by
        dsimp only [ρ]
        by_cases hiA : i ∈ A
        · simp [hiA]
        · by_cases hiB : i ∈ B
          · simp [hiA, hiB]
          · simp only [hiA, hiB, ite_false]
            exact (vars_X_subset_singleton i).trans
              (Finset.singleton_subset_iff.mpr (by simp [hiA]))
    exact (Finset.mem_filter.mp (hsub hu)).2
  have hρ_supp : ∀ p : MvPolynomial σ ℝ,
      (∀ m ∈ p.support, Disjoint m.support A → (m.support \ B).card < b) →
      (multilin (aeval ρ p)).totalDegree ≤ b - 1 ∧
      ∀ u ∈ (multilin (aeval ρ p)).vars, u ∉ A := by
    intro p hp
    have hmon_supp : ∀ d ∈ (aeval ρ p).support, d.support.card ≤ b - 1 ∧
        ∀ u ∈ d.support, u ∉ A := by
      intro d hd
      have hsum : aeval ρ p = ∑ m ∈ p.support, aeval ρ (monomial m (p.coeff m)) := by
        conv_lhs => rw [p.as_sum, map_sum]
      rw [hsum] at hd
      obtain ⟨m, hm, hdm⟩ := Finset.mem_biUnion.mp (support_sum hd)
      have hdisjA : Disjoint m.support A := Finset.disjoint_left.mpr fun i him hiA ↦ by
        have hzero : aeval ρ (monomial m (p.coeff m)) = 0 := by
          rw [aeval_monomial, algebraMap_eq, Finsupp.prod,
            Finset.prod_eq_zero him (by simp [ρ, hiA, zero_pow (Finsupp.mem_support_iff.mp him)]),
            mul_zero]
        simp [hzero] at hdm
      let m' : σ →₀ ℕ := m.filter (· ∉ B)
      have haev_eq : aeval ρ (monomial m (p.coeff m)) = monomial m' (p.coeff m) := by
        rw [aeval_monomial, algebraMap_eq]
        have hprod : m.prod (fun i e ↦ ρ i ^ e) = monomial m' 1 := by
          rw [Finsupp.prod]
          have hfac : ∀ i ∈ m.support, ρ i ^ m i = if i ∉ B then X i ^ m i else 1 :=
            fun i hi ↦ by
              have hiA : i ∉ A := Finset.disjoint_left.mp hdisjA hi
              by_cases hiB : i ∈ B <;> simp [ρ, hiA, hiB]
          rw [Finset.prod_congr rfl hfac, ← Finset.prod_filter]
          have hfs : m.support.filter (· ∉ B) = m'.support := by
            ext i; simp [m', Finsupp.mem_support_iff, and_comm]
          rw [hfs, ← finset_prod_X_pow m']
          exact Finset.prod_congr rfl fun i hi ↦ by
            have hiB : i ∉ B := fun hc ↦ Finsupp.mem_support_iff.mp hi (by simp [m', hc])
            rw [Finsupp.filter_apply_pos (· ∉ B) m hiB]
        rw [hprod, C_mul_monomial, mul_one]
      rw [haev_eq] at hdm
      have hdeq : d = m' := Finset.mem_singleton.mp (support_monomial_subset hdm)
      rw [hdeq]
      have hm'_supp : m'.support = m.support \ B := by
        ext i; simp [m', Finsupp.mem_support_iff, Finset.mem_sdiff, and_comm]
      rw [hm'_supp]
      have hlt := hp m hm hdisjA
      exact ⟨by omega, fun u hu ↦ Finset.disjoint_left.mp hdisjA (Finset.mem_sdiff.mp hu).1⟩
    refine ⟨totalDegree_multilin_le_of_support fun d hd ↦ (hmon_supp d hd).1, fun u hu ↦ ?_⟩
    rw [multilin_eq_sum] at hu
    obtain ⟨d, hd, hdu⟩ := Finset.mem_biUnion.mp (vars_sum_subset _ _ hu)
    obtain ⟨e, he, heu⟩ := mem_vars_iff.mp hdu
    have hed : e = multilinExp d := Finset.mem_singleton.mp (support_monomial_subset he)
    exact (hmon_supp d hd).2 u (support_multilinExp d ▸ hed ▸ heu)
  let tml (i : Fin F.length) := multilin (aeval ρ (π.mult i))
  let sml : List (MvPolynomial σ ℝ) := π.squares.map fun s ↦ multilin (aeval ρ s)
  let Q : MvPolynomial σ ℝ :=
    ∑ i : Fin F.length, tml i * aeval ρ (F.get i) + (sml.map fun s ↦ s ^ 2).sum + 1
  have hQ_deg : Q.totalDegree ≤ max (b + k) (2 * b) := by
    refine (totalDegree_add _ _).trans (max_le ((totalDegree_add _ _).trans (max_le ?_ ?_))
      (by simp))
    · have hρ_bd : ∀ j : σ, (ρ j).totalDegree ≤ 1 := fun j ↦ by
        dsimp only [ρ]; split_ifs
        · simp
        · simp
        · exact totalDegree_var_le j
      refine totalDegree_finsetSum_le fun i _ ↦ (totalDegree_mul _ _).trans ?_
      have h1 : (tml i).totalDegree ≤ b - 1 := (hρ_supp (π.mult i) (hnowide_mult i)).1
      have h2 : (aeval ρ (F.get i)).totalDegree ≤ k :=
        le_trans (by simpa using totalDegree_aeval_le_mul hρ_bd (F.get i))
          (hFk _ (List.get_mem F i))
      exact (Nat.add_le_add h1 h2).trans (by omega)
    · have hlist : ∀ l : List (MvPolynomial σ ℝ), (∀ s ∈ l, s.totalDegree ≤ b - 1) →
          ((l.map fun s ↦ s ^ 2).sum).totalDegree ≤ 2 * b := by
        intro l hl; induction l with
        | nil => simp
        | cons s ss ih =>
          simp only [List.map_cons, List.sum_cons]
          refine (totalDegree_add _ _).trans (max_le ?_
            (ih fun s' hs' ↦ hl s' (List.mem_cons_of_mem s hs')))
          have := (totalDegree_pow s 2).trans (Nat.mul_le_mul_left 2 (hl s List.mem_cons_self))
          omega
      refine (hlist sml fun s hs ↦ ?_).trans (le_max_right _ _)
      obtain ⟨s₀, hs₀, rfl⟩ := List.mem_map.mp hs
      exact (hρ_supp s₀ (hnowide_sq s₀ hs₀)).1
  have hQ_vars : ∀ u ∈ Q.vars, u ∉ A := by
    intro u hu
    rcases Finset.mem_union.mp (vars_add_subset _ _ hu) with h12 | h3
    · rcases Finset.mem_union.mp (vars_add_subset _ _ h12) with h1 | h2
      · obtain ⟨i, _, hui⟩ := Finset.mem_biUnion.mp (vars_sum_subset _ _ h1)
        exact (Finset.mem_union.mp (vars_mul _ _ hui)).elim
          ((hρ_supp (π.mult i) (hnowide_mult i)).2 u) (hρ_vars _ u)
      · have hsqv : ∀ l : List (MvPolynomial σ ℝ), (∀ s ∈ l, ∀ v ∈ s.vars, v ∉ A) →
            ∀ v ∈ ((l.map fun s ↦ s ^ 2).sum).vars, v ∉ A := by
          intro l hl v hv; induction l with
          | nil => simp at hv
          | cons s ss ih =>
            simp only [List.map_cons, List.sum_cons] at hv
            exact (Finset.mem_union.mp (vars_add_subset _ _ hv)).elim
              (fun hs ↦ hl s List.mem_cons_self v (vars_pow _ _ hs))
              (ih fun s' hs' ↦ hl s' (List.mem_cons_of_mem s hs'))
        refine hsqv sml (fun s hs v hv ↦ ?_) u h2
        obtain ⟨s₀, hs₀, rfl⟩ := List.mem_map.mp hs
        exact (hρ_supp s₀ (hnowide_sq s₀ hs₀)).2 v hv
    · simp at h3
  have hQ_eval : ∀ a : σ → Bool, eval (boolPoint ℝ a) Q = 0 := fun a ↦ by
    have heq := congrArg (fun p ↦ eval (boolPoint ℝ a) (aeval ρ p)) π.eq
    simp only [map_add, map_sum, map_mul, map_list_sum, List.map_map, map_neg] at heq
    have hq : eval (boolPoint ℝ a) Q =
        (∑ i, eval (boolPoint ℝ a) (aeval ρ (π.mult i)) *
          eval (boolPoint ℝ a) (aeval ρ (F.get i)) +
        (π.squares.map (fun s ↦ eval (boolPoint ℝ a) (aeval ρ s) ^ 2)).sum) + 1 := by
      simp [Q, tml, sml, map_list_sum, List.map_map, Function.comp_def]
    rw [hq]
    have heq' : ∑ i, eval (boolPoint ℝ a) (aeval ρ (π.mult i)) *
          eval (boolPoint ℝ a) (aeval ρ (F.get i)) +
        (π.squares.map (fun s ↦ eval (boolPoint ℝ a) (aeval ρ s) ^ 2)).sum = -1 := by
      simpa [Function.comp_def] using heq
    linarith
  obtain ⟨qb, hqb_eq, hqb_deg, hqb_vars⟩ := eq_sum_mul_boolAxiom_of_eval_eq_zero hQ_deg hQ_eval
  have hEQ0 : E.fn Q = 0 := by
    rw [hqb_eq, map_sum]; refine Finset.sum_eq_zero fun u _ ↦ ?_
    by_cases hu : u ∈ Q.vars
    · exact E.map_bool_zero u (hQ_vars u hu) (qb u) ((hqb_deg u).trans hr)
    · simp [hqb_vars u hu]
  have hbk : b + k ≤ 2 * r := (le_max_left _ _).trans hr
  have h2b : 2 * b ≤ 2 * r := (le_max_right _ _).trans hr
  have hEQ_ax : E.fn (∑ i : Fin F.length, tml i * aeval ρ (F.get i)) = 0 := by
    rw [map_sum]; refine Finset.sum_eq_zero fun i _ ↦ ?_
    have ⟨htd, htv⟩ := hρ_supp (π.mult i) (hnowide_mult i)
    have htd' : (tml i).totalDegree + k ≤ 2 * r := by change (multilin _).totalDegree + k ≤ _; omega
    exact E.map_leaf_axiom_zero hFk hAB (by omega) (List.get_mem F i) htd' htv
  have hEQ_sq : 0 ≤ E.fn ((sml.map fun s ↦ s ^ 2).sum) := by
    rw [map_list_sum, List.map_map]; refine List.sum_nonneg fun x hx ↦ ?_
    obtain ⟨s, hs, rfl⟩ := List.mem_map.mp hx
    obtain ⟨s₀, hs₀, rfl⟩ := List.mem_map.mp hs
    have ⟨hsd, _⟩ := hρ_supp s₀ (hnowide_sq s₀ hs₀)
    exact E.map_sq_nonneg (multilin (aeval ρ s₀)) (by omega)
  simp only [Q, map_add, hEQ_ax, zero_add, E.map_one] at hEQ0
  linarith

private theorem greedy_walk_bound {σ : Type*} [Fintype σ] [DecidableEq σ]
    (hn : 0 < Fintype.card σ)
    {F : List (MvPolynomial σ ℝ)} {k b : ℕ} (hFk : ∀ f ∈ F, f.totalDegree ≤ k)
    (hb : 1 ≤ b) (π : SosRefutation F)
    (M₀ : List (Finset σ))
    (hmult_mem : ∀ i : Fin F.length, ∀ m ∈ (π.mult i).support, m.support ∈ M₀)
    (hsq_mem : ∀ s ∈ π.squares, ∀ m ∈ s.support, m.support ∈ M₀) :
    ∀ (fuel T r : ℕ) (A B : Finset σ),
      Fintype.card σ - (A ∪ B).card ≤ fuel →
      Disjoint A B →
      1 ≤ T →
      max (b + k) (2 * b) + 2 * T ≤ 2 * r →
      Nonempty (WalkPE F k A B r) →
      (1 : ℝ) ≤ (1 - (b : ℝ) / (Fintype.card σ : ℝ)) ^ (T - 1) *
        ((M₀.filter fun S ↦ decide (Disjoint S A ∧ b ≤ (S \ B).card)).length : ℝ) := by
  intro fuel
  induction fuel with
  | zero =>
    intro T r A B hfuel hAB _ hr ⟨E⟩
    have huniv : A ∪ B = Finset.univ :=
      Finset.eq_univ_of_card _ (le_antisymm (Finset.card_le_univ _) (by omega))
    have hemp : ∀ S : Finset σ, Disjoint S A → S \ B = ∅ := fun S hdA ↦ by
      ext u
      simp only [Finset.mem_sdiff, Finset.notMem_empty, iff_false, not_and]
      intro huS huB
      exact (Finset.mem_union.mp (huniv ▸ Finset.mem_univ u)).elim
        (Finset.disjoint_left.mp hdA huS) huB
    exact (E.false_of_no_wide hFk hb hAB (by omega) π
      (fun _ m _ hdA ↦ by rw [hemp m.support hdA, Finset.card_empty]; omega)
      (fun _ _ m _ hdA ↦ by rw [hemp m.support hdA, Finset.card_empty]; omega)).elim
  | succ fuel ih =>
    intro T r A B hfuel hAB hT hr ⟨E⟩
    set active := M₀.filter fun S ↦ decide (Disjoint S A ∧ b ≤ (S \ B).card)
    have hact_pos : 1 ≤ active.length := by
      by_contra h0
      have hemp : active = [] := List.eq_nil_of_length_eq_zero (by omega)
      have hnone : ∀ S ∈ M₀, Disjoint S A → (S \ B).card < b := fun S hS hdA ↦ by
        by_contra hge
        have : S ∈ active := List.mem_filter.mpr ⟨hS, decide_eq_true ⟨hdA, by omega⟩⟩
        simp [hemp] at this
      exact E.false_of_no_wide hFk hb hAB (by omega) π
        (fun i m hm ↦ hnone m.support (hmult_mem i m hm))
        (fun s hs m hm ↦ hnone m.support (hsq_mem s hs m hm))
    rcases eq_or_lt_of_le hT with rfl | hT2
    · simp only [Nat.sub_self, pow_zero, one_mul]
      exact_mod_cast hact_pos
    · let U : Finset σ := Finset.univ \ (A ∪ B)
      have hsubU : ∀ S ∈ active, S \ B ⊆ U := fun S hS u hu ↦ by
        have ⟨hdA, _⟩ := of_decide_eq_true (List.mem_filter.mp hS).2
        obtain ⟨huS, huB⟩ := Finset.mem_sdiff.mp hu
        exact Finset.mem_sdiff.mpr ⟨Finset.mem_univ u, fun h ↦
          (Finset.mem_union.mp h).elim (Finset.disjoint_left.mp hdA huS) huB⟩
      have hsum_ge : b * active.length ≤
          ∑ v ∈ U, (active.filter fun S ↦ decide (v ∈ S)).length := by
        have hcount : ∀ l : List (Finset σ), (∀ S ∈ l, S \ B ⊆ U) →
            (l.map fun S ↦ (S \ B).card).sum =
            ∑ v ∈ U, (l.filter fun S ↦ decide (v ∈ S)).length := by
          intro l hl
          induction l with
          | nil => simp
          | cons S ss ihl =>
            simp only [List.map_cons, List.sum_cons, List.filter_cons]
            rw [ihl fun S' hS' ↦ hl S' (List.mem_cons_of_mem S hS')]
            have hfilt : U.filter (· ∈ S) = S \ B := by
              ext v
              refine ⟨fun hv ↦ ?_, fun hv ↦ Finset.mem_filter.mpr
                ⟨hl S List.mem_cons_self hv, (Finset.mem_sdiff.mp hv).1⟩⟩
              obtain ⟨hvU, hvS⟩ := Finset.mem_filter.mp hv
              exact Finset.mem_sdiff.mpr ⟨hvS, fun hvB ↦
                (Finset.mem_sdiff.mp hvU).2 (Finset.mem_union_right A hvB)⟩
            rw [← hfilt, Finset.card_filter, ← Finset.sum_add_distrib]
            exact Finset.sum_congr rfl fun v _ ↦ by by_cases hv : v ∈ S <;> simp [hv, Nat.add_comm]
        rw [← hcount active hsubU]
        have hlb : ∀ l : List (Finset σ), (∀ S ∈ l, b ≤ (S \ B).card) →
            b * l.length ≤ (l.map fun S ↦ (S \ B).card).sum := by
          intro l hl; induction l with
          | nil => simp
          | cons S ss ihl =>
            simp only [List.map_cons, List.sum_cons, List.length_cons, Nat.mul_succ]
            have := hl S List.mem_cons_self
            have := ihl fun S' hS' ↦ hl S' (List.mem_cons_of_mem S hS'); omega
        exact hlb active fun S hS ↦ (of_decide_eq_true (List.mem_filter.mp hS).2).2
      have hS₀_ex : ∃ S₀ ∈ active, True := by
        rcases hact : active with _ | ⟨S₀, _⟩
        · simp [hact] at hact_pos
        · exact ⟨S₀, List.mem_cons_self, trivial⟩
      obtain ⟨S₀, hS₀, -⟩ := hS₀_ex
      have hS₀_ge : b ≤ (S₀ \ B).card := (of_decide_eq_true (List.mem_filter.mp hS₀).2).2
      have hU_ne : U.Nonempty := by
        obtain ⟨u, hu⟩ := Finset.card_pos.mp (by omega : 0 < (S₀ \ B).card)
        exact ⟨u, hsubU S₀ hS₀ hu⟩
      have hb_le_n : b ≤ Fintype.card σ := hS₀_ge.trans (Finset.card_le_univ _)
      obtain ⟨v, hvU, hv_freq⟩ : ∃ v ∈ U,
          (b : ℝ) * (active.length : ℝ) / (Fintype.card σ : ℝ) ≤
            ((active.filter fun S ↦ decide (v ∈ S)).length : ℝ) := by
        by_contra hall
        push Not at hall
        have hlt := Finset.sum_lt_sum_of_nonempty hU_ne hall
        rw [Finset.sum_const, nsmul_eq_mul] at hlt
        have hprod : (U.card : ℝ) * ((b : ℝ) * (active.length : ℝ) / (Fintype.card σ : ℝ)) ≤
            (b : ℝ) * (active.length : ℝ) := by
          rw [mul_div_assoc', div_le_iff₀ (Nat.cast_pos.mpr hn),
            mul_comm ((b : ℝ) * (active.length : ℝ))]
          exact mul_le_mul_of_nonneg_right (Nat.cast_le.mpr (Finset.card_le_univ U))
            (mul_nonneg (Nat.cast_nonneg b) (Nat.cast_nonneg active.length))
        have hge : (b : ℝ) * (active.length : ℝ) ≤
            ∑ v ∈ U, ((active.filter fun S ↦ decide (v ∈ S)).length : ℝ) := by
          exact_mod_cast hsum_ge
        linarith
      have hvAB : v ∉ A ∪ B := (Finset.mem_sdiff.mp hvU).2
      have hvA : v ∉ A := fun h ↦ hvAB (Finset.mem_union_left B h)
      have hvB : v ∉ B := fun h ↦ hvAB (Finset.mem_union_right A h)
      have h1v_nn : 0 ≤ E.fn (1 - X v) := by
        have hid : (1 - (X v : MvPolynomial σ ℝ)) ^ 2 = (1 - X v) + 1 * boolAxiom ℝ v := by
          rw [boolAxiom_eq_sub]; ring
        have hsq := E.map_sq_nonneg (1 - X v) (by
          have := (totalDegree_sub (1 : MvPolynomial σ ℝ) (X v)).trans
            (max_le (by simp) (totalDegree_var_le v))
          omega)
        rwa [hid, map_add, E.map_bool_zero v hvA 1
          (by rw [one_mul]; exact (totalDegree_boolAxiom_le v).trans (by omega)), add_zero] at hsq
      have hfnn : 0 ≤ 1 - (b : ℝ) / (Fintype.card σ : ℝ) := by
        rw [sub_nonneg, div_le_one (Nat.cast_pos.mpr hn)]
        exact_mod_cast hb_le_n
      rcases eq_or_lt_of_le h1v_nn with hv0 | hvpos
      · have hcard_inc : (A ∪ insert v B).card = (A ∪ B).card + 1 := by
          rw [Finset.union_insert, Finset.card_insert_of_notMem hvAB]
        have hih := ih T r A (insert v B) (by omega)
          (Finset.disjoint_insert_right.mpr ⟨hvA, hAB⟩) hT hr ⟨E.condOne hv0.symm⟩
        have hlen_le : (M₀.filter fun S ↦
            decide (Disjoint S A ∧ b ≤ (S \ insert v B).card)).length ≤ active.length := by
          have hfl : ∀ l : List (Finset σ),
              (l.filter fun S ↦ decide (Disjoint S A ∧ b ≤ (S \ insert v B).card)).length ≤
              (l.filter fun S ↦ decide (Disjoint S A ∧ b ≤ (S \ B).card)).length := by
            intro l; induction l with
            | nil => simp
            | cons S ss ihs =>
              simp only [List.filter_cons]
              by_cases h1 : Disjoint S A ∧ b ≤ (S \ insert v B).card
              · have h2 : Disjoint S A ∧ b ≤ (S \ B).card :=
                  ⟨h1.1, h1.2.trans (Finset.card_le_card
                    (Finset.sdiff_subset_sdiff subset_rfl (Finset.subset_insert v B)))⟩
                rw [decide_eq_true h1, decide_eq_true h2]
                simp only [↓reduceIte, List.length_cons]
                exact Nat.succ_le_succ ihs
              · rw [decide_eq_false h1]
                by_cases h2 : Disjoint S A ∧ b ≤ (S \ B).card
                · rw [decide_eq_true h2]; simp only [Bool.false_eq_true, ↓reduceIte,
                    List.length_cons]; exact ihs.trans (Nat.le_succ _)
                · rw [decide_eq_false h2]; exact ihs
          exact hfl M₀
        exact hih.trans (mul_le_mul_of_nonneg_left (Nat.cast_le.mpr hlen_le) (pow_nonneg hfnn _))
      · have hcard_inc : (insert v A ∪ B).card = (A ∪ B).card + 1 := by
          rw [Finset.insert_union, Finset.card_insert_of_notMem hvAB]
        have hih := ih (T - 1) (r - 1) (insert v A) B (by omega)
          (Finset.disjoint_insert_left.mpr ⟨hvB, hAB⟩) (by omega) (by omega)
          ⟨E.condZero hFk hAB (by omega) hvA hvpos⟩
        have hfilt : (M₀.filter fun S ↦
            decide (Disjoint S (insert v A) ∧ b ≤ (S \ B).card)) =
            active.filter fun S ↦ !decide (v ∈ S) := by
          dsimp only [active]
          rw [List.filter_filter]
          congr 1; ext S
          by_cases hd : Disjoint S A <;> by_cases hv : v ∈ S <;>
            by_cases hc : b ≤ (S \ B).card <;>
            simp [Finset.disjoint_insert_right, hd, hv, hc]
        have hpart : (active.filter fun S ↦ decide (v ∈ S)).length +
            (active.filter fun S ↦ !decide (v ∈ S)).length = active.length := by
          clear hih hfilt hsum_ge hv_freq hact_pos hS₀
          induction active with
          | nil => simp
          | cons S ss ihs =>
            simp only [List.filter_cons]; by_cases hv : v ∈ S <;> simp [hv] <;> omega
        have hnew_le : ((M₀.filter fun S ↦
            decide (Disjoint S (insert v A) ∧ b ≤ (S \ B).card)).length : ℝ) ≤
            (1 - (b : ℝ) / (Fintype.card σ : ℝ)) * (active.length : ℝ) := by
          rw [hfilt]
          have hp : ((active.filter fun S ↦ decide (v ∈ S)).length : ℝ) +
              ((active.filter fun S ↦ !decide (v ∈ S)).length : ℝ) = (active.length : ℝ) := by
            exact_mod_cast hpart
          have hmul : (1 - (b : ℝ) / (Fintype.card σ : ℝ)) * (active.length : ℝ) =
              (active.length : ℝ) - (b : ℝ) * (active.length : ℝ) / (Fintype.card σ : ℝ) := by
            ring
          linarith
        calc
          (1 : ℝ) ≤ (1 - (b : ℝ) / (Fintype.card σ : ℝ)) ^ (T - 1 - 1) *
              ((M₀.filter fun S ↦
                decide (Disjoint S (insert v A) ∧ b ≤ (S \ B).card)).length : ℝ) := hih
          _ ≤ (1 - (b : ℝ) / (Fintype.card σ : ℝ)) ^ (T - 1 - 1) *
              ((1 - (b : ℝ) / (Fintype.card σ : ℝ)) * (active.length : ℝ)) :=
            mul_le_mul_of_nonneg_left hnew_le (pow_nonneg hfnn _)
          _ = (1 - (b : ℝ) / (Fintype.card σ : ℝ)) ^ (T - 1) * (active.length : ℝ) := by
            rw [← mul_assoc, ← pow_succ, show T - 1 - 1 + 1 = T - 1 by omega]

/-- **Atserias–Hakoniemi Size-Degree Trade-Off for Sum-of-Squares**: for any system `F` of real
polynomial equations of total degree at most `k` over a nonempty finite set `σ` of
`n = Fintype.card σ` Boolean variables (containing `X i ^ 2 - X i` for all `i : σ`), if `k ≤ d`
and `F` has no SoS refutation of degree strictly less than `d`, then every SoS refutation `π` of
`F` satisfies `Real.exp ((d - k) ^ 2 / (600 * n)) ≤ π.size`. -/
theorem atserias_hakoniemi_size_degree {σ : Type*} [Fintype σ] [Nonempty σ]
    {F : List (MvPolynomial σ ℝ)} {k d : ℕ}
    (hbool : ∀ i : σ, boolAxiom ℝ i ∈ F) (hFk : ∀ f ∈ F, f.totalDegree ≤ k)
    (hkd : k ≤ d) (hnd : ∀ d' < d, ¬ SosRefutableInDegree F d')
    (π : SosRefutation F) :
    Real.exp (((d : ℝ) - (k : ℝ)) ^ 2 / (600 * (Fintype.card σ : ℝ))) ≤ (π.size : ℝ) := by
  classical
  set n : ℕ := Fintype.card σ
  have hn_pos : 0 < n := Fintype.card_pos
  have hk2 : 2 ≤ k := by
    let i₀ : σ := Classical.arbitrary σ
    have hmem : Finsupp.single i₀ 2 ∈ (boolAxiom ℝ i₀).support := by
      rw [mem_support_iff, boolAxiom_eq_sub, coeff_sub, X_pow_eq_monomial, X, coeff_monomial,
        coeff_monomial, ite_eq_left rfl, ite_eq_right (fun h ↦ by
          have := congrArg (fun f ↦ f i₀) h; simp at this), sub_zero]
      exact one_ne_zero
    have h2 : 2 ≤ (boolAxiom ℝ i₀).totalDegree := by
      have hlt := le_totalDegree hmem
      rwa [Finsupp.sum_single_index rfl] at hlt
    exact h2.trans (hFk _ (hbool i₀))
  rcases eq_or_lt_of_le hkd with rfl | hklt
  · simp only [sub_self, zero_pow two_ne_zero, zero_div, Real.exp_zero]
    exact_mod_cast π.one_le_size
  · by_cases hgap : d - k < 20
    · have hsz2 : 2 ≤ π.size := by
        by_contra h1
        exact hnd 0 (by omega) ⟨π, (π.degree_eq_zero_of_size_le_one (by omega)).le⟩
      have harg : ((d : ℝ) - (k : ℝ)) ^ 2 / (600 * (n : ℝ)) ≤ 361 / 600 := by
        have hdk : (d : ℝ) - (k : ℝ) ≤ 19 := by
          have : (d : ℝ) ≤ (k : ℝ) + 19 := by exact_mod_cast (by omega : d ≤ k + 19)
          linarith
        have hdk0 : 0 ≤ (d : ℝ) - (k : ℝ) := by
          have : (k : ℝ) ≤ (d : ℝ) := by exact_mod_cast hklt.le
          linarith
        have hn1 : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn_pos
        rw [div_le_div_iff₀ (by positivity) (by norm_num)]
        nlinarith
      have hexp2 : Real.exp (361 / 600) ≤ 2 := by
        have hthird : Real.exp (361 / 1800) ≤ (1 - 361 / 1800 : ℝ)⁻¹ := by
          rw [le_inv_comm₀ (Real.exp_pos _) (by norm_num)]
          have := Real.add_one_le_exp (-(361 / 1800 : ℝ))
          rw [Real.exp_neg] at this; linarith
        calc
          Real.exp (361 / 600) = Real.exp (361 / 1800) ^ 3 := by rw [← Real.exp_nat_mul]; norm_num
          _ ≤ ((1 - 361 / 1800 : ℝ)⁻¹) ^ 3 := pow_le_pow_left₀ (Real.exp_pos _).le hthird 3
          _ ≤ 2 := by norm_num
      exact (Real.exp_le_exp.mpr harg).trans (hexp2.trans (by exact_mod_cast hsz2))
    · let r₀ : ℕ := (d - 1) / 2
      obtain ⟨PE⟩ := exists_pseudoExpectation_of_not_refutableInDegree hbool (m := r₀)
        fun h ↦ hnd (2 * r₀) (by omega) (sosRefutableInDegree_iff_cslib.mpr h)
      let E₀ : WalkPE F k ∅ ∅ r₀ :=
        { fn := PE.toLinearMap
          map_one := PE.map_one
          map_sq_nonneg := PE.map_sq_nonneg
          map_bool_zero := fun u _ q hq ↦ PE.map_mul_eq_zero _ (hbool u) q hq
          map_axiom_zero := fun f hf q hq ↦ by
            have hid : aeval (fun i : σ ↦
                if i ∈ (∅ : Finset σ) then (0 : MvPolynomial σ ℝ) else X i) f = f := by
              simp [aeval_X_left_apply]
            rw [hid]
            exact PE.map_mul_eq_zero f hf q
              ((totalDegree_mul q f).trans ((Nat.add_le_add_left (hFk f hf) _).trans hq))
          map_one_sub_zero := fun _ hw ↦ by simp at hw }
      let b : ℕ := (d - k) / 4
      have hb5 : 5 ≤ b := by omega
      have hbd : 4 * b ≤ d - k := Nat.mul_div_le (d - k) 4
      have hr0_lb : d - 2 ≤ 2 * r₀ := by omega
      let M₀ : List (Finset σ) :=
        ((List.finRange F.length).flatMap fun i ↦ (π.mult i).support.toList.map Finsupp.support) ++
        (π.squares.flatMap fun s ↦ s.support.toList.map Finsupp.support)
      have hM₀_len : M₀.length = π.size := by
        rw [π.size_eq_sum]
        simp only [M₀, List.length_append, List.length_flatMap, List.length_map,
          Finset.length_toList, Fin.sum_univ_def]
      have hmax_r : max (b + k) (2 * b) + 2 * b ≤ 2 * r₀ := by
        rw [← Nat.add_max_add_right]; exact max_le (by omega) (by omega)
      have hwalk := greedy_walk_bound hn_pos hFk (by omega) π M₀
        (fun i m hm ↦ List.mem_append_left _ (List.mem_flatMap.mpr
          ⟨i, List.mem_finRange i, List.mem_map_of_mem (Finset.mem_toList.mpr hm)⟩))
        (fun s hs m hm ↦ List.mem_append_right _ (List.mem_flatMap.mpr
          ⟨s, hs, List.mem_map_of_mem (Finset.mem_toList.mpr hm)⟩))
        n b r₀ ∅ ∅ (by simp [n]) (Finset.disjoint_empty_left ∅) (by omega)
        hmax_r ⟨E₀⟩
      by_cases hbn : (n : ℝ) < (b : ℝ)
      · have h0 : (M₀.filter fun S ↦
            decide (Disjoint S (∅ : Finset σ) ∧ b ≤ (S \ ∅).card)) = [] := by
          rw [List.filter_eq_nil_iff]
          intro S _
          simp only [decide_eq_true_eq, not_and, Finset.sdiff_empty]
          intro _ hle
          have : (b : ℝ) ≤ (n : ℝ) := by exact_mod_cast hle.trans (Finset.card_le_univ S)
          linarith
        rw [h0, List.length_nil, Nat.cast_zero, mul_zero] at hwalk; linarith
      · push Not at hbn
        have hfnn : 0 ≤ 1 - (b : ℝ) / (n : ℝ) := by
          rw [sub_nonneg, div_le_one (Nat.cast_pos.mpr hn_pos)]; exact hbn
        have hlen_le : ((M₀.filter fun S ↦
            decide (Disjoint S (∅ : Finset σ) ∧ b ≤ (S \ ∅).card)).length : ℝ) ≤ (π.size : ℝ) := by
          rw [← hM₀_len]; exact_mod_cast List.length_filter_le _ M₀
        have hexp_dec : 1 - (b : ℝ) / (n : ℝ) ≤ Real.exp (-((b : ℝ) / (n : ℝ))) := by
          have := Real.add_one_le_exp (-((b : ℝ) / (n : ℝ))); linarith
        have h1 : (1 : ℝ) ≤
            Real.exp (-(((b - 1 : ℕ) : ℝ) * (b : ℝ) / (n : ℝ))) * (π.size : ℝ) :=
          calc
            (1 : ℝ) ≤ (1 - (b : ℝ) / (n : ℝ)) ^ (b - 1) * (π.size : ℝ) :=
              hwalk.trans (mul_le_mul_of_nonneg_left hlen_le (pow_nonneg hfnn _))
            _ ≤ (Real.exp (-((b : ℝ) / (n : ℝ)))) ^ (b - 1) * (π.size : ℝ) :=
              mul_le_mul_of_nonneg_right (pow_le_pow_left₀ hfnn hexp_dec _) (by positivity)
            _ = Real.exp (-(((b - 1 : ℕ) : ℝ) * (b : ℝ) / (n : ℝ))) * (π.size : ℝ) := by
              rw [← Real.exp_nat_mul]; congr 2; ring
        have h2 : Real.exp (((b - 1 : ℕ) : ℝ) * (b : ℝ) / (n : ℝ)) ≤ (π.size : ℝ) := by
          have := mul_le_mul_of_nonneg_left h1
            (Real.exp_pos (((b - 1 : ℕ) : ℝ) * (b : ℝ) / (n : ℝ))).le
          rwa [mul_one, ← mul_assoc, ← Real.exp_add, add_neg_cancel, Real.exp_zero,
            one_mul] at this
        refine (Real.exp_le_exp.mpr ?_).trans h2
        rw [show ((d : ℝ) - (k : ℝ)) ^ 2 / (600 * (n : ℝ)) =
            (((d : ℝ) - (k : ℝ)) ^ 2 / 600) / (n : ℝ) by ring,
          div_le_div_iff_of_pos_right (Nat.cast_pos.mpr hn_pos),
          div_le_iff₀ (by norm_num : (0 : ℝ) < 600),
          Nat.cast_sub (by omega : 1 ≤ b), Nat.cast_one]
        have hb_lb : (d : ℝ) - (k : ℝ) ≤ 4 * (b : ℝ) + 3 := by
          have hc : ((d - k : ℕ) : ℝ) ≤ ((4 * b + 3 : ℕ) : ℝ) := Nat.cast_le.mpr (by omega)
          rw [Nat.cast_sub hkd] at hc; push_cast at hc; exact hc
        have hb5' : (5 : ℝ) ≤ (b : ℝ) := by exact_mod_cast hb5
        have hdk0 : 0 ≤ (d : ℝ) - (k : ℝ) := sub_nonneg.mpr (Nat.cast_le.mpr hkd)
        nlinarith

/-- **Atserias–Hakoniemi Size-Degree Trade-Off over active twin Boolean variables**: for any
twin-literal system `F` of total degree at most `k` whose occurring base variables lie in
`U : Finset V` with `U.card ≤ N`, containing `boolAxiom ℝ (v, b)` for all `v ∈ U` and
`b : Bool`, if `k ≤ d` and `F` has no SoS refutation of degree strictly less than `d`, then every
SoS refutation `π` of `F` satisfies `Real.exp ((d - k) ^ 2 / (1200 * N)) ≤ π.size`. -/
theorem atserias_hakoniemi_size_degree_twin {V : Type*}
    {F : List (MvPolynomial (Lit V) ℝ)} {U : Finset V} {N k d : ℕ}
    (hUN : U.card ≤ N)
    (hvars : ∀ f ∈ F, ∀ l ∈ f.vars, l.1 ∈ U)
    (hbool : ∀ v ∈ U, ∀ b : Bool, boolAxiom ℝ (v, b) ∈ F)
    (hFk : ∀ f ∈ F, f.totalDegree ≤ k)
    (hkd : k ≤ d) (hnd : ∀ d' < d, ¬ SosRefutableInDegree F d')
    (π : SosRefutation F) :
    Real.exp (((d : ℝ) - (k : ℝ)) ^ 2 / (1200 * (N : ℝ))) ≤ (π.size : ℝ) := by
  classical
  rcases U.eq_empty_or_nonempty with rfl | hUne
  · rcases eq_or_lt_of_le hkd with rfl | hklt
    · simp only [sub_self, zero_pow two_ne_zero, zero_div, Real.exp_zero]
      exact_mod_cast π.one_le_size
    · exfalso
      have hconst : ∀ f ∈ F, f = C (eval 0 f) := fun f hf ↦ by
        have htd : f.totalDegree = 0 := Nat.eq_zero_of_le_zero <| Finset.sup_le fun m hm ↦ by
          by_cases hm0 : m = 0
          · simp [hm0]
          · obtain ⟨l, hl⟩ := Finsupp.support_nonempty_iff.mpr hm0
            exact (Finset.notMem_empty l.1 (hvars f hf l (mem_vars_of_mem_support hm hl))).elim
        have hc := totalDegree_eq_zero_iff_eq_C.mp htd
        have h0 : eval 0 f = f.coeff 0 := by conv_lhs => rw [hc]; rw [eval_C]
        rwa [← h0] at hc
      by_cases hex : ∃ f ∈ F, eval 0 f ≠ 0
      · obtain ⟨f, hf, hne⟩ := hex
        let c : ℝ := eval 0 f
        refine hnd 0 (by omega) (SosRefutableInDegree.of_list [(C (-c⁻¹), f)] ?_ []
          (by simp) ?_)
        · intro p hp
          obtain rfl : p = (C (-c⁻¹), f) := by simpa using hp
          exact ⟨hf, by rw [hconst f hf, ← map_mul, totalDegree_C]⟩
        · simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, add_zero]
          rw [hconst f hf, ← map_mul, show -c⁻¹ * eval 0 f = -(c⁻¹ * c) from neg_mul _ _,
            inv_mul_cancel₀ hne, map_neg, map_one]
      · push Not at hex
        exact not_sosRefutation_of_eval_eq_zero 0 hex π
  · let σ := {v : V // v ∈ U} × Bool
    have : Nonempty σ := ⟨(⟨hUne.choose, hUne.choose_spec⟩, false)⟩
    let ρ : AtomSubst (Lit V) σ := fun l ↦
      if hl : l.1 ∈ U then .inr (⟨l.1, hl⟩, l.2) else .inl false
    let ι : σ → Lit V := fun s ↦ (s.1.1, s.2)
    have hround : ∀ f ∈ F, MvPolynomial.rename ι (ρ.evalHom f) = f := fun f hf ↦ by
      conv_rhs => rw [f.as_sum]
      conv_lhs => rw [f.as_sum, map_sum, map_sum]
      refine Finset.sum_congr rfl fun m hm ↦ ?_
      rw [ρ.evalHom_monomial_eq, map_mul, rename_C, Finsupp.prod, map_prod]
      have hfac : ∀ l ∈ m.support,
          MvPolynomial.rename ι (ρ.toPoly l ^ m l) = (X l : MvPolynomial (Lit V) ℝ) ^ m l :=
        fun l hl ↦ by
          have hlU : l.1 ∈ U := hvars f hf l (mem_vars_of_mem_support hm hl)
          simp [ρ, hlU, ι]
      rw [Finset.prod_congr rfl hfac, prod_X_pow_eq_monomial, C_mul_monomial, mul_one]
    let F' := ρ.restrictSystem F
    obtain ⟨π', _, hsz'⟩ := ρ.mapRefutation π
    have hbool' : ∀ s : σ, boolAxiom ℝ s ∈ F' := by
      rintro ⟨⟨v, hv⟩, b⟩
      have himg : ρ.evalHom (boolAxiom ℝ (v, b)) = boolAxiom ℝ (⟨v, hv⟩, b) := by
        simp [ρ, hv, boolAxiom_eq_sub]
      have hne : boolAxiom ℝ ((⟨v, hv⟩, b) : σ) ≠ 0 := fun h0 ↦ by
        have := congrArg (eval fun _ : σ ↦ (2 : ℝ)) h0; simp at this; norm_num at this
      exact (ρ.mem_restrictSystem_iff).mpr ⟨⟨_, hbool v hv b, himg⟩, hne⟩
    have hF'k : ∀ g ∈ F', g.totalDegree ≤ k := fun g hg ↦ by
      obtain ⟨⟨f, hf, rfl⟩, _⟩ := (ρ.mem_restrictSystem_iff).mp hg
      exact (ρ.totalDegree_evalHom_le f).trans (hFk f hf)
    have hnd' : ∀ d' < d, ¬ SosRefutableInDegree F' d' := by
      intro d' hd' ⟨πd, hπd⟩
      obtain ⟨hmul, hsq⟩ := SosProof.degree_le_iff.mp hπd
      have hmemF : ∀ g ∈ F', MvPolynomial.rename ι g ∈ F := fun g hg ↦ by
        obtain ⟨⟨f, hf, rfl⟩, _⟩ := (ρ.mem_restrictSystem_iff).mp hg
        rwa [hround f hf]
      refine hnd d' hd' (SosRefutableInDegree.of_list
        ((List.finRange F'.length).map fun i ↦
          (MvPolynomial.rename ι (πd.mult i), MvPolynomial.rename ι (F'.get i))) ?_
        (πd.squares.map (MvPolynomial.rename ι)) ?_ ?_)
      · intro p hp
        obtain ⟨i, _, rfl⟩ := List.mem_map.mp hp
        exact ⟨hmemF _ (List.get_mem F' i),
          by rw [← map_mul]; exact (totalDegree_rename_le ι _).trans (hmul i)⟩
      · intro s hs
        obtain ⟨s₀, hs₀, rfl⟩ := List.mem_map.mp hs
        exact (Nat.mul_le_mul_left 2 (totalDegree_rename_le ι s₀)).trans (hsq s₀ hs₀)
      · have heq := congrArg (MvPolynomial.rename ι) πd.eq
        simp only [map_add, map_sum, map_mul, map_list_sum, List.map_map, map_neg, map_one] at heq
        rw [← heq]; congr 1
        · rw [List.map_map, ← List.sum_ofFn]
          exact congrArg List.sum (List.ext_getElem (by simp) (by simp))
        · simp [List.map_map, Function.comp_def, map_pow]
    have hah := atserias_hakoniemi_size_degree hbool' hF'k hkd hnd' π'
    have hcard_σ : Fintype.card σ = 2 * U.card := by
      simp [σ, Fintype.card_prod, Fintype.card_coe, Nat.mul_comm]
    refine (Real.exp_le_exp.mpr ?_).trans (hah.trans (Nat.cast_le.mpr hsz'))
    rw [hcard_σ]
    have hpos1 : 0 < (600 : ℝ) * ((2 * U.card : ℕ) : ℝ) := by
      have := hUne.card_pos; positivity
    refine div_le_div_of_nonneg_left (sq_nonneg _) hpos1 ?_
    have : (U.card : ℝ) ≤ (N : ℝ) := Nat.cast_le.mpr hUN
    push_cast; linarith

end AtseriasHakoniemi

end CslibFrontier.ProofComplexity
