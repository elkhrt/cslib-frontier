/-!
# Semantic Sherali-Adams Proof System and Pseudo-Measure Duality

This module formalizes the semantic Sherali-Adams polynomial proof system over Boolean variables
and their twin (negation) variables, together with the linear-programming duality characterization
of minimum coefficient size in terms of pseudo-measures.

All results are proved under standard Lean axioms.

## Main definitions

- `CslibFrontier.Logics.Propositional.SheraliAdams.booleanIdeal`: the ideal generated by the
  Boolean and negation axioms `x_v (1 - x_v)`, `x̄_v (1 - x̄_v)`, and `1 - x̄_v - x_v`.
- `CslibFrontier.Logics.Propositional.SheraliAdams.SemanticSARefutation`: a semantic
  Sherali-Adams refutation of a finite polynomial system `P`, together with its `coeffSize`,
  `nonzeroMonomialCount`, and `IsBoundedCoeff` API.
- `CslibFrontier.Logics.Propositional.SheraliAdams.UnarySARefutation`: a unary Sherali-Adams
  refutation with integer monomial coefficients and negative integer right-hand side `-M`.
- `CslibFrontier.Logics.Propositional.SheraliAdams.IsPseudoMeasure`: a `δ`-pseudo-measure for
  a polynomial system `P` vanishing on the Boolean ideal.

## Main results

- `CslibFrontier.Logics.Propositional.SheraliAdams.mem_booleanIdeal_iff_evalBool_eq_zero`: a
  polynomial lies in the Boolean ideal if and only if it vanishes on all Boolean assignments.
- `CslibFrontier.Logics.Propositional.SheraliAdams.mem_booleanIdeal_iff_ttInner_self_eq_zero`
  and `CslibFrontier.Logics.Propositional.SheraliAdams.ttInner_literalMonomial`: truth-table
  inner-product verification criterion (`⟨π, π⟩ = 0`) and closed-form monomial inner product.
- `CslibFrontier.Logics.Propositional.SheraliAdams.exists_pseudoMeasure_iff_forall_coeffSize_ge`:
  a `δ`-pseudo-measure exists if and only if every semantic Sherali-Adams refutation has
  coefficient size at least `1 / δ`.
- `CslibFrontier.Logics.Propositional.SheraliAdams.boundedCoeff_size_lower_bound` and
  `CslibFrontier.Logics.Propositional.SheraliAdams.unary_size_lower_bound`: size lower bounds
  for bounded-coefficient and unary Sherali-Adams refutations from coefficient-size lower bounds.
-/

public section

namespace CslibFrontier.Logics.Propositional.SheraliAdams

open MvPolynomial Matrix

section BooleanRing

variable {V : Type*}

/-- Boolean evaluation of a variable or its twin negation variable under `ρ : V → Bool`. -/
def twinAssign (ρ : V → Bool) : V ⊕ V → ℝ
  | Sum.inl v => if ρ v then 1 else 0
  | Sum.inr v => if ρ v then 0 else 1

/-- Evaluation of a polynomial over Boolean variables and their twin variables at `ρ`. -/
noncomputable def evalBool (ρ : V → Bool) (p : MvPolynomial (V ⊕ V) ℝ) : ℝ :=
  MvPolynomial.eval (twinAssign ρ) p

@[simp]
theorem evalBool_X_inl (ρ : V → Bool) (v : V) :
    evalBool ρ (X (Sum.inl v)) = if ρ v then 1 else 0 := by
  simp [evalBool, twinAssign]

@[simp]
theorem evalBool_X_inr (ρ : V → Bool) (v : V) :
    evalBool ρ (X (Sum.inr v)) = if ρ v then 0 else 1 := by
  simp [evalBool, twinAssign]

@[simp]
theorem evalBool_one (ρ : V → Bool) : evalBool ρ (1 : MvPolynomial (V ⊕ V) ℝ) = 1 := by
  simp [evalBool]

@[simp]
theorem evalBool_zero (ρ : V → Bool) : evalBool ρ (0 : MvPolynomial (V ⊕ V) ℝ) = 0 := by
  simp [evalBool]

@[simp]
theorem evalBool_C (ρ : V → Bool) (c : ℝ) : evalBool ρ (C c) = c := by
  simp [evalBool]

@[simp]
theorem evalBool_add (ρ : V → Bool) (p q : MvPolynomial (V ⊕ V) ℝ) :
    evalBool ρ (p + q) = evalBool ρ p + evalBool ρ q := by
  simp [evalBool]

@[simp]
theorem evalBool_sub (ρ : V → Bool) (p q : MvPolynomial (V ⊕ V) ℝ) :
    evalBool ρ (p - q) = evalBool ρ p - evalBool ρ q := by
  simp [evalBool]

@[simp]
theorem evalBool_neg (ρ : V → Bool) (p : MvPolynomial (V ⊕ V) ℝ) :
    evalBool ρ (-p) = -evalBool ρ p := by
  simp [evalBool]

@[simp]
theorem evalBool_mul (ρ : V → Bool) (p q : MvPolynomial (V ⊕ V) ℝ) :
    evalBool ρ (p * q) = evalBool ρ p * evalBool ρ q := by
  simp [evalBool]

@[simp]
theorem evalBool_sum {α : Type*} (ρ : V → Bool) (s : Finset α)
    (f : α → MvPolynomial (V ⊕ V) ℝ) :
    evalBool ρ (∑ a ∈ s, f a) = ∑ a ∈ s, evalBool ρ (f a) := by
  simp [evalBool]

@[simp]
theorem evalBool_prod {α : Type*} (ρ : V → Bool) (s : Finset α)
    (f : α → MvPolynomial (V ⊕ V) ℝ) :
    evalBool ρ (∏ a ∈ s, f a) = ∏ a ∈ s, evalBool ρ (f a) := by
  simp [evalBool]

/-- The set of Boolean axioms `x_v(1 - x_v)`, `x̄_v(1 - x̄_v)`, and negation axioms
`1 - x̄_v - x_v` over variable set `V`. -/
noncomputable def booleanAxioms (V : Type*) : Set (MvPolynomial (V ⊕ V) ℝ) :=
  (Set.range fun v : V => X (Sum.inl v) * (1 - X (Sum.inl v))) ∪
  (Set.range fun v : V => X (Sum.inr v) * (1 - X (Sum.inr v))) ∪
  (Set.range fun v : V => (1 : MvPolynomial (V ⊕ V) ℝ) - X (Sum.inr v) - X (Sum.inl v))

/-- The ideal generated by the Boolean and negation axioms over `V`. -/
noncomputable def booleanIdeal (V : Type*) : Ideal (MvPolynomial (V ⊕ V) ℝ) :=
  Ideal.span (booleanAxioms V)

/-- The multilinear literal monomial `∏_{v ∈ A} x_v ∏_{v ∈ B} x̄_v`. -/
noncomputable def literalMonomial (A B : Finset V) : MvPolynomial (V ⊕ V) ℝ :=
  (∏ v ∈ A, X (Sum.inl v)) * (∏ v ∈ B, X (Sum.inr v))

/-- The positive-literal multilinear monomial `∏_{v ∈ S} x_v`. -/
noncomputable def posMonomial (S : Finset V) : MvPolynomial (V ⊕ V) ℝ :=
  ∏ v ∈ S, X (Sum.inl v)

/-- The indicator polynomial of a Boolean assignment `ρ` on a finite variable set `V`. -/
noncomputable def assignmentIndicator [Fintype V] (ρ : V → Bool) :
    MvPolynomial (V ⊕ V) ℝ :=
  ∏ v : V, if ρ v then X (Sum.inl v) else X (Sum.inr v)

private lemma literalMonomial_eq_monomial (A B : Finset V) :
    ∃ d : V ⊕ V →₀ ℕ, literalMonomial A B = MvPolynomial.monomial d (1 : ℝ) := by
  classical
  let dA : V ⊕ V →₀ ℕ := ∑ v ∈ A, Finsupp.single (Sum.inl v) 1
  let dB : V ⊕ V →₀ ℕ := ∑ v ∈ B, Finsupp.single (Sum.inr v) 1
  refine ⟨dA + dB, ?_⟩
  have hA : ∏ v ∈ A, (X (Sum.inl v) : MvPolynomial (V ⊕ V) ℝ) =
      MvPolynomial.monomial dA 1 := by
    change ∏ v ∈ A, (X (Sum.inl v) : MvPolynomial (V ⊕ V) ℝ) =
      MvPolynomial.monomial (∑ v ∈ A, Finsupp.single (Sum.inl v) 1) 1
    induction A using Finset.induction_on with
    | empty => simp
    | @insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.sum_insert ha, ih, MvPolynomial.X,
        MvPolynomial.monomial_mul_monomial, mul_one]
  have hB : ∏ v ∈ B, (X (Sum.inr v) : MvPolynomial (V ⊕ V) ℝ) =
      MvPolynomial.monomial dB 1 := by
    change ∏ v ∈ B, (X (Sum.inr v) : MvPolynomial (V ⊕ V) ℝ) =
      MvPolynomial.monomial (∑ v ∈ B, Finsupp.single (Sum.inr v) 1) 1
    induction B using Finset.induction_on with
    | empty => simp
    | @insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.sum_insert ha, ih, MvPolynomial.X,
        MvPolynomial.monomial_mul_monomial, mul_one]
  rw [literalMonomial, hA, hB, MvPolynomial.monomial_mul_monomial, mul_one]

theorem evalBool_literalMonomial (ρ : V → Bool) (A B : Finset V) :
    evalBool ρ (literalMonomial A B) =
      if (∀ v ∈ A, ρ v = true) ∧ (∀ v ∈ B, ρ v = false) then 1 else 0 := by
  classical
  have hA :
      evalBool ρ (∏ v ∈ A, X (Sum.inl v)) = if ∀ v ∈ A, ρ v = true then 1 else 0 := by
    induction A using Finset.induction_on with
    | empty => simp
    | @insert a s ha ih =>
      rw [Finset.prod_insert ha, evalBool_mul, ih, evalBool_X_inl]
      by_cases hρa : ρ a = true <;> simp [hρa]
  have hB :
      evalBool ρ (∏ v ∈ B, X (Sum.inr v)) = if ∀ v ∈ B, ρ v = false then 1 else 0 := by
    induction B using Finset.induction_on with
    | empty => simp
    | @insert b s hb ih =>
      rw [Finset.prod_insert hb, evalBool_mul, ih, evalBool_X_inr]
      by_cases hρb : ρ b = false <;> simp [hρb]
  rw [literalMonomial, evalBool_mul, hA, hB]
  split_ifs <;> simp_all

theorem evalBool_assignmentIndicator [Fintype V] (ρ τ : V → Bool) :
    evalBool ρ (assignmentIndicator τ) = if ρ = τ then 1 else 0 := by
  classical
  by_cases h : ρ = τ
  · subst h
    simp only [assignmentIndicator, evalBool_prod, ↓reduceIte]
    refine Finset.prod_eq_one fun v _ => ?_
    cases hρv : ρ v <;> simp [hρv]
  · simp only [assignmentIndicator, evalBool_prod, h, ↓reduceIte]
    have hex : ∃ v, ρ v ≠ τ v := by
      by_contra hall
      push Not at hall
      exact h (funext hall)
    rcases hex with ⟨v, hv⟩
    refine Finset.prod_eq_zero (Finset.mem_univ v) ?_
    cases hρv : ρ v <;> cases hτv : τ v <;> simp_all

private lemma evalBool_eq_zero_of_mem_booleanAxioms (ρ : V → Bool)
    {q : MvPolynomial (V ⊕ V) ℝ} (hq : q ∈ booleanAxioms V) : evalBool ρ q = 0 := by
  rcases hq with (⟨v, rfl⟩ | ⟨v, rfl⟩) | ⟨v, rfl⟩
  · cases hρ : ρ v <;> simp [hρ]
  · cases hρ : ρ v <;> simp [hρ]
  · cases hρ : ρ v <;> simp [hρ]

theorem evalBool_eq_zero_of_mem_booleanIdeal {p : MvPolynomial (V ⊕ V) ℝ}
    (hp : p ∈ booleanIdeal V) (ρ : V → Bool) : evalBool ρ p = 0 := by
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hp
  · intro q hq
    exact evalBool_eq_zero_of_mem_booleanAxioms ρ hq
  · exact evalBool_zero ρ
  · intro a b _ _ ha hb
    rw [evalBool_add, ha, hb, add_zero]
  · intro r a _ ha
    change evalBool ρ (r * a) = 0
    rw [evalBool_mul, ha, mul_zero]

private lemma X_inr_sub_mem_booleanIdeal (v : V) :
    X (Sum.inr v) - (1 - X (Sum.inl v)) ∈ booleanIdeal V := by
  have h : (1 : MvPolynomial (V ⊕ V) ℝ) - X (Sum.inr v) - X (Sum.inl v) ∈ booleanIdeal V :=
    Ideal.subset_span (Or.inr ⟨v, rfl⟩)
  have heq :
      X (Sum.inr v) - (1 - X (Sum.inl v)) =
        -((1 : MvPolynomial (V ⊕ V) ℝ) - X (Sum.inr v) - X (Sum.inl v)) := by
    ring
  rw [heq]
  exact (booleanIdeal V).neg_mem h

private lemma X_inl_sq_sub_mem_booleanIdeal (v : V) :
    (X (Sum.inl v) : MvPolynomial (V ⊕ V) ℝ) * X (Sum.inl v) - X (Sum.inl v) ∈
      booleanIdeal V := by
  have h : (X (Sum.inl v) : MvPolynomial (V ⊕ V) ℝ) * (1 - X (Sum.inl v)) ∈ booleanIdeal V :=
    Ideal.subset_span (Or.inl (Or.inl ⟨v, rfl⟩))
  have heq :
      (X (Sum.inl v) : MvPolynomial (V ⊕ V) ℝ) * X (Sum.inl v) - X (Sum.inl v) =
        -(X (Sum.inl v) * (1 - X (Sum.inl v))) := by
    ring
  rw [heq]
  exact (booleanIdeal V).neg_mem h

private lemma exists_multilinear_rep (p : MvPolynomial (V ⊕ V) ℝ) :
    ∃ (T : Finset (Finset V)) (c : Finset V → ℝ),
      p - ∑ S ∈ T, C (c S) * posMonomial S ∈ booleanIdeal V := by
  classical
  let Rep (q : MvPolynomial (V ⊕ V) ℝ) : Prop :=
    ∃ (T : Finset (Finset V)) (c : Finset V → ℝ),
      q - ∑ S ∈ T, C (c S) * posMonomial S ∈ booleanIdeal V
  have hrep_pos : ∀ (v : V) (S : Finset V), Rep (X (Sum.inl v) * posMonomial S) := by
    intro v S
    by_cases hv : v ∈ S
    · refine ⟨{S}, fun _ => 1, ?_⟩
      simp only [Finset.sum_singleton, map_one, one_mul]
      have hprod : posMonomial S = X (Sum.inl v) * posMonomial (S.erase v) := by
        rw [posMonomial, posMonomial, ← Finset.mul_prod_erase S (fun u => X (Sum.inl u)) hv]
      have heq :
          X (Sum.inl v) * posMonomial S - posMonomial S =
            (X (Sum.inl v) * X (Sum.inl v) - X (Sum.inl v)) * posMonomial (S.erase v) := by
        conv_lhs => rw [hprod]
        ring
      rw [heq]
      exact (booleanIdeal V).mul_mem_right _ (X_inl_sq_sub_mem_booleanIdeal v)
    · refine ⟨{insert v S}, fun _ => 1, ?_⟩
      simp only [Finset.sum_singleton, map_one, one_mul]
      have hprod : posMonomial (insert v S) = X (Sum.inl v) * posMonomial S := by
        rw [posMonomial, posMonomial, Finset.prod_insert hv]
      rw [hprod, sub_self]
      exact (booleanIdeal V).zero_mem
  have hrep_add : ∀ {p q}, Rep p → Rep q → Rep (p + q) := by
    rintro p q ⟨T1, c1, h1⟩ ⟨T2, c2, h2⟩
    refine ⟨T1 ∪ T2, fun S => (if S ∈ T1 then c1 S else 0) + (if S ∈ T2 then c2 S else 0), ?_⟩
    have hsum1 : ∑ S ∈ T1 ∪ T2, C (if S ∈ T1 then c1 S else 0) * posMonomial S =
        ∑ S ∈ T1, C (c1 S) * posMonomial S := by
      rw [← Finset.sum_subset Finset.subset_union_left]
      · refine Finset.sum_congr rfl fun S hS => by simp [hS]
      · intro S _ hS
        simp [hS]
    have hsum2 : ∑ S ∈ T1 ∪ T2, C (if S ∈ T2 then c2 S else 0) * posMonomial S =
        ∑ S ∈ T2, C (c2 S) * posMonomial S := by
      rw [← Finset.sum_subset Finset.subset_union_right]
      · refine Finset.sum_congr rfl fun S hS => by simp [hS]
      · intro S _ hS
        simp [hS]
    have hcomb :
        (p + q) - ∑ S ∈ T1 ∪ T2,
            C ((if S ∈ T1 then c1 S else 0) + (if S ∈ T2 then c2 S else 0)) * posMonomial S =
          (p - ∑ S ∈ T1, C (c1 S) * posMonomial S) +
          (q - ∑ S ∈ T2, C (c2 S) * posMonomial S) := by
      simp only [map_add, add_mul, Finset.sum_add_distrib, hsum1, hsum2]
      ring
    rw [hcomb]
    exact (booleanIdeal V).add_mem h1 h2
  have hrep_C_mul : ∀ (a : ℝ) {q}, Rep q → Rep (C a * q) := by
    rintro a q ⟨T, c, hq⟩
    refine ⟨T, fun S => a * c S, ?_⟩
    have heq :
        C a * q - ∑ S ∈ T, C (a * c S) * posMonomial S =
          C a * (q - ∑ S ∈ T, C (c S) * posMonomial S) := by
      rw [mul_sub, Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun S _ => by rw [map_mul, mul_assoc]
    rw [heq]
    exact (booleanIdeal V).mul_mem_left _ hq
  have hrep_sub : ∀ {p q}, Rep p → Rep q → Rep (p - q) := by
    intro p q hp hq
    rw [sub_eq_add_neg]
    have hneg : Rep (-q) := by
      have : -q = C (-1 : ℝ) * q := by simp
      rw [this]
      exact hrep_C_mul (-1) hq
    exact hrep_add hp hneg
  have hrep_mul_inl : ∀ (v : V) {q}, Rep q → Rep (X (Sum.inl v) * q) := by
    rintro v q ⟨T, c, hq⟩
    have hterm : Rep (∑ S ∈ T, C (c S) * (X (Sum.inl v) * posMonomial S)) := by
      clear hq
      induction T using Finset.induction_on with
      | empty =>
        refine ⟨∅, fun _ => 0, ?_⟩
        simp [(booleanIdeal V).zero_mem]
      | @insert a s ha ih =>
        rw [Finset.sum_insert ha]
        exact hrep_add (hrep_C_mul (c a) (hrep_pos v a)) ih
    rcases hterm with ⟨T', c', h'⟩
    refine ⟨T', c', ?_⟩
    have hsum_eq :
        X (Sum.inl v) * ∑ S ∈ T, C (c S) * posMonomial S =
          ∑ S ∈ T, C (c S) * (X (Sum.inl v) * posMonomial S) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun S _ => by ring
    have heq :
        X (Sum.inl v) * q - ∑ S ∈ T', C (c' S) * posMonomial S =
          X (Sum.inl v) * (q - ∑ S ∈ T, C (c S) * posMonomial S) +
          ((∑ S ∈ T, C (c S) * (X (Sum.inl v) * posMonomial S)) -
            ∑ S ∈ T', C (c' S) * posMonomial S) := by
      rw [mul_sub, hsum_eq]
      ring
    rw [heq]
    exact (booleanIdeal V).add_mem ((booleanIdeal V).mul_mem_left _ hq) h'
  change Rep p
  induction p using MvPolynomial.induction_on with
  | C a =>
    refine ⟨{∅}, fun _ => a, ?_⟩
    simp [posMonomial, (booleanIdeal V).zero_mem]
  | add p q hp hq => exact hrep_add hp hq
  | mul_X p x hp =>
    rw [mul_comm]
    cases x with
    | inl v => exact hrep_mul_inl v hp
    | inr v =>
      have hsub : Rep ((1 - X (Sum.inl v)) * p) := by
        rw [sub_mul, one_mul]
        exact hrep_sub hp (hrep_mul_inl v hp)
      rcases hsub with ⟨T, c, hT⟩
      refine ⟨T, c, ?_⟩
      have heq :
          X (Sum.inr v) * p - ∑ S ∈ T, C (c S) * posMonomial S =
            (X (Sum.inr v) - (1 - X (Sum.inl v))) * p +
            ((1 - X (Sum.inl v)) * p - ∑ S ∈ T, C (c S) * posMonomial S) := by
        ring
      rw [heq]
      exact (booleanIdeal V).add_mem
        ((booleanIdeal V).mul_mem_right _ (X_inr_sub_mem_booleanIdeal v)) hT

/-- A polynomial over Boolean and twin variables lies in the Boolean ideal if and only if
it evaluates to `0` on every Boolean assignment `ρ : V → Bool`. -/
theorem mem_booleanIdeal_iff_evalBool_eq_zero (p : MvPolynomial (V ⊕ V) ℝ) :
    p ∈ booleanIdeal V ↔ ∀ ρ : V → Bool, evalBool ρ p = 0 := by
  classical
  constructor
  · exact evalBool_eq_zero_of_mem_booleanIdeal
  · intro heval
    obtain ⟨T, c, hrep⟩ := exists_multilinear_rep p
    have hsum_zero : ∀ ρ : V → Bool,
        ∑ S ∈ T, c S * (if ∀ v ∈ S, ρ v = true then 1 else 0) = 0 := by
      intro ρ
      have h0 := evalBool_eq_zero_of_mem_booleanIdeal hrep ρ
      rw [evalBool_sub, heval ρ, zero_sub, neg_eq_zero, evalBool_sum] at h0
      have hterm : ∀ S ∈ T,
          evalBool ρ (C (c S) * posMonomial S) =
            c S * (if ∀ v ∈ S, ρ v = true then 1 else 0) := by
        intro S _
        rw [evalBool_mul, evalBool_C]
        congr 1
        have := evalBool_literalMonomial ρ S ∅
        simpa [literalMonomial, posMonomial] using this
      rwa [Finset.sum_congr rfl hterm] at h0
    have hc_zero : ∀ n : ℕ, ∀ S ∈ T, S.card = n → c S = 0 := by
      intro n
      induction n using Nat.strong_induction_on with
      | ind n ih =>
        intro S hST hcard
        let ρ : V → Bool := fun v => decide (v ∈ S)
        have hρ := hsum_zero ρ
        have hsplit :
            ∑ U ∈ T, c U * (if ∀ v ∈ U, ρ v = true then 1 else 0) = c S := by
          rw [← Finset.add_sum_erase _ _ hST]
          have hS : c S * (if ∀ v ∈ S, ρ v = true then 1 else 0) = c S := by
            simp [ρ]
          rw [hS]
          have hrest :
              ∑ U ∈ T.erase S, c U * (if ∀ v ∈ U, ρ v = true then 1 else 0) = 0 := by
            refine Finset.sum_eq_zero fun U hU => ?_
            have hUmem : U ∈ T := Finset.mem_of_mem_erase hU
            have hUne : U ≠ S := Finset.ne_of_mem_erase hU
            by_cases hsub : ∀ v ∈ U, ρ v = true
            · have hUsub : U ⊆ S := fun v hv => of_decide_eq_true (hsub v hv)
              have hlt : U.card < n := by
                rw [← hcard]
                exact Finset.card_lt_card (Finset.ssubset_iff_subset_ne.mpr ⟨hUsub, hUne⟩)
              rw [ih U.card hlt U hUmem rfl, zero_mul]
            · simp [hsub]
          rw [hrest, add_zero]
        linarith
    have hsum_eq : ∑ S ∈ T, C (c S) * posMonomial S = 0 := by
      refine Finset.sum_eq_zero fun S hS => ?_
      rw [hc_zero S.card S hS rfl, map_zero, zero_mul]
    rw [hsum_eq, sub_zero] at hrep
    exact hrep

/-- Any monomial `monomial d 1` is congruent modulo `booleanIdeal V` to the multilinear
literal monomial on the supports of `d ∘ Sum.inl` and `d ∘ Sum.inr`. -/
theorem monomial_sub_literalMonomial_mem_booleanIdeal [Fintype V] (d : V ⊕ V →₀ ℕ) :
    MvPolynomial.monomial d (1 : ℝ) -
      literalMonomial
        (Finset.univ.filter fun v => d (Sum.inl v) ≠ 0)
        (Finset.univ.filter fun v => d (Sum.inr v) ≠ 0) ∈ booleanIdeal V := by
  classical
  rw [mem_booleanIdeal_iff_evalBool_eq_zero]
  intro ρ
  rw [evalBool_sub, evalBool_literalMonomial, evalBool, MvPolynomial.eval_monomial, one_mul]
  rw [Finsupp.prod]
  have hprod :
      ∏ x ∈ d.support, twinAssign ρ x ^ d x =
        if (∀ v, d (Sum.inl v) ≠ 0 → ρ v = true) ∧
           (∀ v, d (Sum.inr v) ≠ 0 → ρ v = false) then 1 else 0 := by
    by_cases h :
        (∀ v, d (Sum.inl v) ≠ 0 → ρ v = true) ∧
        (∀ v, d (Sum.inr v) ≠ 0 → ρ v = false)
    · rw [ite_eq_left h]
      refine Finset.prod_eq_one fun x hx => ?_
      have hne : d x ≠ 0 := Finsupp.mem_support_iff.mp hx
      cases x with
      | inl v => simp [twinAssign, h.1 v hne]
      | inr v => simp [twinAssign, h.2 v hne]
    · rw [ite_eq_right h]
      have hex : ∃ x ∈ d.support, twinAssign ρ x = 0 := by
        by_contra hall
        push Not at hall
        apply h
        constructor
        · intro v hv
          have hmem : Sum.inl v ∈ d.support := Finsupp.mem_support_iff.mpr hv
          have hnz := hall (Sum.inl v) hmem
          cases hρv : ρ v
          · simp [twinAssign, hρv] at hnz
          · rfl
        · intro v hv
          have hmem : Sum.inr v ∈ d.support := Finsupp.mem_support_iff.mpr hv
          have hnz := hall (Sum.inr v) hmem
          cases hρv : ρ v
          · rfl
          · simp [twinAssign, hρv] at hnz
      rcases hex with ⟨x, hx, hx0⟩
      refine Finset.prod_eq_zero hx ?_
      rw [hx0, zero_pow (Finsupp.mem_support_iff.mp hx)]
  rw [hprod]
  simp

/-- Every polynomial is congruent modulo `booleanIdeal V` to its Boolean truth-table expansion
in the assignment indicators. -/
theorem sub_sum_evalBool_indicator_mem_booleanIdeal [Fintype V] [DecidableEq V]
    (p : MvPolynomial (V ⊕ V) ℝ) :
    p - ∑ ρ : V → Bool, C (evalBool ρ p) * assignmentIndicator ρ ∈ booleanIdeal V := by
  rw [mem_booleanIdeal_iff_evalBool_eq_zero]
  intro τ
  rw [evalBool_sub, evalBool_sum]
  have hsum :
      ∑ ρ : V → Bool, evalBool τ (C (evalBool ρ p) * assignmentIndicator ρ) = evalBool τ p := by
    have : ∀ ρ : V → Bool,
        evalBool τ (C (evalBool ρ p) * assignmentIndicator ρ) =
          if τ = ρ then evalBool ρ p else 0 := by
      intro ρ
      rw [evalBool_mul, evalBool_C, evalBool_assignmentIndicator]
      split_ifs <;> ring
    simp [this]
  rw [hsum, sub_self]

/-- Truth-table inner product on Boolean assignments. -/
def ttInner [Fintype V] [DecidableEq V] (u w : (V → Bool) → ℝ) : ℝ :=
  ∑ ρ : V → Bool, u ρ * w ρ

theorem ttInner_self_nonneg [Fintype V] [DecidableEq V] (u : (V → Bool) → ℝ) :
    0 ≤ ttInner u u :=
  Finset.sum_nonneg fun ρ _ => mul_self_nonneg (u ρ)

/-- Truth-table inner product verification criterion: a polynomial lies in the Boolean ideal if
and only if the self inner product of its truth table is zero. -/
theorem mem_booleanIdeal_iff_ttInner_self_eq_zero [Fintype V] [DecidableEq V]
    (p : MvPolynomial (V ⊕ V) ℝ) :
    p ∈ booleanIdeal V ↔ ttInner (fun ρ => evalBool ρ p) (fun ρ => evalBool ρ p) = 0 := by
  rw [mem_booleanIdeal_iff_evalBool_eq_zero, ttInner]
  constructor
  · intro h
    refine Finset.sum_eq_zero fun ρ _ => ?_
    rw [h ρ, mul_zero]
  · intro h ρ
    have h0 := (Finset.sum_eq_zero_iff_of_nonneg fun τ _ => mul_self_nonneg (evalBool τ p)).mp
      h ρ (Finset.mem_univ ρ)
    exact mul_self_eq_zero.mp h0

/-- Closed-form truth-table inner product of two literal monomials: `0` if any variable appears
positively in one and negatively in the other, and `2 ^ (|V| - |A ∪ A' ∪ B ∪ B'|)` otherwise. -/
theorem ttInner_literalMonomial [Fintype V] [DecidableEq V] (A B A' B' : Finset V) :
    ttInner (fun ρ => evalBool ρ (literalMonomial A B))
      (fun ρ => evalBool ρ (literalMonomial A' B')) =
      if Disjoint (A ∪ A') (B ∪ B') then
        (2 : ℝ) ^ (Fintype.card V - (A ∪ A' ∪ (B ∪ B')).card)
      else 0 := by
  classical
  have hterm : ∀ ρ : V → Bool,
      evalBool ρ (literalMonomial A B) * evalBool ρ (literalMonomial A' B') =
        if (∀ v ∈ A ∪ A', ρ v = true) ∧ (∀ v ∈ B ∪ B', ρ v = false) then 1 else 0 := by
    intro ρ
    rw [evalBool_literalMonomial, evalBool_literalMonomial]
    by_cases h1 : (∀ v ∈ A, ρ v = true) ∧ (∀ v ∈ B, ρ v = false)
    · by_cases h2 : (∀ v ∈ A', ρ v = true) ∧ (∀ v ∈ B', ρ v = false)
      · have h12 : (∀ v ∈ A ∪ A', ρ v = true) ∧ (∀ v ∈ B ∪ B', ρ v = false) :=
          ⟨fun v hv => (Finset.mem_union.mp hv).elim (h1.1 v) (h2.1 v),
           fun v hv => (Finset.mem_union.mp hv).elim (h1.2 v) (h2.2 v)⟩
        rw [ite_eq_left h1, ite_eq_left h2, ite_eq_left h12, mul_one]
      · have hnot : ¬ ((∀ v ∈ A ∪ A', ρ v = true) ∧ (∀ v ∈ B ∪ B', ρ v = false)) := fun h =>
          h2 ⟨fun v hv => h.1 v (Finset.mem_union_right _ hv),
              fun v hv => h.2 v (Finset.mem_union_right _ hv)⟩
        rw [ite_eq_left h1, ite_eq_right h2, ite_eq_right hnot, mul_zero]
    · have hnot : ¬ ((∀ v ∈ A ∪ A', ρ v = true) ∧ (∀ v ∈ B ∪ B', ρ v = false)) := fun h =>
        h1 ⟨fun v hv => h.1 v (Finset.mem_union_left _ hv),
            fun v hv => h.2 v (Finset.mem_union_left _ hv)⟩
      rw [ite_eq_right h1, ite_eq_right hnot, zero_mul]
  simp_rw [ttInner, hterm]
  split_ifs with hdisj
  · let P := A ∪ A'
    let Q := B ∪ B'
    have hcard_sum :
        (∑ ρ : V → Bool, if (∀ v ∈ P, ρ v = true) ∧ (∀ v ∈ Q, ρ v = false) then (1 : ℝ) else 0) =
          ((Finset.univ.filter fun ρ : V → Bool =>
            (∀ v ∈ P, ρ v = true) ∧ (∀ v ∈ Q, ρ v = false)).card : ℝ) := by
      simp [Finset.sum_boole]
    rw [hcard_sum]
    let R : Finset V := Finset.univ \ (P ∪ Q)
    have hRcard : R.card = Fintype.card V - (P ∪ Q).card := by
      rw [Finset.card_sdiff, Finset.inter_univ, Finset.card_univ]
    have hbij :
        (Finset.univ.filter fun ρ : V → Bool =>
          (∀ v ∈ P, ρ v = true) ∧ (∀ v ∈ Q, ρ v = false)).card =
          Fintype.card (R → Bool) := by
      rw [← Fintype.card_coe]
      refine Fintype.card_congr ?_
      exact
        { toFun := fun ρ (v : R) => ρ.1 v.1
          invFun := fun f =>
            ⟨fun v =>
              if hv : v ∈ P then true
              else if hv' : v ∈ Q then false
              else f ⟨v, Finset.mem_sdiff.mpr
                ⟨Finset.mem_univ v, fun hmem => by
                  rcases Finset.mem_union.mp hmem with hP | hQ
                  · exact hv hP
                  · exact hv' hQ⟩⟩,
              Finset.mem_filter.mpr ⟨Finset.mem_univ _,
                ⟨fun v hv => by simp [hv],
                 fun v hv => by
                  have hvP : v ∉ P := Finset.disjoint_right.mp hdisj hv
                  simp [hvP, hv]⟩⟩⟩
          left_inv := fun ⟨ρ, hρ⟩ => by
            ext v
            have hρ' := (Finset.mem_filter.mp hρ).2
            by_cases hvP : v ∈ P
            · simp [hvP, hρ'.1 v hvP]
            · by_cases hvQ : v ∈ Q
              · simp [hvP, hvQ, hρ'.2 v hvQ]
              · simp [hvP, hvQ]
          right_inv := fun f => by
            ext ⟨v, hv⟩
            have hnot : v ∉ P ∪ Q := (Finset.mem_sdiff.mp hv).2
            have hvP : v ∉ P := fun h => hnot (Finset.mem_union_left _ h)
            have hvQ : v ∉ Q := fun h => hnot (Finset.mem_union_right _ h)
            simp [hvP, hvQ] }
    rw [hbij, Fintype.card_fun, Fintype.card_bool, Fintype.card_coe, hRcard]
    norm_cast
  · refine Finset.sum_eq_zero fun ρ _ => ?_
    have hnot : ¬ ((∀ v ∈ A ∪ A', ρ v = true) ∧ (∀ v ∈ B ∪ B', ρ v = false)) := by
      intro h
      rw [Finset.not_disjoint_iff] at hdisj
      rcases hdisj with ⟨v, hvP, hvQ⟩
      have h1 := h.1 v hvP
      have h2 := h.2 v hvQ
      simp [h1] at h2
    simp only [hnot, ↓reduceIte]

end BooleanRing

section SheraliAdams

variable {V ι : Type*}

/-- A semantic Sherali-Adams refutation of a finite polynomial system `P : ι → R[V ⊕ V]`:
polynomial multipliers `g j` and nonnegative multilinear coefficients `alpha` such that
`∑ j, g j * P j + f_0 ≡ -1 (mod I_B)`. -/
@[ext]
structure SemanticSARefutation [Fintype V] [Fintype ι]
    (P : ι → MvPolynomial (V ⊕ V) ℝ) where
  /-- Polynomial multipliers for the axioms in `P`. -/
  g : ι → MvPolynomial (V ⊕ V) ℝ
  /-- Nonnegative coefficients of the multilinear positive sum `f_0`. -/
  alpha : Finset V × Finset V → ℝ
  /-- Nonnegativity of the coefficients of `f_0`. -/
  alpha_nonneg : ∀ ab, 0 ≤ alpha ab
  /-- Refutation congruence `∑ j, g j * P j + f_0 ≡ -1 (mod booleanIdeal V)`. -/
  is_refutation :
    (∑ j : ι, g j * P j) +
      (∑ ab : Finset V × Finset V, C (alpha ab) * literalMonomial ab.1 ab.2) + 1 ∈
      booleanIdeal V

/-- The nonnegative polynomial `f_0` of a semantic Sherali-Adams refutation. -/
noncomputable def SemanticSARefutation.f0 [Fintype V] [Fintype ι]
    {P : ι → MvPolynomial (V ⊕ V) ℝ} (π : SemanticSARefutation P) :
    MvPolynomial (V ⊕ V) ℝ :=
  ∑ ab : Finset V × Finset V, C (π.alpha ab) * literalMonomial ab.1 ab.2

/-- The coefficient size of a semantic Sherali-Adams refutation: the sum of the magnitudes of
all monomial coefficients in `g_1, …, g_m` and `f_0`. -/
@[expose]
noncomputable def SemanticSARefutation.coeffSize [Fintype V] [Fintype ι]
    {P : ι → MvPolynomial (V ⊕ V) ℝ} (π : SemanticSARefutation P) : ℝ :=
  (∑ ab : Finset V × Finset V, π.alpha ab) +
    ∑ j : ι, ∑ d ∈ (π.g j).support, |(π.g j).coeff d|

theorem SemanticSARefutation.coeffSize_nonneg [Fintype V] [Fintype ι]
    {P : ι → MvPolynomial (V ⊕ V) ℝ} (π : SemanticSARefutation P) :
    0 ≤ π.coeffSize := by
  refine add_nonneg (Finset.sum_nonneg fun ab _ => π.alpha_nonneg ab) ?_
  exact Finset.sum_nonneg fun j _ => Finset.sum_nonneg fun d _ => abs_nonneg _

/-- Number of nonzero monomial terms in `f_0` and `g_1, …, g_m`. -/
noncomputable def SemanticSARefutation.nonzeroMonomialCount [Fintype V] [Fintype ι]
    {P : ι → MvPolynomial (V ⊕ V) ℝ} (π : SemanticSARefutation P) : ℕ :=
  (Finset.univ.filter fun ab => π.alpha ab ≠ 0).card +
    ∑ j : ι, (π.g j).support.card

/-- A refutation has `B`-bounded coefficients if every coefficient of `f_0` and every `g j`
has magnitude at most `B`. -/
def SemanticSARefutation.IsBoundedCoeff [Fintype V] [Fintype ι]
    {P : ι → MvPolynomial (V ⊕ V) ℝ} (π : SemanticSARefutation P) (B : ℝ) : Prop :=
  (∀ ab, π.alpha ab ≤ B) ∧ (∀ j d, |(π.g j).coeff d| ≤ B)

/-- Bounded-coefficient size lower bound: if every semantic Sherali-Adams refutation of `P` has
coefficient size at least `s`, then any `B`-bounded-coefficient refutation contains at least
`s / B` nonzero monomial terms. -/
theorem boundedCoeff_size_lower_bound [Fintype V] [Fintype ι]
    {P : ι → MvPolynomial (V ⊕ V) ℝ} {s B : ℝ} (hB : 0 < B)
    (hmin : ∀ π : SemanticSARefutation P, s ≤ π.coeffSize)
    (π : SemanticSARefutation P) (hbdd : π.IsBoundedCoeff B) :
    s / B ≤ (π.nonzeroMonomialCount : ℝ) := by
  have h1 : ∑ ab : Finset V × Finset V, π.alpha ab ≤
      B * ((Finset.univ.filter fun ab => π.alpha ab ≠ 0).card : ℝ) := by
    calc
      ∑ ab : Finset V × Finset V, π.alpha ab
          = ∑ ab ∈ Finset.univ.filter (fun ab => π.alpha ab ≠ 0), π.alpha ab := by
        symm
        refine Finset.sum_subset (Finset.filter_subset _ _) ?_
        intro ab _ hab
        simp only [Finset.mem_filter, Finset.mem_univ, true_and, not_not] at hab
        exact hab
      _ ≤ ∑ _ab ∈ Finset.univ.filter (fun ab => π.alpha ab ≠ 0), B :=
        Finset.sum_le_sum fun ab _ => hbdd.1 ab
      _ = B * ((Finset.univ.filter fun ab => π.alpha ab ≠ 0).card : ℝ) := by
        rw [Finset.sum_const, nsmul_eq_mul, mul_comm]
  have h2 : ∑ j : ι, ∑ d ∈ (π.g j).support, |(π.g j).coeff d| ≤
      B * (∑ j : ι, ((π.g j).support.card : ℝ)) := by
    rw [Finset.mul_sum]
    refine Finset.sum_le_sum fun j _ => ?_
    calc
      ∑ d ∈ (π.g j).support, |(π.g j).coeff d|
          ≤ ∑ _d ∈ (π.g j).support, B := Finset.sum_le_sum fun d _ => hbdd.2 j d
      _ = B * ((π.g j).support.card : ℝ) := by
        rw [Finset.sum_const, nsmul_eq_mul, mul_comm]
  have hle : π.coeffSize ≤ B * (π.nonzeroMonomialCount : ℝ) := by
    rw [SemanticSARefutation.coeffSize, SemanticSARefutation.nonzeroMonomialCount]
    push_cast
    linarith
  rw [div_le_iff₀ hB]
  linarith [hmin π]

/-- A unary Sherali-Adams refutation of `P`: integer multipliers `g j` and natural-number
coefficients `alpha` summing to `-M` (`M ≥ 1`) modulo the Boolean ideal. -/
@[ext]
structure UnarySARefutation [Fintype V] [Fintype ι]
    (P : ι → MvPolynomial (V ⊕ V) ℝ) where
  /-- Integer-coefficient multipliers for the axioms in `P`. -/
  g : ι → MvPolynomial (V ⊕ V) ℤ
  /-- Nonnegative integer coefficients for the multilinear sum `f_0`. -/
  alpha : Finset V × Finset V → ℕ
  /-- Positive integer right-hand side magnitude `M ≥ 1`. -/
  M : ℕ
  /-- Positivity of `M`. -/
  M_pos : 1 ≤ M
  /-- Refutation congruence `∑ j, g j * P j + f_0 ≡ -M (mod booleanIdeal V)`. -/
  is_refutation :
    (∑ j : ι, MvPolynomial.map (Int.castRingHom ℝ) (g j) * P j) +
      (∑ ab : Finset V × Finset V, C (alpha ab : ℝ) * literalMonomial ab.1 ab.2) +
      C (M : ℝ) ∈ booleanIdeal V

/-- The unary size of a unary Sherali-Adams refutation: sum of magnitudes of all unit
monomials in `f_0` and `g_1, …, g_m`. -/
noncomputable def UnarySARefutation.unarySize [Fintype V] [Fintype ι]
    {P : ι → MvPolynomial (V ⊕ V) ℝ} (π : UnarySARefutation P) : ℕ :=
  (∑ ab : Finset V × Finset V, π.alpha ab) +
    ∑ j : ι, ∑ d ∈ (π.g j).support, ((π.g j).coeff d).natAbs

/-- Rescaling a unary Sherali-Adams refutation by `1 / M` yields a semantic Sherali-Adams
refutation of coefficient size at most its unary size. -/
noncomputable def UnarySARefutation.toSemantic [Fintype V] [Fintype ι]
    {P : ι → MvPolynomial (V ⊕ V) ℝ} (π : UnarySARefutation P) :
    SemanticSARefutation P where
  g j := C (1 / (π.M : ℝ)) * MvPolynomial.map (Int.castRingHom ℝ) (π.g j)
  alpha ab := (π.alpha ab : ℝ) / (π.M : ℝ)
  alpha_nonneg ab := by positivity
  is_refutation := by
    have hMpos : (0 : ℝ) < (π.M : ℝ) := by
      exact_mod_cast (Nat.succ_le_iff.mp π.M_pos)
    have hMne : (π.M : ℝ) ≠ 0 := ne_of_gt hMpos
    have hscale :
        (∑ j : ι, C (1 / (π.M : ℝ)) * MvPolynomial.map (Int.castRingHom ℝ) (π.g j) * P j) +
          (∑ ab : Finset V × Finset V,
            C ((π.alpha ab : ℝ) / (π.M : ℝ)) * literalMonomial ab.1 ab.2) + 1 =
          C (1 / (π.M : ℝ)) *
            ((∑ j : ι, MvPolynomial.map (Int.castRingHom ℝ) (π.g j) * P j) +
              (∑ ab : Finset V × Finset V,
                C (π.alpha ab : ℝ) * literalMonomial ab.1 ab.2) +
              C (π.M : ℝ)) := by
      simp only [mul_add, Finset.mul_sum]
      congr 1
      · congr 1
        · refine Finset.sum_congr rfl fun j _ => by ring
        · refine Finset.sum_congr rfl fun ab _ => ?_
          rw [← mul_assoc, ← map_mul]
          congr 2
          field_simp [hMne]
      · rw [← map_mul]
        have h1 : (1 / (π.M : ℝ)) * (π.M : ℝ) = 1 := one_div_mul_cancel hMne
        rw [h1, map_one]
    rw [hscale]
    exact (booleanIdeal V).mul_mem_left _ π.is_refutation

/-- Unary Sherali-Adams size lower bound: if every semantic Sherali-Adams refutation of `P`
requires coefficient size at least `s`, then any unary Sherali-Adams refutation of `P` has size
at least `s`. -/
theorem unary_size_lower_bound [Fintype V] [Fintype ι]
    {P : ι → MvPolynomial (V ⊕ V) ℝ} {s : ℝ}
    (hmin : ∀ π : SemanticSARefutation P, s ≤ π.coeffSize)
    (π : UnarySARefutation P) :
    s ≤ (π.unarySize : ℝ) := by
  have hMpos : (0 : ℝ) < (π.M : ℝ) := by
    exact_mod_cast (Nat.succ_le_iff.mp π.M_pos)
  have hMge1 : (1 : ℝ) ≤ (π.M : ℝ) := by exact_mod_cast π.M_pos
  have hto : π.toSemantic.coeffSize ≤ (π.unarySize : ℝ) := by
    rw [SemanticSARefutation.coeffSize, UnarySARefutation.unarySize]
    simp only [UnarySARefutation.toSemantic, Nat.cast_add, Nat.cast_sum]
    have h1 : ∑ ab : Finset V × Finset V, (π.alpha ab : ℝ) / (π.M : ℝ) ≤
        ∑ ab : Finset V × Finset V, (π.alpha ab : ℝ) := by
      refine Finset.sum_le_sum fun ab _ => div_le_self (Nat.cast_nonneg _) hMge1
    have h2 :
        ∑ j : ι,
          ∑ d ∈ (C (1 / (π.M : ℝ)) * MvPolynomial.map (Int.castRingHom ℝ) (π.g j)).support,
            |(C (1 / (π.M : ℝ)) * MvPolynomial.map (Int.castRingHom ℝ) (π.g j)).coeff d| ≤
        ∑ j : ι, ∑ d ∈ (π.g j).support, (((π.g j).coeff d).natAbs : ℝ) := by
      refine Finset.sum_le_sum fun j _ => ?_
      have hsub :
          (C (1 / (π.M : ℝ)) * MvPolynomial.map (Int.castRingHom ℝ) (π.g j)).support ⊆
            (π.g j).support := by
        intro d hd
        rw [MvPolynomial.mem_support_iff] at hd ⊢
        rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_map] at hd
        intro h0
        apply hd
        simp [h0]
      refine (Finset.sum_le_sum_of_subset_of_nonneg hsub fun _ _ _ => abs_nonneg _).trans ?_
      refine Finset.sum_le_sum fun d _ => ?_
      rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_map, abs_mul,
        abs_of_pos (one_div_pos.mpr hMpos)]
      have habs : |(Int.castRingHom ℝ) ((π.g j).coeff d)| = (((π.g j).coeff d).natAbs : ℝ) := by
        change |((π.g j).coeff d : ℝ)| = (((π.g j).coeff d).natAbs : ℝ)
        rw [← Int.cast_abs, Int.abs_eq_natAbs, Int.cast_natCast]
      rw [habs, one_div_mul_eq_div]
      exact div_le_self (Nat.cast_nonneg _) hMge1
    linarith
  exact (hmin π.toSemantic).trans hto

end SheraliAdams

section PseudoMeasure

variable {V ι : Type*}

/-- A `δ`-pseudo-measure for a polynomial system `P` over Boolean and twin variables: a linear
functional vanishing on the Boolean ideal such that `μ(1) = 1`, `|μ(m · p)| ≤ δ` for every
monomial `m` and `p ∈ P`, and `μ(m) ≥ -δ` for every monomial `m`. -/
structure IsPseudoMeasure [Fintype V] [Fintype ι] (δ : ℝ)
    (P : ι → MvPolynomial (V ⊕ V) ℝ)
    (μ : MvPolynomial (V ⊕ V) ℝ →ₗ[ℝ] ℝ) : Prop where
  /-- `μ` vanishes on the Boolean and negation ideal `I_B`. -/
  vanishes_booleanIdeal : ∀ q ∈ booleanIdeal V, μ q = 0
  /-- Normalization `μ(1) = 1`. -/
  map_one : μ 1 = 1
  /-- Axiom bound `|μ(m · p)| ≤ δ` for all monomials `m` and `p ∈ P`. -/
  axiom_bound : ∀ (d : V ⊕ V →₀ ℕ) (j : ι), |μ (MvPolynomial.monomial d 1 * P j)| ≤ δ
  /-- Approximate non-negativity `μ(m) ≥ -δ` for all monomials `m`. -/
  monomial_lower : ∀ (d : V ⊕ V →₀ ℕ), -δ ≤ μ (MvPolynomial.monomial d 1)

/-- Linear functional induced by a weight vector `w : (V → Bool) → ℝ` on Boolean assignments. -/
noncomputable def ofWeights [Fintype V] [DecidableEq V] (w : (V → Bool) → ℝ) :
    MvPolynomial (V ⊕ V) ℝ →ₗ[ℝ] ℝ where
  toFun p := ∑ ρ : V → Bool, w ρ * evalBool ρ p
  map_add' p q := by
    simp only [evalBool_add, mul_add, Finset.sum_add_distrib]
  map_smul' r p := by
    simp only [smul_eq_mul, RingHom.id_apply, Finset.mul_sum]
    refine Finset.sum_congr rfl fun ρ _ => ?_
    have : evalBool ρ (r • p) = r * evalBool ρ p := by
      simp [evalBool, Algebra.smul_def]
    rw [this]
    ring

@[simp]
theorem ofWeights_apply [Fintype V] [DecidableEq V] (w : (V → Bool) → ℝ)
    (p : MvPolynomial (V ⊕ V) ℝ) :
    ofWeights w p = ∑ ρ : V → Bool, w ρ * evalBool ρ p := by
  simp [ofWeights]

theorem ofWeights_vanishes_booleanIdeal [Fintype V] [DecidableEq V] (w : (V → Bool) → ℝ)
    {q : MvPolynomial (V ⊕ V) ℝ} (hq : q ∈ booleanIdeal V) :
    ofWeights w q = 0 := by
  rw [ofWeights_apply]
  refine Finset.sum_eq_zero fun ρ _ => ?_
  rw [evalBool_eq_zero_of_mem_booleanIdeal hq ρ, mul_zero]

theorem eq_ofWeights_of_vanishes_booleanIdeal [Fintype V] [DecidableEq V]
    (μ : MvPolynomial (V ⊕ V) ℝ →ₗ[ℝ] ℝ)
    (hμ : ∀ q ∈ booleanIdeal V, μ q = 0) (p : MvPolynomial (V ⊕ V) ℝ) :
    μ p = ofWeights (fun ρ => μ (assignmentIndicator ρ)) p := by
  have hsub := hμ _ (sub_sum_evalBool_indicator_mem_booleanIdeal p)
  rw [map_sub, map_sum, sub_eq_zero] at hsub
  rw [hsub, ofWeights_apply]
  refine Finset.sum_congr rfl fun ρ _ => ?_
  have hsmul :
      C (evalBool ρ p) * assignmentIndicator ρ = evalBool ρ p • assignmentIndicator ρ := by
    rw [Algebra.smul_def]
    rfl
  rw [hsmul, map_smul, smul_eq_mul, mul_comm]

/-- Soundness direction of pseudo-measure duality: any `δ`-pseudo-measure forces every
semantic Sherali-Adams refutation to have coefficient size at least `1 / δ`. -/
theorem coeffSize_ge_of_isPseudoMeasure [Fintype V] [Fintype ι]
    {P : ι → MvPolynomial (V ⊕ V) ℝ} {δ : ℝ} (hδ : 0 < δ)
    {μ : MvPolynomial (V ⊕ V) ℝ →ₗ[ℝ] ℝ} (hμ : IsPseudoMeasure δ P μ)
    (π : SemanticSARefutation P) :
    1 / δ ≤ π.coeffSize := by
  have h0 : μ ((∑ j : ι, π.g j * P j) + π.f0 + 1) = 0 :=
    hμ.vanishes_booleanIdeal _ π.is_refutation
  rw [map_add, map_add, hμ.map_one] at h0
  have hg :
      -δ * (∑ j : ι, ∑ d ∈ (π.g j).support, |(π.g j).coeff d|) ≤
        μ (∑ j : ι, π.g j * P j) := by
    rw [map_sum, Finset.mul_sum]
    refine Finset.sum_le_sum fun j _ => ?_
    have hdecomp :
        π.g j * P j =
          ∑ d ∈ (π.g j).support, (π.g j).coeff d • (MvPolynomial.monomial d 1 * P j) := by
      conv_lhs => rw [(π.g j).as_sum]
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun d _ => ?_
      rw [Algebra.smul_def, ← mul_assoc, MvPolynomial.algebraMap_eq,
        MvPolynomial.C_mul_monomial, mul_one]
    rw [hdecomp, map_sum, Finset.mul_sum]
    refine Finset.sum_le_sum fun d _ => ?_
    rw [map_smul, smul_eq_mul]
    have hab := hμ.axiom_bound d j
    have hle := neg_abs_le ((π.g j).coeff d * μ (MvPolynomial.monomial d 1 * P j))
    rw [abs_mul] at hle
    have hmul : |(π.g j).coeff d| * |μ (MvPolynomial.monomial d 1 * P j)| ≤
        |(π.g j).coeff d| * δ :=
      mul_le_mul_of_nonneg_left hab (abs_nonneg _)
    linarith
  have hf0 : -δ * (∑ ab : Finset V × Finset V, π.alpha ab) ≤ μ π.f0 := by
    rw [SemanticSARefutation.f0, map_sum, Finset.mul_sum]
    refine Finset.sum_le_sum fun ab _ => ?_
    have hsmul :
        C (π.alpha ab) * literalMonomial ab.1 ab.2 =
          π.alpha ab • literalMonomial ab.1 ab.2 := by
      rw [Algebra.smul_def]
      rfl
    rw [hsmul, map_smul, smul_eq_mul]
    rcases literalMonomial_eq_monomial ab.1 ab.2 with ⟨d, hd⟩
    rw [hd]
    have hlow := hμ.monomial_lower d
    nlinarith [π.alpha_nonneg ab]
  rw [SemanticSARefutation.coeffSize, div_le_iff₀ hδ]
  nlinarith

/-- Pseudo-measure linear-programming duality: a `δ`-pseudo-measure for `P` exists if and only if
every semantic Sherali-Adams refutation of `P` has coefficient size at least `1 / δ`. -/
theorem exists_pseudoMeasure_iff_forall_coeffSize_ge [Fintype V] [Fintype ι]
    (P : ι → MvPolynomial (V ⊕ V) ℝ) {δ : ℝ} (hδ : 0 < δ) :
    (∃ μ : MvPolynomial (V ⊕ V) ℝ →ₗ[ℝ] ℝ, IsPseudoMeasure δ P μ) ↔
      ∀ π : SemanticSARefutation P, 1 / δ ≤ π.coeffSize := by
  classical
  constructor
  · rintro ⟨μ, hμ⟩ π
    exact coeffSize_ge_of_isPseudoMeasure hδ hμ π
  · intro hmin
    by_contra hno
    let Row := Unit ⊕ (Finset V × Finset V) ⊕
      ((Finset V × Finset V) × ι) ⊕ ((Finset V × Finset V) × ι)
    let A : Matrix Row (V → Bool) ℝ := Matrix.of fun r ρ =>
      match r with
      | Sum.inl _ => -1
      | Sum.inr (Sum.inl ab) => -evalBool ρ (literalMonomial ab.1 ab.2)
      | Sum.inr (Sum.inr (Sum.inl (ab, j))) =>
        evalBool ρ (literalMonomial ab.1 ab.2 * P j)
      | Sum.inr (Sum.inr (Sum.inr (ab, j))) =>
        -evalBool ρ (literalMonomial ab.1 ab.2 * P j)
    let b : Row → ℝ := fun r =>
      match r with
      | Sum.inl _ => -1
      | Sum.inr _ => δ
    have hno_sol : ¬ ∃ w : (V → Bool) → ℝ, A *ᵥ w ≤ b := by
      rintro ⟨w, hw⟩
      have hone_le : (1 : ℝ) ≤ ofWeights w 1 := by
        have hrow := hw (Sum.inl Unit.unit)
        simp only [A, b, Matrix.mulVec, dotProduct, Matrix.of_apply, neg_mul,
          Finset.sum_neg_distrib, one_mul] at hrow
        rw [ofWeights_apply]
        simp only [evalBool_one, mul_one]
        linarith
      have hpos : (0 : ℝ) < ofWeights w 1 := by linarith
      let M : ℝ := ofWeights w 1
      let μ : MvPolynomial (V ⊕ V) ℝ →ₗ[ℝ] ℝ := (1 / M) • ofWeights w
      apply hno
      refine ⟨μ, ?_⟩
      refine
        { vanishes_booleanIdeal := fun q hq => by
            simp [μ, ofWeights_vanishes_booleanIdeal w hq]
          map_one := by
            simp only [μ, LinearMap.smul_apply, smul_eq_mul, M]
            exact one_div_mul_cancel (ne_of_gt hpos)
          axiom_bound := fun d j => ?_
          monomial_lower := fun d => ?_ }
      · let ab : Finset V × Finset V :=
          (Finset.univ.filter fun v => d (Sum.inl v) ≠ 0,
           Finset.univ.filter fun v => d (Sum.inr v) ≠ 0)
        have hcong :
            μ (MvPolynomial.monomial d 1 * P j) = μ (literalMonomial ab.1 ab.2 * P j) := by
          have hd := monomial_sub_literalMonomial_mem_booleanIdeal d
          have hmem := (booleanIdeal V).mul_mem_right (P j) hd
          have h0 : μ ((MvPolynomial.monomial d 1 - literalMonomial ab.1 ab.2) * P j) = 0 := by
            simp only [μ, LinearMap.smul_apply, smul_eq_mul]
            rw [ofWeights_vanishes_booleanIdeal w hmem, mul_zero]
          rw [sub_mul, map_sub, sub_eq_zero] at h0
          exact h0
        rw [hcong]
        have hr1 := hw (Sum.inr (Sum.inr (Sum.inl (ab, j))))
        have hr2 := hw (Sum.inr (Sum.inr (Sum.inr (ab, j))))
        simp only [A, b, Matrix.mulVec, dotProduct, Matrix.of_apply, neg_mul,
          Finset.sum_neg_distrib] at hr1 hr2
        have heq1 :
            ∑ ρ : V → Bool, evalBool ρ (literalMonomial ab.1 ab.2 * P j) * w ρ =
              ofWeights w (literalMonomial ab.1 ab.2 * P j) := by
          rw [ofWeights_apply]
          refine Finset.sum_congr rfl fun ρ _ => mul_comm _ _
        rw [heq1] at hr1 hr2
        have hMge1 : (1 : ℝ) ≤ M := hone_le
        have hdiv : |ofWeights w (literalMonomial ab.1 ab.2 * P j)| ≤ M * δ := by
          rw [abs_le]
          constructor <;> nlinarith
        change |(1 / M) * ofWeights w (literalMonomial ab.1 ab.2 * P j)| ≤ δ
        rw [abs_mul, abs_of_pos (one_div_pos.mpr hpos), one_div_mul_eq_div, div_le_iff₀ hpos]
        linarith
      · let ab : Finset V × Finset V :=
          (Finset.univ.filter fun v => d (Sum.inl v) ≠ 0,
           Finset.univ.filter fun v => d (Sum.inr v) ≠ 0)
        have hcong : μ (MvPolynomial.monomial d 1) = μ (literalMonomial ab.1 ab.2) := by
          have hd := monomial_sub_literalMonomial_mem_booleanIdeal d
          have h0 : μ (MvPolynomial.monomial d 1 - literalMonomial ab.1 ab.2) = 0 := by
            simp only [μ, LinearMap.smul_apply, smul_eq_mul]
            rw [ofWeights_vanishes_booleanIdeal w hd, mul_zero]
          rw [map_sub, sub_eq_zero] at h0
          exact h0
        rw [hcong]
        have hr := hw (Sum.inr (Sum.inl ab))
        simp only [A, b, Matrix.mulVec, dotProduct, Matrix.of_apply, neg_mul,
          Finset.sum_neg_distrib] at hr
        have heq :
            ∑ ρ : V → Bool, evalBool ρ (literalMonomial ab.1 ab.2) * w ρ =
              ofWeights w (literalMonomial ab.1 ab.2) := by
          rw [ofWeights_apply]
          refine Finset.sum_congr rfl fun ρ _ => mul_comm _ _
        rw [heq] at hr
        simp only [μ, LinearMap.smul_apply, smul_eq_mul, one_div_mul_eq_div]
        rw [le_div_iff₀ hpos]
        nlinarith
    obtain ⟨y, hy_nonneg, hyA, hyb⟩ := (Matrix.not_exists_mulVec_le_iff A b).mp hno_sol
    let y0 : ℝ := y (Sum.inl Unit.unit)
    let alpha0 : Finset V × Finset V → ℝ := fun ab => y (Sum.inr (Sum.inl ab))
    let betaPos : Finset V × Finset V → ι → ℝ :=
      fun ab j => y (Sum.inr (Sum.inr (Sum.inl (ab, j))))
    let betaNeg : Finset V × Finset V → ι → ℝ :=
      fun ab j => y (Sum.inr (Sum.inr (Sum.inr (ab, j))))
    have hyb_exp :
        -y0 + δ * ((∑ ab, alpha0 ab) +
          ∑ j : ι, ∑ ab : Finset V × Finset V, (betaPos ab j + betaNeg ab j)) < 0 := by
      have hdot :
          y ⬝ᵥ b = -y0 + δ * ((∑ ab, alpha0 ab) +
            ∑ j : ι, ∑ ab : Finset V × Finset V, (betaPos ab j + betaNeg ab j)) := by
        rw [dotProduct, Fintype.sum_sum_type, Fintype.sum_unique,
          Fintype.sum_sum_type, Fintype.sum_sum_type]
        simp only [b, y0, alpha0, betaPos, betaNeg, mul_neg, mul_one]
        rw [Fintype.sum_prod_type (f := fun p : (Finset V × Finset V) × ι =>
              y (Sum.inr (Sum.inr (Sum.inl p))) * δ),
            Fintype.sum_prod_type (f := fun p : (Finset V × Finset V) × ι =>
              y (Sum.inr (Sum.inr (Sum.inr p))) * δ)]
        rw [Finset.sum_comm (f := fun ab j => y (Sum.inr (Sum.inr (Sum.inl (ab, j)))) * δ),
            Finset.sum_comm (f := fun ab j => y (Sum.inr (Sum.inr (Sum.inr (ab, j)))) * δ)]
        simp only [Finset.sum_add_distrib, Finset.mul_sum, mul_add]
        have hmul_comm : ∀ (f : Finset V × Finset V → ℝ),
            ∑ ab, f ab * δ = ∑ ab, δ * f ab := fun f =>
          Finset.sum_congr rfl fun _ _ => mul_comm _ _
        have hmul_comm2 : ∀ (f : ι → Finset V × Finset V → ℝ),
            ∑ j, ∑ ab, f j ab * δ = ∑ j, ∑ ab, δ * f j ab := fun f =>
          Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => mul_comm _ _
        rw [hmul_comm, hmul_comm2, hmul_comm2]
      linarith
    have hsum_nonneg :
        0 ≤ (∑ ab, alpha0 ab) +
          ∑ j : ι, ∑ ab : Finset V × Finset V, (betaPos ab j + betaNeg ab j) :=
      add_nonneg (Finset.sum_nonneg fun ab _ => hy_nonneg _)
        (Finset.sum_nonneg fun j _ => Finset.sum_nonneg fun ab _ =>
          add_nonneg (hy_nonneg _) (hy_nonneg _))
    have hy0_pos : 0 < y0 := by nlinarith
    let g_poly : ι → MvPolynomial (V ⊕ V) ℝ := fun j =>
      ∑ ab : Finset V × Finset V,
        C ((betaNeg ab j - betaPos ab j) / y0) * literalMonomial ab.1 ab.2
    let π : SemanticSARefutation P :=
      { g := g_poly
        alpha := fun ab => alpha0 ab / y0
        alpha_nonneg := fun ab => div_nonneg (hy_nonneg _) (le_of_lt hy0_pos)
        is_refutation := by
          rw [mem_booleanIdeal_iff_evalBool_eq_zero]
          intro ρ
          have hcol := congr_fun hyA ρ
          rw [Matrix.vecMul, dotProduct, Pi.zero_apply, Fintype.sum_sum_type, Fintype.sum_unique,
            Fintype.sum_sum_type, Fintype.sum_sum_type] at hcol
          simp only [A, Matrix.of_apply] at hcol
          rw [Fintype.sum_prod_type (f := fun p : (Finset V × Finset V) × ι =>
                y (Sum.inr (Sum.inr (Sum.inl p))) *
                  evalBool ρ (literalMonomial p.1.1 p.1.2 * P p.2)),
              Fintype.sum_prod_type (f := fun p : (Finset V × Finset V) × ι =>
                y (Sum.inr (Sum.inr (Sum.inr p))) *
                  -evalBool ρ (literalMonomial p.1.1 p.1.2 * P p.2))] at hcol
          rw [evalBool_add, evalBool_add, evalBool_one, evalBool_sum, evalBool_sum]
          have hcol' :
              (∑ j : ι, ∑ ab : Finset V × Finset V,
                (betaNeg ab j - betaPos ab j) * evalBool ρ (literalMonomial ab.1 ab.2) *
                  evalBool ρ (P j)) +
              (∑ ab : Finset V × Finset V, alpha0 ab * evalBool ρ (literalMonomial ab.1 ab.2)) +
              y0 = 0 := by
            have hswap :
                ∑ ab : Finset V × Finset V, ∑ j : ι,
                  betaPos ab j * evalBool ρ (literalMonomial ab.1 ab.2 * P j) =
                ∑ j : ι, ∑ ab : Finset V × Finset V,
                  betaPos ab j * evalBool ρ (literalMonomial ab.1 ab.2) * evalBool ρ (P j) := by
              rw [Finset.sum_comm]
              refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun ab _ => ?_
              rw [evalBool_mul, mul_assoc]
            have hneg_swap :
                -(∑ ab : Finset V × Finset V, ∑ j : ι,
                  betaNeg ab j * evalBool ρ (literalMonomial ab.1 ab.2 * P j)) =
                -(∑ j : ι, ∑ ab : Finset V × Finset V,
                  betaNeg ab j * evalBool ρ (literalMonomial ab.1 ab.2) * evalBool ρ (P j)) := by
              congr 1
              rw [Finset.sum_comm]
              refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun ab _ => ?_
              rw [evalBool_mul, mul_assoc]
            have hcol2 :
                -y0 + (-(∑ ab : Finset V × Finset V,
                    alpha0 ab * evalBool ρ (literalMonomial ab.1 ab.2))) +
                  ((∑ ab : Finset V × Finset V, ∑ j : ι,
                    betaPos ab j * evalBool ρ (literalMonomial ab.1 ab.2 * P j)) +
                   -(∑ ab : Finset V × Finset V, ∑ j : ι,
                    betaNeg ab j * evalBool ρ (literalMonomial ab.1 ab.2 * P j))) = 0 := by
              simp only [mul_neg, mul_one, Finset.sum_neg_distrib] at hcol
              have hu : (default : Unit) = Unit.unit := rfl
              rw [hu] at hcol
              dsimp only [y0, alpha0, betaPos, betaNeg]
              linarith
            rw [hswap, hneg_swap] at hcol2
            have hsub_sum :
                (∑ j : ι, ∑ ab : Finset V × Finset V,
                  (betaNeg ab j - betaPos ab j) * evalBool ρ (literalMonomial ab.1 ab.2) *
                    evalBool ρ (P j)) =
                (∑ j : ι, ∑ ab : Finset V × Finset V,
                  betaNeg ab j * evalBool ρ (literalMonomial ab.1 ab.2) * evalBool ρ (P j)) -
                (∑ j : ι, ∑ ab : Finset V × Finset V,
                  betaPos ab j * evalBool ρ (literalMonomial ab.1 ab.2) * evalBool ρ (P j)) := by
              rw [← Finset.sum_sub_distrib]
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [← Finset.sum_sub_distrib]
              refine Finset.sum_congr rfl fun ab _ => by ring
            linarith
          have hdiv :
              (∑ j : ι, evalBool ρ (g_poly j * P j)) +
              (∑ ab : Finset V × Finset V,
                evalBool ρ (C (alpha0 ab / y0) * literalMonomial ab.1 ab.2)) + 1 =
              ((∑ j : ι, ∑ ab : Finset V × Finset V,
                (betaNeg ab j - betaPos ab j) * evalBool ρ (literalMonomial ab.1 ab.2) *
                  evalBool ρ (P j)) +
               (∑ ab : Finset V × Finset V,
                alpha0 ab * evalBool ρ (literalMonomial ab.1 ab.2)) + y0) / y0 := by
            simp only [g_poly, evalBool_mul, evalBool_sum, evalBool_C, Finset.sum_mul]
            rw [add_div, add_div, div_self (ne_of_gt hy0_pos)]
            simp only [div_eq_mul_inv, Finset.sum_mul]
            congr 1
            congr 1
            · refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun ab _ => by ring
            · refine Finset.sum_congr rfl fun ab _ => by ring
          rw [hdiv, hcol', zero_div] }
    have hcoeff_lt : π.coeffSize < 1 / δ := by
      have hdeg_g :
          ∀ j : ι, ∑ d ∈ (π.g j).support, |(π.g j).coeff d| ≤
            ∑ ab : Finset V × Finset V, (betaPos ab j + betaNeg ab j) / y0 := by
        intro j
        have htri :
            ∀ (S : Finset (Finset V × Finset V))
              (f : Finset V × Finset V → MvPolynomial (V ⊕ V) ℝ),
              ∑ d ∈ (∑ ab ∈ S, f ab).support, |(∑ ab ∈ S, f ab).coeff d| ≤
                ∑ ab ∈ S, ∑ d ∈ (f ab).support, |(f ab).coeff d| := by
          intro S f
          induction S using Finset.induction_on with
          | empty => simp
          | @insert a s ha ih =>
            rw [Finset.sum_insert ha, Finset.sum_insert ha]
            let p1 := f a
            let p2 := ∑ ab ∈ s, f ab
            have hsub : (p1 + p2).support ⊆ p1.support ∪ p2.support :=
              MvPolynomial.support_add
            calc
              ∑ d ∈ (p1 + p2).support, |(p1 + p2).coeff d|
                  ≤ ∑ d ∈ p1.support ∪ p2.support, |(p1 + p2).coeff d| :=
                Finset.sum_le_sum_of_subset_of_nonneg hsub fun _ _ _ => abs_nonneg _
              _ ≤ ∑ d ∈ p1.support ∪ p2.support, (|p1.coeff d| + |p2.coeff d|) :=
                Finset.sum_le_sum fun d _ => by
                  have hca : (p1 + p2).coeff d = p1.coeff d + p2.coeff d :=
                    DFunLike.congr_fun (AddMonoidAlgebra.coeff_add p1 p2) d
                  rw [hca]
                  exact abs_add_le _ _
              _ = (∑ d ∈ p1.support ∪ p2.support, |p1.coeff d|) +
                  (∑ d ∈ p1.support ∪ p2.support, |p2.coeff d|) := Finset.sum_add_distrib
              _ = (∑ d ∈ p1.support, |p1.coeff d|) + (∑ d ∈ p2.support, |p2.coeff d|) := by
                congr 1
                · symm
                  refine Finset.sum_subset Finset.subset_union_left fun d _ hd => ?_
                  simp [MvPolynomial.notMem_support_iff.mp hd]
                · symm
                  refine Finset.sum_subset Finset.subset_union_right fun d _ hd => ?_
                  simp [MvPolynomial.notMem_support_iff.mp hd]
              _ ≤ (∑ d ∈ p1.support, |p1.coeff d|) +
                  ∑ ab ∈ s, ∑ d ∈ (f ab).support, |(f ab).coeff d| :=
                add_le_add le_rfl ih
        refine (htri Finset.univ _).trans ?_
        refine Finset.sum_le_sum fun ab _ => ?_
        rcases literalMonomial_eq_monomial ab.1 ab.2 with ⟨d0, hd0⟩
        rw [hd0, MvPolynomial.C_mul_monomial, mul_one]
        by_cases hc0 : (betaNeg ab j - betaPos ab j) / y0 = 0
        · rw [hc0, map_zero, MvPolynomial.support_zero, Finset.sum_empty]
          exact div_nonneg (add_nonneg (hy_nonneg _) (hy_nonneg _)) (le_of_lt hy0_pos)
        · rw [MvPolynomial.support_monomial, ite_eq_right hc0,
            Finset.sum_singleton, MvPolynomial.coeff_monomial,
            ite_eq_left rfl, abs_div, abs_of_pos hy0_pos]
          refine div_le_div_of_nonneg_right ?_ (le_of_lt hy0_pos)
          have h1 : 0 ≤ betaPos ab j := hy_nonneg _
          have h2 : 0 ≤ betaNeg ab j := hy_nonneg _
          rw [abs_le]
          constructor <;> linarith
      have htot :
          π.coeffSize ≤
            ((∑ ab, alpha0 ab) +
              ∑ j : ι, ∑ ab : Finset V × Finset V, (betaPos ab j + betaNeg ab j)) / y0 := by
        rw [SemanticSARefutation.coeffSize, add_div]
        simp only [div_eq_mul_inv, Finset.sum_mul]
        refine add_le_add le_rfl ?_
        refine Finset.sum_le_sum fun j _ => ?_
        simpa only [div_eq_mul_inv] using hdeg_g j
      have hstrict :
          ((∑ ab, alpha0 ab) +
            ∑ j : ι, ∑ ab : Finset V × Finset V, (betaPos ab j + betaNeg ab j)) / y0 <
            1 / δ := by
        rw [div_lt_div_iff₀ hy0_pos hδ]
        linarith
      linarith
    linarith [hmin π]

end PseudoMeasure

end CslibFrontier.Logics.Propositional.SheraliAdams
