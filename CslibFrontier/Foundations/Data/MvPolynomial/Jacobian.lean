/-!
# Polynomial Jacobian Matrices, Faithful Homomorphisms, and Sharp Jacobian Sparsity

This module defines Jacobian matrices and square Jacobian minors for families of multivariate
polynomials, finite transcendence degree, and faithful algebra homomorphisms, and proves:

- the Jacobian chain rule for polynomial substitutions and algebra homomorphisms;
- nonvanishing preservation of arbitrary polynomial compositions under faithful homomorphisms;
- the sharp monomial-collapse support bound `|supp(J_cols(f))| ≤ ∏_i |supp(f_i)|` (eliminating
  the naive `r!` determinant factor).

## Main definitions

* `CslibFrontier.MvPolynomial.jacobianMatrix`: the matrix `(∂ f_i / ∂ x_j)` of formal partial
  derivatives.
* `CslibFrontier.MvPolynomial.jacobianMinor`: the determinant of a square column submatrix of
  `jacobianMatrix`.
* `CslibFrontier.MvPolynomial.trdegFin`: natural-number transcendence degree of a family of
  multivariate polynomials over a field.
* `CslibFrontier.MvPolynomial.IsFaithful`: transcendence-degree preservation under an algebra
  homomorphism.

## Main results

* `CslibFrontier.MvPolynomial.jacobianMatrix_aeval` and
  `CslibFrontier.MvPolynomial.jacobianMatrix_algHom`: chain rule for polynomial Jacobians.
* `CslibFrontier.MvPolynomial.faithful_aeval_eq_zero_iff`: a faithful homomorphism preserves
  vanishing of arbitrary polynomial compositions `aeval f C`.
* `CslibFrontier.MvPolynomial.card_support_det_monomialDeriv_le` and
  `CslibFrontier.MvPolynomial.card_support_jacobianMinor_le`: sharp support-size bound for
  square Jacobian minors.
-/

public section

namespace CslibFrontier.MvPolynomial

open Finset _root_.MvPolynomial Function

/-- The Jacobian matrix `(∂ f_i / ∂ x_j)` of a family of multivariate polynomials. -/
noncomputable def jacobianMatrix {F : Type*} [CommSemiring F] {ι σ : Type*}
    (f : ι → MvPolynomial σ F) : Matrix ι σ (MvPolynomial σ F) :=
  Matrix.of fun i j ↦ _root_.MvPolynomial.pderiv j (f i)

/-- Entrywise evaluation of `jacobianMatrix`. -/
@[simp]
theorem jacobianMatrix_apply {F : Type*} [CommSemiring F] {ι σ : Type*}
    (f : ι → MvPolynomial σ F) (i : ι) (j : σ) :
    jacobianMatrix f i j = _root_.MvPolynomial.pderiv j (f i) := by
  unfold jacobianMatrix
  rfl

/-- The square Jacobian minor formed by selecting columns `cols : ι → σ` of `jacobianMatrix f`. -/
noncomputable def jacobianMinor {F : Type*} [CommRing F] {ι σ : Type*}
    [Fintype ι] [DecidableEq ι] (f : ι → MvPolynomial σ F) (cols : ι → σ) :
    MvPolynomial σ F :=
  ((jacobianMatrix f).submatrix id cols).det

/-- Determinant expression for `jacobianMinor`. -/
theorem jacobianMinor_eq_det {F : Type*} [CommRing F] {ι σ : Type*}
    [Fintype ι] [DecidableEq ι] (f : ι → MvPolynomial σ F) (cols : ι → σ) :
    jacobianMinor f cols = (Matrix.of fun i j ↦ _root_.MvPolynomial.pderiv (cols j) (f i)).det := by
  unfold jacobianMinor jacobianMatrix
  rfl

/-- Natural-number transcendence degree of the `F`-subalgebra generated by a polynomial family. -/
noncomputable def trdegFin (F : Type*) [Field F] {ι σ : Type*}
    (f : ι → MvPolynomial σ F) : ℕ :=
  (Algebra.trdeg F (Algebra.adjoin F (Set.range f))).toNat

/-- An `F`-algebra homomorphism `Φ : F[x] → F[y]` is faithful to `f` when it preserves
`trdegFin F f`. -/
def IsFaithful {F : Type*} [Field F] {ι σ τ : Type*}
    (Φ : MvPolynomial σ F →ₐ[F] MvPolynomial τ F) (f : ι → MvPolynomial σ F) : Prop :=
  trdegFin F f = trdegFin F (Φ ∘ f)

/-- Characterization of `IsFaithful`. -/
theorem isFaithful_iff {F : Type*} [Field F] {ι σ τ : Type*}
    {Φ : MvPolynomial σ F →ₐ[F] MvPolynomial τ F} {f : ι → MvPolynomial σ F} :
    IsFaithful Φ f ↔ trdegFin F f = trdegFin F (Φ ∘ f) := by
  unfold IsFaithful
  rfl

/-- Cardinal cast of `trdegFin` for finite polynomial families. -/
theorem natCast_trdegFin_eq {F : Type*} [Field F] {ι σ : Type*} [Finite ι]
    (f : ι → MvPolynomial σ F) :
    (trdegFin F f : Cardinal) = Algebra.trdeg F (Algebra.adjoin F (Set.range f)) := by
  have : Algebra.FiniteType F (Algebra.adjoin F (Set.range f)) :=
    Algebra.FiniteType.adjoin_of_finite (Set.finite_range f)
  have hlt : Algebra.trdeg F (Algebra.adjoin F (Set.range f)) < Cardinal.aleph0 :=
    trdeg_lt_aleph0_of_finiteType
  unfold trdegFin
  exact Cardinal.cast_toNat_of_lt_aleph0 hlt

/-- Every finite family of polynomials has transcendence degree at most the size of the index
type. -/
theorem trdegFin_le_card {F : Type*} [Field F] {ι σ : Type*} [Fintype ι]
    (f : ι → MvPolynomial σ F) :
    trdegFin F f ≤ Fintype.card ι := by
  let A := Algebra.adjoin F (Set.range f)
  let s : Set A := Set.range fun i : ι ↦ (⟨f i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ : A)
  have htop : Algebra.adjoin F s = ⊤ := by
    rw [eq_top_iff]
    rintro ⟨y, hy⟩ _
    induction hy using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with ⟨i, rfl⟩
      exact Algebra.subset_adjoin ⟨i, rfl⟩
    | algebraMap r => exact Subalgebra.algebraMap_mem _ r
    | add a b _ _ ha hb => exact Subalgebra.add_mem _ (ha trivial) (hb trivial)
    | mul a b _ _ ha hb => exact Subalgebra.mul_mem _ (ha trivial) (hb trivial)
  have halg : Algebra.IsAlgebraic (Algebra.adjoin F s) A :=
    ⟨fun x ↦ isAlgebraic_algebraMap (R := Algebra.adjoin F s) ⟨x, by rw [htop]; trivial⟩⟩
  have hle : Algebra.trdeg F A ≤ Cardinal.mk s :=
    Algebra.IsAlgebraic.trdeg_le_cardinalMk (R := F) (s := s)
  classical
  let S : Finset A := Finset.univ.image fun i : ι ↦ (⟨f i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ : A)
  have hfin : s = (S : Set A) := by
    ext x; simp [s, S]
  have hcard : Cardinal.mk s ≤ (Fintype.card ι : Cardinal) := by
    rw [hfin]
    have hmk : Cardinal.mk (S : Set A) = (S.card : Cardinal) := Cardinal.mk_coe_finset
    rw [hmk]
    exact_mod_cast Finset.card_image_le.trans_eq Finset.card_univ
  rw [← natCast_trdegFin_eq] at hle
  exact_mod_cast hle.trans hcard

/-- An algebraically independent `k`-element subfamily lower-bounds `trdegFin`. -/
theorem le_trdegFin_of_algebraicIndependent {F : Type*} [Field F] {ι σ : Type*} [Finite ι]
    {f : ι → MvPolynomial σ F} {k : ℕ} {e : Fin k → ι}
    (hind : AlgebraicIndependent F (f ∘ e)) :
    k ≤ trdegFin F f := by
  let g : Fin k → Algebra.adjoin F (Set.range f) :=
    fun i ↦ ⟨f (e i), Algebra.subset_adjoin ⟨e i, rfl⟩⟩
  have hg : AlgebraicIndependent F g :=
    AlgebraicIndependent.of_comp (Algebra.adjoin F (Set.range f)).val hind
  have hle := hg.lift_cardinalMk_le_trdeg
  rw [← natCast_trdegFin_eq] at hle
  simpa using hle

/-- Every finite family admits a transcendence-basis subfamily of size `trdegFin F f`. -/
theorem exists_transcendenceBasis_subfamily {F : Type*} [Field F] {ι σ : Type*} [Finite ι]
    (f : ι → MvPolynomial σ F) :
    ∃ e : Fin (trdegFin F f) ↪ ι,
      AlgebraicIndependent F (f ∘ e) ∧
      ∀ i : ι, IsAlgebraic (Algebra.adjoin F (Set.range (f ∘ e))) (f i) := by
  classical
  let A := Algebra.adjoin F (Set.range f)
  let s : Set A := Set.range fun i : ι ↦ (⟨f i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ : A)
  have htop : Algebra.adjoin F s = ⊤ := by
    rw [eq_top_iff]
    rintro ⟨y, hy⟩ _
    induction hy using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with ⟨i, rfl⟩
      exact Algebra.subset_adjoin ⟨i, rfl⟩
    | algebraMap r => exact Subalgebra.algebraMap_mem _ r
    | add a b _ _ ha hb => exact Subalgebra.add_mem _ (ha trivial) (hb trivial)
    | mul a b _ _ ha hb => exact Subalgebra.mul_mem _ (ha trivial) (hb trivial)
  have : Algebra.IsAlgebraic (Algebra.adjoin F s) A :=
    ⟨fun x ↦ isAlgebraic_algebraMap (R := Algebra.adjoin F s) ⟨x, by rw [htop]; trivial⟩⟩
  obtain ⟨t, hts, ht⟩ := exists_isTranscendenceBasis_subset (R := F) s
  have hcard : Cardinal.mk t = (trdegFin F f : Cardinal) := by
    rw [ht.cardinalMk_eq_trdeg, natCast_trdegFin_eq]
  have hfin_t : t.Finite := (Set.finite_range _).subset hts
  have : Fintype t := hfin_t.fintype
  have hft : Fintype.card t = trdegFin F f := by
    have h1 : (Fintype.card t : Cardinal) = Cardinal.mk t := (Cardinal.mk_fintype t).symm
    exact_mod_cast h1.trans hcard
  let equivT : Fin (trdegFin F f) ≃ t := (Fintype.equivFinOfCardEq hft).symm
  have hchoose : ∀ j : Fin (trdegFin F f), ∃ i : ι,
      (⟨f i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ : A) = (equivT j).1 := fun j ↦ hts (equivT j).2
  choose eFn heFn using hchoose
  have hinj : Function.Injective eFn := by
    intro a b hab
    have h1 : (equivT a).1 = (equivT b).1 := by rw [← heFn a, ← heFn b, hab]
    exact equivT.injective (Subtype.ext h1)
  let e : Fin (trdegFin F f) ↪ ι := ⟨eFn, hinj⟩
  have hcomp : f ∘ e = fun j ↦ ((equivT j).1 : MvPolynomial σ F) := by
    funext j
    exact congrArg Subtype.val (heFn j)
  refine ⟨e, ?_, ?_⟩
  · rw [hcomp]
    have ht_ind : AlgebraicIndependent F (fun j : Fin (trdegFin F f) ↦ (equivT j).1) :=
      (algebraicIndependent_equiv equivT).mpr ht.1
    rw [algebraicIndependent_iff] at ht_ind ⊢
    intro p hp
    apply ht_ind p
    apply Subtype.ext
    have hval : ∀ q : MvPolynomial (Fin (trdegFin F f)) F,
        A.val (aeval (fun j ↦ (equivT j).1) q) =
        aeval (fun j ↦ ((equivT j).1 : MvPolynomial σ F)) q := by
      intro q
      induction q using _root_.MvPolynomial.induction_on with
      | C a => simp
      | add p₁ p₂ hp₁ hp₂ => simp only [map_add, hp₁, hp₂]
      | mul_X p₁ j hp₁ => simp only [map_mul, aeval_X, hp₁]; rfl
    change A.val _ = 0
    rw [hval p]
    exact hp
  · intro i
    have halg : IsAlgebraic (Algebra.adjoin F (Set.range (fun x : t ↦ x.1)))
        (⟨f i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ : A) := ht.isAlgebraic.isAlgebraic _
    obtain ⟨p, hp0, hp_eval⟩ := halg
    have hmem : ∀ z : A, z ∈ Algebra.adjoin F (Set.range (fun x : t ↦ x.1)) →
        z.1 ∈ Algebra.adjoin F (Set.range (f ∘ e)) := by
      intro z hz
      induction hz using Algebra.adjoin_induction with
      | mem x hx =>
        rcases hx with ⟨y, rfl⟩
        refine Algebra.subset_adjoin ⟨equivT.symm y, ?_⟩
        have hy := heFn (equivT.symm y)
        rw [Equiv.apply_symm_apply] at hy
        exact congrArg Subtype.val hy
      | algebraMap r => exact Subalgebra.algebraMap_mem _ r
      | add a b _ _ ha hb => exact Subalgebra.add_mem _ ha hb
      | mul a b _ _ ha hb => exact Subalgebra.mul_mem _ ha hb
    let φ : Algebra.adjoin F (Set.range (fun x : t ↦ x.1)) →ₐ[F]
        Algebra.adjoin F (Set.range (f ∘ e)) :=
      { toFun := fun z ↦ ⟨z.1.1, hmem z.1 z.2⟩
        map_one' := rfl
        map_mul' := fun _ _ ↦ rfl
        map_zero' := rfl
        map_add' := fun _ _ ↦ rfl
        commutes' := fun _ ↦ rfl }
    have hφ_inj : Function.Injective φ := fun a b hab ↦
      Subtype.ext (Subtype.ext (congrArg (fun x ↦ x.1) hab))
    refine ⟨p.map φ.toRingHom, ?_, ?_⟩
    · intro h0
      exact hp0 (Polynomial.map_injective φ.toRingHom hφ_inj (by rw [h0, Polynomial.map_zero]))
    · have hval : A.val (Polynomial.aeval (⟨f i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ : A) p) = 0 := by
        rw [hp_eval, map_zero]
      suffices hgen : ∀ q, Polynomial.aeval (f i) (q.map φ.toRingHom) =
          A.val (Polynomial.aeval (⟨f i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ : A) q) by
        rw [hgen, hval]
      intro q
      induction q using Polynomial.induction_on' with
      | add q₁ q₂ hq₁ hq₂ =>
        simp only [Polynomial.map_add, map_add, hq₁, hq₂]
      | monomial k c =>
        simp only [Polynomial.map_monomial, Polynomial.aeval_monomial, map_mul, map_pow]
        rfl

/-- Applying an `F`-algebra homomorphism cannot increase transcendence degree. -/
theorem trdegFin_comp_le {F : Type*} [Field F] {ι σ τ : Type*} [Finite ι]
    (Φ : MvPolynomial σ F →ₐ[F] MvPolynomial τ F) (f : ι → MvPolynomial σ F) :
    trdegFin F (Φ ∘ f) ≤ trdegFin F f := by
  obtain ⟨e, hind, -⟩ := exists_transcendenceBasis_subfamily (F := F) (Φ ∘ f)
  exact le_trdegFin_of_algebraicIndependent (hind.of_comp Φ)

/-- Chain rule for Jacobian matrices under polynomial substitution `aeval g`. -/
theorem jacobianMatrix_aeval {F ι σ τ : Type*} [CommSemiring F] [Fintype σ]
    (g : σ → MvPolynomial τ F) (f : ι → MvPolynomial σ F) :
    jacobianMatrix (fun i ↦ aeval g (f i)) =
      (jacobianMatrix f).map (aeval g) * jacobianMatrix g := by
  refine Matrix.ext fun i j ↦ ?_
  rw [jacobianMatrix_apply, Matrix.mul_apply]
  simp only [Matrix.map_apply, jacobianMatrix_apply]
  exact _root_.MvPolynomial.pderiv_aeval g (f i) j

/-- Chain rule for Jacobian matrices under an arbitrary `F`-algebra homomorphism. -/
theorem jacobianMatrix_algHom {F ι σ τ : Type*} [CommSemiring F] [Fintype σ]
    (Φ : MvPolynomial σ F →ₐ[F] MvPolynomial τ F) (f : ι → MvPolynomial σ F) :
    jacobianMatrix (Φ ∘ f) = (jacobianMatrix f).map Φ * jacobianMatrix (fun s ↦ Φ (X s)) := by
  have hΦ : Φ = aeval (fun s ↦ Φ (X s)) := by
    apply algHom_ext
    intro s
    simp
  have hcomp : Φ ∘ f = fun i ↦ aeval (fun s ↦ Φ (X s)) (f i) := by
    funext i
    exact congrArg (fun h : MvPolynomial σ F →ₐ[F] MvPolynomial τ F ↦ h (f i)) hΦ
  rw [hcomp, jacobianMatrix_aeval]
  congr 1
  refine Matrix.ext fun i j ↦ ?_
  simp only [Matrix.map_apply]
  exact congrArg (fun h : MvPolynomial σ F →ₐ[F] MvPolynomial τ F ↦ h (jacobianMatrix f i j))
    hΦ.symm

private theorem map_aeval_eq {F ι σ τ : Type*} [CommSemiring F]
    (Φ : MvPolynomial σ F →ₐ[F] MvPolynomial τ F) (f : ι → MvPolynomial σ F)
    (C : MvPolynomial ι F) :
    Φ (aeval f C) = aeval (Φ ∘ f) C := by
  induction C using _root_.MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp only [map_add, hp, hq]
  | mul_X p i hp => simp only [map_mul, aeval_X, hp, Function.comp_apply]

private theorem aeval_mem_adjoin_range {F R ι : Type*} [CommSemiring F] [CommSemiring R]
    [Algebra F R] (f : ι → R) (P : MvPolynomial ι F) :
    aeval f P ∈ Algebra.adjoin F (Set.range f) := by
  induction P using _root_.MvPolynomial.induction_on with
  | C a => rw [aeval_C]; exact Subalgebra.algebraMap_mem _ a
  | add p q hp hq => rw [map_add]; exact Subalgebra.add_mem _ hp hq
  | mul_X p i hp =>
    rw [map_mul, aeval_X]
    exact Subalgebra.mul_mem _ hp (Algebra.subset_adjoin ⟨i, rfl⟩)

private theorem exists_aeval_eq_of_mem_adjoin {F R ι : Type*} [CommSemiring F] [CommSemiring R]
    [Algebra F R] (f : ι → R) {x : R} (hx : x ∈ Algebra.adjoin F (Set.range f)) :
    ∃ P : MvPolynomial ι F, aeval f P = x := by
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
    rcases hy with ⟨i, rfl⟩
    exact ⟨X i, by simp⟩
  | algebraMap a => exact ⟨C a, by simp⟩
  | add a b _ _ ha hb =>
    rcases ha with ⟨pa, hpa⟩
    rcases hb with ⟨pb, hpb⟩
    exact ⟨pa + pb, by simp [hpa, hpb]⟩
  | mul a b _ _ ha hb =>
    rcases ha with ⟨pa, hpa⟩
    rcases hb with ⟨pb, hpb⟩
    exact ⟨pa * pb, by simp [hpa, hpb]⟩

/-- A faithful algebra homomorphism preserves vanishing of every polynomial composition
`aeval f C`. -/
theorem faithful_aeval_eq_zero_iff {F ι σ τ : Type*} [Field F] [Finite ι]
    {Φ : MvPolynomial σ F →ₐ[F] MvPolynomial τ F} {f : ι → MvPolynomial σ F}
    (hΦ : IsFaithful Φ f) (C : MvPolynomial ι F) :
    aeval f C = 0 ↔ aeval (Φ ∘ f) C = 0 := by
  classical
  constructor
  · intro h
    rw [← map_aeval_eq, h, map_zero]
  · intro h0
    by_contra hne
    obtain ⟨e, hindΦ, -⟩ := exists_transcendenceBasis_subfamily (F := F) (Φ ∘ f)
    have hind : AlgebraicIndependent F (f ∘ e) := hindΦ.of_comp Φ
    let A := Algebra.adjoin F (Set.range f)
    let g : Fin (trdegFin F (Φ ∘ f)) → A :=
      fun j ↦ ⟨f (e j), Algebra.subset_adjoin ⟨e j, rfl⟩⟩
    have hg_ind : AlgebraicIndependent F g := AlgebraicIndependent.of_comp A.val hind
    have htr_le : Cardinal.lift.{0} (Algebra.trdeg F A) ≤
        Cardinal.lift (Cardinal.mk (Fin (trdegFin F (Φ ∘ f)))) := by
      rw [← natCast_trdegFin_eq f, isFaithful_iff.mp hΦ]
      simp
    have hbasis : IsTranscendenceBasis F g :=
      hg_ind.isTranscendenceBasis_of_lift_trdeg_le_of_finite htr_le
    have hCf_mem : aeval f C ∈ A := aeval_mem_adjoin_range f C
    have halg : IsAlgebraic (Algebra.adjoin F (Set.range g)) (⟨aeval f C, hCf_mem⟩ : A) :=
      hbasis.isAlgebraic.isAlgebraic _
    have hex : ∃ n, ∃ P : Polynomial (Algebra.adjoin F (Set.range g)),
        P ≠ 0 ∧ Polynomial.aeval (⟨aeval f C, hCf_mem⟩ : A) P = 0 ∧ P.natDegree = n :=
      ⟨_, _, halg.choose_spec.1, halg.choose_spec.2, rfl⟩
    obtain ⟨P, hP0, hPeval, hPdeg⟩ := Nat.find_spec hex
    have hP0_const : P.coeff 0 ≠ 0 := by
      intro hc0
      have hX_dvd : Polynomial.X ∣ P := Polynomial.X_dvd_iff.mpr hc0
      obtain ⟨Q, hQ⟩ := hX_dvd
      have hQ0 : Q ≠ 0 := fun h ↦ hP0 (by rw [hQ, h, mul_zero])
      have hQdeg : Q.natDegree < P.natDegree := by
        rw [hQ, Polynomial.natDegree_X_mul hQ0]
        omega
      have hQeval : Polynomial.aeval (⟨aeval f C, hCf_mem⟩ : A) Q = 0 := by
        rw [hQ, map_mul, Polynomial.aeval_X] at hPeval
        have hneA : (⟨aeval f C, hCf_mem⟩ : A) ≠ 0 := fun h ↦ hne (congrArg Subtype.val h)
        exact (mul_eq_zero.mp hPeval).resolve_left hneA
      exact Nat.find_min hex (hPdeg ▸ hQdeg) ⟨Q, hQ0, hQeval, rfl⟩
    have hsplit : P = Polynomial.C (P.coeff 0) + Polynomial.X * P.divX := by
      simp [add_comm]
    have heq0 : (P.coeff 0 : A) + (⟨aeval f C, hCf_mem⟩ : A) *
        Polynomial.aeval (⟨aeval f C, hCf_mem⟩ : A) P.divX = 0 := by
      have h1 := congrArg (Polynomial.aeval (⟨aeval f C, hCf_mem⟩ : A)) hsplit
      rw [hPeval, map_add, map_mul, Polynomial.aeval_C, Polynomial.aeval_X] at h1
      exact h1.symm
    have heq_poly : ((P.coeff 0).1.1 : MvPolynomial σ F) +
        aeval f C * (Polynomial.aeval (⟨aeval f C, hCf_mem⟩ : A) P.divX).1 = 0 :=
      congrArg Subtype.val heq0
    have hΦ_const : Φ ((P.coeff 0).1.1) = 0 := by
      have h1 := congrArg Φ heq_poly
      rw [map_add, map_mul, map_aeval_eq, h0, zero_mul, add_zero] at h1
      exact h1.trans (map_zero Φ)
    obtain ⟨R, hR_A⟩ := exists_aeval_eq_of_mem_adjoin g (P.coeff 0).2
    have hR : aeval (f ∘ e) R = (P.coeff 0).1.1 := by
      have hval := congrArg Subtype.val hR_A
      have hcomm : (aeval g R : A).1 = aeval (f ∘ e) R := by
        clear h0 hne hR_A hval
        induction R using _root_.MvPolynomial.induction_on with
        | C a => simp [A]
        | add p q hp hq => rw [map_add, map_add, Subalgebra.coe_add, hp, hq]
        | mul_X p j hp => simp only [map_mul, aeval_X, MulMemClass.coe_mul, hp, g, comp_apply]
      exact hcomm.symm.trans hval
    have hR0 : R ≠ 0 := by
      intro h0'
      rw [h0', map_zero] at hR
      exact hP0_const (Subtype.ext (Subtype.ext hR.symm))
    have hR_vanish : aeval ((Φ ∘ f) ∘ e) R = 0 := by
      have hcomp : (Φ ∘ f) ∘ e = Φ ∘ (f ∘ e) := rfl
      rw [hcomp, ← map_aeval_eq, hR, hΦ_const]
    exact hR0 (hindΦ.eq_zero_of_aeval_eq_zero R hR_vanish)

private theorem finset_prod_monomial {F σ ι : Type*} [CommSemiring F] (s : Finset ι)
    (e : ι → (σ →₀ ℕ)) (c : ι → F) :
    ∏ i ∈ s, monomial (e i) (c i) = monomial (∑ i ∈ s, e i) (∏ i ∈ s, c i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [monomial_zero']
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.sum_insert ha, Finset.prod_insert ha, ih,
      monomial_mul_monomial]

/-- Monomial collapse for determinants of partial-derivative-like matrices: if row `i` is a sum
over `α ∈ I i` of `c i α * w i α j * X^(μ i α - e_{col j})` (with zero whenever
`μ i α (col j) = 0`), then the determinant has support cardinality at most `∏ i, (I i).card`. -/
theorem card_support_det_monomialDeriv_le {F σ : Type*} [CommRing F] {r : ℕ}
    {ι : Fin r → Type*} (I : ∀ i, Finset (ι i))
    (c : ∀ i, ι i → F) (μ : ∀ i, ι i → (σ →₀ ℕ)) (w : ∀ i, ι i → Fin r → F)
    (cols : Fin r → σ)
    (hw_zero : ∀ i α j, μ i α (cols j) = 0 → w i α j = 0) :
    (Matrix.of fun (i j : Fin r) ↦
      ∑ α ∈ I i, monomial (μ i α - Finsupp.single (cols j) 1) (c i α * w i α j)).det.support.card ≤
      ∏ i : Fin r, (I i).card := by
  classical
  let M : Matrix (Fin r) (Fin r) (MvPolynomial σ F) := Matrix.of fun i j ↦
    ∑ α ∈ I i, monomial (μ i α - Finsupp.single (cols j) 1) (c i α * w i α j)
  let T : Finset (∀ i : Fin r, ι i) := Fintype.piFinset I
  have hdet_eq : M.det = ∑ f ∈ T,
      monomial ((∑ i : Fin r, μ i (f i)) - ∑ j : Fin r, Finsupp.single (cols j) 1)
        ((∏ i : Fin r, c i (f i)) *
          (Matrix.of fun (i j : Fin r) ↦ w i (f i) j).det) := by
    rw [Matrix.det_apply']
    have hterm : ∀ σp : Equiv.Perm (Fin r),
        ∏ j : Fin r, M (σp j) j =
        ∑ f ∈ T, ∏ j : Fin r,
          monomial (μ (σp j) (f (σp j)) - Finsupp.single (cols j) 1)
            (c (σp j) (f (σp j)) * w (σp j) (f (σp j)) j) := fun σp ↦ by
      have h1 : ∏ j : Fin r, M (σp j) j =
          ∏ i : Fin r, ∑ α ∈ I i,
            monomial (μ i α - Finsupp.single (cols (σp⁻¹ i)) 1) (c i α * w i α (σp⁻¹ i)) := by
        refine Fintype.prod_equiv σp _ _ fun j ↦ ?_
        simp [M]
      rw [h1, Finset.prod_sum]
      refine Finset.sum_bij (fun p _ i ↦ p i (Finset.mem_univ i)) ?_ ?_ ?_ ?_
      · intro p hp
        rw [Fintype.mem_piFinset]
        exact fun i ↦ (Finset.mem_pi.mp hp) i (Finset.mem_univ i)
      · intro p₁ _ p₂ _ heq
        ext i hi
        exact congrFun heq i
      · intro f hf
        refine ⟨fun i _ ↦ f i, Finset.mem_pi.mpr fun i _ ↦ (Fintype.mem_piFinset.mp hf) i, rfl⟩
      · intro p _
        have hattach : ∏ x ∈ (Finset.univ : Finset (Fin r)).attach,
            monomial (μ x.1 (p x.1 x.2) - Finsupp.single (cols (σp⁻¹ x.1)) 1)
              (c x.1 (p x.1 x.2) * w x.1 (p x.1 x.2) (σp⁻¹ x.1)) =
            ∏ i : Fin r,
              monomial (μ i (p i (Finset.mem_univ i)) - Finsupp.single (cols (σp⁻¹ i)) 1)
                (c i (p i (Finset.mem_univ i)) * w i (p i (Finset.mem_univ i)) (σp⁻¹ i)) := by
          exact Finset.prod_attach Finset.univ fun i ↦
            monomial (μ i (p i (Finset.mem_univ i)) - Finsupp.single (cols (σp⁻¹ i)) 1)
              (c i (p i (Finset.mem_univ i)) * w i (p i (Finset.mem_univ i)) (σp⁻¹ i))
        rw [hattach]
        exact (Fintype.prod_equiv σp _ _ fun j ↦ by simp).symm
    simp_rw [hterm, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun f _ ↦ ?_
    rw [Matrix.det_apply', Finset.mul_sum, map_sum]
    refine Finset.sum_congr rfl fun σp _ ↦ ?_
    by_cases hpos : ∀ j : Fin r, 1 ≤ μ (σp j) (f (σp j)) (cols j)
    · have hprod_mon : ∏ j : Fin r,
          monomial (μ (σp j) (f (σp j)) - Finsupp.single (cols j) 1)
            (c (σp j) (f (σp j)) * w (σp j) (f (σp j)) j) =
          monomial ((∑ i : Fin r, μ i (f i)) - ∑ j : Fin r, Finsupp.single (cols j) 1)
            ((∏ i : Fin r, c i (f i)) * ∏ j : Fin r, w (σp j) (f (σp j)) j) := by
        rw [finset_prod_monomial]
        refine congrArg₂ (fun e a ↦ monomial e a) ?_ ?_
        · ext v
          have hsum_app : ∀ (g : Fin r → (σ →₀ ℕ)), (∑ j : Fin r, g j) v = ∑ j : Fin r, g j v :=
            fun g ↦ map_sum (Finsupp.applyAddHom v) g Finset.univ
          rw [Finsupp.tsub_apply, hsum_app, hsum_app, hsum_app]
          simp only [Finsupp.tsub_apply]
          have hle : ∀ j : Fin r, (Finsupp.single (cols j) 1) v ≤ μ (σp j) (f (σp j)) v := by
            intro j
            rw [Finsupp.single_apply]
            split_ifs with h
            · subst h; exact hpos j
            · exact Nat.zero_le _
          have hsub_sum :
              ∑ j : Fin r, (μ (σp j) (f (σp j)) v - (Finsupp.single (cols j) 1) v) =
              (∑ j : Fin r, μ (σp j) (f (σp j)) v) -
                ∑ j : Fin r, (Finsupp.single (cols j) 1) v := by
            have hadd : (∑ j : Fin r, (μ (σp j) (f (σp j)) v - (Finsupp.single (cols j) 1) v)) +
                ∑ j : Fin r, (Finsupp.single (cols j) 1) v =
                ∑ j : Fin r, μ (σp j) (f (σp j)) v := by
              rw [← Finset.sum_add_distrib]
              refine Finset.sum_congr rfl fun j _ ↦ Nat.sub_add_cancel (hle j)
            omega
          rw [hsub_sum]
          congr 1
          exact Fintype.sum_equiv σp _ _ fun _ ↦ rfl
        · rw [Finset.prod_mul_distrib]
          congr 1
          exact Fintype.prod_equiv σp _ _ fun _ ↦ rfl
      rw [hprod_mon]
      have hsign : (Equiv.Perm.sign σp : MvPolynomial σ F) = C (Equiv.Perm.sign σp : F) := by
        rcases Int.units_eq_one_or (Equiv.Perm.sign σp) with h | h <;> simp [h]
      rw [hsign, C_mul_monomial]
      congr 1
      simp only [Matrix.of_apply]
      ring
    · push Not at hpos
      obtain ⟨j₀, hj₀⟩ := hpos
      have hj0 : μ (σp j₀) (f (σp j₀)) (cols j₀) = 0 := by omega
      have hw0 : w (σp j₀) (f (σp j₀)) j₀ = 0 := hw_zero _ _ _ hj0
      have h1 : ∏ j : Fin r,
          monomial (μ (σp j) (f (σp j)) - Finsupp.single (cols j) 1)
            (c (σp j) (f (σp j)) * w (σp j) (f (σp j)) j) = 0 :=
        Finset.prod_eq_zero (Finset.mem_univ j₀) (by simp [hw0])
      have h2 : ∏ j : Fin r, w (σp j) (f (σp j)) j = 0 :=
        Finset.prod_eq_zero (Finset.mem_univ j₀) hw0
      simp only [Matrix.of_apply]
      rw [h1, mul_zero, h2, mul_zero, mul_zero, monomial_zero]
  change M.det.support.card ≤ ∏ i : Fin r, (I i).card
  rw [hdet_eq]
  have hsub : (∑ f ∈ T, monomial ((∑ i : Fin r, μ i (f i)) - ∑ j : Fin r, Finsupp.single (cols j) 1)
      ((∏ i : Fin r, c i (f i)) * (Matrix.of fun (i j : Fin r) ↦ w i (f i) j).det)).support ⊆
      T.image fun f ↦ (∑ i : Fin r, μ i (f i)) - ∑ j : Fin r, Finsupp.single (cols j) 1 := by
    intro m hm
    rw [mem_support_iff, coeff_sum] at hm
    obtain ⟨f, hfT, hne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hm
    rw [coeff_monomial] at hne
    split_ifs at hne with heq
    · exact Finset.mem_image.mpr ⟨f, hfT, heq⟩
    · exact absurd rfl hne
  calc _ ≤ (T.image fun f ↦ (∑ i : Fin r, μ i (f i)) -
              ∑ j : Fin r, Finsupp.single (cols j) 1).card := Finset.card_le_card hsub
    _ ≤ T.card := Finset.card_image_le
    _ = ∏ i : Fin r, (I i).card := Fintype.card_piFinset I

/-- Sharp Jacobian minor sparsity bound: for any `r` polynomials `f_1, ..., f_r` and any `r`
columns `cols`, `(jacobianMinor f cols).support.card ≤ ∏ i, (f i).support.card`. -/
theorem card_support_jacobianMinor_le {F σ : Type*} [CommRing F] {r : ℕ}
    (f : Fin r → MvPolynomial σ F) (cols : Fin r → σ) :
    (jacobianMinor f cols).support.card ≤ ∏ i : Fin r, (f i).support.card := by
  classical
  have hmat : (Matrix.of fun (i j : Fin r) ↦ _root_.MvPolynomial.pderiv (cols j) (f i)) =
      Matrix.of fun (i j : Fin r) ↦
        ∑ α ∈ (f i).support,
          monomial (α - Finsupp.single (cols j) 1) ((f i).coeff α * (α (cols j) : F)) := by
    refine Matrix.ext fun i j ↦ ?_
    simp only [Matrix.of_apply]
    conv_lhs => rw [(f i).as_sum, map_sum]
    refine Finset.sum_congr rfl fun α _ ↦ ?_
    rw [pderiv_monomial]
  rw [jacobianMinor_eq_det, hmat]
  exact card_support_det_monomialDeriv_le (fun i ↦ (f i).support)
    (fun i α ↦ (f i).coeff α) (fun _ α ↦ α) (fun _ α j ↦ (α (cols j) : F)) cols
    (fun _ _ _ h ↦ by simp [h])

end CslibFrontier.MvPolynomial
